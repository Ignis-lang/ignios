//!
//! # User Mode Self-Tests
//!
//! Boot-time checks of ring 3, system calls and process isolation.
//!
//! ## Overview
//!
//! Each test runs a throwaway ring 3 program from `user_test_asm.S` as a real
//! process and compares what the kernel sees with what the program is
//! supposed to do. A mismatch panics.
//!
//! | Step              | What it proves                                          |
//! |-------------------|---------------------------------------------------------|
//! | exit(42)          | `iretq` to ring 3, `SYSCALL` in, status delivered by `wait` |
//! | registers         | `SYSRET` returns `-ENOSYS` and preserves every register but RAX, RCX, R11 |
//! | spin              | timer interrupts arrive while in ring 3 and return by `iretq` |
//! | syscalls          | `write`, `getpid`, `sched_yield`, `nanosleep` and their errors |
//! | isolation (9 programs) | a fault or a forbidden instruction kills only that process, no frame leaks |
//! | hello             | a real static ELF64 loaded from a Limine module        |
//!
//! `main.ign` calls `UserTest::run` once, after the scheduler tests and before
//! it enables the keyboard.

import Drivers from "@drivers";
import Mm from "@mm";
import Time from "@time";
import Process from "./process";
import Programs from "./programs";

/// Functions implemented in `user_test_asm.S`.
extern UserTestAsm {
  /// Address of the machine code of program `index`.
  function ignis_user_test_start(index: u64): u64;

  /// Length in bytes of program `index`.
  function ignis_user_test_size(index: u64): u64;
}

/// The user mode tests.
export namespace UserTest {
  /// Program index 0: `exit(42)`.
  const EXIT: u64 = 0;

  /// Program index 1: checks that a system call preserves the registers.
  const REGISTERS: u64 = 1;

  /// Program index 2: a long loop in ring 3 that timer interrupts interrupt.
  const SPIN: u64 = 2;

  /// Program index 3: exercises every implemented system call and its errors.
  const SYSCALLS: u64 = 3;

  /// Program index 4: writes to page 0. Indexes 4 to 12 are the misbehaving
  /// programs.
  const NULL_WRITE: u64 = 4;

  /// Index 5: executes `hlt`.
  const HLT: u64 = 5;

  /// Index 6: executes `cli`.
  const CLI: u64 = 6;

  /// Index 7: executes an undefined instruction (`ud2`).
  const UNDEFINED: u64 = 7;

  /// Index 8: reads kernel memory.
  const KERNEL_READ: u64 = 8;

  /// Index 9: writes to I/O port 0x3F8.
  const PORT: u64 = 9;

  /// Index 10: writes to its own read-only code page.
  const CODE_WRITE: u64 = 10;

  /// Index 11: jumps to its no-execute stack.
  const STACK_JUMP: u64 = 11;

  /// Index 12: divides by zero.
  const DIVIDE: u64 = 12;

  /// What the shell shows for a process that died of SIGSEGV, SIGILL and
  /// SIGFPE: 128 plus 11, 4 and 8.
  const KILLED_BY_SEGV: u64 = 139;

  /// 128 + 4 (SIGILL).
  const KILLED_BY_ILL: u64 = 132;

  /// 128 + 8 (SIGFPE).
  const KILLED_BY_FPE: u64 = 136;

  /// The program sleeps 20 ms, which is two timer ticks.
  const SYSCALLS_SLEEP_TICKS: u64 = 2;

  /// Runs the programs one after the other and reports on the console.
  function run(): void {
    let exitStatus: u64 = runProgram(EXIT);

    if (exitStatus != 42) {
      @panic("user test: exit(42) came back with another status");
    }

    Drivers::Console::writeLine("user: ring 3 entered by iretq, exit(42) through SYSCALL gave status 42");

    if (runProgram(REGISTERS) != 0) {
      @panic("user test: SYSCALL changed a register or returned the wrong value");
    }

    Drivers::Console::writeLine("user: SYSCALL returned -ENOSYS by SYSRET with every other register intact");

    let ticksBefore: u64 = Time::Timer::ticks();

    if (runProgram(SPIN) != 7) {
      @panic("user test: the spinning program did not finish");
    }

    let ticks: u64 = Time::Timer::ticks() - ticksBefore;

    if (ticks == 0) {
      @panic("user test: no timer tick arrived while a program ran in ring 3");
    }

    Drivers::Console::write("user: ");
    Drivers::Console::writeDecimal(ticks);
    Drivers::Console::writeLine(" timer ticks passed while it ran in ring 3 and every one returned by iretq");

    runSyscalls();
    runIsolation();
    runHello();
  }

  /// Runs every program that does something a user program must not and
  /// checks that each one is killed with the status of the matching signal,
  /// that the kernel is still running afterwards and that no frame leaked.
  function runIsolation(): void {
    let freeBefore: u64 = Mm::Pmm::freeFrameCount();

    expectKilled(NULL_WRITE, KILLED_BY_SEGV);
    expectKilled(HLT, KILLED_BY_SEGV);
    expectKilled(CLI, KILLED_BY_SEGV);
    expectKilled(UNDEFINED, KILLED_BY_ILL);
    expectKilled(KERNEL_READ, KILLED_BY_SEGV);
    expectKilled(PORT, KILLED_BY_SEGV);
    expectKilled(CODE_WRITE, KILLED_BY_SEGV);
    expectKilled(STACK_JUMP, KILLED_BY_SEGV);
    expectKilled(DIVIDE, KILLED_BY_FPE);

    if (Mm::Pmm::freeFrameCount() != freeBefore) {
      @panic("user test: killed processes leaked frames");
    }

    Drivers::Console::writeLine("user: isolation ok, a null write, hlt, cli, ud2, a kernel read, port I/O, a write to code, a jump to the stack and a divide by zero each killed only their process");
  }

  /// Runs program `index` and panics unless the kernel killed it with
  /// `status`.
  function expectKilled(index: u64, status: u64): void {
    if (runProgram(index) != status) {
      Drivers::Console::write("user test: program ");
      Drivers::Console::writeDecimal(index);
      Drivers::Console::writeLine(" was not killed as expected");
      @panic("user test: a misbehaving program was not killed");
    }
  }

  /// Runs `hello`, the ELF program the bootloader loaded as a module. It
  /// prints from ring 3 and exits with 0 when its own checks pass.
  function runHello(): void {
    let status: u64 = Programs::runNamed("hello");

    if (status != 0) {
      @panic("user test: the hello program failed");
    }

    Drivers::Console::writeLine("user: hello from a static ELF64 module loaded by Limine ran and exited with status 0");
  }

  /// Runs the system call program, which prints from ring 3 and checks the
  /// result of every call, including the error ones.
  function runSyscalls(): void {
    let ticksBefore: u64 = Time::Timer::ticks();
    let status: u64 = runProgram(SYSCALLS);

    if (status != 0) {
      Drivers::Console::write("user test: system call check ");
      Drivers::Console::writeDecimal(status);
      Drivers::Console::writeLine(" failed");
      @panic("user test: a system call returned the wrong value");
    }

    if (Time::Timer::ticks() - ticksBefore < SYSCALLS_SLEEP_TICKS) {
      @panic("user test: nanosleep returned too early");
    }

    Drivers::Console::writeLine("user: write, getpid, sched_yield, nanosleep, -ENOSYS, -EFAULT, -EBADF and -EINVAL behave as on Linux");
  }

  /// Starts program `index` as a process, waits for it and returns its exit
  /// status.
  function runProgram(index: u64): u64 {
    let start: u64 = UserTestAsm::ignis_user_test_start(index);
    let size: u64 = UserTestAsm::ignis_user_test_size(index);

    let id: u64 = Process::startCode(@pointerFromInteger<*u8>(start), size);

    if (id == Process::NO_PROCESS) {
      @panic("user test: cannot start a process");
    }

    return Process::wait(id);
  }
}
