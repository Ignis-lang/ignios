//!
//! # Scheduler Self-Tests
//!
//! Boot-time checks of the scheduler. They run with the timer ticking and
//! report by panicking on the first violation.
//!
//! ## Tests
//!
//! | Function            | What it proves                                           |
//! |---------------------|----------------------------------------------------------|
//! | `runCooperative`    | round-robin order, exit and slot reuse, sleep timing, a full table |
//! | `runAddressSpaces`  | two threads read the same user address and each sees its own page, so a switch loads the right CR3, and no frame leaks |
//! | `runPreemptive`     | two threads that never yield both get the processor, taken by the timer |
//!
//! A thread function can only be turned into the address `Sched::Scheduler::spawn`
//! takes where it is named, so every `spawn` here names its function.
//! `main.ign` runs them in the order above and prints a line after each.

import Arch from "@arch";
import Boot from "@boot";
import Mm from "@mm";
import Sched from "@sched";
import Time from "@time";

/// Results the test threads report back to the boot thread.
record SchedulerTestState {
  /// Shared sum the round-robin workers add their weight to.
  static mut counter: u64;

  /// The order in which the workers ran: each step stores the worker index.
  static mut trace: u8[16];

  /// Entries stored in `trace`.
  static mut traceLength: u64;

  /// How many ticks the sleeping worker measured.
  static mut sleptTicks: u64;

  /// Set to 1 by the boot thread to tell the spinners to finish.
  static mut stop: u64;

  /// Loop iterations each spinner completed.
  static mut spins: u64[2];

  /// Reads that found the expected marker, for each address-space thread.
  static mut spaceReads: u64[2];
}

/// The scheduler tests. Each function checks one property and panics when it
/// fails.
export namespace SchedulerTest {
  /// Round-robin workers started by `testRoundRobin`.
  const WORKERS: u64 = 3;

  /// Steps (and yields) each worker performs.
  const STEPS: u64 = 3;

  /// Ticks the sleeping worker asks for.
  const SLEEP_TICKS: u64 = 5;

  /// The user address both address-space threads read: `0x400000`, where
  /// programs are loaded.
  const SPACE_ADDRESS: u64 = 0x400000;

  /// Base of the marker thread `index` finds at `SPACE_ADDRESS`: the value
  /// there is `SPACE_MARKER + index`, so each thread can tell its own page.
  const SPACE_MARKER: u64 = 0x5100;

  /// Reads each address-space thread performs.
  const SPACE_ROUNDS: u64 = 4;

  /// Ticks the preemption check lets two threads that never yield compete.
  const PREEMPTION_TICKS: u64 = 40;

  /// Runs the cooperative checks: round-robin order, exit and reuse of
  /// slots, sleeping, and a full table. The scheduler must be initialized
  /// and the timer running. Interrupts are left as they were found.
  function runCooperative(): void {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();

    testRoundRobin();
    testSleep();
    testFullTable();

    Arch::Cpu::restoreInterrupts(saved);
  }

  /// Two threads in two address spaces read the same user address while
  /// they yield to each other, and each must see its own page every time:
  /// the scheduler loads the CR3 of the thread it switches to. Frees the
  /// spaces' frames when the threads end and checks the PMM count. Interrupts
  /// are left as they were found.
  function runAddressSpaces(): void {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();
    let freeBefore: u64 = Mm::Pmm::freeFrameCount();
    let mut ids: u64[2];
    let mut index: u64 = 0;

    while (index < 2) {
      SchedulerTestState::spaceReads[index] = 0;

      let root: u64 = Mm::AddressSpace::create();
      let frame: u64 = Mm::AddressSpace::allocatePage(root, SPACE_ADDRESS, Mm::Vmm::WRITABLE | Mm::Vmm::NO_EXECUTE);

      if (root == Mm::Pmm::NO_FRAME || frame == Mm::Pmm::NO_FRAME) {
        @panic("address space switch self-test: no memory");
      }

      *(Boot::Hhdm::toVirtual(frame) as *mut u64) = SPACE_MARKER + index;

      ids[index] = Sched::Scheduler::spawnIn(Arch::ContextAsm::ignis_function_address(spaceReader), index, root);

      if (ids[index] == Sched::Thread::NO_THREAD) {
        @panic("address space switch self-test: cannot spawn");
      }

      index += 1;
    }

    joinRange(ids[0], ids[1]);

    if (SchedulerTestState::spaceReads[0] != SPACE_ROUNDS || SchedulerTestState::spaceReads[1] != SPACE_ROUNDS) {
      @panic("address space switch self-test: a thread saw another thread's page");
    }

    if (Arch::Cpu::readCr3() != Mm::Vmm::rootTable()) {
      @panic("address space switch self-test: CR3 is not back on the kernel space");
    }

    if (Mm::Pmm::freeFrameCount() != freeBefore) {
      @panic("address space switch self-test: an address space leaked frames");
    }

    Arch::Cpu::restoreInterrupts(saved);
  }

  /// Two threads that spin without ever yielding must both get the processor
  /// from the timer interrupt while the boot thread, which is waiting for
  /// time to pass, keeps getting it back. Preemption must be enabled.
  /// Interrupts are left as they were found. Returns how many times the
  /// timer took the processor away from a thread that had not given it up.
  function runPreemptive(): u64 {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();
    let preemptionsBefore: u64 = Sched::Scheduler::preemptionCount();

    SchedulerTestState::stop = 0;
    SchedulerTestState::spins[0] = 0;
    SchedulerTestState::spins[1] = 0;

    let first: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(spinner), 0);
    let second: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(spinner), 1);

    let end: u64 = Time::Timer::ticks() + PREEMPTION_TICKS;

    Arch::Cpu::enableInterrupts();

    while (Time::Timer::ticks() < end) {
      Arch::Cpu::waitForInterrupt();
    }

    Arch::Cpu::disableInterrupts();
    @writeVolatile<u64>(&mut SchedulerTestState::stop as *mut u64, 1);

    joinRange(first, second);

    if (spinCount(0) == 0 || spinCount(1) == 0) {
      @panic("preemption self-test: a spinning thread never got the processor");
    }

    let preemptions: u64 = Sched::Scheduler::preemptionCount() - preemptionsBefore;

    if (preemptions < 2) {
      @panic("preemption self-test: the timer did not take the processor away");
    }

    Arch::Cpu::restoreInterrupts(saved);

    return preemptions;
  }

  /// Three workers that yield after every step must interleave in the order
  /// they were spawned, and each must add its own weight to the shared
  /// counter every step.
  function testRoundRobin(): void {
    SchedulerTestState::counter = 0;
    SchedulerTestState::traceLength = 0;

    let threadsBefore: u64 = Sched::Thread::threadCount();
    let first: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(roundRobinWorker), 0);
    let second: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(roundRobinWorker), 1);
    let third: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(roundRobinWorker), 2);

    if (second != first + 1 || third != second + 1) {
      @panic("scheduler self-test: thread ids are not sequential");
    }

    joinRange(first, third);

    if (SchedulerTestState::traceLength != WORKERS * STEPS) {
      @panic("scheduler self-test: a worker did not finish all its steps");
    }

    let mut index: u64 = 0;

    while (index < WORKERS * STEPS) {
      if ((SchedulerTestState::trace[index] as u64) != index % WORKERS) {
        @panic("scheduler self-test: the workers did not run round-robin");
      }

      index += 1;
    }

    if (SchedulerTestState::counter != STEPS * (1 + 2 + 3)) {
      @panic("scheduler self-test: the shared counter is wrong");
    }

    if (Sched::Thread::threadCount() != threadsBefore) {
      @panic("scheduler self-test: exited threads were not freed");
    }
  }

  /// A sleeper must stay blocked for the ticks it asked for and then run
  /// again.
  function testSleep(): void {
    SchedulerTestState::sleptTicks = 0;

    let id: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(sleepWorker), SLEEP_TICKS);

    joinRange(id, id);

    if (SchedulerTestState::sleptTicks < SLEEP_TICKS || SchedulerTestState::sleptTicks > SLEEP_TICKS + 2) {
      @panic("scheduler self-test: a sleeper woke at the wrong time");
    }
  }

  /// Filling every slot must make the next `spawn` fail cleanly, and the
  /// slots must be usable again once their threads are gone.
  function testFullTable(): void {
    let free: u64 = Sched::Thread::MAX_THREADS - Sched::Thread::threadCount();
    let mut first: u64 = Sched::Thread::NO_THREAD;
    let mut last: u64 = Sched::Thread::NO_THREAD;
    let mut spawned: u64 = 0;

    while (true) {
      let id: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(sleepWorker), 2);

      if (id == Sched::Thread::NO_THREAD) {
        break;
      }

      if (first == Sched::Thread::NO_THREAD) {
        first = id;
      }

      last = id;
      spawned += 1;
    }

    if (spawned != free || spawned == 0) {
      @panic("scheduler self-test: the table did not fill up exactly");
    }

    joinRange(first, last);

    let again: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(sleepWorker), 1);

    if (again == Sched::Thread::NO_THREAD) {
      @panic("scheduler self-test: a freed slot could not be reused");
    }

    joinRange(again, again);
  }

  /// Sleeps one tick at a time until no thread with an id from `first` to
  /// `last` is left. Sleeping rather than yielding lets the idle thread run
  /// and the tick count advance when every other thread is asleep.
  function joinRange(first: u64, last: u64): void {
    let mut id: u64 = first;

    while (id <= last) {
      while (Sched::Thread::isAlive(id)) {
        Sched::Scheduler::sleep(1);
      }

      id += 1;
    }
  }

  /// Reads the user address `SPACE_ADDRESS` `SPACE_ROUNDS` times, yielding
  /// between the reads, and counts the reads that found its own marker.
  function spaceReader(index: u64): void {
    let page: *mut u64 = @pointerFromInteger<*mut u64>(SPACE_ADDRESS);
    let mut round: u64 = 0;

    while (round < SPACE_ROUNDS) {
      if (*page == SPACE_MARKER + index) {
        SchedulerTestState::spaceReads[index] += 1;
      }

      Sched::Scheduler::yield();
      round += 1;
    }
  }

  /// How many loop iterations spinner `index` completed.
  function spinCount(index: u64): u64 {
    return @readVolatile<u64>(&mut SchedulerTestState::spins as *mut u64 + index);
  }

  /// Counts iterations until told to stop and never yields, sleeps or
  /// blocks.
  function spinner(index: u64): void {
    let counter: *mut u64 = &mut SchedulerTestState::spins as *mut u64 + index;

    while (@readVolatile<u64>(&mut SchedulerTestState::stop as *mut u64) == 0) {
      @writeVolatile<u64>(counter, @readVolatile<u64>(counter) + 1);
    }
  }

  /// Adds its weight to the counter and records its index, `STEPS` times,
  /// yielding after each.
  function roundRobinWorker(index: u64): void {
    let mut step: u64 = 0;

    while (step < STEPS) {
      SchedulerTestState::trace[SchedulerTestState::traceLength] = index as u8;
      SchedulerTestState::traceLength += 1;
      SchedulerTestState::counter += index + 1;
      Sched::Scheduler::yield();
      step += 1;
    }
  }

  /// Sleeps `ticks` ticks and records how long that took.
  function sleepWorker(ticks: u64): void {
    let start: u64 = Time::Timer::ticks();

    Sched::Scheduler::sleep(ticks);
    SchedulerTestState::sleptTicks = Time::Timer::ticks() - start;
  }
}
