//!
//! # Limine Modules
//!
//! Files the bootloader loaded next to the kernel, the Limine modules named
//! in `boot/limine.conf`.
//!
//! ## Overview
//!
//! The protocol reports each module's address and size in the higher half
//! direct map. Modules live in memory of type "executable and modules", which
//! the kernel's own direct map leaves out so that the kernel image cannot be
//! written through it. `initialize` therefore maps the pages of every module,
//! read only and no-execute, before anything reads a module. A module is
//! found by the string the configuration associates with it.
//!
//! ```text
//!   boot/limine.conf                         limine.ign / modules.ign
//!   module_path:   boot():/hello.elf   ──►   File.path    "/hello.elf"
//!   module_string: hello               ──►   File.string  "hello"   <- `run hello`
//!                                            File.address, File.size
//! ```

import Boot from "@boot";
import Drivers from "@drivers";
import Vmm from "./vmm";

/// The module API.
export namespace Modules {
  /// 4 KiB.
  const PAGE_SIZE: u64 = 4096;

  /// Returned by `find` when no module has the name.
  const NOT_FOUND: u64 = 0xFFFFFFFFFFFFFFFF;

  /// Maps every module read only and lists them on the console.
  function initialize(): void {
    let response: *mut Boot::Limine::ModuleResponse = Boot::Limine::modules();

    if (response == null) {
      Drivers::Console::writeLine("modules: none");
      return;
    }

    let mut index: u64 = 0;

    while (index < (*response).moduleCount) {
      let file: *mut Boot::Limine::File = Boot::Limine::moduleFile(response, index);

      let start: u64 = @integerFromPointer((*file).address) / PAGE_SIZE * PAGE_SIZE;
      let end: u64 = (@integerFromPointer((*file).address) + (*file).size + PAGE_SIZE - 1) / PAGE_SIZE * PAGE_SIZE;

      Vmm::mapRange(start, start - Boot::Hhdm::offset(), end - start, Vmm::NO_EXECUTE);

      Drivers::Console::write("modules: ");
      writeText((*file).string);
      Drivers::Console::write(" is ");
      writeText((*file).path);
      Drivers::Console::write(", ");
      Drivers::Console::writeDecimal((*file).size);
      Drivers::Console::write(" bytes at ");
      Drivers::Console::writeHex(@integerFromPointer((*file).address));
      Drivers::Console::writeLine("");

      index += 1;
    }
  }

  /// The number of modules the bootloader loaded, 0 when it gave no response.
  function count(): u64 {
    let response: *mut Boot::Limine::ModuleResponse = Boot::Limine::modules();

    if (response == null) {
      return 0;
    }

    return (*response).moduleCount;
  }

  /// The index of the module whose configuration string is the `length`
  /// bytes at `name`, or `NOT_FOUND`.
  function find(name: *u8, length: u64): u64 {
    let mut index: u64 = 0;

    while (index < count()) {
      if (stringIs((*moduleAt(index)).string, name, length)) {
        return index;
      }

      index += 1;
    }

    return NOT_FOUND;
  }

  /// The first byte of module `index`.
  function address(index: u64): *u8 {
    return (*moduleAt(index)).address as *u8;
  }

  /// The size in bytes of module `index`.
  function size(index: u64): u64 {
    return (*moduleAt(index)).size;
  }

  /// The Limine file record of module `index`.
  function moduleAt(index: u64): *mut Boot::Limine::File {
    return Boot::Limine::moduleFile(Boot::Limine::modules(), index);
  }

  /// Writes a NUL-terminated string the bootloader owns.
  function writeText(text: *mut u8): void {
    let mut index: u64 = 0;

    while (*(text + index) != 0) {
      Drivers::Console::writeChar(*(text + index));
      index += 1;
    }
  }

  /// True when the NUL-terminated `text` is exactly the `length` bytes at
  /// `name`.
  function stringIs(text: *mut u8, name: *u8, length: u64): boolean {
    let mut index: u64 = 0;

    while (index < length) {
      if (*(text + index) == 0 || *(text + index) != *(name + index)) {
        return false;
      }

      index += 1;
    }

    return *(text + length) == 0;
  }
}
