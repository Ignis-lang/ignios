//!
//! # System Call Operations
//!
//! The small numbers the kernel uses for what a system call does, independent
//! of any ABI.
//!
//! ## Overview
//!
//! Dispatch has two steps so the kernel can speak more than one convention.
//! An ABI owns a table that turns its own system call number into one of these
//! operations, and the kernel then runs the operation. A number the table does
//! not know turns into `NONE`. The tables are `TABLE_SIZE` bytes long, so
//! numbers 0 to 511 can be mapped.

/// The kernel operations and the size of an ABI table.
namespace Syscall::Operation {
  /// System call numbers 0 to 511 can be mapped. The Linux table has fewer.
  const TABLE_SIZE: u64 = 512;

  /// Kernel operations. 0 is what a number the ABI does not know maps to.
  const NONE: u8 = 0;

  /// End the process.
  const EXIT: u8 = 1;

  /// Write bytes to a descriptor.
  const WRITE: u8 = 2;

  /// Return the process id.
  const GET_PID: u8 = 3;

  /// Give up the processor.
  const YIELD: u8 = 4;

  /// Sleep for a time.
  const SLEEP: u8 = 5;

  /// Read bytes from a descriptor.
  const READ: u8 = 6;

  /// Open a path relative to a directory.
  const OPEN: u8 = 7;

  /// Close a descriptor.
  const CLOSE: u8 = 8;

  /// Move the offset of a descriptor.
  const SEEK: u8 = 9;

  /// Describe the file of a descriptor.
  const STAT: u8 = 10;

  /// Describe the file of a path relative to a directory.
  const STAT_AT: u8 = 11;

  /// Read the entries of a directory.
  const READ_DIRECTORY: u8 = 12;

  /// Create a directory at a path relative to a directory.
  const MAKE_DIRECTORY: u8 = 13;

  /// Map a new region of memory.
  const MAP: u8 = 14;

  /// Remove mapped memory.
  const UNMAP: u8 = 15;

  /// Power the machine off or reset it.
  const POWER: u8 = 16;

  /// Remove a file.
  const UNLINK: u8 = 17;

  /// Remove an empty directory.
  const REMOVE_DIRECTORY: u8 = 18;

  /// Change the current directory.
  const CHANGE_DIRECTORY: u8 = 19;

  /// Read the path of the current directory.
  const CURRENT_DIRECTORY: u8 = 20;

  /// Start a program from a path.
  const SPAWN: u8 = 21;

  /// Wait for a process to end.
  const WAIT: u8 = 22;

  /// Wait for any child to end.
  const WAIT_ANY: u8 = 23;
}
