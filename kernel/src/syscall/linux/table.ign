//!
//! # Linux System Call Table
//!
//! The Linux x86_64 numbers the kernel implements, and the table that maps
//! each one to a kernel operation.
//!
//! ## Calls Implemented
//!
//! | Linux no | Name          | Operation            | Notes                           |
//! |----------|---------------|----------------------|---------------------------------|
//! | 1        | `write`       | `Operation::WRITE`   | fd 1 and 2 only, to the console |
//! | 24       | `sched_yield` | `Operation::YIELD`   | returns 0                       |
//! | 35       | `nanosleep`   | `Operation::SLEEP`   | rounded up to 10 ms ticks       |
//! | 39       | `getpid`      | `Operation::GET_PID` | the process id                  |
//! | 56       | `clone`       | `Operation::CLONE`   | threads only (`linux/thread.ign`) |
//! | 60       | `exit`        | `Operation::EXIT_THREAD` | ends the calling thread, status & 0xFF; the process when it is the last |
//! | 158      | `arch_prctl`  | `Operation::ARCH_CONTROL` | `ARCH_SET_FS`, `ARCH_GET_FS`  |
//! | 186      | `gettid`      | `Operation::GET_TID` | the thread id                   |
//! | 202      | `futex`       | `Operation::FUTEX`   | WAIT and WAKE (`linux/futex.ign`) |
//! | 218      | `set_tid_address` | `Operation::SET_TID_ADDRESS` | records the address, returns the tid |
//! | 231      | `exit_group`  | `Operation::EXIT`    | ends every thread, status & 0xFF |
//!
//! Every other number maps to `Operation::NONE` and fails with `-ENOSYS` (-38).
//! The numbers come from the Linux x86_64 syscall table,
//! `arch/x86/entry/syscalls/syscall_64.tbl`.

import _ from "../operation";

/// The number-to-operation table of the Linux ABI.
record LinuxTableState {
  /// One byte per system call number, the `Syscall::Operation` value it maps
  /// to. Zero entries are `NONE`. The size must equal
  /// `Syscall::Operation::TABLE_SIZE`.
  static mut linux: u8[512];
}

/// The Linux numbers and the table.
namespace Syscall::Linux {
  /// Linux numbers, from arch/x86/entry/syscalls/syscall_64.tbl. `read`, 0.
  const NUMBER_READ: u64 = 0;

  /// `write`, number 1.
  const NUMBER_WRITE: u64 = 1;

  /// `close`, number 3.
  const NUMBER_CLOSE: u64 = 3;

  /// `fstat`, number 5.
  const NUMBER_FSTAT: u64 = 5;

  /// `lseek`, number 8.
  const NUMBER_LSEEK: u64 = 8;

  /// `mmap`, number 9.
  const NUMBER_MMAP: u64 = 9;

  /// `munmap`, number 11.
  const NUMBER_MUNMAP: u64 = 11;

  /// `sched_yield`, number 24.
  const NUMBER_SCHED_YIELD: u64 = 24;

  /// `nanosleep`, number 35.
  const NUMBER_NANOSLEEP: u64 = 35;

  /// `getpid`, number 39.
  const NUMBER_GETPID: u64 = 39;

  /// `clone`, number 56.
  const NUMBER_CLONE: u64 = 56;

  /// `exit`, number 60.
  const NUMBER_EXIT: u64 = 60;

  /// `kill`, number 62.
  const NUMBER_KILL: u64 = 62;

  /// `getcwd`, number 79.
  const NUMBER_GETCWD: u64 = 79;

  /// `chdir`, number 80.
  const NUMBER_CHDIR: u64 = 80;

  /// `arch_prctl`, number 158.
  const NUMBER_ARCH_PRCTL: u64 = 158;

  /// `gettid`, number 186.
  const NUMBER_GETTID: u64 = 186;

  /// `futex`, number 202.
  const NUMBER_FUTEX: u64 = 202;

  /// `set_tid_address`, number 218.
  const NUMBER_SET_TID_ADDRESS: u64 = 218;

  /// `reboot`, number 169.
  const NUMBER_REBOOT: u64 = 169;

  /// `getdents64`, number 217.
  const NUMBER_GETDENTS64: u64 = 217;

  /// `exit_group`, number 231.
  const NUMBER_EXIT_GROUP: u64 = 231;

  /// `openat`, number 257.
  const NUMBER_OPENAT: u64 = 257;

  /// `mkdirat`, number 258.
  const NUMBER_MKDIRAT: u64 = 258;

  /// `newfstatat`, number 262.
  const NUMBER_NEWFSTATAT: u64 = 262;

  /// `unlinkat`, number 263.
  const NUMBER_UNLINKAT: u64 = 263;

  /// Fills the table of the Linux ABI.
  function initialize(): void {
    let table: *mut u8 = tableBase();

    *(table + NUMBER_READ) = Operation::READ;
    *(table + NUMBER_WRITE) = Operation::WRITE;
    *(table + NUMBER_CLOSE) = Operation::CLOSE;
    *(table + NUMBER_FSTAT) = Operation::STAT;
    *(table + NUMBER_LSEEK) = Operation::SEEK;
    *(table + NUMBER_MMAP) = Operation::MAP;
    *(table + NUMBER_MUNMAP) = Operation::UNMAP;
    *(table + NUMBER_GETDENTS64) = Operation::READ_DIRECTORY;
    *(table + NUMBER_REBOOT) = Operation::POWER;
    *(table + NUMBER_OPENAT) = Operation::OPEN;
    *(table + NUMBER_MKDIRAT) = Operation::MAKE_DIRECTORY;
    *(table + NUMBER_NEWFSTATAT) = Operation::STAT_AT;
    *(table + NUMBER_UNLINKAT) = Operation::UNLINK;
    *(table + NUMBER_GETCWD) = Operation::CURRENT_DIRECTORY;
    *(table + NUMBER_KILL) = Operation::KILL;
    *(table + NUMBER_CHDIR) = Operation::CHANGE_DIRECTORY;
    *(table + NUMBER_SCHED_YIELD) = Operation::YIELD;
    *(table + NUMBER_NANOSLEEP) = Operation::SLEEP;
    *(table + NUMBER_GETPID) = Operation::GET_PID;
    *(table + NUMBER_EXIT) = Operation::EXIT_THREAD;
    *(table + NUMBER_CLONE) = Operation::CLONE;
    *(table + NUMBER_ARCH_PRCTL) = Operation::ARCH_CONTROL;
    *(table + NUMBER_GETTID) = Operation::GET_TID;
    *(table + NUMBER_SET_TID_ADDRESS) = Operation::SET_TID_ADDRESS;
    *(table + NUMBER_FUTEX) = Operation::FUTEX;
    *(table + NUMBER_EXIT_GROUP) = Operation::EXIT;
  }

  /// The first byte of the table.
  function tableBase(): *mut u8 {
    return &mut LinuxTableState::linux as *mut u8;
  }
}
