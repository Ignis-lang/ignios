//!
//! # Linux Memory System Calls
//!
//! `mmap` and `munmap` on top of `Proc::Memory`.
//!
//! ## Overview
//!
//! `mmap(addr, length, prot, flags, fd, offset)` maps a new region and
//! returns its address. Three kinds are supported:
//!
//! | Kind                 | Flags                          | Contents                                              |
//! |----------------------|--------------------------------|-------------------------------------------------------|
//! | anonymous            | `MAP_PRIVATE \| MAP_ANONYMOUS` | zeros                                                 |
//! | private file mapping | `MAP_PRIVATE`, an open `fd`    | the file from `offset`, zeros past its end; a write copies the page |
//! | shared file mapping  | `MAP_SHARED`, an open `fd`     | the file's page cache: writes reach the file          |
//!
//! A file mapping is lazy: each page comes from the page cache on first
//! access, and nothing is copied at `mmap` time. A private page sees later
//! writes to the file until the process writes it; the write copies the
//! page, and the copy never reaches the file. A shared page is the cache
//! page itself: a write through it is seen by `read`, and a `write` to the
//! file is seen through it. A shared mapping past the end of the file
//! reaches zeroed pages that `read` does not show; cutting the file zeroes
//! the cut bytes, and growing it zeroes the new bytes again. A writable
//! shared mapping of a running program's file is `-EBUSY` (Linux says
//! `ETXTBSY`), and the file of a writable shared mapping cannot be run. `MAP_SHARED | MAP_ANONYMOUS` is refused: without
//! `fork` it would equal a private mapping.
//!
//! ## Arguments
//!
//! | Argument | Rule                                                              | Error        |
//! |----------|-------------------------------------------------------------------|--------------|
//! | `addr`   | a hint, ignored; the kernel picks the address                     |              |
//! | `length` | not 0; rounded up to whole pages                                  | `-EINVAL`    |
//! | `prot`   | `PROT_READ` 1, `PROT_WRITE` 2, `PROT_EXEC` 4, or `PROT_NONE` 0; not write and execute together | `-EINVAL` |
//! | `flags`  | exactly one of `MAP_SHARED` 1 and `MAP_PRIVATE` 2; `MAP_ANONYMOUS` `0x20` optional, only with `MAP_PRIVATE`; `MAP_FIXED` `0x10` is not supported | `-EINVAL` |
//! | `fd`     | ignored with `MAP_ANONYMOUS`; otherwise open, a regular file, opened for reading, and for writing too with `MAP_SHARED` and `PROT_WRITE` | `-EBADF`, `-ENODEV`, `-EACCES` |
//! | `offset` | a multiple of the page size                                       | `-EINVAL`    |
//!
//! Running out of frames or of region table entries is `-ENOMEM`. A
//! `MAP_SHARED` with `PROT_WRITE` of a file that a running program's image
//! maps, or that is being loaded, is `-EBUSY`: Linux says `ETXTBSY` (26),
//! which IgniOS does not have, and `write` to such a file is `-EBUSY` too.
//!
//! `munmap(addr, length)` removes the pages of `[addr, addr + length)` that
//! belong to `mmap` regions. `addr` must be page aligned and `length` not 0
//! (`-EINVAL`); a range with no region in it is not an error, as on Linux.
//! Splitting a region in two when no table entry is free is `-ENOMEM`.

import Fs from "@fs";
import Proc from "@proc";
import _ from "../core";
import _ from "./errno";

/// The memory system call handlers.
namespace Syscall::Linux {
  /// `PROT_READ`.
  const PROT_READ: u64 = 1;

  /// `PROT_WRITE`.
  const PROT_WRITE: u64 = 2;

  /// `PROT_EXEC`.
  const PROT_EXEC: u64 = 4;

  /// `MAP_SHARED`.
  const MAP_SHARED: u64 = 0x01;

  /// `MAP_PRIVATE`.
  const MAP_PRIVATE: u64 = 0x02;

  /// `MAP_FIXED`.
  const MAP_FIXED: u64 = 0x10;

  /// `MAP_ANONYMOUS`.
  const MAP_ANONYMOUS: u64 = 0x20;

  /// 4 KiB.
  const MAP_PAGE_SIZE: u64 = 4096;

  /// `mmap(addr, length, prot, flags, fd, offset)`. Returns the address of
  /// the new region.
  function mmap(
    hint: u64,
    length: u64,
    protection: u64,
    flags: u64,
    descriptor: u64,
    offset: u64
  ): u64 {
    if (length == 0 || (protection & ~(PROT_READ | PROT_WRITE | PROT_EXEC)) != 0 || offset % MAP_PAGE_SIZE != 0) {
      return Linux::failure(Linux::EINVAL);
    }

    let shared: boolean = (flags & MAP_SHARED) != 0;
    let anonymous: boolean = (flags & MAP_ANONYMOUS) != 0;

    if (shared == ((flags & MAP_PRIVATE) != 0) || (flags & MAP_FIXED) != 0 || (shared && anonymous)) {
      return Linux::failure(Linux::EINVAL);
    }

    let mut address: u64 = 0;
    let status: u64 = Syscall::Core::map(anonymous, shared, descriptor, offset, length, translateProtection(protection), &mut address as *mut u64);

    return status == Fs::Vfs::OK ? address : Linux::failureFor(status);
  }

  /// `munmap(addr, length)`.
  function munmap(address: u64, length: u64): u64 {
    let status: u64 = Syscall::Core::unmap(address, length);

    return status == Fs::Vfs::OK ? 0 : Linux::failureFor(status);
  }

  /// The `Proc::Memory` protection of Linux `prot` bits.
  function translateProtection(protection: u64): u64 {
    let mut neutral: u64 = 0;

    if ((protection & PROT_READ) != 0) {
      neutral = neutral | Proc::Memory::READ;
    }

    if ((protection & PROT_WRITE) != 0) {
      neutral = neutral | Proc::Memory::WRITE;
    }

    if ((protection & PROT_EXEC) != 0) {
      neutral = neutral | Proc::Memory::EXECUTE;
    }

    return neutral;
  }
}
