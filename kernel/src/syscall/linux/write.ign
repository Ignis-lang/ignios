//!
//! # Linux write
//!
//! `write(fd, buf, count)`: the only way a user program prints.
//!
//! ## Overview
//!
//! Only the console, as descriptors 1 and 2, goes anywhere. Every pointer a
//! process passes is checked before the kernel touches it, and never
//! dereferenced directly: `Mm::AddressSpace::isAccessible`, `copyFromUser` and
//! `copyToUser` walk the process's page tables and refuse a range that leaves
//! the user half or crosses a page that is not mapped or not user accessible.
//! A refused range is `-EFAULT`.
//!
//! The whole range is checked before the first byte is printed, so a bad
//! pointer prints nothing. The bytes then pass through a small kernel buffer,
//! so a long request is copied and printed piece by piece.

import Drivers from "@drivers";
import Mm from "@mm";
import Proc from "@proc";
import _ from "./errno";

/// The staging buffer of `write`.
record WriteState {
  /// Staging buffer for `write`: user bytes are copied here, then printed. The
  /// size must equal `Syscall::Linux::COPY_BUFFER_SIZE`.
  static mut copyBuffer: u8[256];
}

/// The `write` handler.
namespace Syscall::Linux {
  /// File descriptor 1.
  const STDOUT: u64 = 1;

  /// File descriptor 2, which goes to the console too.
  const STDERR: u64 = 2;

  /// The most one `write` takes. A longer request is a short write, which
  /// the caller already has to handle.
  const MAX_WRITE: u64 = 65536;

  /// Bytes of `WriteState::copyBuffer`, the unit `write` copies and prints at a
  /// time. It must equal the array size there.
  const COPY_BUFFER_SIZE: u64 = 256;

  /// `write(fd, buf, count)`: only the console, as descriptors 1 and 2, goes
  /// anywhere. The whole range is checked before the first byte is printed,
  /// so a bad pointer is `-EFAULT` and prints nothing. The bytes then pass
  /// through a small kernel buffer, so a long request is copied and printed
  /// piece by piece.
  function write(descriptor: u64, buffer: u64, count: u64): u64 {
    if (descriptor != STDOUT && descriptor != STDERR) {
      return Linux::failure(Linux::EBADF);
    }

    let total: u64 = count < MAX_WRITE ? count : MAX_WRITE;
    let root: u64 = Proc::Process::currentRoot();
    let chunk: *mut u8 = &mut WriteState::copyBuffer as *mut u8;

    if (!Mm::AddressSpace::isAccessible(root, buffer, total, false)) {
      return Linux::failure(Linux::EFAULT);
    }

    let mut done: u64 = 0;

    while (done < total) {
      let piece: u64 = total - done < COPY_BUFFER_SIZE ? total - done : COPY_BUFFER_SIZE;

      if (!Mm::AddressSpace::copyFromUser(root, chunk, buffer + done, piece)) {
        return Linux::failure(Linux::EFAULT);
      }

      let mut index: u64 = 0;

      while (index < piece) {
        Drivers::Console::writeChar(*(chunk + index));
        index += 1;
      }

      done += piece;
    }

    return done;
  }
}
