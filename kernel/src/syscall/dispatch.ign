//!
//! # System Call Dispatch
//!
//! The entry point from ring 3 into the kernel, and the two-step lookup that
//! turns a call number into an operation.
//!
//! ## Flow
//!
//! `usermode_asm.S` builds an `Arch::InterruptFrame` for a `SYSCALL` and calls
//! `dispatch` with it. The result goes back in RAX, where a value from -4095
//! to -1 is a negated errno.
//!
//! ```text
//!   user:    mov eax, 1 ; mov edi, 1 ; lea rsi, [msg] ; mov edx, n ; syscall
//!                │
//!                ▼  (hardware: RCX = RIP, R11 = RFLAGS, IF cleared, CPL 0)
//!   kernel:  ignis_syscall_entry          switch to the kernel stack, build the frame
//!                │
//!                ▼
//!            sti; Syscall::dispatch(frame); cli
//!                ├─ lookup(abi, frame.rax)     number -> operation (Operation::WRITE ...)
//!                ├─ run the operation          arguments from rdi, rsi, rdx, r10, r8, r9
//!                └─ frame.rax := result        value or -errno
//!                │
//!                ▼
//!            ignis_syscall_entry          reload registers, sysretq
//! ```
//!
//! A system call runs with interrupts on and may be preempted anywhere, as
//! kernel threads are. What it shares with other threads is behind locks
//! (`Lib::Rank`): the process table and the VFS take mutexes, memory and the
//! scheduler take spinlocks, and its argument copies live in the thread's
//! own scratch area (`Syscall::Scratch`).
//!
//! Each process has an ABI, its personality. The ABI owns a table that turns a
//! system call number into an operation of the kernel, a small number that does
//! not depend on any convention (`Syscall::Operation`), and the kernel runs
//! that operation. Two ABIs exist. Linux x86_64 (`Syscall::Linux`): the call
//! number in RAX, the arguments in RDI, RSI, RDX, R10, R8 and R9, Linux's
//! numbers and Linux's errno values; a number the table does not know fails
//! with `-ENOSYS`. Native IgniOS (`Syscall::Native`), for a program with the
//! IgniOS ELF note: the same argument registers, its own numbers, the status
//! in RAX and the value in RDX; an unknown number is `NOT_SUPPORTED`.
//! ABI-independent work, such as moving bytes, is in `Syscall::Core`.
//!
//! The entry stub turns interrupts on around the handlers: another thread
//! may run in the middle of a call, on this processor or another, so what a
//! handler shares is behind the locks of `Lib::Rank`, and a handler that
//! waits (`nanosleep`) does it through the scheduler.
//!
//! See concept doc 15.

import Arch from "@arch";
import Drivers from "@drivers";
import Proc from "@proc";
import Sched from "@sched";
import _ from "./linux/errno";
import _ from "./linux/files";
import _ from "./linux/kill";
import _ from "./linux/memory";
import _ from "./linux/nanosleep";
import _ from "./linux/reboot";
import _ from "./linux/table";
import _ from "./native/calls";
import _ from "./native/status";
import _ from "./native/table";
import _ from "./operation";

/// The dispatcher.
namespace Syscall {
  /// Fills the tables of the Linux and the native ABI.
  function initialize(): void {
    Linux::initialize();
    Native::initialize();
  }

  /// Called by the entry stub with interrupts on, on the kernel stack of the
  /// calling thread.
  @externName("ignis_syscall_dispatch")
  function dispatch(frame: *mut Arch::InterruptFrame): void {
    let abi: u64 = Proc::Process::currentAbi();
    let operation: u8 = lookup(abi, (*frame).rax);

    if (abi == Proc::Process::ABI_NATIVE) {
      Native::run(operation, frame);
    } else {
      runLinux(operation, frame);
    }

    // About to return to ring 3: a process that was killed, also while it
    // waited in this call, ends here.
    Proc::Process::checkKill();
  }

  /// Runs `operation` with the Linux registers of `frame`.
  function runLinux(operation: u8, frame: *mut Arch::InterruptFrame): void {
    let first: u64 = (*frame).rdi;
    let second: u64 = (*frame).rsi;
    let third: u64 = (*frame).rdx;
    let fourth: u64 = (*frame).r10;
    let fifth: u64 = (*frame).r8;
    let sixth: u64 = (*frame).r9;

    if (operation == Operation::EXIT) {
      Proc::Process::exitCurrent(first & 0xFF);
    }

    if (operation == Operation::WRITE) {
      (*frame).rax = Linux::write(first, second, third);
    } else if (operation == Operation::READ) {
      (*frame).rax = Linux::read(first, second, third);
    } else if (operation == Operation::OPEN) {
      (*frame).rax = Linux::openAt(first, second, third, fourth);
    } else if (operation == Operation::CLOSE) {
      (*frame).rax = Linux::close(first);
    } else if (operation == Operation::SEEK) {
      (*frame).rax = Linux::seek(first, second, third);
    } else if (operation == Operation::STAT) {
      (*frame).rax = Linux::stat(first, second);
    } else if (operation == Operation::STAT_AT) {
      (*frame).rax = Linux::statAt(first, second, third, fourth);
    } else if (operation == Operation::READ_DIRECTORY) {
      (*frame).rax = Linux::readDirectory(first, second, third);
    } else if (operation == Operation::MAKE_DIRECTORY) {
      (*frame).rax = Linux::makeDirectoryAt(first, second, third);
    } else if (operation == Operation::MAP) {
      (*frame).rax = Linux::mmap(first, second, third, fourth, fifth, sixth);
    } else if (operation == Operation::UNMAP) {
      (*frame).rax = Linux::munmap(first, second);
    } else if (operation == Operation::POWER) {
      (*frame).rax = Linux::reboot(first, second, third);
    } else if (operation == Operation::UNLINK) {
      (*frame).rax = Linux::unlinkAt(first, second, third);
    } else if (operation == Operation::CHANGE_DIRECTORY) {
      (*frame).rax = Linux::changeDirectory(first);
    } else if (operation == Operation::CURRENT_DIRECTORY) {
      (*frame).rax = Linux::currentDirectory(first, second);
    } else if (operation == Operation::KILL) {
      (*frame).rax = Linux::kill(first, second);
    } else if (operation == Operation::GET_PID) {
      (*frame).rax = Proc::Process::currentId();
    } else if (operation == Operation::YIELD) {
      Sched::Scheduler::yield();
      (*frame).rax = 0;
    } else if (operation == Operation::SLEEP) {
      (*frame).rax = Linux::nanosleep(first, second);
    } else {
      (*frame).rax = Linux::failure(Linux::ENOSYS);
    }
  }

  /// The operation the ABI `abi` maps `number` to.
  function lookup(abi: u64, number: u64): u8 {
    if (number >= Operation::TABLE_SIZE) {
      return Operation::NONE;
    }

    return *(tableFor(abi) + number);
  }

  /// The number-to-operation table of an ABI.
  function tableFor(abi: u64): *mut u8 {
    return abi == Proc::Process::ABI_NATIVE ? Native::tableBase() : Linux::tableBase();
  }

  /// Called by the entry stub when the return address of a system call is
  /// not canonical and `SYSRET` would fault in ring 0.
  @externName("ignis_syscall_bad_return")
  function badReturn(rip: u64): never {
    Drivers::Console::write("process ");
    Drivers::Console::writeDecimal(Proc::Process::currentId());
    Drivers::Console::write(": non-canonical return address ");
    Drivers::Console::writeHex(rip);
    Drivers::Console::writeLine("");

    Proc::Process::killCurrent(139);
  }
}
