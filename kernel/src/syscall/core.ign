//!
//! # System Call Core
//!
//! The parts of a system call that do not depend on the ABI: moving bytes
//! between a descriptor and user memory, with every user pointer checked.
//!
//! ## Overview
//!
//! Each ABI (`Syscall::Linux`, `Syscall::Native`) reads its arguments from its
//! own registers and reports its own error numbers, but both move bytes the
//! same way. The functions here return a status code, `Fs::Vfs::OK` or one of
//! the `Fs` codes, or `BAD_ADDRESS` for a user pointer that failed
//! validation, and write the byte count through a pointer. Each ABI turns
//! the status into its own result (`Linux::errorFor`, `Native::statusFor`).
//!
//! | Rule                                   | Effect                                        |
//! |----------------------------------------|-----------------------------------------------|
//! | at most `MAX_TRANSFER` bytes per call  | a longer request is a short transfer           |
//! | the whole user range checked first     | a bad buffer moves nothing                     |
//! | an error after some bytes moved        | `OK` with the bytes moved so far              |
//!
//! `map` and `unmap` do the same for `Proc::Memory`: the descriptor checks of
//! a file mapping (readable; writable too for a writable shared one) and
//! the status of the region table, as kernel codes. A file mapping copies
//! nothing: its pages come from the page cache when touched.
//!
//! The staging buffer of `read` and `write` is the COPY part of the calling
//! thread's scratch area (`Syscall::Scratch`), so a call preempted or
//! blocked halfway keeps it while other threads run their own calls.

import Fs from "@fs";
import Mm from "@mm";
import Proc from "@proc";
import Sched from "@sched";

/// Where each kernel copy of a system call lives in the running thread's
/// scratch area (`Sched::Scheduler::scratch`). A thread runs one system call
/// at a time, so the Linux and native paths share one place.
///
/// ```text
///   offset  bytes  use
///        0   4096  PATH: a path copied from the user (Fs::Vfs::PATH_MAX)
///     4096    144  STAT: one Linux struct stat
///     4240    280  DIRENT: one Linux directory record
///     4520    512  COPY: the staging buffer of read and write
///     5032     32  SMALL: one native info record or entry header
///     5064         end, within Sched::Thread::SCRATCH_BYTES
/// ```
namespace Syscall::Scratch {
  const PATH: u64 = 0;
  const STAT: u64 = 4096;
  const DIRENT: u64 = 4240;
  const COPY: u64 = 4520;
  const SMALL: u64 = 5032;
  const END: u64 = 5064;

  /// The running thread's scratch bytes at `offset`.
  function at(offset: u64): *mut u8 {
    if (END > Sched::Thread::SCRATCH_BYTES) {
      @panic("syscall: the scratch layout does not fit the thread's area");
    }

    return Sched::Scheduler::scratch() + offset;
  }
}

/// The ABI-independent transfers.
namespace Syscall::Core {
  /// A user pointer failed validation. Next to the `Fs` codes, which stay
  /// below 100.
  const BAD_ADDRESS: u64 = 100;

  /// Mapping something that is not a regular file. Next to `BAD_ADDRESS`.
  const NO_DEVICE: u64 = 101;

  /// The descriptor lacks the access the call needs.
  const ACCESS: u64 = 102;

  /// The process is not a child of the caller, or the caller has none.
  const NO_CHILD: u64 = 103;

  /// The most one `read` or `write` moves.
  const MAX_TRANSFER: u64 = 65536;

  /// Bytes of the COPY part of the scratch area.
  const COPY_BUFFER_SIZE: u64 = 512;

  /// Reads up to `count` bytes from `descriptor` of the running process into
  /// the user buffer at `buffer` and writes the number read to `done`: 0 at
  /// the end of a file. Returns `Fs::Files::BAD_DESCRIPTOR`, `BAD_ADDRESS`
  /// for a buffer that is not writable user memory, or the `Fs::Files::read`
  /// codes.
  function read(descriptor: u64, buffer: u64, count: u64, done: *mut u64): u64 {
    let total: u64 = count < MAX_TRANSFER ? count : MAX_TRANSFER;
    let root: u64 = Proc::Process::currentRoot();
    let table: u64 = Proc::Process::currentSlot();
    let chunk: *mut u8 = Syscall::Scratch::at(Syscall::Scratch::COPY);

    *done = 0;

    if (Fs::Files::get(table, descriptor) == null) {
      return Fs::Files::BAD_DESCRIPTOR;
    }

    if (!Proc::User::isAccessible(root, buffer, total, true)) {
      return BAD_ADDRESS;
    }

    let mut moved: u64 = 0;

    while (moved < total) {
      let wanted: u64 = total - moved < COPY_BUFFER_SIZE ? total - moved : COPY_BUFFER_SIZE;
      let mut got: u64 = 0;
      let status: u64 = Fs::Files::read(table, descriptor, chunk, wanted, &mut got as *mut u64);

      if (status != Fs::Vfs::OK) {
        *done = moved;
        return moved > 0 ? Fs::Vfs::OK : status;
      }

      if (got > 0 && !Proc::User::copyToUser(root, buffer + moved, chunk as *u8, got)) {
        return BAD_ADDRESS;
      }

      moved += got;

      if (got < wanted) {
        break;
      }
    }

    *done = moved;

    return Fs::Vfs::OK;
  }

  /// Writes up to `count` bytes from the user buffer at `buffer` to
  /// `descriptor` of the running process and writes the number written to
  /// `done`. Returns `Fs::Files::BAD_DESCRIPTOR`, `BAD_ADDRESS` for a buffer
  /// that is not readable user memory, or the `Fs::Files::write` codes.
  function write(descriptor: u64, buffer: u64, count: u64, done: *mut u64): u64 {
    let total: u64 = count < MAX_TRANSFER ? count : MAX_TRANSFER;
    let root: u64 = Proc::Process::currentRoot();
    let table: u64 = Proc::Process::currentSlot();
    let chunk: *mut u8 = Syscall::Scratch::at(Syscall::Scratch::COPY);

    *done = 0;

    if (Fs::Files::get(table, descriptor) == null) {
      return Fs::Files::BAD_DESCRIPTOR;
    }

    if (!Proc::User::isAccessible(root, buffer, total, false)) {
      return BAD_ADDRESS;
    }

    let mut moved: u64 = 0;

    while (moved < total) {
      let piece: u64 = total - moved < COPY_BUFFER_SIZE ? total - moved : COPY_BUFFER_SIZE;
      let mut written: u64 = 0;

      if (!Proc::User::copyFromUser(root, chunk, buffer + moved, piece)) {
        return BAD_ADDRESS;
      }

      let status: u64 = Fs::Files::write(table, descriptor, chunk as *u8, piece, &mut written as *mut u64);

      if (status != Fs::Vfs::OK) {
        *done = moved;
        return moved > 0 ? Fs::Vfs::OK : status;
      }

      moved += written;
    }

    *done = moved;

    return Fs::Vfs::OK;
  }

  /// Maps `length` bytes with the `Proc::Memory` `protection` into the
  /// running process and writes the address to `address`. An `anonymous`
  /// mapping is zeroed; otherwise it maps the file open as `descriptor`
  /// from `offset` (a page multiple), privately or `shared`, lazily from
  /// the page cache: nothing is copied now. Returns `Fs::Vfs::INVALID` for
  /// a bad length, protection or offset or a shared anonymous mapping,
  /// `Fs::Files::BAD_DESCRIPTOR`, `NO_DEVICE` for something other than a
  /// regular file, `ACCESS` for a descriptor not open for reading, or a
  /// writable shared mapping of one not open for writing, `Fs::Vfs::BUSY`
  /// for a writable shared mapping of a running program's file or one being
  /// loaded (Linux `ETXTBSY`, reported as `EBUSY`), and
  /// `Fs::Vfs::NO_MEMORY` when frames or region entries run out.
  function map(
    anonymous: boolean,
    shared: boolean,
    descriptor: u64,
    offset: u64,
    length: u64,
    protection: u64,
    address: *mut u64
  ): u64 {
    // A file mapping looks up the node and counts the region on it: the
    // VFS lock is held until the region holds the node.
    if (!anonymous) {
      Fs::Vfs::lock();
    }

    let result: u64 = mapFrom(anonymous, shared, descriptor, offset, length, protection, address);

    if (!anonymous) {
      Fs::Vfs::unlock();
    }

    return result;
  }

  /// The body of `map`, with the VFS lock held for a file mapping.
  function mapFrom(
    anonymous: boolean,
    shared: boolean,
    descriptor: u64,
    offset: u64,
    length: u64,
    protection: u64,
    address: *mut u64
  ): u64 {
    if (length == 0 || offset % 4096 != 0 || (protection & ~(Proc::Memory::READ | Proc::Memory::WRITE | Proc::Memory::EXECUTE)) != 0 || (anonymous && shared)) {
      return Fs::Vfs::INVALID;
    }

    let slot: u64 = Proc::Process::currentSlot();
    let mut node: *mut Fs::Node = null;

    if (!anonymous) {
      Fs::Vfs::requireLock();

      let file: *mut Fs::OpenFile = Fs::Files::get(slot, descriptor);

      if (file == null) {
        return Fs::Files::BAD_DESCRIPTOR;
      }

      if ((*file).kind != Fs::Files::NODE || (*(*file).node).kind != Fs::Vfs::FILE) {
        return NO_DEVICE;
      }

      if (((*file).flags & Fs::Files::READ) == 0) {
        return ACCESS;
      }

      if (shared && (protection & Proc::Memory::WRITE) != 0 && ((*file).flags & Fs::Files::WRITE) == 0) {
        return ACCESS;
      }

      node = (*file).node;

      // Its stores would change the text of a running program, or of one
      // being loaded (Linux `ETXTBSY`).
      if (shared && (protection & Proc::Memory::WRITE) != 0 && ((*node).images > 0 || (*node).pins > 0)) {
        return Fs::Vfs::BUSY;
      }
    }

    let status: u64 = Proc::Memory::map(slot, Proc::Process::currentRoot(), length, protection, node, offset, shared, address);

    if (status == Proc::Memory::OK) {
      return Fs::Vfs::OK;
    }

    return status == Proc::Memory::INVALID ? Fs::Vfs::INVALID : Fs::Vfs::NO_MEMORY;
  }

  /// Removes `[address, address + length)` from the mappings of the running
  /// process. Returns `Fs::Vfs::INVALID` for an unaligned address, a length
  /// of 0 or a range outside the user half, and `Fs::Vfs::NO_MEMORY` when a
  /// split needs a region entry and none is free.
  function unmap(address: u64, length: u64): u64 {
    let status: u64 = Proc::Memory::unmap(Proc::Process::currentSlot(), Proc::Process::currentRoot(), address, length);

    if (status == Proc::Memory::OK) {
      return Fs::Vfs::OK;
    }

    return status == Proc::Memory::INVALID ? Fs::Vfs::INVALID : Fs::Vfs::NO_MEMORY;
  }
}
