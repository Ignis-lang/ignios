//!
//! # PS/2 Controller
//!
//! Driver for the 8042 PS/2 controller, keyboard port only.
//!
//! ## Overview
//!
//! The controller keeps its firmware translation setting, so the keyboard
//! arrives as scancode set 1 bytes, as it does under QEMU and OVMF. The
//! keyboard raises IRQ1 for each byte, and `handleInterrupt` moves the bytes
//! into the scancode queue. Bytes from the auxiliary (mouse) port are read and
//! dropped. This module only moves bytes; `keyboard.ign` turns them into
//! characters.
//!
//! ## Ports and Registers
//!
//! The controller has two I/O ports. The same port number means different
//! registers for reading and writing:
//!
//! | Port   | Read           | Write                  |
//! |--------|----------------|------------------------|
//! | `0x60` | data (output buffer) | data to the device, or the argument of a command |
//! | `0x64` | status         | command                |
//!
//! Status register bits used here:
//!
//! ```text
//!   bit 7   6   5     4   3   2   1    0
//!       .   .   AUX   .   .   .   IBF  OBF
//!
//!   OBF (bit 0)  output buffer full: a byte is waiting at port 0x60
//!   IBF (bit 1)  input buffer full: the controller has not read the last
//!                byte written; wait for it to clear before writing
//!   AUX (bit 5)  the waiting byte came from the second (mouse) port
//! ```
//!
//! The configuration byte (read with command `0x20`, written with command
//! `0x60` followed by the new value on port `0x60`):
//!
//! ```text
//!   bit 7   6          5   4                   3   2     1        0
//!       0   translate  .   clock1 disabled     .   post  irq12    irq1
//!                                                         enable   enable
//! ```
//!
//! `initialize` clears bits 1 (second port interrupt) and 4 (first port
//! clock disable) and sets bit 0 (first port interrupt). It leaves bit 6
//! alone, which is how the scancodes stay in set 1.
//!
//! ## Key Press Path
//!
//! ```text
//!   key -> keyboard -> 8042 -> IRQ1 -> IOAPIC pin 1 -> vector 0x21
//!       -> Trap::dispatch -> Drivers::Ps2::handleInterrupt -> Lib::ScancodeQueue::push
//! ```
//!
//! See concept doc 06 and the OSDev wiki pages "I8042 PS/2 Controller" and
//! "PS/2 Keyboard".

import Arch from "@arch";
import Lib from "@lib";

/// The PS/2 controller API.
namespace Drivers::Ps2 {
  /// Data port. Reading it takes the byte out of the output buffer.
  const DATA: u16 = 0x60;

  /// Status register (read side of port `0x64`).
  const STATUS: u16 = 0x64;

  /// Command register (write side of port `0x64`).
  const COMMAND: u16 = 0x64;

  /// Status bit 0: a byte is waiting to be read from `DATA`.
  const OUTPUT_FULL: u8 = 0x01;

  /// Status bit 1: the controller still holds the last byte written; do not
  /// write another one yet.
  const INPUT_FULL: u8 = 0x02;

  /// Status bit 5: the waiting byte came from the auxiliary (mouse) port.
  const AUXILIARY_DATA: u8 = 0x20;

  /// What a status read returns when no controller decodes the port.
  const NO_CONTROLLER: u8 = 0xFF;

  /// Command `0x20`: put the configuration byte in the output buffer.
  const READ_CONFIGURATION: u8 = 0x20;

  /// Command `0x60`: the next byte written to `DATA` is the new configuration.
  const WRITE_CONFIGURATION: u8 = 0x60;

  /// Command `0xAE`: enable the first (keyboard) port.
  const ENABLE_FIRST_PORT: u8 = 0xAE;

  /// Configuration bit 0: raise IRQ1 when the keyboard has a byte.
  const CONFIGURATION_FIRST_INTERRUPT: u8 = 0x01;

  /// Configuration bit 1: raise IRQ12 when the mouse has a byte. Cleared.
  const CONFIGURATION_SECOND_INTERRUPT: u8 = 0x02;

  /// Configuration bit 4: the first port clock is stopped. Cleared.
  const CONFIGURATION_FIRST_CLOCK_DISABLED: u8 = 0x10;

  /// Upper bound on bytes drained by `flush`, so a controller that always
  /// reports a full output buffer cannot stall the boot.
  const FLUSH_LIMIT: u64 = 256;

  /// Spin iterations before a controller handshake is considered dead.
  const WAIT_LIMIT: u64 = 1000000;

  /// Drains stale bytes, turns on the keyboard interrupt, turns off the
  /// auxiliary one and makes sure the keyboard port is clocked and enabled.
  /// Returns false when there is no controller or it stops answering.
  function initialize(): boolean {
    if (Arch::Port::readByte(STATUS) == NO_CONTROLLER) {
      return false;
    }

    flush();

    if (!sendCommand(READ_CONFIGURATION) || !waitForOutput()) {
      return false;
    }

    let configuration: u8 = Arch::Port::readByte(DATA);
    let cleared: u8 = CONFIGURATION_SECOND_INTERRUPT | CONFIGURATION_FIRST_CLOCK_DISABLED;
    let updated: u8 = (configuration & ~cleared) | CONFIGURATION_FIRST_INTERRUPT;

    if (!sendCommand(WRITE_CONFIGURATION) || !writeData(updated)) {
      return false;
    }

    if (!sendCommand(ENABLE_FIRST_PORT)) {
      return false;
    }

    flush();

    return true;
  }

  /// The IRQ1 handler: moves every byte the controller holds into the
  /// scancode queue, dropping auxiliary ones.
  function handleInterrupt(): void {
    while (true) {
      let status: u8 = Arch::Port::readByte(STATUS);

      if ((status & OUTPUT_FULL) == 0) {
        return;
      }

      let value: u8 = Arch::Port::readByte(DATA);

      if ((status & AUXILIARY_DATA) == 0) {
        Lib::ScancodeQueue::push(value);
      }
    }
  }

  /// Discards bytes waiting in the output buffer, at most `FLUSH_LIMIT`.
  function flush(): void {
    let mut drained: u64 = 0;

    while (drained < FLUSH_LIMIT && (Arch::Port::readByte(STATUS) & OUTPUT_FULL) != 0) {
      Arch::Port::readByte(DATA);
      drained += 1;
    }
  }

  /// Writes a controller command once the input buffer is free. Returns false
  /// when it stays busy for `WAIT_LIMIT` polls.
  function sendCommand(command: u8): boolean {
    if (!waitForInputSpace()) {
      return false;
    }

    Arch::Port::writeByte(COMMAND, command);

    return true;
  }

  /// Writes a data byte (a command argument) once the input buffer is free.
  /// Returns false on timeout.
  function writeData(value: u8): boolean {
    if (!waitForInputSpace()) {
      return false;
    }

    Arch::Port::writeByte(DATA, value);

    return true;
  }

  /// Polls until the input buffer is empty. Returns false after `WAIT_LIMIT`
  /// polls.
  function waitForInputSpace(): boolean {
    let mut spins: u64 = 0;

    while ((Arch::Port::readByte(STATUS) & INPUT_FULL) != 0) {
      if (spins == WAIT_LIMIT) {
        return false;
      }

      Arch::Cpu::pause();
      spins += 1;
    }

    return true;
  }

  /// Polls until a byte is waiting in the output buffer. Returns false after
  /// `WAIT_LIMIT` polls.
  function waitForOutput(): boolean {
    let mut spins: u64 = 0;

    while ((Arch::Port::readByte(STATUS) & OUTPUT_FULL) == 0) {
      if (spins == WAIT_LIMIT) {
        return false;
      }

      Arch::Cpu::pause();
      spins += 1;
    }

    return true;
  }
}
