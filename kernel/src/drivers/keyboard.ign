//!
//! # Keyboard Decoder
//!
//! A scancode set 1 decoder with a US keyboard layout.
//!
//! ## Overview
//!
//! `decode` takes the raw bytes the keyboard sends, in order, from whatever
//! source reads them, and tracks the modifier keys between calls. It yields
//! ASCII: printable characters, `\n` for Enter, `\t` for Tab and 0x08 for
//! Backspace. Every other key, every key release and every extended (0xE0)
//! key yields `NONE`. Releases and the extended Control key only update the
//! modifier state.
//!
//! ## Scancode Set 1
//!
//! Pressing a key sends its make code. Releasing it sends the same code with
//! bit 7 set (`code | 0x80`). A few keys send a prefix first:
//!
//! | Bytes                  | Meaning                                        |
//! |------------------------|------------------------------------------------|
//! | `0xE0 xx`              | extended key (right Ctrl is `E0 1D`, arrows, ...) |
//! | `E1 1D 45 E1 9D C5`    | Pause: six bytes, no release code              |
//!
//! Make codes of the keys `translate` knows:
//!
//! ```text
//!   02-0B   1 2 3 4 5 6 7 8 9 0     0C  -     0D  =     0E  Backspace
//!   0F      Tab
//!   10-19   q w e r t y u i o p     1A  [     1B  ]     1C  Enter
//!   1D      Left Ctrl
//!   1E-26   a s d f g h j k l       27  ;     28  '     29  `
//!   2A      Left Shift              2B  \
//!   2C-32   z x c v b n m           33  ,     34  .     35  /
//!   36      Right Shift
//!   39      Space                   3A  Caps Lock
//! ```
//!
//! ## State Machine
//!
//! ```text
//!   byte arrives
//!     │
//!     ├─ inside a Pause sequence? ── yes ─► skip it (5 bytes after E1)
//!     ├─ E1? ───────────────────────────► start skipping 5 bytes
//!     ├─ E0? ───────────────────────────► remember "extended" for next byte
//!     ├─ extended key? ─────────────────► only right Ctrl changes state
//!     ├─ modifier (Shift, Ctrl, Caps)? ─► update flags, no character
//!     ├─ release? ──────────────────────► NONE
//!     └─ otherwise ─────────────────────► translate(key) with Shift / Caps Lock
//! ```
//!
//! See concept doc 06.

import _ from "./ps2";

/// Decoder state kept between bytes. Every field is written only by `decode`.
record KeyboardState {
  /// True after an `0xE0` prefix, until the next byte arrives.
  static mut extended: boolean = false;

  /// Bytes of the Pause sequence still to skip.
  static mut pauseBytesLeft: u8 = 0;

  /// True while the left Shift key is down.
  static mut leftShift: boolean = false;

  /// True while the right Shift key is down.
  static mut rightShift: boolean = false;

  /// True while the left Ctrl key is down.
  static mut leftControl: boolean = false;

  /// True while the right Ctrl key (`E0 1D`) is down.
  static mut rightControl: boolean = false;

  /// The Caps Lock toggle, flipped on each key press.
  static mut capsLock: boolean = false;

  /// True while the Caps Lock key is down, so the auto-repeat of a held key does
  /// not toggle the lock again.
  static mut capsLockHeld: boolean = false;
}

/// The decoder API: `decode` is the only function the terminal needs.
namespace Drivers::Keyboard {
  /// What `decode` returns for a byte that produces no character.
  const NONE: u8 = 0;

  /// The character code `decode` returns for the Backspace key.
  const BACKSPACE: u8 = 0x08;

  /// First byte of an extended key: `0xE0`.
  const EXTENDED_PREFIX: u8 = 0xE0;

  /// First byte of the Pause sequence: `0xE1`.
  const PAUSE_PREFIX: u8 = 0xE1;

  /// Bit 7 of a scancode byte: set on key release.
  const RELEASE: u8 = 0x80;

  /// The bytes that follow 0xE1 in the Pause sequence (E1 1D 45 E1 9D C5).
  /// They are skipped so the 0x1D in them is not read as Ctrl.
  const PAUSE_TRAILING_BYTES: u8 = 5;

  /// Make code of the Control key (`0x1D`), also the second byte of right
  /// Control (`E0 1D`).
  const KEY_CONTROL: u8 = 0x1D;

  /// Make code of left Shift.
  const KEY_LEFT_SHIFT: u8 = 0x2A;

  /// Make code of right Shift.
  const KEY_RIGHT_SHIFT: u8 = 0x36;

  /// Make code of Caps Lock.
  const KEY_CAPS_LOCK: u8 = 0x3A;

  /// Feeds one scancode byte and returns the character it completes, or
  /// NONE.
  function decode(scancode: u8): u8 {
    if (KeyboardState::pauseBytesLeft > 0) {
      KeyboardState::pauseBytesLeft -= 1;
      return NONE;
    }

    if (scancode == PAUSE_PREFIX) {
      KeyboardState::pauseBytesLeft = PAUSE_TRAILING_BYTES;
      return NONE;
    }

    if (scancode == EXTENDED_PREFIX) {
      KeyboardState::extended = true;
      return NONE;
    }

    let released: boolean = (scancode & RELEASE) != 0;
    let key: u8 = scancode & ~RELEASE;

    if (KeyboardState::extended) {
      KeyboardState::extended = false;

      if (key == KEY_CONTROL) {
        KeyboardState::rightControl = !released;
      }

      return NONE;
    }

    if (key == KEY_LEFT_SHIFT) {
      KeyboardState::leftShift = !released;
      return NONE;
    }

    if (key == KEY_RIGHT_SHIFT) {
      KeyboardState::rightShift = !released;
      return NONE;
    }

    if (key == KEY_CONTROL) {
      KeyboardState::leftControl = !released;
      return NONE;
    }

    if (key == KEY_CAPS_LOCK) {
      if (!released && !KeyboardState::capsLockHeld) {
        KeyboardState::capsLock = !KeyboardState::capsLock;
      }

      KeyboardState::capsLockHeld = !released;
      return NONE;
    }

    if (released) {
      return NONE;
    }

    return translate(key);
  }

  /// True while either Shift key is down.
  function isShiftHeld(): boolean {
    return KeyboardState::leftShift || KeyboardState::rightShift;
  }

  /// Tracked for later key bindings; it does not change what `decode`
  /// returns yet.
  function isControlHeld(): boolean {
    return KeyboardState::leftControl || KeyboardState::rightControl;
  }

  /// True while Caps Lock is toggled on.
  function isCapsLockOn(): boolean {
    return KeyboardState::capsLock;
  }

  /// Applies Shift and Caps Lock to the pressed `key`. Caps Lock only
  /// changes letters, and Shift reverses it for them.
  function translate(key: u8): u8 {
    let letter: u8 = unshifted(key);
    let isLetter: boolean = letter >= ('a' as u8) && letter <= ('z' as u8);

    if (isLetter && KeyboardState::capsLock != isShiftHeld()) {
      return letter - 0x20;
    }

    if (!isLetter && isShiftHeld()) {
      return shifted(key);
    }

    return letter;
  }

  /// The US layout character of a set 1 make code without modifiers.
  function unshifted(key: u8): u8 {
    return match (key) {
      0x02 -> '1' as u8,
      0x03 -> '2' as u8,
      0x04 -> '3' as u8,
      0x05 -> '4' as u8,
      0x06 -> '5' as u8,
      0x07 -> '6' as u8,
      0x08 -> '7' as u8,
      0x09 -> '8' as u8,
      0x0A -> '9' as u8,
      0x0B -> '0' as u8,
      0x0C -> '-' as u8,
      0x0D -> '=' as u8,
      0x0E -> BACKSPACE,
      0x0F -> '\t' as u8,
      0x10 -> 'q' as u8,
      0x11 -> 'w' as u8,
      0x12 -> 'e' as u8,
      0x13 -> 'r' as u8,
      0x14 -> 't' as u8,
      0x15 -> 'y' as u8,
      0x16 -> 'u' as u8,
      0x17 -> 'i' as u8,
      0x18 -> 'o' as u8,
      0x19 -> 'p' as u8,
      0x1A -> '[' as u8,
      0x1B -> ']' as u8,
      0x1C -> '\n' as u8,
      0x1E -> 'a' as u8,
      0x1F -> 's' as u8,
      0x20 -> 'd' as u8,
      0x21 -> 'f' as u8,
      0x22 -> 'g' as u8,
      0x23 -> 'h' as u8,
      0x24 -> 'j' as u8,
      0x25 -> 'k' as u8,
      0x26 -> 'l' as u8,
      0x27 -> ';' as u8,
      0x28 -> '\'' as u8,
      0x29 -> '`' as u8,
      0x2B -> '\\' as u8,
      0x2C -> 'z' as u8,
      0x2D -> 'x' as u8,
      0x2E -> 'c' as u8,
      0x2F -> 'v' as u8,
      0x30 -> 'b' as u8,
      0x31 -> 'n' as u8,
      0x32 -> 'm' as u8,
      0x33 -> ',' as u8,
      0x34 -> '.' as u8,
      0x35 -> '/' as u8,
      0x39 -> ' ' as u8,
      _ -> NONE,
    };
  }

  /// The US layout character of a set 1 make code with Shift held, for the
  /// keys that are not letters.
  function shifted(key: u8): u8 {
    return match (key) {
      0x02 -> '!' as u8,
      0x03 -> '@' as u8,
      0x04 -> '#' as u8,
      0x05 -> '$' as u8,
      0x06 -> '%' as u8,
      0x07 -> '^' as u8,
      0x08 -> '&' as u8,
      0x09 -> '*' as u8,
      0x0A -> '(' as u8,
      0x0B -> ')' as u8,
      0x0C -> '_' as u8,
      0x0D -> '+' as u8,
      0x1A -> '{' as u8,
      0x1B -> '}' as u8,
      0x27 -> ':' as u8,
      0x28 -> '"' as u8,
      0x29 -> '~' as u8,
      0x2B -> '|' as u8,
      0x33 -> '<' as u8,
      0x34 -> '>' as u8,
      0x35 -> '?' as u8,
      _ -> unshifted(key),
    };
  }

  /// Brings up the PS/2 controller and reports the result on the console.
  /// Returns false when no controller answered, in which case the kernel halts:
  /// without a keyboard the terminal is useless.
  function initialize(): boolean {
    if (!Ps2::initialize()) {
      Drivers::Console::writeLine("keyboard: no PS/2 controller answered");
      return false;
    }

    Drivers::Console::writeLine("keyboard: PS/2, scancode set 1, US layout, IRQ1 through the IOAPIC");
    return true;
  }
}
