//!
//! # The File Tree
//!
//! One tree of directories and regular files in kernel memory: the VFS.
//!
//! ## Overview
//!
//! Every file and directory is a `Fs::Node` on the kernel heap. A directory
//! keeps its children in a singly linked list in the order they were added,
//! which is the order `child` (and so `getdents64`) returns them.
//!
//! ```text
//!   root "/" ──firstChild──► "bin" ──nextSibling──► "etc"
//!                              │                      │
//!                         firstChild             firstChild
//!                              ▼                      ▼
//!                           "hello"                 "motd"
//!                         data ─► archive         data ─► archive
//! ```
//!
//! `initialize` builds the tree from the initramfs and adds `/dev/console`, a
//! `DEVICE` node that `Fs::Files` opens as the console. A seeded file does not
//! copy its data: `data` points into the archive, which Limine loaded and
//! the kernel mapped read only. The first write to such a file copies the
//! data to the heap and the file owns it from then on (copy on write), so
//! the archive is never modified. Nothing here is saved anywhere: files and
//! directories created at run time are gone after a reboot.
//!
//! ## Page cache
//!
//! A file can have a page cache: `cache` is a heap table with one physical
//! frame per page of the file, 0 for a page not cached. `pageFrame` fills a
//! page on demand, copying the file bytes of that page from `data` and
//! zeroing the rest of the frame; a page past the end of the file is all
//! zeros (a shared mapping may reach it). The memory mappings take their
//! pages from it, so every mapping of a file sees the same frame.
//!
//! ```text
//!   node.cache ─► [ frame | 0 | frame | ... ]   one entry per page
//!                    │      │     │
//!                    ▼      ▼     ▼
//!               the bytes  the bytes of this page stay in `data`
//! ```
//!
//! A cached page is the only authority for its bytes; an uncached page's
//! bytes stay in `data`. `read` takes each page from its frame or from
//! `data` and never fills the cache. `write` and the zeros of an extension
//! (`write` past the end, `truncate` up) go through the same page by page
//! path, so a cached frame changes in place and a mapping sees the new
//! bytes; an extension zeroes `[old size, new size)` explicitly, since a
//! shared writer may have dirtied the tail of the last page. `truncate`
//! down keeps the frames. The cache holds one reference to each frame
//! (a mapping takes its own with `Mm::Pmm::reference`) and gives them back
//! only when the node is freed; nothing is evicted. The VFS lock guards it.
//!
//! Two counters keep a mapped file whole: `mappings` (the memory regions
//! that name the node) refuses removal, and `images` (the regions of a
//! running program) refuses `write` and `truncate`, as Linux's `ETXTBSY`.
//!
//! ## Paths
//!
//! `lookup` walks a path one component at a time:
//!
//! | Path part      | Meaning                                                |
//! |----------------|--------------------------------------------------------|
//! | leading `/`    | start at the root instead of the given directory       |
//! | empty, `//`    | ignored                                                |
//! | `.`            | the same directory                                     |
//! | `..`           | the parent; the parent of the root is the root         |
//! | trailing `/`   | the result must be a directory, otherwise `NOT_DIRECTORY` |
//!
//! A component longer than `NAME_MAX` bytes or a path longer than
//! `PATH_MAX` bytes is `NAME_TOO_LONG`. Every intermediate component must be
//! a directory (`NOT_DIRECTORY` otherwise) and must exist (`NOT_FOUND`).
//!
//! ## Status codes
//!
//! The functions return `Fs::Vfs::OK` or one of the codes below. They are the
//! VFS's own codes; each system call ABI turns them into its error numbers
//! (`Syscall::Linux` turns `NOT_FOUND` into `-ENOENT`, and so on).
//!
//! | Code            | Meaning                                    | Linux     |
//! |-----------------|--------------------------------------------|-----------|
//! | `NOT_FOUND`     | a component does not exist                 | `ENOENT`  |
//! | `NOT_DIRECTORY` | a component that must be a directory is not| `ENOTDIR` |
//! | `IS_DIRECTORY`  | a file operation on a directory            | `EISDIR`  |
//! | `EXISTS`        | creating a name that is already taken      | `EEXIST`  |
//! | `NAME_TOO_LONG` | a component or the path is too long        | `ENAMETOOLONG` |
//! | `NO_MEMORY`     | the heap is exhausted                      | `ENOMEM`  |
//! | `NOT_EMPTY`     | removing a directory that has children     | `ENOTEMPTY` |
//! | `INVALID`       | a malformed request (an empty name, `..`)  | `EINVAL`  |
//! | `TOO_LARGE`     | a file would grow past `MAX_FILE_SIZE` (64 MiB) | `EFBIG` |
//! | `BUSY`          | removing a node that is open, pinned or mapped; writing or truncating a pinned file or a program image | `EBUSY`   |
//!
//! One mutex, the VFS lock (`lock`, rank `Lib::MutexRank::VFS`), guards the
//! whole tree, the node data, every descriptor table and every current
//! directory. `Fs::Files` takes it inside each operation; a caller that uses
//! `Fs::Vfs` directly holds it across its whole sequence. Every function
//! that reads or changes the tree checks that the caller holds it
//! (`requireLock`), once the scheduler runs. A program being loaded pins its
//! file (`pin`), which then refuses removal, writes and truncation. The
//! page cache and the `mappings` and `images` counters are guarded by it too.

import Boot from "@boot";
import Drivers from "@drivers";
import Lib from "@lib";
import Mm from "@mm";
import Sched from "@sched";
import _ from "./initramfs";
import _ from "./tar";
import _ from "./tty";

namespace Fs {
  /// A file or a directory of the tree.
  @cLayout
  record Node {
    /// `Fs::Vfs::FILE`, `Fs::Vfs::DIRECTORY` or `Fs::Vfs::DEVICE`.
    public kind: u64;

    /// A number unique to this node, reported as the inode number.
    public id: u64;

    /// The permission bits, reported, not enforced.
    public mode: u64;

    /// The name, a heap copy without a NUL. Empty for the root.
    public name: *mut u8;

    /// The name length in bytes.
    public nameLength: u64;

    /// The directory that holds this node. The root is its own parent.
    public parent: *mut Node;

    /// The first child of a directory, null when it is empty.
    public firstChild: *mut Node;

    /// The next child of the same parent, null for the last one.
    public nextSibling: *mut Node;

    /// The number of children of a directory.
    public childCount: u64;

    /// The contents of a file: in the archive or on the heap. The bytes of
    /// a page in the page cache are in its frame, not here.
    public data: *mut u8;

    /// The file length in bytes.
    public size: u64;

    /// The bytes the heap block at `data` can hold. 0 while `data` points
    /// into the archive, which marks the data as not owned.
    public capacity: u64;

    /// Holders that read the node with the VFS lock let go, such as a
    /// program being loaded. While above 0 the node cannot be removed
    /// (`Fs::Files::isOpen`).
    public pins: u64;

    /// The page cache of a file: a heap array of `cachePages` physical frame
    /// addresses, one per page of the file, 0 for a page not cached. Null
    /// while nothing is cached. A cached page is the only authority for its
    /// bytes; `data` keeps the bytes of the pages that are not cached.
    public cache: *mut u64;

    /// The entries of `cache`.
    public cachePages: u64;

    /// The memory regions that name the node. While above 0 the node cannot
    /// be removed (`BUSY`).
    public mappings: u64;

    /// The program image regions that name the node. While above 0 the file
    /// cannot be written or truncated (`BUSY`, Linux `ETXTBSY`).
    public images: u64;
  }
}

/// The root of the tree and the node counter.
record VfsState {
  /// The root directory, null before `initialize`.
  static mut root: *mut Fs::Node = null;

  /// The id the next node gets.
  static mut nextId: u64 = 1;

  /// Path buffer of `seed`.
  static mut path: u8[256];

  /// The VFS lock, rank `Lib::MutexRank::VFS`: guards the whole tree, the
  /// node data, every descriptor table and every current directory.
  static mut lock: Sched::Mutex;
}

/// The file tree API.
namespace Fs::Vfs {
  /// A regular file.
  const FILE: u64 = 1;

  /// A directory.
  const DIRECTORY: u64 = 2;

  /// A device. Its node only names it; `Fs::Files` opens it as the device
  /// it is. The only one is `/dev/console`.
  const DEVICE: u64 = 3;

  /// Mode of `/dev/console`: rw--w----, as on Linux.
  const CONSOLE_MODE: u64 = 0x190;

  /// The operation succeeded.
  const OK: u64 = 0;

  /// See the module header for the codes.
  const NOT_FOUND: u64 = 1;

  /// A component that must be a directory is not one.
  const NOT_DIRECTORY: u64 = 2;

  /// A file operation was asked of a directory.
  const IS_DIRECTORY: u64 = 3;

  /// The name is already taken.
  const EXISTS: u64 = 4;

  /// A component is longer than `NAME_MAX` or the path longer than `PATH_MAX`.
  const NAME_TOO_LONG: u64 = 5;

  /// The heap is exhausted.
  const NO_MEMORY: u64 = 6;

  /// The directory to remove has children.
  const NOT_EMPTY: u64 = 7;

  /// A malformed request.
  const INVALID: u64 = 8;

  /// The file would grow past `MAX_FILE_SIZE`.
  const TOO_LARGE: u64 = 9;

  /// The node is in use: open by a descriptor, the root, mapped, or pinned
  /// while a program is loaded from it (then writes are refused too). A
  /// file that a running program's image maps refuses writes and
  /// truncation.
  const BUSY: u64 = 10;

  /// The largest file: 64 MiB. Files live on the kernel heap, which holds at
  /// most 256 MiB, and a write or a `truncate` past this is `TOO_LARGE`
  /// before anything is allocated.
  const MAX_FILE_SIZE: u64 = 0x4000000;

  /// The longest name of one component, as on Linux.
  const NAME_MAX: u64 = 255;

  /// The longest path, its terminating NUL included, as on Linux.
  const PATH_MAX: u64 = 4096;

  /// Default mode of a directory created at run time: rwxr-xr-x.
  const DIRECTORY_MODE: u64 = 0x1ED;

  /// Default mode of a file created at run time: rw-r--r--.
  const FILE_MODE: u64 = 0x1A4;

  /// The smallest heap block a file's data gets, so small appends do not
  /// copy the file each time.
  const MIN_CAPACITY: u64 = 64;

  /// The bytes of one page of the page cache: one frame.
  const PAGE_SIZE: u64 = 4096;

  /// ASCII `/`.
  const SLASH: u8 = 0x2F;

  /// ASCII `.`.
  const DOT: u8 = 0x2E;

  /// Creates the root and adds every member of the initramfs. Panics when the
  /// heap runs out or the archive names a path twice with different kinds:
  /// the kernel cannot run without its files.
  function initialize(): void {
    Sched::Mutex::initialize(vfsLock(), Lib::MutexRank::VFS);
    Fs::Tty::initialize();

    let root: *mut Fs::Node = newNode(DIRECTORY, "" as *u8, 0, DIRECTORY_MODE);

    if (root == null) {
      @panic("vfs: no memory for the root");
    }

    (*root).parent = root;
    VfsState::root = root;

    seed();
    addConsole();
  }

  /// Takes the VFS lock. The functions of `Fs::Vfs` that read or change the
  /// tree expect it held; `Fs::Files` takes it itself. Only the boot-time
  /// setup and self-tests, which run before any other thread, call
  /// `Fs::Vfs` without it.
  function lock(): void {
    Sched::Mutex::lock(vfsLock());
  }

  /// Releases the VFS lock.
  function unlock(): void {
    Sched::Mutex::unlock(vfsLock());
  }

  /// Panics when the running thread does not hold the VFS lock, once the
  /// scheduler runs: a missing lock then fails the first call that lacks it,
  /// on every boot, instead of a race that shows once in a while. The
  /// boot-time setup and its self-test run before the scheduler, alone.
  function requireLock(): void {
    if (Sched::Scheduler::isStarted() && !Sched::Mutex::isHeldByCaller(vfsLock())) {
      @panic("vfs: the tree was used without the VFS lock");
    }
  }

  /// Keeps `node` from being removed while its holder reads it without the
  /// VFS lock. The lock is held.
  function pin(node: *mut Fs::Node): void {
    (*node).pins += 1;
  }

  /// Ends a `pin`. The lock is held.
  function unpin(node: *mut Fs::Node): void {
    if ((*node).pins == 0) {
      @panic("vfs: unpin of a node that is not pinned");
    }

    (*node).pins -= 1;
  }

  /// Counts one more memory region that names `node`. The lock is held.
  function addMapping(node: *mut Fs::Node): void {
    requireLock();
    (*node).mappings += 1;
  }

  /// Ends an `addMapping`. The lock is held.
  function removeMapping(node: *mut Fs::Node): void {
    requireLock();

    if ((*node).mappings == 0) {
      @panic("vfs: removeMapping of a node that is not mapped");
    }

    (*node).mappings -= 1;
  }

  /// Counts one more program image region that names `node`. The lock is
  /// held.
  function addImage(node: *mut Fs::Node): void {
    requireLock();
    (*node).images += 1;
  }

  /// Ends an `addImage`. The lock is held.
  function removeImage(node: *mut Fs::Node): void {
    requireLock();

    if ((*node).images == 0) {
      @panic("vfs: removeImage of a node that is not an image");
    }

    (*node).images -= 1;
  }

  /// The cache frame of page `page` of file `node`, or 0 when that page is
  /// not cached. The lock is held.
  function cachedFrame(node: *mut Fs::Node, page: u64): u64 {
    requireLock();

    if (page >= (*node).cachePages) {
      return 0;
    }

    return *((*node).cache + page);
  }

  /// The cache frame of page `page` of file `node`, filled on demand: a new
  /// frame gets the file bytes `[page * PAGE_SIZE, size)` of that page and
  /// zeros after them, so a page past the end of the file is all zeros.
  /// Returns `Mm::Pmm::NO_FRAME` when no frame or no heap is left; nothing
  /// changes then. The cache keeps its own reference; a caller that maps
  /// the frame takes another with `Mm::Pmm::reference`. The lock is held.
  function pageFrame(node: *mut Fs::Node, page: u64): u64 {
    requireLock();

    let cached: u64 = cachedFrame(node, page);

    if (cached != 0) {
      return cached;
    }

    if ((*node).kind != FILE || page >= MAX_FILE_SIZE / PAGE_SIZE || !growCache(node, page + 1)) {
      return Mm::Pmm::NO_FRAME;
    }

    let frame: u64 = Mm::Pmm::allocateFrame();

    if (frame == Mm::Pmm::NO_FRAME) {
      return Mm::Pmm::NO_FRAME;
    }

    let bytes: *mut u8 = Boot::Hhdm::toVirtual(frame);
    let start: u64 = page * PAGE_SIZE;
    let mut length: u64 = 0;

    if (start < (*node).size) {
      length = (*node).size - start;

      if (length > PAGE_SIZE) {
        length = PAGE_SIZE;
      }

      Lib::Mem::copy(bytes, ((*node).data + start) as *u8, length);
    }

    Lib::Mem::fill(bytes + length, 0, PAGE_SIZE - length);
    *((*node).cache + page) = frame;

    return frame;
  }

  /// Writes the `count` bytes at `source`, or zeros when `source` is null,
  /// to file `node` at `offset`, page by page: into the cache frame of a
  /// cached page, into `data` otherwise. The caller made `data` an owned
  /// heap block that holds `offset + count` bytes (`reserve`).
  function store(node: *mut Fs::Node, offset: u64, source: *u8, count: u64): void {
    let mut done: u64 = 0;

    while (done < count) {
      let position: u64 = offset + done;
      let chunk: u64 = pageChunk(position, count - done);
      let frame: u64 = cachedFrame(node, position / PAGE_SIZE);
      let mut target: *mut u8 = (*node).data + position;

      if (frame != 0) {
        target = Boot::Hhdm::toVirtual(frame) + position % PAGE_SIZE;
      }

      if (source == null) {
        Lib::Mem::fill(target, 0, chunk);
      } else {
        Lib::Mem::copy(target, source + done, chunk);
      }

      done += chunk;
    }
  }

  /// The bytes from `position` to the end of its page, at most `left`.
  function pageChunk(position: u64, left: u64): u64 {
    let chunk: u64 = PAGE_SIZE - position % PAGE_SIZE;

    return chunk < left ? chunk : left;
  }

  /// Makes the cache table of `node` hold at least `pages` entries, the new
  /// ones 0. Returns false when the heap is exhausted; the table is
  /// unchanged then.
  function growCache(node: *mut Fs::Node, pages: u64): boolean {
    if ((*node).cachePages >= pages) {
      return true;
    }

    let table: *mut u64 = Mm::Heap::allocate(pages * 8, 16) as *mut u64;

    if (table == null) {
      return false;
    }

    let mut index: u64 = 0;

    while (index < pages) {
      *(table + index) = index < (*node).cachePages ? *((*node).cache + index) : 0;
      index += 1;
    }

    if ((*node).cache != null) {
      Mm::Heap::free((*node).cache as *mut u8);
    }

    (*node).cache = table;
    (*node).cachePages = pages;

    return true;
  }

  /// Drops the cache's reference to every frame of `node` and frees the
  /// table.
  function dropCache(node: *mut Fs::Node): void {
    let mut index: u64 = 0;

    while (index < (*node).cachePages) {
      let frame: u64 = *((*node).cache + index);

      if (frame != 0) {
        Mm::Pmm::freeFrame(frame);
      }

      index += 1;
    }

    if ((*node).cache != null) {
      Mm::Heap::free((*node).cache as *mut u8);
    }

    (*node).cache = null;
    (*node).cachePages = 0;
  }

  /// `VfsState::lock`.
  function vfsLock(): *mut Sched::Mutex {
    return &mut VfsState::lock as *mut Sched::Mutex;
  }

  /// Creates `/dev` when the initramfs did not, and `/dev/console` in it.
  function addConsole(): void {
    let mut dev: *mut Fs::Node = findChild(VfsState::root, "dev" as *u8, 3);
    let mut console: *mut Fs::Node = null;

    if (dev == null && create(VfsState::root, "dev" as *u8, 3, DIRECTORY, DIRECTORY_MODE, &mut dev as *mut *mut Fs::Node) != OK) {
      @panic("vfs: cannot create /dev");
    }

    if (create(dev, "console" as *u8, 7, DEVICE, CONSOLE_MODE, &mut console as *mut *mut Fs::Node) != OK) {
      @panic("vfs: cannot create /dev/console");
    }
  }

  /// A short text for a status code, as `strerror` would print it.
  function describe(status: u64): str {
    return match (status) {
      OK -> "success",
      NOT_FOUND -> "no such file or directory",
      NOT_DIRECTORY -> "not a directory",
      IS_DIRECTORY -> "is a directory",
      EXISTS -> "file exists",
      NAME_TOO_LONG -> "file name too long",
      NO_MEMORY -> "out of memory",
      NOT_EMPTY -> "directory not empty",
      INVALID -> "invalid argument",
      TOO_LARGE -> "file too large",
      BUSY -> "device or resource busy",
      _ -> "unknown error",
    };
  }

  /// The root directory.
  function root(): *mut Fs::Node {
    return VfsState::root;
  }

  /// Prints one line with the number of nodes and file bytes under the root.
  function report(): void {
    let mut nodes: u64 = 0;
    let mut bytes: u64 = 0;

    count(VfsState::root, &mut nodes as *mut u64, &mut bytes as *mut u64);

    Drivers::Console::write("vfs: ");
    Drivers::Console::writeDecimal(nodes);
    Drivers::Console::write(" nodes, ");
    Drivers::Console::writeDecimal(bytes);
    Drivers::Console::writeLine(" bytes in files, seeded from the initramfs");
  }

  /// Finds the node the `length` bytes of `path` name, starting at `base`
  /// for a relative path and at the root for an absolute one. On `OK`
  /// writes the node to `result`. See the module header for the rules.
  function lookup(base: *mut Fs::Node, path: *u8, length: u64, result: *mut *mut Fs::Node): u64 {
    requireLock();

    if (length >= PATH_MAX) {
      return NAME_TOO_LONG;
    }

    let mut node: *mut Fs::Node = base;

    if (length > 0 && *path == SLASH) {
      node = VfsState::root;
    }

    let mut position: u64 = 0;

    while (position < length) {
      while (position < length && *(path + position) == SLASH) {
        position += 1;
      }

      let start: u64 = position;

      while (position < length && *(path + position) != SLASH) {
        position += 1;
      }

      let componentLength: u64 = position - start;

      if (componentLength == 0) {
        continue;
      }

      if (componentLength > NAME_MAX) {
        return NAME_TOO_LONG;
      }

      if ((*node).kind != DIRECTORY) {
        return NOT_DIRECTORY;
      }

      let component: *u8 = path + start;

      if (isDot(component, componentLength)) {
        continue;
      }

      if (isDotDot(component, componentLength)) {
        node = (*node).parent;
        continue;
      }

      let next: *mut Fs::Node = findChild(node, component, componentLength);

      if (next == null) {
        return NOT_FOUND;
      }

      node = next;
    }

    if (length > 0 && *(path + length - 1) == SLASH && (*node).kind != DIRECTORY) {
      return NOT_DIRECTORY;
    }

    *result = node;

    return OK;
  }

  /// Splits the `length` bytes of `path` into the directory that holds its
  /// last component and that component. On `OK` writes the directory to
  /// `parent`, and the offset and length of the last component in `path` to
  /// `nameOffset` and `nameLength`. A path with no last component (`/`, `.`,
  /// `..`, empty) is `INVALID`, since nothing can be created under such a
  /// name. Trailing slashes are dropped: `mkdir a/` creates `a`.
  function lookupParent(
    base: *mut Fs::Node,
    path: *u8,
    length: u64,
    parent: *mut *mut Fs::Node,
    nameOffset: *mut u64,
    nameLength: *mut u64
  ): u64 {
    requireLock();

    if (length >= PATH_MAX) {
      return NAME_TOO_LONG;
    }

    let mut end: u64 = length;

    while (end > 0 && *(path + end - 1) == SLASH) {
      end -= 1;
    }

    let mut start: u64 = end;

    while (start > 0 && *(path + start - 1) != SLASH) {
      start -= 1;
    }

    let componentLength: u64 = end - start;

    if (componentLength == 0 || isDot(path + start, componentLength) || isDotDot(path + start, componentLength)) {
      return INVALID;
    }

    if (componentLength > NAME_MAX) {
      return NAME_TOO_LONG;
    }

    let mut directory: *mut Fs::Node = null;
    let mut status: u64 = OK;

    if (start == 0) {
      directory = base;
    } else {
      status = lookup(base, path, start, &mut directory as *mut *mut Fs::Node);
    }

    if (status != OK) {
      return status;
    }

    if ((*directory).kind != DIRECTORY) {
      return NOT_DIRECTORY;
    }

    *parent = directory;
    *nameOffset = start;
    *nameLength = componentLength;

    return OK;
  }

  /// The child of `directory` called by the `length` bytes at `name`, or
  /// null.
  function findChild(directory: *mut Fs::Node, name: *u8, length: u64): *mut Fs::Node {
    let mut child: *mut Fs::Node = (*directory).firstChild;

    while (child != null) {
      if ((*child).nameLength == length && Lib::Mem::compare((*child).name as *u8, name, length) == 0) {
        return child;
      }

      child = (*child).nextSibling;
    }

    return null;
  }

  /// Creates a node of `kind` called by the `length` bytes at `name` in
  /// `directory`, with `mode`. On `OK` writes it to `result`. Returns
  /// `EXISTS` when the name is taken, whatever its kind, `NOT_DIRECTORY`
  /// when `directory` is a file, `INVALID` for an empty name, `.`, `..` or a
  /// name with a slash, `NAME_TOO_LONG` and `NO_MEMORY`.
  function create(
    directory: *mut Fs::Node,
    name: *u8,
    length: u64,
    kind: u64,
    mode: u64,
    result: *mut *mut Fs::Node
  ): u64 {
    requireLock();

    if ((*directory).kind != DIRECTORY) {
      return NOT_DIRECTORY;
    }

    if (length == 0 || isDot(name, length) || isDotDot(name, length) || hasSlash(name, length)) {
      return INVALID;
    }

    if (length > NAME_MAX) {
      return NAME_TOO_LONG;
    }

    if (findChild(directory, name, length) != null) {
      return EXISTS;
    }

    let node: *mut Fs::Node = newNode(kind, name, length, mode);

    if (node == null) {
      return NO_MEMORY;
    }

    attach(directory, node);
    *result = node;

    return OK;
  }

  /// Removes `node`, a file or an empty directory, from its parent and frees
  /// it with its name, page cache and owned data. Returns `NOT_EMPTY` for a
  /// directory with children, `INVALID` for the root and `BUSY` while a
  /// memory region maps it.
  function remove(node: *mut Fs::Node): u64 {
    requireLock();

    if (node == VfsState::root) {
      return INVALID;
    }

    if ((*node).kind == DIRECTORY && (*node).firstChild != null) {
      return NOT_EMPTY;
    }

    if ((*node).mappings > 0) {
      return BUSY;
    }

    let parent: *mut Fs::Node = (*node).parent;

    if ((*parent).firstChild == node) {
      (*parent).firstChild = (*node).nextSibling;
    } else {
      let mut previous: *mut Fs::Node = (*parent).firstChild;

      while ((*previous).nextSibling != node) {
        previous = (*previous).nextSibling;
      }

      (*previous).nextSibling = (*node).nextSibling;
    }

    (*parent).childCount -= 1;
    freeNode(node);

    return OK;
  }

  /// Copies up to `count` bytes of file `node` from `offset` to `buffer` and
  /// writes the number copied to `copied`: 0 at or past the end of the file.
  /// A cached page is read from its frame; the cache is not filled.
  /// Returns `IS_DIRECTORY` for a directory and `INVALID` for a device.
  function read(
    node: *mut Fs::Node,
    offset: u64,
    buffer: *mut u8,
    count: u64,
    copied: *mut u64
  ): u64 {
    requireLock();

    if ((*node).kind != FILE) {
      return notFileStatus(node);
    }

    if (offset >= (*node).size) {
      *copied = 0;
      return OK;
    }

    let mut length: u64 = (*node).size - offset;

    if (count < length) {
      length = count;
    }

    let mut done: u64 = 0;

    while (done < length) {
      let position: u64 = offset + done;
      let chunk: u64 = pageChunk(position, length - done);
      let frame: u64 = cachedFrame(node, position / PAGE_SIZE);

      if (frame != 0) {
        Lib::Mem::copy(buffer + done, (Boot::Hhdm::toVirtual(frame) + position % PAGE_SIZE) as *u8, chunk);
      } else {
        Lib::Mem::copy(buffer + done, ((*node).data + position) as *u8, chunk);
      }

      done += chunk;
    }

    *copied = length;

    return OK;
  }

  /// Writes the `count` bytes at `source` to file `node` at `offset`. The
  /// file grows as needed, and a gap between the old end and `offset` reads
  /// as zeros. The first write to a file whose data is in the archive copies
  /// it to the heap. A cached page is written in its frame. Returns
  /// `IS_DIRECTORY`, `INVALID` for a device, `BUSY` while pinned or a
  /// program image, `TOO_LARGE` past `MAX_FILE_SIZE`, `NO_MEMORY`, or
  /// `INVALID` when `offset + count` does not fit a signed 64-bit offset.
  function write(node: *mut Fs::Node, offset: u64, source: *u8, count: u64): u64 {
    requireLock();

    if ((*node).kind != FILE) {
      return notFileStatus(node);
    }

    // A pinned file is being read without the lock; a write could move its
    // data. A running program's image must not change under it.
    if ((*node).pins > 0 || (*node).images > 0) {
      return BUSY;
    }

    let end: u64 = offset + count;

    // Offsets are signed 64-bit values everywhere (`Fs::Files::seek`), so an
    // end past 2^63 - 1 is malformed, whether or not the unsigned sum wraps.
    if (end < offset || (end as i64) < 0) {
      return INVALID;
    }

    if (end > MAX_FILE_SIZE) {
      return TOO_LARGE;
    }

    let mut newSize: u64 = (*node).size;

    if (end > newSize) {
      newSize = end;
    }

    if (!reserve(node, newSize)) {
      return NO_MEMORY;
    }

    if (offset > (*node).size) {
      store(node, (*node).size, null, offset - (*node).size);
    }

    store(node, offset, source, count);
    (*node).size = newSize;

    return OK;
  }

  /// Cuts file `node` to `length` bytes, or extends it with zeros, written
  /// into the cache frames of cached pages. Cutting keeps the frames.
  /// Returns `IS_DIRECTORY`, `INVALID` for a device, `BUSY` while pinned or
  /// a program image, `TOO_LARGE` past `MAX_FILE_SIZE`, or `NO_MEMORY`.
  function truncate(node: *mut Fs::Node, length: u64): u64 {
    requireLock();

    if ((*node).kind != FILE) {
      return notFileStatus(node);
    }

    if ((*node).pins > 0 || (*node).images > 0) {
      return BUSY;
    }

    if (length > MAX_FILE_SIZE) {
      return TOO_LARGE;
    }

    if (length > (*node).size) {
      if (!reserve(node, length)) {
        return NO_MEMORY;
      }

      store(node, (*node).size, null, length - (*node).size);
    }

    // Cutting keeps the cache frames: the bytes past the new end are zeroed
    // by the next extension, not now.
    (*node).size = length;

    return OK;
  }

  /// Writes the absolute path of `node` (`/` for the root, `/a/b` below it)
  /// to the `capacity` bytes at `buffer`, without a NUL, and its length to
  /// `length`. Returns `NAME_TOO_LONG` when it does not fit.
  function pathOf(node: *mut Fs::Node, buffer: *mut u8, capacity: u64, length: *mut u64): u64 {
    requireLock();

    if (node == VfsState::root) {
      if (capacity < 1) {
        return NAME_TOO_LONG;
      }

      *buffer = SLASH;
      *length = 1;
      return OK;
    }

    let mut total: u64 = 0;
    let mut walk: *mut Fs::Node = node;

    while (walk != VfsState::root) {
      total += 1 + (*walk).nameLength;
      walk = (*walk).parent;
    }

    if (total > capacity) {
      return NAME_TOO_LONG;
    }

    let mut end: u64 = total;

    walk = node;

    while (walk != VfsState::root) {
      end -= (*walk).nameLength;
      Lib::Mem::copy(buffer + end, (*walk).name as *u8, (*walk).nameLength);
      end -= 1;
      *(buffer + end) = SLASH;
      walk = (*walk).parent;
    }

    *length = total;

    return OK;
  }

  /// The child of `directory` at `index` in the order they were added, or
  /// null past the last one.
  function child(directory: *mut Fs::Node, index: u64): *mut Fs::Node {
    requireLock();

    let mut node: *mut Fs::Node = (*directory).firstChild;
    let mut position: u64 = 0;

    while (node != null && position < index) {
      node = (*node).nextSibling;
      position += 1;
    }

    return node;
  }

  /// Makes sure file `node` owns a heap block of at least `size` bytes with
  /// its current data in it. Returns false when the heap is exhausted; the
  /// file is unchanged then.
  function reserve(node: *mut Fs::Node, size: u64): boolean {
    if ((*node).capacity >= size && (*node).capacity > 0) {
      return true;
    }

    let mut capacity: u64 = MIN_CAPACITY;

    // Doubling cannot wrap: callers keep `size` at most `MAX_FILE_SIZE`, so
    // the loop stops at twice that at most.
    while (capacity < size) {
      capacity = capacity * 2;
    }

    let block: *mut u8 = Mm::Heap::allocate(capacity, 16);

    if (block == null) {
      return false;
    }

    if ((*node).size > 0) {
      Lib::Mem::copy(block, (*node).data as *u8, (*node).size);
    }

    if ((*node).capacity > 0) {
      Mm::Heap::free((*node).data);
    }

    (*node).data = block;
    (*node).capacity = capacity;

    return true;
  }

  /// Adds every member of the initramfs. Missing parent directories are
  /// created, so the result does not depend on the member order. Panics on
  /// a name used twice with different kinds or when the heap runs out.
  function seed(): void {
    let mut entry: Fs::TarEntry = Fs::TarEntry { kind: 0, mode: 0, data: null, size: 0, pathLength: 0, next: 0 };
    let mut offset: u64 = 0;
    let path: *mut u8 = &mut VfsState::path as *mut u8;

    while (Fs::Tar::next(Fs::Initramfs::archive(), Fs::Initramfs::size(), offset, &mut entry as *mut Fs::TarEntry, path) == Fs::Tar::OK) {
      if (entry.pathLength > 0) {
        seedEntry(path as *u8, entry.pathLength, &mut entry as *mut Fs::TarEntry);
      }

      offset = entry.next;
    }
  }

  /// Adds the member described by `entry` at the normalized `path`,
  /// creating each missing directory on the way.
  function seedEntry(path: *u8, length: u64, entry: *mut Fs::TarEntry): void {
    let mut directory: *mut Fs::Node = VfsState::root;
    let mut start: u64 = 0;

    while (start < length) {
      let mut end: u64 = start;

      while (end < length && *(path + end) != SLASH) {
        end += 1;
      }

      let isLast: boolean = end == length;
      let mut kind: u64 = DIRECTORY;
      let mut mode: u64 = DIRECTORY_MODE;

      if (isLast) {
        kind = (*entry).kind == Fs::Tar::FILE ? FILE : DIRECTORY;
        mode = (*entry).mode;
      }

      let mut node: *mut Fs::Node = findChild(directory, path + start, end - start);

      if (node == null) {
        if (create(directory, path + start, end - start, kind, mode, &mut node as *mut *mut Fs::Node) != OK) {
          @panic("vfs: cannot add an initramfs member");
        }

        if (isLast && kind == FILE) {
          (*node).data = (*entry).data as *mut u8;
          (*node).size = (*entry).size;
        }
      } else if ((*node).kind != kind) {
        @panic("vfs: the initramfs names a path as a file and a directory");
      }

      directory = node;
      start = end + 1;
    }
  }

  /// Allocates a node with a heap copy of the name. Returns null when the
  /// heap is exhausted.
  function newNode(kind: u64, name: *u8, length: u64, mode: u64): *mut Fs::Node {
    let node: *mut Fs::Node = Mm::Heap::allocate(@sizeOf<Fs::Node>(), 16) as *mut Fs::Node;

    if (node == null) {
      return null;
    }

    let mut copy: *mut u8 = null;

    if (length > 0) {
      copy = Mm::Heap::allocate(length, 1);

      if (copy == null) {
        Mm::Heap::free(node as *mut u8);
        return null;
      }

      Lib::Mem::copy(copy, name, length);
    }

    (*node).kind = kind;
    (*node).id = VfsState::nextId;
    (*node).mode = mode;
    (*node).name = copy;
    (*node).nameLength = length;
    (*node).parent = null;
    (*node).firstChild = null;
    (*node).nextSibling = null;
    (*node).childCount = 0;
    (*node).data = null;
    (*node).size = 0;
    (*node).capacity = 0;
    (*node).pins = 0;
    (*node).cache = null;
    (*node).cachePages = 0;
    (*node).mappings = 0;
    (*node).images = 0;

    VfsState::nextId += 1;

    return node;
  }

  /// Frees a detached node, its name, its page cache and the data it owns.
  function freeNode(node: *mut Fs::Node): void {
    dropCache(node);

    if ((*node).capacity > 0) {
      Mm::Heap::free((*node).data);
    }

    if ((*node).nameLength > 0) {
      Mm::Heap::free((*node).name);
    }

    Mm::Heap::free(node as *mut u8);
  }

  /// Appends `node` to the children of `directory`.
  function attach(directory: *mut Fs::Node, node: *mut Fs::Node): void {
    (*node).parent = directory;

    if ((*directory).firstChild == null) {
      (*directory).firstChild = node;
    } else {
      let mut last: *mut Fs::Node = (*directory).firstChild;

      while ((*last).nextSibling != null) {
        last = (*last).nextSibling;
      }

      (*last).nextSibling = node;
    }

    (*directory).childCount += 1;
  }

  /// Adds to `nodes` and `bytes` the nodes and file bytes of the subtree at
  /// `node`.
  function count(node: *mut Fs::Node, nodes: *mut u64, bytes: *mut u64): void {
    *nodes = *nodes + 1;
    *bytes = *bytes + (*node).size;

    let mut child: *mut Fs::Node = (*node).firstChild;

    while (child != null) {
      count(child, nodes, bytes);
      child = (*child).nextSibling;
    }
  }

  /// The status of a file operation on a node that is not a file:
  /// `IS_DIRECTORY` for a directory, `INVALID` for a device, which only
  /// `Fs::Files` can read and write.
  function notFileStatus(node: *mut Fs::Node): u64 {
    return (*node).kind == DIRECTORY ? IS_DIRECTORY : INVALID;
  }

  /// True when the `length` bytes at `name` are `.`.
  function isDot(name: *u8, length: u64): boolean {
    return length == 1 && *name == DOT;
  }

  /// True when the `length` bytes at `name` are `..`.
  function isDotDot(name: *u8, length: u64): boolean {
    return length == 2 && *name == DOT && *(name + 1) == DOT;
  }

  /// True when the `length` bytes at `name` contain a `/`.
  function hasSlash(name: *u8, length: u64): boolean {
    let mut index: u64 = 0;

    while (index < length) {
      if (*(name + index) == SLASH) {
        return true;
      }

      index += 1;
    }

    return false;
  }
}
