//!
//! # Line Input
//!
//! Turns key presses into lines: echo, Backspace, Enter and Ctrl+D. The
//! kernel terminal and a program reading descriptor 0 both get their input
//! here.
//!
//! ## Overview
//!
//! Like a Unix terminal in canonical mode, input is edited a line at a time
//! and handed over only when it is complete:
//!
//! | Key          | Effect                                                          |
//! |--------------|-----------------------------------------------------------------|
//! | printable    | stored and echoed, up to the capacity of the line               |
//! | Backspace    | erases the last stored character and echoes `0x08`; nothing on an empty line |
//! | Enter        | echoes a newline and ends the line, which keeps the `\n`        |
//! | Ctrl+D       | on an empty line: end of input (0 bytes); otherwise ends the line without a `\n` |
//! | anything else | ignored (Tab, other control codes)                             |
//!
//! `readLine` edits into a caller's buffer. `read` serves descriptor 0: it
//! keeps one line and hands it out over as many reads as the caller's
//! buffers need, so a short read buffer loses nothing.
//!
//! ## Waiting for a key
//!
//! One spinlock, taken with `lockIrq` (rank `Lib::Rank::WAIT_QUEUE`), guards
//! the line, the busy flag and the cancel flags. A reader that finds no key
//! sleeps on the wait queue with that lock held (`Sched::Wait::sleepOn`),
//! and the keyboard interrupt wakes it (`keysArrived`, called by the trap
//! dispatcher after IRQ1). The check and the sleep are one step under the
//! lock, so a key that arrives in between still wakes the reader, on any
//! processor. A key is decoded and echoed with the lock let go.
//!
//! This is the logic of `/dev/console`, so it lives in `Fs`: it needs the
//! scheduler to wait, and `Drivers` sits below it.
//!
//! A reader may give a token (`readAs`, `readLineAs`); `cancel` with that
//! token makes its read end at once with 0 bytes. The kernel uses it to stop
//! a process it ends while the process waits for the keyboard. The token is
//! the process slot, shared by every thread of the process, so the cancel
//! stays in force until `forget` withdraws it: every thread reading, now or
//! later, ends its read (C4 D17). The process's descriptors are closed with
//! its last thread, which calls `forget`.
//!
//! Only one reader edits a line at a time; another one waits until it is
//! done. Each reader edits into a buffer of its own, so it cannot change a
//! line another reader is still taking in pieces. Two programs reading the
//! keyboard at once each get whole lines in turn; only when a reader's own
//! new line arrives while another reader still holds a remainder, and the
//! new line is longer than its buffer, is the rest of the new line dropped.

import Arch from "@arch";
import Drivers from "@drivers";
import Lib from "@lib";
import Sched from "@sched";

/// The line `read` hands out.
record TtyState {
  /// The line. The size must equal `Fs::Tty::LINE_CAPACITY`.
  static mut line: u8[256];

  /// Its length, newline included.
  static mut length: u64 = 0;

  /// How much of it `read` has handed out.
  static mut position: u64 = 0;

  /// True while a reader is editing a line.
  static mut busy: boolean = false;

  /// One flag per token, 1 when every read of that reader must end at once
  /// (`Fs::Tty::cancel`) until `Fs::Tty::forget` clears it. Token 0 is the
  /// kernel terminal, which is never cancelled. The size must be
  /// `MAX_TOKENS`.
  static mut cancelled: u8[65];

  /// Guards every field above.
  static mut lock: Arch::SpinLock;

  /// Readers waiting for a key, for the line to be free, or for a cancel.
  static mut waiters: Sched::WaitQueue;
}

/// The line input API.
namespace Fs::Tty {
  /// Bytes of the line `read` keeps.
  const LINE_CAPACITY: u64 = 256;

  /// ASCII backspace.
  const BACKSPACE: u8 = 0x08;

  /// ASCII line feed, the byte Enter decodes to.
  const NEWLINE: u8 = 0x0A;

  /// Ctrl+D, end of transmission.
  const END_OF_INPUT: u8 = 0x04;

  /// First printable ASCII character, space.
  const FIRST_PRINTABLE: u8 = 0x20;

  /// Last printable ASCII character, tilde.
  const LAST_PRINTABLE: u8 = 0x7E;

  /// The token of a reader that cannot be cancelled, the kernel terminal.
  const NO_TOKEN: u64 = 0;

  /// Tokens are 1 to 64, a process slot plus 1.
  const MAX_TOKENS: u64 = 65;

  /// Edits one line into the `capacity` bytes at `buffer` and returns its
  /// length: printable characters up to `capacity - 1`, then the `\n` of
  /// Enter. Returns 0 for Ctrl+D on an empty line, and the characters without
  /// a `\n` for Ctrl+D after some.
  function readLine(buffer: *mut u8, capacity: u64): u64 {
    return readLineAs(buffer, capacity, NO_TOKEN);
  }

  /// `readLine` for the reader `token`, which `cancel` can stop: the read
  /// then ends at once with 0 bytes, and the keys typed so far stay unread.
  function readLineAs(buffer: *mut u8, capacity: u64, token: u64): u64 {
    Arch::Spin::lockIrq(ttyLock());

    while (TtyState::busy) {
      if (isCancelled(token)) {
        Arch::Spin::unlockIrq(ttyLock());
        return 0;
      }

      Sched::Wait::sleepOn(waitQueue(), ttyLock());
    }

    TtyState::busy = true;

    let mut length: u64 = 0;
    let mut finished: boolean = false;

    while (!finished) {
      if (isCancelled(token)) {
        length = 0;
        break;
      }

      if (Lib::ScancodeQueue::isEmpty()) {
        Sched::Wait::sleepOn(waitQueue(), ttyLock());
        continue;
      }

      // Only the busy reader pops, so the queue keeps its one consumer.
      let scancode: u8 = Lib::ScancodeQueue::pop();

      Arch::Spin::unlockIrq(ttyLock());

      let character: u8 = Drivers::Keyboard::decode(scancode);

      if (character == NEWLINE) {
        Drivers::Console::writeChar(NEWLINE);
        *(buffer + length) = NEWLINE;
        length += 1;
        finished = true;
      } else if (character == END_OF_INPUT) {
        finished = true;
      } else if (character == BACKSPACE) {
        if (length > 0) {
          length -= 1;
          Drivers::Console::writeChar(BACKSPACE);
        }
      } else if (character >= FIRST_PRINTABLE && character <= LAST_PRINTABLE && length + 1 < capacity) {
        *(buffer + length) = character;
        length += 1;
        Drivers::Console::writeChar(character);
      }

      Arch::Spin::lockIrq(ttyLock());
    }

    TtyState::busy = false;
    Sched::Wait::wakeAll(waitQueue());
    Arch::Spin::unlockIrq(ttyLock());

    return length;
  }

  /// Copies up to `count` bytes of keyboard input to `buffer` and writes the
  /// number copied to `done`. Hands out what is left of the current line
  /// first; when nothing is left, waits for a new line. `done` is 0 at the end
  /// of input (Ctrl+D on an empty line).
  function read(buffer: *mut u8, count: u64, done: *mut u64): void {
    readAs(buffer, count, done, NO_TOKEN);
  }

  /// `read` for the reader `token`, which `cancel` can stop.
  function readAs(buffer: *mut u8, count: u64, done: *mut u64, token: u64): void {
    if (count == 0) {
      *done = 0;
      return;
    }

    Arch::Spin::lockIrq(ttyLock());

    if (TtyState::position >= TtyState::length) {
      Arch::Spin::unlockIrq(ttyLock());

      // Edit into a buffer of this reader: another reader may wait in
      // `readLine` meanwhile, and the shared line must not change under it.
      let mut fresh: u8[256];
      let length: u64 = readLineAs(&mut fresh as *mut u8, LINE_CAPACITY, token);

      if (length == 0) {
        *done = 0;
        return;
      }

      Arch::Spin::lockIrq(ttyLock());

      if (TtyState::position < TtyState::length) {
        Arch::Spin::unlockIrq(ttyLock());
        Lib::Mem::copy(buffer, (&mut fresh as *u8), length < count ? length : count);
        *done = length < count ? length : count;
        return;
      }

      Lib::Mem::copy(&mut TtyState::line as *mut u8, &mut fresh as *u8, length);
      TtyState::length = length;
      TtyState::position = 0;
    }

    let left: u64 = TtyState::length - TtyState::position;
    let copied: u64 = left < count ? left : count;

    Lib::Mem::copy(buffer, (&mut TtyState::line as *u8) + TtyState::position, copied);
    TtyState::position += copied;
    *done = copied;
    Arch::Spin::unlockIrq(ttyLock());
  }

  /// Ends every read of `token` at once: each `readAs` with it, waiting now
  /// or started later, returns 0 bytes, until `forget` withdraws the cancel.
  /// Readers with other tokens are not affected.
  function cancel(token: u64): void {
    if (token != NO_TOKEN && token < MAX_TOKENS) {
      Arch::Spin::lockIrq(ttyLock());
      *flagOf(token) = 1;
      Sched::Wait::wakeAll(waitQueue());
      Arch::Spin::unlockIrq(ttyLock());
    }
  }

  /// Withdraws the cancel for `token`, so a later reader with the same token
  /// (a new process in the slot) is not stopped by it.
  function forget(token: u64): void {
    if (token < MAX_TOKENS) {
      Arch::Spin::lockIrq(ttyLock());
      *flagOf(token) = 0;
      Arch::Spin::unlockIrq(ttyLock());
    }
  }

  /// True while a cancel for `token` is in force.
  function cancelPending(token: u64): boolean {
    if (token >= MAX_TOKENS) {
      return false;
    }

    Arch::Spin::lockIrq(ttyLock());

    let pending: boolean = *flagOf(token) != 0;

    Arch::Spin::unlockIrq(ttyLock());

    return pending;
  }

  /// Wakes the readers after the keyboard interrupt queued scancodes. The
  /// trap dispatcher calls it after IRQ1, with interrupts off.
  function keysArrived(): void {
    Arch::Spin::lockIrq(ttyLock());
    Sched::Wait::wakeAll(waitQueue());
    Arch::Spin::unlockIrq(ttyLock());
  }

  /// Sets up the lock. `Fs::Vfs::initialize` calls it, before any reader or
  /// keyboard interrupt.
  function initialize(): void {
    Arch::Spin::initialize(ttyLock(), Lib::Rank::WAIT_QUEUE);
  }

  /// True when the reads of `token` are cancelled. The flag stays set, so
  /// every thread of the process reading with the token sees it, not only
  /// the first one. The lock is held.
  function isCancelled(token: u64): boolean {
    return token != NO_TOKEN && token < MAX_TOKENS && *flagOf(token) != 0;
  }

  /// `TtyState::lock`.
  function ttyLock(): *mut Arch::SpinLock {
    return &mut TtyState::lock as *mut Arch::SpinLock;
  }

  /// `TtyState::waiters`.
  function waitQueue(): *mut Sched::WaitQueue {
    return &mut TtyState::waiters as *mut Sched::WaitQueue;
  }

  /// The cancel flag of `token`.
  function flagOf(token: u64): *mut u8 {
    return (&mut TtyState::cancelled as *mut u8) + token;
  }
}
