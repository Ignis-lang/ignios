//!
//! # Threads
//!
//! The thread table: one slot per kernel thread, its state and its stack.
//!
//! ## Overview
//!
//! A thread is a slot in a fixed table: an id, a state, the stack pointer it
//! was switched out with, and a kernel stack of its own. Slot 0 is the boot
//! thread, the code `kmain` was already running on Limine's stack. Slots 1 to
//! 8 are the idle threads, one per processor (slot 1 + n for processor n),
//! each of which runs only when nothing else is ready for its processor.
//! Every other slot is free until `Sched::Scheduler::spawn` fills it. This file owns the
//! table and the stacks. `scheduler.ign` decides which slot runs.
//!
//! ## Thread States
//!
//! ```text
//!                     spawn
//!           UNUSED ───────────► READY ◄──────────────────────┐
//!              ▲                  │  ▲                       │ wakeSleepers:
//!              │ reapZombie       │  │ yield, or the time    │ now >= wakeTick
//!              │ (next thread)    │  │ slice ran out         │
//!            DEAD                 ▼  │                       │
//!              ▲              RUNNING ──── sleep(ticks) ──► BLOCKED
//!              │                  │  │
//!              └──── exitCurrent ─┘  └─── join(id) ──► WAITING
//!                                                        │
//!                    reapZombie of thread `id` makes it READY
//! ```
//!
//! One thread per processor is RUNNING. The idle threads are never in the
//! run queue: a processor runs its own when the queue is empty.
//!
//! ## Thread Stacks
//!
//! Each slot has `STACK_SPAN` bytes (5 pages) of virtual address space at
//! `STACK_REGION + slot * STACK_SPAN`:
//!
//! ```text
//!   high   base + 0x5000  ┌──────────────────────┐ <- stack top (RSP0 for user threads)
//!                         │ stack page 4         │
//!                         │ stack page 3         │    16 KiB of frames from the PMM,
//!                         │ stack page 2         │    grows downward
//!                         │ stack page 1         │
//!   low    base + 0x1000  ├──────────────────────┤
//!                         │ guard page (unmapped)│ <- overflow faults here
//!          base + 0x0000  └──────────────────────┘
//!
//!   STACK_REGION = 0xFFFFB00000000000
//! ```
//!
//! The boot thread (slot 0) keeps running on Limine's stack and has no such
//! region. Stacks are `STACK_PAGES` pages of PMM frames mapped in a region of
//! their own, below an unmapped guard page: a thread that overflows its stack
//! takes a page fault instead of writing over another thread's stack.
//!
//! Every slot's stack is mapped once, at boot, and stays mapped: a new
//! thread in the slot reuses it. A processor may still hold a translation of
//! a stack in its TLB after the thread moved away (kernel threads share one
//! CR3, so switching between them flushes nothing); since the mapping never
//! changes, such a stale entry is harmless, and no TLB shootdown is needed
//! (`Sched::Shootdown` is for user pages that are removed or replaced).
//!
//! ## Memory Cost of the Table
//!
//! `MAX_THREADS` is 128 (C4 D12: 64 processes with a few threads each, plus
//! the boot thread, eight idle threads and the kernel threads). Every slot
//! but the boot thread's maps its stack at boot: 127 * 16 KiB = 2032 KiB of
//! frames, in 127 * 20 KiB = 2540 KiB of virtual space from `STACK_REGION`.
//! The x87 and SSE areas take 128 * 512 = 64 KiB, the run queue 1 KiB, and
//! each slot that ever ran a thread keeps its 5 KiB scratch area on the heap.
//!
//! ## User Threads
//!
//! A thread of a user process also holds what Linux gives each thread: its
//! thread id (`tid`, which the process id counter hands out, so it never
//! equals another process's id; the first thread's is the process id), its
//! FS base for thread-local storage (`fsBase`), loaded into IA32_FS_BASE by
//! every switch into a thread with an address space of its own, and the
//! clear-child-tid address (`clearChildTid`) of `set_tid_address` and
//! `CLONE_CHILD_CLEARTID`. Kernel threads have tid 0 and leave FS alone: the
//! kernel never addresses through FS.
//!
//! See concept doc 13.

import Arch from "@arch";
import Lib from "@lib";
import Mm from "@mm";

/// The thread table. The array size must equal `Sched::Thread::MAX_THREADS`,
/// and has to be an integer literal.
record ThreadState {
  /// The thread table, indexed by slot.
  static mut threads: Sched::Thread::Control[128];

  /// The id the next created thread gets.
  static mut nextId: u64;
}

/// The x87 and SSE save areas, one `Arch::Fpu::STATE_SIZE` (512) bytes per
/// slot, kept apart from the thread table so each one is 16-byte aligned.
/// Slot `n` owns bytes `n * 512` to `n * 512 + 511`. The size has to be an
/// integer literal equal to `Sched::Thread::FPU_AREA_BYTES`, and
/// `initializeBootThread` panics unless that is `MAX_THREADS * 512`. The field has no
/// comment of its own because `ignis fmt` rejects a comment before an
/// attributed field.
record FpuAreaState {
  @aligned(16)
  static mut areas: u8[65536];
}

/// The thread table and the thread stacks.
namespace Sched::Thread {
  /// One entry of the thread table.
  @cLayout
  record Control {
    /// Unique thread id, assigned from a counter that never goes back. Slot
    /// numbers are reused, ids are not.
    public id: u64;

    /// One of `UNUSED`, `READY`, `RUNNING`, `BLOCKED` or `DEAD`.
    public state: u64;

    /// The stack pointer the thread was switched out with. Meaningful when the
    /// thread is not running.
    public savedRsp: u64;

    /// Lowest address of the slot's stack region: the guard page. 0 for the boot
    /// thread, which does not run on a region stack.
    public stackBase: u64;

    /// Tick count at which a `BLOCKED` thread becomes ready.
    public wakeTick: u64;

    /// Timer ticks that arrived while this thread was running.
    public runTicks: u64;

    /// Physical address of the PML4 the thread owns, or 0 for the kernel's.
    public root: u64;

    /// Id of the thread a `WAITING` thread waits for.
    public joinTarget: u64;

    /// The next thread in the wait queue this one sleeps on, as its slot
    /// plus 1; 0 at the end of the queue.
    public waitNext: u64;

    /// The highest rank of the mutexes this thread holds, 0 for none.
    public mutexTop: u64;

    /// Heap address of the thread's `SCRATCH_BYTES` scratch area, which its
    /// system calls use for the kernel copies of their arguments. Each
    /// thread has its own, so a system call may block at any point while
    /// another thread runs one.
    public scratch: u64;

    /// The process slot the thread belongs to, plus 1; 0 for a kernel
    /// thread. Set when the thread is created (`Sched::Scheduler::spawnMember`)
    /// and cleared when it leaves its process (`setProcess`), both under the
    /// process table lock; the threads of a process are the slots that
    /// hold its value.
    public process: u64;

    /// 1 when `wake` came while the thread was not parked: its next `park`
    /// returns at once.
    public wakePending: u64;

    /// 1 when `interrupt` came while the thread was not waiting: its next
    /// `sleep`, `join` or `park` returns at once.
    public interrupted: u64;

    /// The processor the thread ran on last.
    public cpu: u64;

    /// The Linux thread id of a user thread, from the process id counter;
    /// 0 for a kernel thread. Set before the thread first runs.
    public tid: u64;

    /// The FS base of a user thread, loaded into IA32_FS_BASE by every
    /// switch into it (`Sched::Scheduler::activateSpaceOf`).
    public fsBase: u64;

    /// The user address the thread's exit clears (`set_tid_address`,
    /// `CLONE_CHILD_CLEARTID`), or 0. Only the thread itself reads or
    /// changes it.
    public clearChildTid: u64;
  }

  /// Bytes of every thread's scratch area.
  const SCRATCH_BYTES: u64 = 5120;

  /// Size of the thread table, the boot thread and the eight idle threads
  /// included: 64 processes, some with several threads, and a few kernel
  /// threads fit in the rest (see "Memory Cost of the Table").
  const MAX_THREADS: u64 = 128;

  /// Size of `FpuAreaState::areas` in bytes.
  const FPU_AREA_BYTES: u64 = 65536;

  /// Slot of the boot thread.
  const BOOT_SLOT: u64 = 0;

  /// Slot of processor 0's idle thread; processor n's is `IDLE_SLOT + n`.
  const IDLE_SLOT: u64 = 1;

  /// The first slot `spawn` may fill: past every processor's idle slot.
  const FIRST_SPAWN_SLOT: u64 = 9;

  /// Returned by `spawn` when the table is full or the stack cannot be
  /// mapped.
  const NO_THREAD: u64 = 0xFFFFFFFFFFFFFFFF;

  /// A free slot.
  const UNUSED: u64 = 0;

  /// In the run queue, waiting for the processor.
  const READY: u64 = 1;

  /// The thread the processor is executing.
  const RUNNING: u64 = 2;

  /// Asleep until `wakeTick`.
  const BLOCKED: u64 = 3;

  /// Finished, waiting for the next thread to free its stack.
  const DEAD: u64 = 4;

  /// Waiting until the thread `joinTarget` is gone from the table.
  const WAITING: u64 = 5;

  /// Parked until another thread calls `Sched::Scheduler::wake` on it.
  const PARKED: u64 = 6;

  /// Asleep on a `Sched::WaitQueue` until `Sched::Wait::wakeOne` or
  /// `wakeAll`. A kill does not wake it.
  const QUEUED: u64 = 7;

  /// 4 KiB.
  const PAGE_SIZE: u64 = 4096;

  /// Stack pages per thread: 16 KiB.
  const STACK_PAGES: u64 = 4;

  /// A stack plus the guard page below it.
  const STACK_SPAN: u64 = (STACK_PAGES + 1) * PAGE_SIZE;

  /// Where thread stacks live, one `STACK_SPAN` per slot, away from the
  /// direct map, the heap, the APIC pages and the page-table test address.
  const STACK_REGION: u64 = 0xFFFFB00000000000;

  /// True while a thread with this id is in the table, dead or not yet
  /// freed included. The caller holds the run queue lock; elsewhere use
  /// `Sched::Scheduler::isAlive`.
  function isAlive(id: u64): boolean {
    let mut alive: boolean = false;
    let mut slot: u64 = 0;

    while (slot < MAX_THREADS) {
      let thread: *mut Control = slotPointer(slot);

      if ((*thread).state != UNUSED && (*thread).id == id) {
        alive = true;
      }

      slot += 1;
    }

    return alive;
  }

  /// The state of slot `slot` as a word for display, "free" for an unused
  /// slot.
  function stateName(slot: u64): str {
    let state: u64 = (*slotPointer(slot)).state;

    if (state == READY) {
      return "ready";
    }

    if (state == RUNNING) {
      return "running";
    }

    if (state == BLOCKED) {
      return "sleeping";
    }

    if (state == WAITING) {
      return "waiting";
    }

    if (state == PARKED || state == QUEUED) {
      return "blocked";
    }

    if (state == DEAD) {
      return "dead";
    }

    return "free";
  }

  /// The x87 and SSE save area of `slot`, 16-byte aligned. The scheduler
  /// saves the registers here when the thread is switched out and loads
  /// them from here when it is switched in.
  function fpuArea(slot: u64): *mut u8 {
    return (&mut FpuAreaState::areas as *mut u8) + slot * Arch::Fpu::STATE_SIZE;
  }

  /// Gives `slot` the initial x87 and SSE state: everything masked, round to
  /// nearest, empty registers.
  function resetFpuArea(slot: u64): void {
    Lib::Mem::copy(fpuArea(slot), Arch::Fpu::initialState() as *u8, Arch::Fpu::STATE_SIZE);
  }

  /// The id of the thread in `slot`. Meaningful when the slot is in use.
  function slotId(slot: u64): u64 {
    return (*slotPointer(slot)).id;
  }

  /// True when `slot` holds a thread.
  function slotInUse(slot: u64): boolean {
    return (*slotPointer(slot)).state != UNUSED;
  }

  /// The processor the thread in `slot` runs or last ran on.
  function slotCpu(slot: u64): u64 {
    return (*slotPointer(slot)).cpu;
  }

  /// Timer ticks the thread in `slot` has been running when a tick arrived.
  /// The count grows only once preemption is enabled.
  function slotRunTicks(slot: u64): u64 {
    return (*slotPointer(slot)).runTicks;
  }

  /// The tick a sleeping thread wakes at, or 0 when `slot` is not asleep.
  function slotWakeTick(slot: u64): u64 {
    if ((*slotPointer(slot)).state != BLOCKED) {
      return 0;
    }

    return (*slotPointer(slot)).wakeTick;
  }

  /// The idle slot of processor `cpu`.
  function idleSlot(cpu: u64): u64 {
    return IDLE_SLOT + cpu;
  }

  /// True for any processor's idle slot.
  function isIdleSlot(slot: u64): boolean {
    return slot >= IDLE_SLOT && slot < FIRST_SPAWN_SLOT;
  }

  /// The free slots `spawn` can still fill.
  function spawnableSlots(): u64 {
    let mut count: u64 = 0;
    let mut slot: u64 = FIRST_SPAWN_SLOT;

    while (slot < MAX_THREADS) {
      if ((*slotPointer(slot)).state == UNUSED) {
        count += 1;
      }

      slot += 1;
    }

    return count;
  }

  /// Threads currently in the table, idle and boot included.
  function threadCount(): u64 {
    let mut count: u64 = 0;
    let mut slot: u64 = 0;

    while (slot < MAX_THREADS) {
      if ((*slotPointer(slot)).state != UNUSED) {
        count += 1;
      }

      slot += 1;
    }

    return count;
  }

  /// Fills `slot` with a thread that has never run. Returns false, leaving
  /// the slot free, when the stack cannot be mapped.
  function createThread(slot: u64, entry: u64, argument: u64, root: u64): boolean {
    let base: u64 = STACK_REGION + slot * STACK_SPAN;
    let thread: *mut Control = slotPointer(slot);

    if ((*thread).scratch == 0) {
      (*thread).scratch = @integerFromPointer(Mm::Heap::allocate(SCRATCH_BYTES, 16));

      if ((*thread).scratch == 0) {
        return false;
      }
    }

    (*thread).id = ThreadState::nextId;
    (*thread).state = READY;
    (*thread).stackBase = base;
    (*thread).wakeTick = 0;
    (*thread).runTicks = 0;
    (*thread).waitNext = 0;
    (*thread).mutexTop = 0;
    (*thread).process = 0;
    (*thread).wakePending = 0;
    (*thread).interrupted = 0;
    (*thread).cpu = 0;
    (*thread).tid = 0;
    (*thread).fsBase = 0;
    (*thread).clearChildTid = 0;
    (*thread).root = root;
    (*thread).savedRsp = Arch::Context::prepareStack(base + STACK_SPAN, entry, argument);
    resetFpuArea(slot);

    ThreadState::nextId += 1;

    return true;
  }

  /// Maps the pages above the guard page at `base`, or none of them.
  function mapStack(base: u64): boolean {
    let mut page: u64 = 1;

    while (page <= STACK_PAGES) {
      let frame: u64 = Mm::Pmm::allocateFrame();

      if (frame == Mm::Pmm::NO_FRAME || !Mm::Vmm::map(base + page * PAGE_SIZE, frame, Mm::Vmm::WRITABLE | Mm::Vmm::NO_EXECUTE)) {
        if (frame != Mm::Pmm::NO_FRAME) {
          Mm::Pmm::freeFrame(frame);
        }

        unmapStack(base, page - 1);
        return false;
      }

      page += 1;
    }

    return true;
  }

  /// Unmaps the first `pages` stack pages above the guard page at `base` and
  /// returns their frames to the PMM.
  function unmapStack(base: u64, pages: u64): void {
    let mut page: u64 = 1;

    while (page <= pages) {
      let address: u64 = base + page * PAGE_SIZE;
      let frame: u64 = Mm::Vmm::translate(address);

      Mm::Vmm::unmap(address);
      Mm::Pmm::freeFrame(frame);
      page += 1;
    }
  }

  /// A free slot above the idle thread, or `NO_THREAD`.
  function findFreeSlot(): u64 {
    let mut slot: u64 = FIRST_SPAWN_SLOT;

    while (slot < MAX_THREADS) {
      if ((*slotPointer(slot)).state == UNUSED) {
        return slot;
      }

      slot += 1;
    }

    return NO_THREAD;
  }

  /// The scratch area of the thread in `slot`.
  function scratchOf(slot: u64): *mut u8 {
    return @pointerFromInteger<*mut u8>((*slotPointer(slot)).scratch);
  }

  /// A pointer to the table entry of `slot`.
  function slotPointer(slot: u64): *mut Control {
    return tableBase() + slot;
  }

  /// A pointer to the first entry of the thread table.
  function tableBase(): *mut Control {
    return &mut ThreadState::threads as *mut Control;
  }

  /// Marks slot 0 as the running boot thread, id 0, and starts the id counter
  /// at 1. The boot thread already runs on Limine's stack, so it gets no
  /// stack of its own.
  function initializeBootThread(): void {
    if (MAX_THREADS * Arch::Fpu::STATE_SIZE != FPU_AREA_BYTES) {
      @panic("thread: the FPU save areas do not match MAX_THREADS");
    }

    let boot: *mut Control = slotPointer(BOOT_SLOT);

    (*boot).id = 0;
    (*boot).state = RUNNING;
    (*boot).scratch = @integerFromPointer(Mm::Heap::allocate(SCRATCH_BYTES, 16));

    if ((*boot).scratch == 0) {
      @panic("thread: no heap for the boot thread's scratch area");
    }

    resetFpuArea(BOOT_SLOT);

    // Every other slot's stack, once and for good (see "Thread Stacks").
    let mut slot: u64 = IDLE_SLOT;

    while (slot < MAX_THREADS) {
      if (!mapStack(STACK_REGION + slot * STACK_SPAN)) {
        @panic("thread: no memory for the thread stacks");
      }

      slot += 1;
    }

    ThreadState::nextId = 1;
  }
}
