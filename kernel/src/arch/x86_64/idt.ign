//!
//! # Interrupt Descriptor Table
//!
//! The table that maps each interrupt vector to the code that handles it.
//!
//! ## Overview
//!
//! The table holds 256 gates, one per vector, 16 bytes each (4096 bytes in
//! all). Every gate that has a handler points at one of the assembly thunks in
//! `interrupt_asm.S`, which share one dispatcher. The table itself is a
//! zero-initialized `static mut` in `.bss`, so every gate that is not filled
//! in is "not present" (P = 0).
//!
//! ## Gate Layout (64-bit interrupt gate, 16 bytes)
//!
//! ```text
//!   127            96 95            64 63      48 47 46 45 44 43  40 39 35 34 32 31      16 15       0
//!   ┌───────────────┬────────────────┬──────────┬──┬─────┬──┬──────┬─────┬─────┬──────────┬─────────┐
//!   │ reserved (0)  │ offset 63..32  │ offset   │P │ DPL │0 │ type │ 0   │ IST │ selector │ offset  │
//!   │               │                │ 31..16   │  │     │  │      │     │     │          │ 15..0   │
//!   └───────────────┴────────────────┴──────────┴──┴─────┴──┴──────┴─────┴─────┴──────────┴─────────┘
//!                       high qword                                  low qword
//!
//!   attributes byte (bits 47..40) = 0x8E: P=1, DPL=0, type 0xE
//!   type 0xE = interrupt gate: the CPU clears IF on entry
//!   type 0xF = trap gate: IF is left as it was (not used here)
//! ```
//!
//! - `offset` is the handler address (here the thunk), split in three parts.
//! - `selector` is a code segment selector, `0x08` (kernel code).
//! - `IST` is 0 for no stack switch, or 1 to 7 to switch to `TSS.ISTn`. Only
//!   the double fault gate sets it.
//! - `DPL` 0 means a software `int n` in ring 3 faults, so user code cannot
//!   fake a hardware interrupt.
//!
//! ## Vector Assignment
//!
//! | Vectors      | Source                                              |
//! |--------------|-----------------------------------------------------|
//! | 0-31         | CPU exceptions (see `interrupts.ign`)               |
//! | 32-47        | the 8259 range `0x20-0x2F`, which includes the keyboard at `0x21` through the IOAPIC |
//! | 48 (`0x30`)  | local APIC timer                                    |
//! | 255 (`0xFF`) | local APIC spurious interrupt                       |
//!
//! These 50 vectors (49 contiguous plus the spurious one) are the gates
//! `initialize` fills, and the boot log prints `idt: 50 gates loaded`. See
//! concept doc 04.

import _ from "./gdt";

/// Implemented in `interrupt_asm.S`: returns the entry address of the thunk
/// for `vector`, which must be 0 to 48 or 255.
extern IdtAsm {
  /// The entry address of the thunk for `vector`. Implemented in `interrupt_asm.S`.
  function ignis_interrupt_thunk(vector: u64): u64;
}

/// The 256 gates, 16 bytes each, in zero-initialized storage.
record IdtStorage {
  /// 4096 bytes: 256 gates of 16 bytes. All zero until `Arch::Idt::initialize` fills
  /// the gates that have a thunk.
  static mut GATES: u8[4096];
}

/// The operand of `lidt`: a 16-bit limit (offset of the last valid byte)
/// followed by the 64-bit linear address of the table. 10 bytes, packed.
@cLayout
@packed
record IdtPointer {
  /// Size of the table in bytes minus one.
  public limit: u16;

  /// Linear address of the first gate.
  public base: u64;
}

/// The IDT API. `initialize` is the only entry point the rest of the kernel uses.
namespace Arch::Idt {
  /// Number of vectors the processor can deliver.
  const GATE_COUNT: u64 = 256;

  /// Size of one gate in 64-bit mode.
  const GATE_SIZE: u64 = 16;

  /// Vectors 0-31 are exceptions, 32-47 the remapped PIC lines and the IOAPIC
  /// keyboard, and 48 the local APIC timer. Those and the local APIC spurious
  /// vector are the only vectors that have a thunk.
  const THUNK_COUNT: u64 = 49;

  /// Vector 8, the double fault, the only gate that uses an IST stack.
  const DOUBLE_FAULT: u64 = 8;

  /// Present, ring 0, 64-bit interrupt gate (interrupts stay off in the
  /// handler).
  const INTERRUPT_GATE: u64 = 0x8E;

  /// Fills the gates that have a thunk and loads the table. The kernel GDT
  /// must be loaded first, because the gates name its code selector and the
  /// double fault gate its IST slot. Every other gate stays not present.
  /// `spuriousVector` is the local APIC spurious vector, which has a gate of
  /// its own; the architecture code does not know the APIC, so the caller
  /// passes it in.
  function initialize(spuriousVector: u64): void {
    let selector: u64 = Arch::Gdt::kernelCode() as u64;
    let ist: u64 = Arch::Gdt::doubleFaultIst() as u64;

    // Vectors 0 to 48 are contiguous. The double fault gate alone uses IST1.
    let mut vector: u64 = 0;

    while (vector < THUNK_COUNT) {
      let stack: u64 = vector == DOUBLE_FAULT ? ist : 0;

      setGate(vector, IdtAsm::ignis_interrupt_thunk(vector), selector, stack, INTERRUPT_GATE);
      vector += 1;
    }

    // The spurious vector is far from the others, so it is installed on its own.
    setGate(spuriousVector, IdtAsm::ignis_interrupt_thunk(spuriousVector), selector, 0, INTERRUPT_GATE);

    let descriptor: IdtPointer = IdtPointer {
      limit: (GATE_COUNT * GATE_SIZE - 1) as u16,
      base: tableBase(),
    };

    // Limit is the size minus one: the last valid byte offset.
    asm (descriptor in mem) clobber(memory) { lidt {descriptor} }
  }

  /// Address of the gate table, as `lidt` and `setGate` need it.
  function tableBase(): u64 {
    return @integerFromPointer(&mut IdtStorage::GATES as *mut u8);
  }

  /// Writes one gate at index `vector`: the 16 bytes are two `u64` words,
  /// `low` and `high`.
  ///
  /// `low` packs the handler bits 15..0, the selector at bit 16, the IST number
  /// at bit 32, the attribute byte at bit 40 and the handler bits 31..16 at
  /// bit 48. `high` holds the handler bits 63..32. The parameters are runtime
  /// values so the shifts are 64-bit shifts.
  function setGate(vector: u64, handler: u64, selector: u64, ist: u64, attributes: u64): void {
    let table: *mut u64 = tableBase() as *mut u64;

    let low: u64 = (handler & 0xFFFF) | (selector << 16) | (ist << 32) | (attributes << 40) | (((handler >> 16) & 0xFFFF) << 48);
    let high: u64 = handler >> 32;

    @write<u64>(table + vector * 2, low);
    @write<u64>(table + vector * 2 + 1, high);
  }
}
