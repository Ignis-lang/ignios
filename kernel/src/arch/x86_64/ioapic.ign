//!
//! # I/O APIC
//!
//! The chip that receives device interrupt lines and turns each one into a
//! vector sent to a local APIC.
//!
//! ## Overview
//!
//! An IOAPIC has two memory-mapped registers: IOREGSEL at offset 0 takes the
//! index of an internal register, and IOWIN at offset 0x10 reads or writes it.
//! The internal registers are the id, the version (which also holds the
//! highest redirection entry number) and one 64-bit redirection entry per
//! input pin, split into a low and a high 32-bit register. An entry says
//! which vector the pin raises, whether the line is level or edge triggered
//! and active high or low, whether it is masked, and which local APIC gets
//! it. Pins are numbered by global system interrupt (GSI): each IOAPIC serves
//! a contiguous range starting at the GSI base the MADT gives it.
//!
//! `initialize` maps every IOAPIC the MADT lists, uncached, and masks all of
//! their entries. `routeIsa` then points one ISA interrupt line at a vector,
//! using the MADT interrupt source overrides for the GSI, polarity and
//! trigger. Everything is sent to the processor that runs the code (the
//! bootstrap processor), in physical destination mode.
//!
//! ## Register Access
//!
//! ```text
//!   page base + 0x00   IOREGSEL   write the index of the register you want
//!   page base + 0x10   IOWIN      then read or write its value here
//!
//!   index 0x00  ID           bits 27-24 = IOAPIC id
//!   index 0x01  version      bits 7-0 = version, bits 23-16 = highest entry number
//!   index 0x10 + 2n          redirection entry n, low 32 bits
//!   index 0x11 + 2n          redirection entry n, high 32 bits
//! ```
//!
//! ## Redirection Entry (64 bits)
//!
//! ```text
//!   63..56         55..17     16     15      14    13       12      11     10..8    7..0
//!   ┌──────────────┬────────┬──────┬───────┬─────┬────────┬───────┬──────┬────────┬────────┐
//!   │ destination  │ resvd  │ mask │trigger│ rIRR│polarity│status │ dest │delivery│ vector │
//!   │ (APIC id in  │        │ 1 =  │1=level│     │1=active│       │ mode │ mode   │        │
//!   │  bits 59-56) │        │masked│       │     │ low    │       │0=phys│000=fixed│       │
//!   └──────────────┴────────┴──────┴───────┴─────┴────────┴───────┴──────┴────────┴────────┘
//!      high register (offset 0x11 + 2n)             low register (offset 0x10 + 2n)
//! ```
//!
//! `route` writes the high register first and the low one second. The entry
//! starts masked (`initialize` masks every pin), and the low-register write
//! is the one that unmasks it, so the destination is already valid when the
//! pin goes live.
//!
//! ## Keyboard Example
//!
//! In the QEMU boot log: `ioapic: keyboard IRQ 1 -> GSI 1, vector 0x21, entry
//! 0x21`. The MADT has no override for IRQ 1, so GSI = 1; the entry has
//! vector `0x21` and every other bit clear: unmasked, edge, active high,
//! fixed delivery to physical APIC id 0.
//!
//! See concept doc 12 and the OSDev wiki page "IOAPIC".

import Acpi from "../../acpi";
import Lapic from "./lapic";
import Vmm from "../../vmm";

/// Per-chip data read once at start-up.
record IoapicState {
  /// Highest redirection entry number of each IOAPIC (the version register,
  /// bits 23-16). The count of entries is that plus one.
  static mut maxEntries: u8[8];

  /// Version byte of each IOAPIC (version register, bits 7-0).
  static mut versions: u8[8];
}

/// The IOAPIC API. Call `initialize`, then `routeIsa` for each device line.
export namespace Ioapic {
  /// Where the kernel maps the first IOAPIC page, then one page per further
  /// IOAPIC. It lies in the same higher-half region as the local APIC page.
  const MAPPING: u64 = 0xFFFFA00000010000;

  /// Size of the page mapped for each IOAPIC.
  const PAGE_SIZE: u64 = 4096;

  /// Offset of IOREGSEL from the start of the IOAPIC page.
  const SELECT_OFFSET: u64 = 0x00;

  /// Offset of IOWIN from the start of the IOAPIC page.
  const WINDOW_OFFSET: u64 = 0x10;

  /// Index of the id register.
  const ID_REGISTER: u32 = 0x00;

  /// Index of the version register.
  const VERSION_REGISTER: u32 = 0x01;

  /// Index of the low half of redirection entry 0. Entry `n` is at
  /// `0x10 + 2n` (low) and `0x11 + 2n` (high).
  const FIRST_REDIRECTION_REGISTER: u32 = 0x10;

  /// Redirection entry bit 16: the pin is masked and raises nothing.
  const MASKED: u32 = 0x10000;

  /// Redirection entry bit 13: the line is active low.
  const ACTIVE_LOW: u32 = 0x2000;

  /// Redirection entry bit 15: the line is level triggered.
  const LEVEL_TRIGGERED: u32 = 0x8000;

  /// Bit position of the destination APIC id in the high redirection
  /// register.
  const DESTINATION_SHIFT: u32 = 24;

  /// Returned by `routeIsa` when no IOAPIC serves the line.
  const NO_GSI: u32 = 0xFFFFFFFF;

  /// Maps and masks every IOAPIC in the MADT. The kernel page tables and the
  /// ACPI tables must be ready. Panics when a page cannot be mapped.
  function initialize(): void {
    let count: u64 = Acpi::ioapicCount();

    let mut index: u64 = 0;

    while (index < count) {
      let flags: u64 = Vmm::WRITABLE | Vmm::NO_EXECUTE | Vmm::UNCACHED;

      if (!Vmm::map(pageOf(index), Acpi::ioapicAddress(index), flags)) {
        @panic("ioapic: cannot map an IOAPIC page");
      }

      let version: u32 = readRegister(index, VERSION_REGISTER);

      @write<u8>((&mut IoapicState::versions as *mut u8) + index, (version & 0xFF) as u8);
      @write<u8>((&mut IoapicState::maxEntries as *mut u8) + index, ((version >> 16) & 0xFF) as u8);

      maskAll(index);
      index += 1;
    }
  }

  /// The id field of IOAPIC `index`.
  function id(index: u64): u32 {
    return readRegister(index, ID_REGISTER) >> DESTINATION_SHIFT;
  }

  /// The version of IOAPIC `index`.
  function version(index: u64): u8 {
    return *((&mut IoapicState::versions as *mut u8) + index);
  }

  /// How many redirection entries IOAPIC `index` has.
  function entryCount(index: u64): u64 {
    return (*((&mut IoapicState::maxEntries as *mut u8) + index) as u64) + 1;
  }

  /// Points ISA interrupt line `irq` at `vector` on this processor. The GSI,
  /// polarity and trigger mode come from the MADT override for that line, or
  /// are the ISA defaults (GSI equal to the line, active high, edge). Returns
  /// the GSI used, or 0xFFFFFFFF when no IOAPIC serves it.
  function routeIsa(irq: u8, vector: u8): u32 {
    let gsi: u32 = Acpi::isaIrqGsi(irq);
    let flags: u16 = Acpi::isaIrqFlags(irq);

    if (!route(gsi, vector, Acpi::flagsActiveLow(flags), Acpi::flagsLevelTriggered(flags))) {
      return NO_GSI;
    }

    return gsi;
  }

  /// Programs the redirection entry of `gsi` as an unmasked, fixed-delivery
  /// interrupt to this processor. Returns false when no IOAPIC serves `gsi`.
  function route(gsi: u32, vector: u8, activeLow: boolean, levelTriggered: boolean): boolean {
    let index: u64 = findIoapic(gsi);

    if (index == Acpi::ioapicCount()) {
      return false;
    }

    let pin: u32 = gsi - Acpi::ioapicGsiBase(index);

    let mut low: u32 = vector as u32;

    if (activeLow) {
      low |= ACTIVE_LOW;
    }

    if (levelTriggered) {
      low |= LEVEL_TRIGGERED;
    }

    writeRegister(index, FIRST_REDIRECTION_REGISTER + pin * 2 + 1, Lapic::id() << DESTINATION_SHIFT);
    writeRegister(index, FIRST_REDIRECTION_REGISTER + pin * 2, low);

    return true;
  }

  /// The raw 64-bit redirection entry of `gsi`, or zero when no IOAPIC
  /// serves it.
  function redirection(gsi: u32): u64 {
    let index: u64 = findIoapic(gsi);

    if (index == Acpi::ioapicCount()) {
      return 0;
    }

    let pin: u32 = gsi - Acpi::ioapicGsiBase(index);
    let low: u64 = readRegister(index, FIRST_REDIRECTION_REGISTER + pin * 2) as u64;
    let high: u64 = readRegister(index, FIRST_REDIRECTION_REGISTER + pin * 2 + 1) as u64;

    return (high << 32) | low;
  }

  /// The index of the IOAPIC whose GSI range holds `gsi`, or the IOAPIC
  /// count when none does.
  function findIoapic(gsi: u32): u64 {
    let count: u64 = Acpi::ioapicCount();

    let mut index: u64 = 0;

    while (index < count) {
      let base: u64 = Acpi::ioapicGsiBase(index) as u64;

      if ((gsi as u64) >= base && (gsi as u64) < base + entryCount(index)) {
        return index;
      }

      index += 1;
    }

    return count;
  }

  /// Masks every redirection entry of IOAPIC `index`, so no pin raises an
  /// interrupt until `route` programs it.
  function maskAll(index: u64): void {
    let entries: u64 = entryCount(index);

    let mut pin: u64 = 0;

    while (pin < entries) {
      writeRegister(index, FIRST_REDIRECTION_REGISTER + (pin as u32) * 2, MASKED);
      pin += 1;
    }
  }

  /// The virtual address of the page mapped for IOAPIC `index`.
  function pageOf(index: u64): u64 {
    return MAPPING + index * PAGE_SIZE;
  }

  /// Reads the internal register `register` of IOAPIC `index`: select it, then
  /// read the window. Both accesses are volatile and must stay in this order.
  function readRegister(index: u64, register: u32): u32 {
    @writeVolatile<u32>(@pointerFromInteger<*mut u32>(pageOf(index) + SELECT_OFFSET), register);

    return @readVolatile<u32>(@pointerFromInteger<*mut u32>(pageOf(index) + WINDOW_OFFSET));
  }

  /// Writes `value` to the internal register `register` of IOAPIC `index`.
  function writeRegister(index: u64, register: u32, value: u32): void {
    @writeVolatile<u32>(@pointerFromInteger<*mut u32>(pageOf(index) + SELECT_OFFSET), register);
    @writeVolatile<u32>(@pointerFromInteger<*mut u32>(pageOf(index) + WINDOW_OFFSET), value);
  }
}
