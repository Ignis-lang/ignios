//!
//! # Processor Control
//!
//! Thin wrappers over the privileged instructions the kernel needs: interrupt
//! flag control, halting, model specific registers and control registers.
//!
//! ## Overview
//!
//! Every function is a short inline `asm` block. Interrupt-disabled sections
//! are the kernel's only mutual exclusion, because it runs on one processor:
//! when interrupts are off nothing can preempt the running code. Sections
//! nest by saving the previous state:
//!
//! ```text
//!   let saved = Arch::Cpu::saveAndDisableInterrupts();   // pushfq; pop; cli
//!       ... critical section ...
//!       let inner = Arch::Cpu::saveAndDisableInterrupts();   // nested: saved IF = 0
//!       Arch::Cpu::restoreInterrupts(inner);                 // IF stays off
//!   Arch::Cpu::restoreInterrupts(saved);                     // IF back as it was
//! ```
//!
//! ## Registers Touched
//!
//! | Register           | Bit / number | Meaning                                       |
//! |--------------------|--------------|-----------------------------------------------|
//! | RFLAGS             | bit 9 (`0x200`) | IF, maskable interrupts enabled            |
//! | MSR                | number in ECX | read with `rdmsr` into EDX:EAX, write with `wrmsr` |
//! | CR0                | -            | protection and paging control (WP is bit 16)   |
//! | CR2                | -            | faulting address of a page fault (read in `trap/exception.ign`) |
//! | CR3                | -            | physical address of the PML4 in bits 12-51     |
//! | CR4                | -            | architecture extensions (OSFXSR, SMEP, SMAP, ...) |
//!
//! The MSRs used elsewhere: `IA32_APIC_BASE` (`0x1B`), `IA32_PAT` (`0x277`),
//! `IA32_EFER` (`0xC0000080`), `IA32_STAR` (`0xC0000081`), `IA32_LSTAR`
//! (`0xC0000082`) and `IA32_FMASK` (`0xC0000084`). See concept doc 02 and
//! Intel SDM Vol. 3A, "System Architecture Overview".

/// The processor control API.
namespace Arch::Cpu {
  /// RFLAGS bit 9, the interrupt-enable flag.
  const FLAGS_INTERRUPT_ENABLE: u64 = 0x200;

  /// Disables interrupts and parks the processor for good. The `cli; hlt` pair
  /// sits in a loop because a non-maskable interrupt or a system management
  /// interrupt can still wake the processor from `hlt`.
  function haltForever(): never {
    while (true) {
      asm () clobber(memory) {
        cli
        hlt
      }
    }
  }

  /// Lets maskable interrupts through from the next instruction on (`sti`; the
  /// interrupt shadow means the instruction after `sti` always runs first).
  function enableInterrupts(): void {
    asm () clobber(memory) { sti }
  }

  /// Masks maskable interrupts (`cli`). NMIs are not affected.
  function disableInterrupts(): void {
    asm () clobber(memory) { cli }
  }

  /// Reads RFLAGS.IF, the interrupt-enable flag.
  function interruptsEnabled(): boolean {
    return (readFlags() & FLAGS_INTERRUPT_ENABLE) != 0;
  }

  /// Disables interrupts and returns the previous RFLAGS, for
  /// `restoreInterrupts`. This opens an interrupt-disabled critical section
  /// that can nest: each section gives back only what it found.
  function saveAndDisableInterrupts(): u64 {
    return asm () -> (flags: u64 in rax) clobber(memory) {
      pushfq
      pop {flags}
      cli
    };
  }

  /// Ends a critical section: interrupts come back on only if they were on
  /// when `saveAndDisableInterrupts` returned `saved`.
  function restoreInterrupts(saved: u64): void {
    if ((saved & FLAGS_INTERRUPT_ENABLE) != 0) {
      enableInterrupts();
    }
  }

  /// Reads RFLAGS (`pushfq; pop`).
  function readFlags(): u64 {
    return asm () -> (flags: u64 in rax) {
      pushfq
      pop {flags}
    };
  }

  /// Enables interrupts and halts until one arrives. `sti` takes effect
  /// after the following instruction, so an interrupt that was pending
  /// cannot slip in between and leave the processor halted with work
  /// queued: it wakes the `hlt`.
  function waitForInterrupt(): void {
    asm () clobber(memory) {
      sti
      hlt
    }
  }

  /// Tells the processor it is spinning in a busy-wait loop, which saves
  /// power and avoids a memory-order pipeline flush when the loop exits.
  function pause(): void {
    asm () { pause }
  }

  /// Reads the model specific register `msr` with `rdmsr`: the number goes in
  /// ECX and the 64-bit result comes back split in EDX (high half) and EAX (low
  /// half). Faults with `#GP` for a register the processor does not have.
  function readMsr(msr: u32): u64 {
    asm (msr in ecx) -> (low: u32 in eax, high: u32 in edx) {
      rdmsr
    }

    return ((high as u64) << 32) | (low as u64);
  }

  /// Writes `value` to the model specific register `msr` with `wrmsr`
  /// (ECX = number, EDX:EAX = value). Faults with `#GP` for an unknown register
  /// or a reserved bit set.
  function writeMsr(msr: u32, value: u64): void {
    let low: u32 = value as u32;
    let high: u32 = (value >> 32) as u32;

    asm (msr in ecx, low in eax, high in edx) clobber(memory) {
      wrmsr
    }
  }

  /// Reads control register 0.
  function readCr0(): u64 {
    return asm () -> (value: u64 in rax) { mov {value}, cr0 };
  }

  /// Writes control register 0. `Mm::Vmm::initialize` uses it to set WP (bit 16).
  function writeCr0(value: u64): void {
    asm (value in rax) clobber(memory) { mov cr0, {value} }
  }

  /// Reads control register 3: the physical address of the active PML4.
  function readCr3(): u64 {
    return asm () -> (value: u64 in rax) { mov {value}, cr3 };
  }

  /// Loads a new top-level page table. Every translation that is not global
  /// is dropped from the TLB.
  function writeCr3(value: u64): void {
    asm (value in rax) clobber(memory) { mov cr3, {value} }
  }

  /// Reads control register 4.
  function readCr4(): u64 {
    return asm () -> (value: u64 in rax) { mov {value}, cr4 };
  }

  /// Writes control register 4. Setting a bit for a feature the processor
  /// does not have raises `#GP`, so callers check CPUID first.
  function writeCr4(value: u64): void {
    asm (value in rax) clobber(memory) { mov cr4, {value} }
  }

  /// EAX of CPUID leaf 0: the highest basic leaf the processor answers.
  function cpuidMaxLeaf(): u32 {
    let mut leaf: u32 = 0;
    let mut subleaf: u32 = 0;

    asm (leaf inout eax, subleaf inout ecx) clobber(rbx, rdx) { cpuid }

    return leaf;
  }

  /// EBX of CPUID leaf `leaf`, subleaf `subleaf`. The caller checks
  /// `cpuidMaxLeaf` first: a leaf above it returns the data of the highest
  /// leaf on Intel processors, not zeros.
  function cpuidEbx(leaf: u32, subleaf: u32): u32 {
    let mut a: u32 = leaf;
    let mut c: u32 = subleaf;

    return asm (a inout eax, c inout ecx) -> (b: u32 in ebx) clobber(rdx) { cpuid };
  }

  /// Drops the TLB entry of the page containing `address`.
  function invalidatePage(address: u64): void {
    asm (address in rax) clobber(memory) { invlpg [{address}] }
  }
}
