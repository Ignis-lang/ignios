//! Access to physical memory through Limine's higher half direct map, which
//! maps physical address `p` at `offset + p`. The kernel's own page tables
//! keep the same offset, so these pointers stay valid across the CR3 switch.

import Limine from "./limine";

export namespace Hhdm {
  /// The virtual address of physical address zero.
  function offset(): u64 {
    let response: *mut Limine::HhdmResponse = Limine::hhdm();

    if (response == null) {
      @panic("Limine provided no higher half direct map");
    }

    return (*response).offset;
  }

  /// A pointer to physical address `physical`. The address must lie in a
  /// region the direct map covers.
  function toVirtual(physical: u64): *mut u8 {
    return @pointerFromInteger<*mut u8>(offset() + physical);
  }
}
