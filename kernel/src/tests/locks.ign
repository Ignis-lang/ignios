//!
//! # Lock Self-Test
//!
//! Checks the lock primitives on one CPU with preemption on.
//!
//! ## Overview
//!
//! | Check              | What it proves                                                  |
//! |--------------------|-----------------------------------------------------------------|
//! | irq variant        | `lockIrq` turns interrupts off and `unlockIrq` restores them   |
//! | no preemption      | with a spinlock held across more than a time slice, no thread switch happens, and one happens soon after the release |
//! | mutual exclusion   | three threads add 1 to a counter three times each, waiting more than a time slice between the read and the write: the total is 9 |
//! | ranks              | while a lock of rank 20 is held, ranks 10 and 20 are refused and 30 is allowed; only the last lock taken may be released; a free lock may not be; after the release everything is allowed again; `canSleep` needs exactly one lock taken with `lockIrq`; `releaseUnder` and `holdsOnlyRunQueue`, the rules of the scheduler's lock hand-over |
//! | mutex              | a contender sleeps on a mutex its holder keeps while sleeping, and gets it only after the holder is done, and may not release it meanwhile; mutex ranks and release order; no mutex under a spinlock |
//!
//! The rank and release checks of `lock` and `unlock` panic through the
//! predicates the test calls (`rankAllows`, `releaseAllowed`, `canLock`,
//! `unlockAllowed`), so a broken predicate fails the test. The panics
//! themselves cannot run at boot without stopping it.
//! | wait queue         | three threads sleep on a queue; an interrupt (what `kill` does) does not wake them; `wakeAll` wakes all three |
//! | scratch            | two threads fill their system call scratch areas, yield, and find their own bytes |
//! | wake tokens        | a wake sent before a park, and an interrupt sent before a 10000 s sleep, end the wait at once |
//! | VFS lock           | a file operation started while another thread holds the VFS lock waits for it |
//!
//! The mutual exclusion check stretches each critical section past a time
//! slice, so a tick that would switch threads falls inside it: without the
//! lock the threads interleave and lose updates. On one CPU the preemption
//! counter alone already keeps them apart; the `xchg` itself is only
//! exercised by contention on several CPUs (phase C3 of the concurrency
//! proposal).

import Arch from "@arch";
import Drivers from "@drivers";
import Fs from "@fs";
import Lib from "@lib";
import Sched from "@sched";
import Time from "@time";

/// The state the threads share.
record LocksTestState {
  /// The lock of the counter, rank 20.
  static mut counterLock: Arch::SpinLock;

  /// A second lock, rank 30, for the rank checks.
  static mut innerLock: Arch::SpinLock;

  /// The counter the workers add to.
  static mut counter: u64;

  /// Set to 1 to stop the helper thread.
  static mut stop: u64;

  /// The mutex of the blocking check, rank 50.
  static mut mutex: Sched::Mutex;

  /// 1 while the holder thread holds the mutex.
  static mut holding: u64;

  /// 1 once the holder saw a waiter queued on the mutex.
  static mut queuedSeen: u64;

  /// 1 once the holder finished its section.
  static mut holderDone: u64;

  /// What the contender saw of `holderDone` once it had the mutex.
  static mut contenderSaw: u64;

  /// Per scratch worker: 1 once its area still held its own pattern after
  /// every round.
  static mut scratchIntact: u64[2];

  /// Per scratch worker: the address of its scratch area.
  static mut scratchAddress: u64[2];

  /// Set by the boot thread once the token worker may wait.
  static mut tokenGo: u64;

  /// Set by the token worker once its wait returned.
  static mut tokenDone: u64;

  /// Set by the VFS worker once its file operation returned.
  static mut vfsDone: u64;

  /// 1 when the contender was allowed to release the holder's mutex.
  static mut contenderCouldUnlock: u64;

  /// A second mutex, rank 60, for the release order check.
  static mut outerMutex: Sched::Mutex;

  /// A mutex of the same rank as `mutex`, which the contender holds while it
  /// asks whether it may release `mutex`: the rank rule then allows it, so
  /// only the owner check can refuse.
  static mut twinMutex: Sched::Mutex;

  /// The spinlock of the wait queue check, rank 40.
  static mut queueLock: Arch::SpinLock;

  /// The queue of the wait queue check.
  static mut queue: Sched::WaitQueue;

  /// The condition the queued threads wait for.
  static mut released: u64;

  /// How many times a queued thread came back from `sleepOn`.
  static mut wakeUps: u64;

  /// How many queued threads got past the wait.
  static mut passed: u64;
}

namespace Tests::Locks {
  /// Rank of `counterLock`.
  const COUNTER_RANK: u64 = 20;

  /// Rank of `innerLock`.
  const INNER_RANK: u64 = 30;

  /// Rank of the test mutex.
  const MUTEX_RANK: u64 = 50;

  /// Rank of the wait queue's spinlock.
  const QUEUE_RANK: u64 = 40;

  /// Workers of the mutual exclusion check.
  const WORKERS: u64 = 3;

  /// Increments per worker.
  const ROUNDS: u64 = 3;

  /// Ticks past a time slice that a critical section lasts.
  const STRETCH: u64 = 2;

  /// Runs every check and prints one line. Panics on the first failure.
  /// Leaves the interrupt flag as it found it: the boot steps after it (the
  /// PS/2 setup) expect interrupts off.
  function run(): void {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();

    Arch::Spin::initialize(counterLock(), COUNTER_RANK);
    Arch::Spin::initialize(innerLock(), INNER_RANK);

    checkIrq();
    checkRanks();

    let deferred: u64 = checkNoPreemption();

    checkMutualExclusion();
    checkMutex();
    checkWaitQueue();
    checkScratch();
    checkTokens();
    checkVfsLock();

    // The checks turned interrupts on. `restoreInterrupts` only turns them
    // back on when they were on, so they go off first.
    Arch::Cpu::disableInterrupts();
    Arch::Cpu::restoreInterrupts(saved);

    Drivers::Console::write("locks: spinlock self-test ok, interrupts restored, ");
    Drivers::Console::writeDecimal(deferred);
    Drivers::Console::writeLine(" switches deferred while a lock was held, no lost update, rank order enforced");
    Drivers::Console::writeLine("locks: mutex and wait queue self-test ok, a contender slept until the holder was done, three waiters woke together and a kill did not wake them");
    Drivers::Console::writeLine("locks: scratch self-test ok, two threads kept their own system call scratch across switches");
    Drivers::Console::writeLine("locks: wake token self-test ok, a wake before a park and a kill before a 10000 s sleep were not lost");
    Drivers::Console::writeLine("locks: vfs self-test ok, a file operation waited while another thread held the VFS lock");
  }

  /// Holds the VFS lock while a helper thread removes a file: the helper
  /// must not finish until the lock is let go.
  function checkVfsLock(): void {
    LocksTestState::vfsDone = 0;
    Fs::Vfs::lock();

    let worker: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(vfsWorker), 0);

    Sched::Scheduler::sleep(5);

    let doneWhileHeld: u64 = @readVolatile<u64>(&mut LocksTestState::vfsDone as *mut u64);

    Fs::Vfs::unlock();
    Sched::Scheduler::join(worker);

    if (doneWhileHeld != 0 || LocksTestState::vfsDone != 1) {
      @panic("locks self-test: a file operation ran while another thread held the VFS lock");
    }
  }

  /// Removes a file that does not exist, which takes the VFS lock.
  function vfsWorker(argument: u64): void {
    let status: u64 = Fs::Files::remove(Fs::Vfs::root(), "/no-such-file" as *u8, 13, false);

    if (status != Fs::Vfs::NOT_FOUND) {
      @panic("locks self-test: the VFS worker's remove failed");
    }

    @writeVolatile<u64>(&mut LocksTestState::vfsDone as *mut u64, 1);
  }

  /// A wake that lands before the park, and an interrupt (what `kill` does)
  /// that lands before a 10000 s sleep, must each end the wait at once. A
  /// lost one is rescued with a second wake or interrupt, then fails the
  /// test, so a broken token cannot hang the boot.
  function checkTokens(): void {
    checkToken(Arch::ContextAsm::ignis_function_address(tokenParker), true);
    checkToken(Arch::ContextAsm::ignis_function_address(tokenSleeper), false);
  }

  /// Starts `entry`, sends it a wake or an interrupt while it is still
  /// ready, lets it wait, and checks that it was done within a few ticks.
  function checkToken(entry: u64, wake: boolean): void {
    LocksTestState::tokenGo = 0;
    LocksTestState::tokenDone = 0;

    let worker: u64 = Sched::Scheduler::spawn(entry, 0);

    if (wake) {
      Sched::Scheduler::wake(worker);
    } else {
      Sched::Scheduler::interrupt(worker);
    }

    @writeVolatile<u64>(&mut LocksTestState::tokenGo as *mut u64, 1);
    Sched::Scheduler::sleep(5);

    let done: u64 = @readVolatile<u64>(&mut LocksTestState::tokenDone as *mut u64);

    if (done == 0) {
      if (wake) {
        Sched::Scheduler::wake(worker);
      } else {
        Sched::Scheduler::interrupt(worker);
      }
    }

    Sched::Scheduler::join(worker);

    if (done == 0) {
      @panic("locks self-test: a wake or a kill that came before the wait was lost");
    }
  }

  /// Waits for `tokenGo`, then parks.
  function tokenParker(argument: u64): void {
    while (@readVolatile<u64>(&mut LocksTestState::tokenGo as *mut u64) == 0) {
      Sched::Scheduler::yield();
    }

    Sched::Scheduler::park();
    @writeVolatile<u64>(&mut LocksTestState::tokenDone as *mut u64, 1);
  }

  /// Waits for `tokenGo`, then sleeps 10000 s.
  function tokenSleeper(argument: u64): void {
    while (@readVolatile<u64>(&mut LocksTestState::tokenGo as *mut u64) == 0) {
      Sched::Scheduler::yield();
    }

    Sched::Scheduler::sleep(1000000);
    @writeVolatile<u64>(&mut LocksTestState::tokenDone as *mut u64, 1);
  }

  /// Two threads fill their scratch areas with different patterns, yield
  /// between filling and checking, and check every byte: what a system call
  /// that blocks halfway needs, since another thread runs system calls
  /// meanwhile.
  function checkScratch(): void {
    let mut index: u64 = 0;

    while (index < 2) {
      *(&mut LocksTestState::scratchIntact as *mut u64 + index) = 0;
      index += 1;
    }

    let first: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(scratchWorker), 0);
    let second: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(scratchWorker), 1);

    Sched::Scheduler::join(first);
    Sched::Scheduler::join(second);

    let intact: *mut u64 = &mut LocksTestState::scratchIntact as *mut u64;
    let address: *mut u64 = &mut LocksTestState::scratchAddress as *mut u64;

    if (*intact != 1 || *(intact + 1) != 1 || *address == *(address + 1)) {
      @panic("locks self-test: two threads shared a system call scratch area");
    }
  }

  /// Fills the running thread's scratch area with `0x40 + index`, yields,
  /// and checks it, three times.
  function scratchWorker(index: u64): void {
    let area: *mut u8 = Sched::Scheduler::scratch();
    let pattern: u8 = (0x40 + index) as u8;
    let mut intact: u64 = 1;
    let mut round: u64 = 0;

    *(&mut LocksTestState::scratchAddress as *mut u64 + index) = @integerFromPointer(area);

    while (round < 3) {
      Lib::Mem::fill(area, pattern as i32, Sched::Thread::SCRATCH_BYTES);
      Sched::Scheduler::yield();

      let mut offset: u64 = 0;

      while (offset < Sched::Thread::SCRATCH_BYTES) {
        if (*(area + offset) != pattern) {
          intact = 0;
        }

        offset += 1;
      }

      round += 1;
    }

    *(&mut LocksTestState::scratchIntact as *mut u64 + index) = intact;
  }

  /// `lockIrq` and `unlockIrq`.
  function checkIrq(): void {
    Arch::Cpu::enableInterrupts();
    Arch::Spin::lockIrq(counterLock());

    if (Arch::Cpu::interruptsEnabled() || !Arch::Spin::holdsAny()) {
      @panic("locks self-test: lockIrq left interrupts on or the lock not counted");
    }

    Arch::Spin::unlockIrq(counterLock());

    if (!Arch::Cpu::interruptsEnabled() || Arch::Spin::holdsAny()) {
      @panic("locks self-test: unlockIrq did not restore interrupts or the count");
    }
  }

  /// The rank rule.
  function checkRanks(): void {
    Arch::Spin::lock(counterLock());

    if (Arch::Spin::rankAllows(10) || Arch::Spin::rankAllows(COUNTER_RANK) || !Arch::Spin::rankAllows(INNER_RANK)) {
      @panic("locks self-test: the rank check let a lower rank in, or kept a higher one out");
    }

    Arch::Spin::lock(innerLock());

    if (Arch::Spin::releaseAllowed(counterLock()) || !Arch::Spin::releaseAllowed(innerLock())) {
      @panic("locks self-test: the release order check is wrong");
    }

    Arch::Spin::unlock(innerLock());

    if (!Arch::Spin::releaseAllowed(counterLock())) {
      @panic("locks self-test: the last lock taken could not be released");
    }

    Arch::Spin::unlock(counterLock());

    if (!Arch::Spin::rankAllows(10) || Arch::Spin::releaseAllowed(counterLock())) {
      @panic("locks self-test: ranks stayed taken, or a free lock could be released");
    }

    // sleepOn needs its spinlock taken with lockIrq, and no other one.
    Arch::Cpu::enableInterrupts();
    Arch::Spin::lock(counterLock());

    let sleepWithInterrupts: boolean = Sched::Wait::canSleep();

    Arch::Spin::unlock(counterLock());
    Arch::Spin::lockIrq(counterLock());

    let sleepWithIrqLock: boolean = Sched::Wait::canSleep();

    Arch::Spin::lockIrq(innerLock());

    let sleepWithTwo: boolean = Sched::Wait::canSleep();

    Arch::Spin::unlockIrq(innerLock());
    Arch::Spin::unlockIrq(counterLock());

    if (sleepWithInterrupts || !sleepWithIrqLock || sleepWithTwo) {
      @panic("locks self-test: canSleep allowed a sleep that could lose its wake-up");
    }

    checkHandOver();
  }

  /// Holds a spinlock for more than a time slice while a helper thread wants
  /// the processor: no switch may happen. Returns the deferred switches.
  function checkNoPreemption(): u64 {
    LocksTestState::stop = 0;

    let helper: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(helperLoop), 0);
    let deferredBefore: u64 = Sched::Scheduler::deferredCount();

    Arch::Cpu::enableInterrupts();
    Arch::Spin::lock(counterLock());

    let switches: u64 = Sched::Scheduler::switchCount();

    waitTicks(Sched::Scheduler::TIME_SLICE_TICKS + STRETCH);

    let switchedWhileHeld: boolean = Sched::Scheduler::switchCount() != switches;

    Arch::Spin::unlock(counterLock());

    if (switchedWhileHeld) {
      @panic("locks self-test: a thread switch happened while a spinlock was held");
    }

    let deferred: u64 = Sched::Scheduler::deferredCount() - deferredBefore;

    if (deferred == 0) {
      @panic("locks self-test: no switch was deferred, the check did not cover a slice end");
    }

    waitTicks(2);

    if (Sched::Scheduler::switchCount() == switches) {
      @panic("locks self-test: no switch happened after the spinlock was released");
    }

    @writeVolatile<u64>(&mut LocksTestState::stop as *mut u64, 1);
    Sched::Scheduler::join(helper);

    return deferred;
  }

  /// Three workers increment the counter under the lock.
  function checkMutualExclusion(): void {
    LocksTestState::counter = 0;

    let first: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(worker), 0);
    let mut index: u64 = 1;

    while (index < WORKERS) {
      Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(worker), index);
      index += 1;
    }

    index = 0;

    while (index < WORKERS) {
      Sched::Scheduler::join(first + index);
      index += 1;
    }

    if (LocksTestState::counter != WORKERS * ROUNDS) {
      Drivers::Console::write("locks self-test: counter ");
      Drivers::Console::writeDecimal(LocksTestState::counter);
      Drivers::Console::writeLine("");
      @panic("locks self-test: an update was lost under the spinlock");
    }
  }

  /// A holder takes the mutex and sleeps with it; a contender must sleep on
  /// the mutex until the holder is done. Then the rank rules of mutexes.
  function checkMutex(): void {
    Sched::Mutex::initialize(mutex(), MUTEX_RANK);
    Sched::Mutex::initialize(twinMutex(), MUTEX_RANK);
    LocksTestState::holding = 0;
    LocksTestState::queuedSeen = 0;
    LocksTestState::holderDone = 0;
    LocksTestState::contenderSaw = 0;
    LocksTestState::contenderCouldUnlock = 0;

    let holder: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(mutexHolder), 0);
    let contender: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(mutexContender), 0);

    Sched::Scheduler::join(holder);
    Sched::Scheduler::join(contender);

    if (LocksTestState::queuedSeen != 1) {
      @panic("locks self-test: the contender did not sleep on the mutex");
    }

    if (LocksTestState::contenderSaw != 1) {
      @panic("locks self-test: the contender got the mutex while the holder held it");
    }

    if (LocksTestState::contenderCouldUnlock != 0) {
      @panic("locks self-test: a thread was allowed to release a mutex it does not hold");
    }

    Sched::Mutex::lock(mutex());
    Sched::Mutex::initialize(outerMutex(), MUTEX_RANK + 10);
    Sched::Mutex::lock(outerMutex());

    if (Sched::Mutex::unlockAllowed(mutex()) || !Sched::Mutex::unlockAllowed(outerMutex())) {
      @panic("locks self-test: the mutex release order check is wrong");
    }

    Sched::Mutex::unlock(outerMutex());

    if (Sched::Mutex::canLock(MUTEX_RANK - 10) || Sched::Mutex::canLock(MUTEX_RANK) || !Sched::Mutex::canLock(MUTEX_RANK + 10) || !Sched::Mutex::isHeldByCaller(mutex())) {
      @panic("locks self-test: the mutex rank rule is wrong");
    }

    Sched::Mutex::unlock(mutex());
    Arch::Spin::lock(counterLock());

    if (Sched::Mutex::canLock(MUTEX_RANK)) {
      @panic("locks self-test: a mutex could be taken while a spinlock is held");
    }

    Arch::Spin::unlock(counterLock());
  }

  /// Takes the mutex, sleeps 3 ticks holding it, checks that the contender
  /// queued meanwhile, and releases it.
  function mutexHolder(argument: u64): void {
    Sched::Mutex::lock(mutex());
    @writeVolatile<u64>(&mut LocksTestState::holding as *mut u64, 1);
    Sched::Scheduler::sleep(3);

    if (!Sched::Wait::isEmpty(&mut (*mutex()).waiters as *mut Sched::WaitQueue)) {
      LocksTestState::queuedSeen = 1;
    }

    LocksTestState::holderDone = 1;
    Sched::Mutex::unlock(mutex());
  }

  /// Waits until the holder has the mutex, then takes it.
  function mutexContender(argument: u64): void {
    while (@readVolatile<u64>(&mut LocksTestState::holding as *mut u64) == 0) {
      Sched::Scheduler::yield();
    }

    Sched::Mutex::lock(twinMutex());

    if (Sched::Mutex::unlockAllowed(mutex())) {
      LocksTestState::contenderCouldUnlock = 1;
    }

    Sched::Mutex::unlock(twinMutex());

    Sched::Mutex::lock(mutex());
    LocksTestState::contenderSaw = LocksTestState::holderDone;
    Sched::Mutex::unlock(mutex());
  }

  /// Three threads sleep on a queue. A kill-style interrupt must not wake
  /// them; `wakeAll` wakes all three.
  function checkWaitQueue(): void {
    Arch::Spin::initialize(queueLock(), QUEUE_RANK);
    LocksTestState::queue.head = 0;
    LocksTestState::queue.tail = 0;
    LocksTestState::released = 0;
    LocksTestState::wakeUps = 0;
    LocksTestState::passed = 0;

    let first: u64 = Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(queueWaiter), 0);

    Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(queueWaiter), 1);
    Sched::Scheduler::spawn(Arch::ContextAsm::ignis_function_address(queueWaiter), 2);
    Sched::Scheduler::sleep(3);

    Sched::Scheduler::interrupt(first);
    Sched::Scheduler::sleep(3);

    if (LocksTestState::wakeUps != 0 || LocksTestState::passed != 0) {
      @panic("locks self-test: an interrupt woke a thread queued on a wait queue");
    }

    Arch::Spin::lockIrq(queueLock());
    LocksTestState::released = 1;

    let woken: u64 = Sched::Wait::wakeAll(queue());

    Arch::Spin::unlockIrq(queueLock());

    Sched::Scheduler::join(first);
    Sched::Scheduler::join(first + 1);
    Sched::Scheduler::join(first + 2);

    if (woken != 3 || LocksTestState::passed != 3) {
      @panic("locks self-test: wakeAll did not wake every queued thread");
    }
  }

  /// Sleeps on the queue until `released`.
  function queueWaiter(argument: u64): void {
    Arch::Spin::lockIrq(queueLock());

    while (LocksTestState::released == 0) {
      Sched::Wait::sleepOn(queue(), queueLock());
      LocksTestState::wakeUps += 1;
    }

    LocksTestState::passed += 1;
    Arch::Spin::unlockIrq(queueLock());
  }

  /// `LocksTestState::mutex`.
  function mutex(): *mut Sched::Mutex {
    return &mut LocksTestState::mutex as *mut Sched::Mutex;
  }

  /// The two rules the scheduler's lock hand-over rests on: `releaseUnder`
  /// lets only the lock taken right before the last one go, after which the
  /// last one ranks as if taken alone; and a switch needs the run queue lock
  /// and no other spinlock (`holdsOnlyRunQueue`). Leaves interrupts as it
  /// found them.
  function checkHandOver(): void {
    let wasOn: boolean = Arch::Cpu::interruptsEnabled();

    Arch::Cpu::disableInterrupts();
    Arch::Spin::lock(counterLock());
    Arch::Spin::lock(innerLock());

    let underWrongOrder: boolean = Arch::Spin::releaseUnderAllowed(innerLock(), counterLock());
    let underRightOrder: boolean = Arch::Spin::releaseUnderAllowed(counterLock(), innerLock());

    Arch::Spin::releaseUnder(counterLock(), innerLock());

    let underReleased: boolean = LocksTestState::counterLock.locked == 0 && Arch::CpuLocal::preemptCount() == 1;

    Arch::Spin::unlock(innerLock());

    let allReleased: boolean = !Arch::Spin::holdsAny() && Arch::Spin::rankAllows(10);

    if (underWrongOrder || !underRightOrder || !underReleased || !allReleased) {
      @panic("locks self-test: releaseUnder broke the rank chain");
    }

    Arch::Spin::lock(counterLock());
    Sched::Scheduler::lockRunQueue();

    let switchWithOther: boolean = Sched::Scheduler::holdsOnlyRunQueue();

    Sched::Scheduler::unlockRunQueue();
    Arch::Spin::unlock(counterLock());
    Sched::Scheduler::lockRunQueue();

    let switchAlone: boolean = Sched::Scheduler::holdsOnlyRunQueue();

    Sched::Scheduler::unlockRunQueue();

    if (wasOn) {
      Arch::Cpu::enableInterrupts();
    }

    if (switchWithOther || !switchAlone) {
      @panic("locks self-test: a switch was allowed with another spinlock held");
    }
  }

  /// `LocksTestState::twinMutex`.
  function twinMutex(): *mut Sched::Mutex {
    return &mut LocksTestState::twinMutex as *mut Sched::Mutex;
  }

  /// `LocksTestState::outerMutex`.
  function outerMutex(): *mut Sched::Mutex {
    return &mut LocksTestState::outerMutex as *mut Sched::Mutex;
  }

  /// `LocksTestState::queueLock`.
  function queueLock(): *mut Arch::SpinLock {
    return &mut LocksTestState::queueLock as *mut Arch::SpinLock;
  }

  /// `LocksTestState::queue`.
  function queue(): *mut Sched::WaitQueue {
    return &mut LocksTestState::queue as *mut Sched::WaitQueue;
  }

  /// A worker: read, wait past a time slice, write, `ROUNDS` times.
  function worker(index: u64): void {
    let mut round: u64 = 0;

    while (round < ROUNDS) {
      Arch::Spin::lock(counterLock());

      let value: u64 = @readVolatile<u64>(&mut LocksTestState::counter as *mut u64);

      waitTicks(Sched::Scheduler::TIME_SLICE_TICKS + STRETCH);
      @writeVolatile<u64>(&mut LocksTestState::counter as *mut u64, value + 1);
      Arch::Spin::unlock(counterLock());
      round += 1;
    }
  }

  /// Spins until `stop`, so there is always a thread that wants the
  /// processor.
  function helperLoop(argument: u64): void {
    while (@readVolatile<u64>(&mut LocksTestState::stop as *mut u64) == 0) {
      Arch::Cpu::pause();
    }
  }

  /// Waits, with interrupts on and without giving up the processor, until
  /// `ticks` timer ticks have passed.
  function waitTicks(ticks: u64): void {
    let end: u64 = Time::Timer::ticks() + ticks;

    Arch::Cpu::enableInterrupts();

    while (Time::Timer::ticks() < end) {
      Arch::Cpu::pause();
    }
  }

  /// `LocksTestState::counterLock`.
  function counterLock(): *mut Arch::SpinLock {
    return &mut LocksTestState::counterLock as *mut Arch::SpinLock;
  }

  /// `LocksTestState::innerLock`.
  function innerLock(): *mut Arch::SpinLock {
    return &mut LocksTestState::innerLock as *mut Arch::SpinLock;
  }
}
