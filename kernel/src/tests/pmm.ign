//!
//! # Physical Memory Self-Test
//!
//! Allocates and frees a few frames and checks the allocator's promises.
//!
//! ## Overview
//!
//! The test takes `SELF_TEST_FRAMES` frames and checks that each is aligned
//! and non-zero, that no frame is handed out twice, that the free count
//! follows every step, and that a freed frame comes back first. It also
//! checks that `isAllocated` tells an allocated frame from a free one and
//! from a frame that was never usable, the kernel image's first frame. It
//! panics on the first violation, so a boot that continues has passed it.

import Boot from "@boot";
import Drivers from "@drivers";
import Mm from "@mm";

namespace Tests::Pmm {
  /// Frames the self-test allocates at once. The test keeps their addresses in
  /// an array of this size.
  const SELF_TEST_FRAMES: u64 = 8;

  /// Reserving every available frame leaves nothing for `allocateFrame`,
  /// and no second reservation, while `allocateReserved` still gets frames;
  /// giving the reservation back restores both.
  function checkReservations(): void {
    let freeBefore: u64 = Mm::Pmm::freeFrameCount();
    let available: u64 = Mm::Pmm::availableFrameCount();

    if (Mm::Pmm::reservedFrameCount() != 0 || available != freeBefore || !Mm::Pmm::reserve(available)) {
      @panic("pmm self-test: could not reserve every available frame");
    }

    let refused: boolean = Mm::Pmm::allocateFrame() == Mm::Pmm::NO_FRAME && Mm::Pmm::allocateLargeFrame() == Mm::Pmm::NO_FRAME && !Mm::Pmm::reserve(1);
    let taken: u64 = Mm::Pmm::allocateReserved();

    if (!refused || !Mm::Pmm::isAllocated(taken) || Mm::Pmm::reservedFrameCount() != available - 1) {
      @panic("pmm self-test: a reservation did not keep its frames apart");
    }

    Mm::Pmm::freeFrame(taken);
    Mm::Pmm::unreserve(available - 1);

    let frame: u64 = Mm::Pmm::allocateFrame();

    if (frame == Mm::Pmm::NO_FRAME || Mm::Pmm::reservedFrameCount() != 0) {
      @panic("pmm self-test: frames stayed reserved after unreserve");
    }

    Mm::Pmm::freeFrame(frame);

    if (Mm::Pmm::freeFrameCount() != freeBefore) {
      @panic("pmm self-test: the reservation check leaked frames");
    }
  }

  /// Allocates and frees a few frames and checks the allocator's promises:
  /// aligned non-zero frames, no frame handed out twice, the free count
  /// following every step, a freed frame coming back first, and
  /// `isAllocated` agreeing with all of it. Panics on the first violation.
  function run(): void {
    // The kernel's first physical frame, from Limine: the VMM is not up yet,
    // so `Mm::Vmm::translate` would only answer "not mapped".
    let executable: *mut Boot::Limine::ExecutableAddressResponse = Boot::Limine::executableAddress();

    if (executable == null) {
      @panic("pmm self-test: Limine gave no executable address");
    }

    let kernelFrame: u64 = (*executable).physicalBase;

    if (Mm::Pmm::isAllocated(kernelFrame) || Mm::Pmm::isAllocated(0)) {
      @panic("pmm self-test: a frame that was never usable counts as allocated");
    }

    let mut frames: u64[8];
    let before: u64 = Mm::Pmm::freeFrameCount();

    let mut index: u64 = 0;

    while (index < SELF_TEST_FRAMES) {
      let frame: u64 = Mm::Pmm::allocateFrame();

      if (frame == Mm::Pmm::NO_FRAME || frame % Mm::Pmm::FRAME_SIZE != 0) {
        @panic("pmm self-test: bad frame");
      }

      let mut earlier: u64 = 0;

      while (earlier < index) {
        if (frames[earlier] == frame) {
          @panic("pmm self-test: frame handed out twice");
        }

        earlier += 1;
      }

      if (!Mm::Pmm::isAllocated(frame)) {
        @panic("pmm self-test: an allocated frame does not count as allocated");
      }

      frames[index] = frame;
      index += 1;
    }

    if (Mm::Pmm::freeFrameCount() != before - SELF_TEST_FRAMES) {
      @panic("pmm self-test: free count did not drop");
    }

    let reused: u64 = frames[3];

    Mm::Pmm::freeFrame(reused);

    if (Mm::Pmm::isAllocated(reused)) {
      @panic("pmm self-test: a freed frame still counts as allocated");
    }

    if (Mm::Pmm::allocateFrame() != reused) {
      @panic("pmm self-test: freed frame was not reused");
    }

    index = 0;

    while (index < SELF_TEST_FRAMES) {
      Mm::Pmm::freeFrame(frames[index]);
      index += 1;
    }

    if (Mm::Pmm::freeFrameCount() != before) {
      @panic("pmm self-test: free count did not recover");
    }

    checkReservations();

    Drivers::Console::writeLine("pmm: self-test ok, reservations included");
  }
}
