//!
//! # Demand Paging Self-Test
//!
//! Checks the lazy regions of `Proc::Memory` against the frame counts of the
//! PMM, in a space of its own and the free process slot 63, before any
//! process runs.
//!
//! | Check          | What it proves                                                          |
//! |----------------|-------------------------------------------------------------------------|
//! | lazy map       | mapping 64 MiB takes no page frame, only its page tables, and reserves 16384 frames |
//! | touch          | resolving 3 pages takes exactly 3 frames, from the reservation; a second resolve of a page changes nothing |
//! | refusals       | no region, an instruction fetch in a non-executable region, a write to a read-only region or page, and `PROT_NONE` are refused; a read in a write-only or exec-only region is allowed |
//! | accounting     | a map larger than the available frames, up to 1 TiB, is `NO_MEMORY` and takes neither reservations nor frames; a middle split keeps the tail lazy and returns exactly the untouched pages |
//! | release        | `unmap` frees the touched pages and returns the rest of the reservation; so does the end of a process |

import Boot from "@boot";
import Drivers from "@drivers";
import Mm from "@mm";
import Proc from "@proc";

/// The checks.
namespace Tests::Memory {
  /// The process slot the test uses: the last one, free while the boot
  /// self-tests run.
  const SLOT: u64 = 63;

  /// 4 KiB.
  const PAGE: u64 = 4096;

  /// 64 MiB.
  const LARGE: u64 = 67108864;

  /// Page frames 64 MiB of page tables can take at most: 32 page tables, a
  /// directory, a pointer table, and room for the heap to grow once.
  const TABLE_SLACK: u64 = 64;

  function run(): void {
    // The region table comes from the heap; make the heap big enough first
    // so it does not grow in the middle of a count.
    Mm::Heap::free(Mm::Heap::allocate(16384, 16));
    Proc::Memory::reset(SLOT);

    let freeBefore: u64 = Mm::Pmm::freeFrameCount();
    let root: u64 = Mm::AddressSpace::create();

    if (root == Mm::Pmm::NO_FRAME) {
      @panic("memory self-test: no address space");
    }

    let freeWithSpace: u64 = Mm::Pmm::freeFrameCount();
    let large: u64 = mapOrPanic(root, LARGE, Proc::Memory::READ | Proc::Memory::WRITE);
    let tables: u64 = freeWithSpace - Mm::Pmm::freeFrameCount();

    if (tables > TABLE_SLACK || Mm::Pmm::reservedFrameCount() != LARGE / PAGE) {
      @panic("memory self-test: a lazy 64 MiB mapping took frames or did not reserve them");
    }

    checkTouch(root, large);
    checkRefusals(root, large);
    checkAccounting(root);
    checkReadNeedsAnyAccess(root);
    checkRefusedMapTakesNothing(root);
    checkSplitAccounting(root);

    if (Proc::Memory::unmap(SLOT, root, large, LARGE) != Proc::Memory::OK || Mm::Pmm::reservedFrameCount() != 0) {
      @panic("memory self-test: unmap did not return the reservation");
    }

    checkProcessEnd(root);

    Proc::Memory::reset(SLOT);
    Mm::AddressSpace::destroy(root);

    if (Mm::Pmm::freeFrameCount() != freeBefore || Mm::Pmm::reservedFrameCount() != 0) {
      @panic("memory self-test: frames or reservations leaked");
    }

    Drivers::Console::write("memory: demand paging self-test ok, 64 MiB took ");
    Drivers::Console::writeDecimal(tables);
    Drivers::Console::writeLine(" frames of page tables and 3 touched pages took 3 frames");
  }

  /// Three touches take three frames from the reservation, zeroed; touching
  /// one again takes nothing.
  function checkTouch(root: u64, large: u64): void {
    let free: u64 = Mm::Pmm::freeFrameCount();
    let reserved: u64 = Mm::Pmm::reservedFrameCount();

    let touched: boolean = Proc::Memory::resolve(SLOT, root, large, Proc::Memory::WRITE) && Proc::Memory::resolve(SLOT, root, large + 5 * PAGE + 17, Proc::Memory::READ) && Proc::Memory::resolve(SLOT, root, large + LARGE - 1, Proc::Memory::WRITE);

    if (!touched || Mm::Pmm::freeFrameCount() != free - 3 || Mm::Pmm::reservedFrameCount() != reserved - 3) {
      @panic("memory self-test: touching 3 pages did not take exactly 3 reserved frames");
    }

    let physical: u64 = Mm::AddressSpace::translateUser(root, large + 5 * PAGE, false);

    if (physical == Mm::AddressSpace::NOT_MAPPED || *(Boot::Hhdm::toVirtual(physical) as *mut u64) != 0) {
      @panic("memory self-test: a touched page is not mapped or not zeroed");
    }

    if (!Proc::Memory::resolve(SLOT, root, large, Proc::Memory::WRITE) || Mm::Pmm::freeFrameCount() != free - 3) {
      @panic("memory self-test: touching a present page again took a frame");
    }
  }

  /// Accesses no region allows are refused and take nothing.
  function checkRefusals(root: u64, large: u64): void {
    let readOnly: u64 = mapOrPanic(root, PAGE, Proc::Memory::READ);
    let none: u64 = mapOrPanic(root, PAGE, 0);
    let free: u64 = Mm::Pmm::freeFrameCount();

    let outside: boolean = Proc::Memory::resolve(SLOT, root, none - PAGE, Proc::Memory::READ);
    let fetch: boolean = Proc::Memory::resolve(SLOT, root, large + PAGE, Proc::Memory::EXECUTE);
    let writeMissing: boolean = Proc::Memory::resolve(SLOT, root, readOnly, Proc::Memory::WRITE);
    let protNone: boolean = Proc::Memory::resolve(SLOT, root, none, Proc::Memory::READ);

    if (outside || fetch || writeMissing || protNone || Mm::Pmm::freeFrameCount() != free) {
      @panic("memory self-test: the resolver allowed an access no region allows");
    }

    let readPresent: boolean = Proc::Memory::resolve(SLOT, root, readOnly, Proc::Memory::READ);
    let writePresent: boolean = Proc::Memory::resolve(SLOT, root, readOnly, Proc::Memory::WRITE);

    if (!readPresent || writePresent) {
      @panic("memory self-test: a read-only page was not readable, or became writable");
    }

    Proc::Memory::unmap(SLOT, root, readOnly, PAGE);
    Proc::Memory::unmap(SLOT, root, none, PAGE);
  }

  /// A lazy map larger than what is available reserves nothing.
  function checkAccounting(root: u64): void {
    let reserved: u64 = Mm::Pmm::reservedFrameCount();
    let tooLarge: u64 = (Mm::Pmm::availableFrameCount() + 1) * PAGE;
    let mut address: u64 = 0;

    let available: u64 = Mm::Pmm::availableFrameCount();

    if (Proc::Memory::map(SLOT, root, tooLarge, Proc::Memory::READ | Proc::Memory::WRITE, null, 0, false, &mut address as *mut u64) != Proc::Memory::NO_MEMORY || Mm::Pmm::reservedFrameCount() != reserved || available - Mm::Pmm::availableFrameCount() > TABLE_SLACK) {
      @panic("memory self-test: a mapping larger than the free memory was granted");
    }
  }

  /// A read needs any access at all: write-only and exec-only lazy regions
  /// resolve a read, as x86 can only map a page ring 3 can read.
  function checkReadNeedsAnyAccess(root: u64): void {
    let writeOnly: u64 = mapOrPanic(root, PAGE, Proc::Memory::WRITE);
    let execOnly: u64 = mapOrPanic(root, PAGE, Proc::Memory::EXECUTE);

    if (!Proc::Memory::resolve(SLOT, root, writeOnly, Proc::Memory::READ) || !Proc::Memory::resolve(SLOT, root, execOnly, Proc::Memory::READ)) {
      @panic("memory self-test: a read in a write-only or exec-only region was refused");
    }

    Proc::Memory::unmap(SLOT, root, writeOnly, PAGE);
    Proc::Memory::unmap(SLOT, root, execOnly, PAGE);
  }

  /// A refused lazy map takes no frames, not even for page tables: a 1 TiB
  /// request must not leave the kernel without memory.
  function checkRefusedMapTakesNothing(root: u64): void {
    let available: u64 = Mm::Pmm::availableFrameCount();
    let mut address: u64 = 0;
    let status: u64 = Proc::Memory::map(SLOT, root, 1099511627776, Proc::Memory::READ | Proc::Memory::WRITE, null, 0, false, &mut address as *mut u64);

    if (status != Proc::Memory::NO_MEMORY || available - Mm::Pmm::availableFrameCount() > TABLE_SLACK) {
      @panic("memory self-test: a refused lazy map kept frames");
    }
  }

  /// Unmapping the middle of a partly touched lazy region keeps the tail
  /// lazy, refuses the hole, and returns exactly the untouched reservation.
  function checkSplitAccounting(root: u64): void {
    let region: u64 = mapOrPanic(root, 10 * PAGE, Proc::Memory::READ | Proc::Memory::WRITE);
    let reserved: u64 = Mm::Pmm::reservedFrameCount();

    Proc::Memory::resolve(SLOT, root, region, Proc::Memory::WRITE);
    Proc::Memory::resolve(SLOT, root, region + 4 * PAGE, Proc::Memory::WRITE);
    Proc::Memory::resolve(SLOT, root, region + 9 * PAGE, Proc::Memory::WRITE);
    Proc::Memory::unmap(SLOT, root, region + 3 * PAGE, 3 * PAGE);

    let afterSplit: u64 = Mm::Pmm::reservedFrameCount();
    let tail: boolean = Proc::Memory::resolve(SLOT, root, region + 7 * PAGE, Proc::Memory::WRITE);
    let hole: boolean = Proc::Memory::resolve(SLOT, root, region + 4 * PAGE, Proc::Memory::WRITE);

    Proc::Memory::unmap(SLOT, root, region, 10 * PAGE);

    if (afterSplit != reserved - 5 || !tail || hole || Mm::Pmm::reservedFrameCount() != reserved - 10) {
      @panic("memory self-test: a split lazy region miscounted its reservation");
    }
  }

  /// A process that ends with a lazy region partly touched gives back the
  /// reservation of the untouched pages; destroying its space frees the
  /// touched ones.
  function checkProcessEnd(root: u64): void {
    let region: u64 = mapOrPanic(root, 10 * PAGE, Proc::Memory::READ | Proc::Memory::WRITE);

    Proc::Memory::resolve(SLOT, root, region, Proc::Memory::WRITE);
    Proc::Memory::resolve(SLOT, root, region + 9 * PAGE, Proc::Memory::WRITE);
    Proc::Memory::teardown(SLOT, root);

    if (Mm::Pmm::reservedFrameCount() != 0) {
      @panic("memory self-test: the end of a process kept a reservation");
    }
  }

  /// Maps a lazy region of `length` bytes with `protection` and returns its
  /// start.
  function mapOrPanic(root: u64, length: u64, protection: u64): u64 {
    let mut address: u64 = 0;

    if (Proc::Memory::map(SLOT, root, length, protection, null, 0, false, &mut address as *mut u64) != Proc::Memory::OK) {
      @panic("memory self-test: a lazy mapping failed");
    }

    return address;
  }
}
