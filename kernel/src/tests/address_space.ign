//!
//! # Address Space Self-Test
//!
//! Checks the guarantees of an address space.
//!
//! ## Overview
//!
//! The lower half is private, the upper half is shared, including mappings
//! made after the space was created, pages carry the U/S bit, loading CR3
//! switches the user half, and `destroy` gives back every frame. A 2 MiB
//! page in the user half is also mapped, reached and freed. It panics on the
//! first violation. Interrupts are left as they were found.

import Arch from "@arch";
import Boot from "@boot";
import Drivers from "@drivers";
import Mm from "@mm";

namespace Tests::AddressSpace {
  /// The user address both test spaces map: `0x400000`, where programs load.
  const SELF_TEST_ADDRESS: u64 = 0x400000;

  /// A second user address, mapped in one space only to prove the other space
  /// does not see it.
  const SELF_TEST_SECOND_ADDRESS: u64 = 0x600000;

  /// Values written into the test frames so a read shows which frame it hit.
  const SELF_TEST_MARKER_A: u64 = 0xAAAA0000AAAA0001;

  /// See `SELF_TEST_MARKER_A`: the value for the second space.
  const SELF_TEST_MARKER_B: u64 = 0xBBBB0000BBBB0002;

  /// The value written to a kernel page mapped after both spaces exist.
  const SELF_TEST_KERNEL_MARKER: u64 = 0xCCCC0000CCCC0003;

  /// Where the 2 MiB page test maps its page: 1 GiB, 2 MiB aligned and in
  /// a PDPT entry no other test uses.
  const SELF_TEST_LARGE_ADDRESS: u64 = 0x40000000;

  /// Offset inside the 2 MiB page where the marker goes, past the first
  /// 4 KiB so a wrong offset mask shows up.
  const SELF_TEST_LARGE_OFFSET: u64 = 0x123458;

  /// The value written into the 2 MiB page. Bit 0 is set on purpose: if
  /// `destroy` walked the page as a page table, this word would look like a
  /// present entry.
  const SELF_TEST_LARGE_MARKER: u64 = 0xDDDD0000DDDD0005;

  /// Checks the guarantees of an address space: the lower half is private,
  /// the upper half is shared, including mappings made after the space was
  /// created, pages carry the U/S bit, and `destroy` gives back every frame.
  /// Panics on the first violation. Interrupts are left as they were found.
  function run(): void {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();
    let freeBefore: u64 = Mm::Pmm::freeFrameCount();
    let kernelRoot: u64 = Mm::Vmm::rootTable();

    let first: u64 = Mm::AddressSpace::create();
    let second: u64 = Mm::AddressSpace::create();

    if (first == Mm::Pmm::NO_FRAME || second == Mm::Pmm::NO_FRAME || first == second || first == kernelRoot) {
      @panic("address space self-test: bad PML4");
    }

    testSharedHalf(first, second, kernelRoot);
    testPrivateHalf(first, second, kernelRoot);
    testSwitching(first, second, kernelRoot);
    testLargePage(kernelRoot);

    Mm::AddressSpace::destroy(first);
    Mm::AddressSpace::destroy(second);

    if (Mm::Pmm::freeFrameCount() != freeBefore) {
      @panic("address space self-test: destroy leaked frames");
    }

    Arch::Cpu::restoreInterrupts(saved);

    Drivers::Console::writeLine("address space: self-test ok, private user half, shared kernel half, frames returned");
  }

  /// The two spaces start with the kernel's upper-half entries and nothing
  /// below.
  function testSharedHalf(first: u64, second: u64, kernelRoot: u64): void {
    let kernel: *mut u64 = Mm::Vmm::tableAt(kernelRoot) as *mut u64;
    let one: *mut u64 = Mm::Vmm::tableAt(first) as *mut u64;
    let two: *mut u64 = Mm::Vmm::tableAt(second) as *mut u64;

    let mut index: u64 = 0;

    while (index < Mm::AddressSpace::ENTRIES_PER_TABLE) {
      if (index < Mm::AddressSpace::USER_HALF_ENTRIES) {
        if (*(one + index) != 0 || *(two + index) != 0) {
          @panic("address space self-test: a new space has user mappings");
        }
      } else if (*(one + index) != *(kernel + index) || *(two + index) != *(kernel + index)) {
        @panic("address space self-test: the kernel half is not shared");
      }

      index += 1;
    }
  }

  /// The same user address maps to different frames in the two spaces, with
  /// the U/S bit, and nothing leaks into the other space or the kernel's.
  function testPrivateHalf(first: u64, second: u64, kernelRoot: u64): void {
    let flags: u64 = Mm::Vmm::WRITABLE | Mm::Vmm::NO_EXECUTE;

    let frameA: u64 = Mm::AddressSpace::allocatePage(first, SELF_TEST_ADDRESS, flags);
    let frameB: u64 = Mm::AddressSpace::allocatePage(second, SELF_TEST_ADDRESS, flags);
    let extra: u64 = Mm::AddressSpace::allocatePage(first, SELF_TEST_SECOND_ADDRESS, flags);

    if (frameA == Mm::Pmm::NO_FRAME || frameB == Mm::Pmm::NO_FRAME || extra == Mm::Pmm::NO_FRAME || frameA == frameB) {
      @panic("address space self-test: no distinct frames");
    }

    *(Boot::Hhdm::toVirtual(frameA) as *mut u64) = SELF_TEST_MARKER_A;
    *(Boot::Hhdm::toVirtual(frameB) as *mut u64) = SELF_TEST_MARKER_B;

    if (Mm::Vmm::translateIn(first, SELF_TEST_ADDRESS) != frameA || Mm::Vmm::translateIn(second, SELF_TEST_ADDRESS) != frameB) {
      @panic("address space self-test: a page maps to the wrong frame");
    }

    if (Mm::Vmm::translateIn(kernelRoot, SELF_TEST_ADDRESS) != Mm::Vmm::NOT_MAPPED) {
      @panic("address space self-test: a user page leaked into the kernel space");
    }

    if (Mm::Vmm::translateIn(second, SELF_TEST_SECOND_ADDRESS) != Mm::Vmm::NOT_MAPPED) {
      @panic("address space self-test: a user page leaked into another space");
    }

    let entry: u64 = Mm::Vmm::leafEntryIn(first, SELF_TEST_ADDRESS);
    let top: u64 = *(Mm::Vmm::tableAt(first) as *mut u64);

    if ((entry & Mm::Vmm::USER) == 0 || (entry & Mm::Vmm::WRITABLE) == 0 || (entry & Mm::Vmm::NO_EXECUTE) == 0) {
      @panic("address space self-test: wrong permission bits on a user page");
    }

    if ((top & Mm::Vmm::USER) == 0) {
      @panic("address space self-test: the PML4 entry lacks the U/S bit");
    }

    if ((Mm::Vmm::leafEntryIn(first, Mm::Vmm::textStartAddress()) & Mm::Vmm::USER) != 0) {
      @panic("address space self-test: kernel text is user accessible");
    }

    if (Mm::AddressSpace::translateUser(first, SELF_TEST_ADDRESS, true) != frameA || Mm::AddressSpace::translateUser(first, Mm::AddressSpace::USER_LIMIT, false) != Mm::AddressSpace::NOT_MAPPED) {
      @panic("address space self-test: translateUser disagrees with the tables");
    }

    if (Mm::AddressSpace::mapPage(first, Mm::AddressSpace::USER_LIMIT, frameA, flags) || Mm::AddressSpace::mapPage(first, SELF_TEST_ADDRESS, frameA, flags)) {
      @panic("address space self-test: an invalid mapping was accepted");
    }
  }

  /// Maps a 2 MiB page from `Mm::Pmm::allocateLargeFrame` into a new space
  /// and checks that ring 3 could reach it (U/S at every level), that the
  /// copy functions find the right byte in it, that nothing else can be
  /// mapped over it, and that `destroy` gives back its 512 frames; `run`
  /// checks the free count afterwards.
  function testLargePage(kernelRoot: u64): void {
    let space: u64 = Mm::AddressSpace::create();
    let freeBefore: u64 = Mm::Pmm::freeFrameCount();
    let frame: u64 = Mm::Pmm::allocateLargeFrame();

    if (space == Mm::Pmm::NO_FRAME || frame == Mm::Pmm::NO_FRAME || frame % Mm::Pmm::LARGE_FRAME_SIZE != 0) {
      @panic("address space self-test: no 2 MiB frame");
    }

    if (Mm::Pmm::freeFrameCount() != freeBefore - 512 || !Mm::Pmm::isAllocated(frame) || !Mm::Pmm::isAllocated(frame + Mm::Pmm::LARGE_FRAME_SIZE - Mm::Pmm::FRAME_SIZE)) {
      @panic("address space self-test: a 2 MiB frame is not 512 allocated frames");
    }

    *(Boot::Hhdm::toVirtual(frame + SELF_TEST_LARGE_OFFSET) as *mut u64) = SELF_TEST_LARGE_MARKER;

    let flags: u64 = Mm::Vmm::WRITABLE | Mm::Vmm::NO_EXECUTE;

    if (!Mm::AddressSpace::mapLargePage(space, SELF_TEST_LARGE_ADDRESS, frame, flags)) {
      @panic("address space self-test: cannot map a 2 MiB user page");
    }

    let pml4Entry: u64 = *(Mm::Vmm::tableAt(space) + Mm::Vmm::level4Index(SELF_TEST_LARGE_ADDRESS));
    let pdptEntry: u64 = *(Mm::Vmm::tableAt(pml4Entry & Mm::Vmm::ADDRESS_MASK) + Mm::Vmm::level3Index(SELF_TEST_LARGE_ADDRESS));
    let largeEntry: u64 = Mm::Vmm::largeEntryIn(space, SELF_TEST_LARGE_ADDRESS);

    if ((pml4Entry & Mm::Vmm::USER) == 0 || (pdptEntry & Mm::Vmm::USER) == 0 || (largeEntry & Mm::Vmm::USER) == 0) {
      @panic("address space self-test: a 2 MiB user page lacks U/S at some level");
    }

    let address: u64 = SELF_TEST_LARGE_ADDRESS + SELF_TEST_LARGE_OFFSET;
    let mut copied: u64 = 0;

    if (Mm::AddressSpace::translateUser(space, address, true) != frame + SELF_TEST_LARGE_OFFSET || !Mm::AddressSpace::copyFromUser(space, &mut copied as *mut u8, address, 8) || copied != SELF_TEST_LARGE_MARKER) {
      @panic("address space self-test: the copy functions miss the 2 MiB page");
    }

    if (Mm::Vmm::translateIn(kernelRoot, SELF_TEST_LARGE_ADDRESS) != Mm::Vmm::NOT_MAPPED) {
      @panic("address space self-test: a 2 MiB user page leaked into the kernel space");
    }

    if (Mm::AddressSpace::mapLargePage(space, SELF_TEST_LARGE_ADDRESS, frame, flags) || Mm::AddressSpace::mapPage(space, address & ~(Mm::Vmm::PAGE_SIZE - 1), frame, flags) || Mm::AddressSpace::mapLargePage(space, SELF_TEST_LARGE_ADDRESS + Mm::Vmm::PAGE_SIZE, frame, flags)) {
      @panic("address space self-test: a mapping over a 2 MiB page was accepted");
    }

    Mm::AddressSpace::destroy(space);
  }

  /// Loads each space in turn and reads the same user address, and a kernel
  /// page mapped after both spaces were created. The kernel page must show
  /// the same value everywhere and the user page a different one per space.
  function testSwitching(first: u64, second: u64, kernelRoot: u64): void {
    let frame: u64 = Mm::Pmm::allocateFrame();

    if (frame == Mm::Pmm::NO_FRAME || !Mm::Vmm::map(Mm::Vmm::TEST_ADDRESS, frame, Mm::Vmm::WRITABLE | Mm::Vmm::NO_EXECUTE)) {
      @panic("address space self-test: cannot map the kernel test page");
    }

    let kernelPage: *mut u64 = @pointerFromInteger<*mut u64>(Mm::Vmm::TEST_ADDRESS);
    let userPage: *mut u64 = @pointerFromInteger<*mut u64>(SELF_TEST_ADDRESS);

    *kernelPage = SELF_TEST_KERNEL_MARKER;

    Mm::AddressSpace::activate(first);

    let userInFirst: u64 = *userPage;
    let kernelInFirst: u64 = *kernelPage;

    Mm::AddressSpace::activate(second);

    let userInSecond: u64 = *userPage;
    let kernelInSecond: u64 = *kernelPage;

    Mm::AddressSpace::activate(kernelRoot);

    Mm::Vmm::unmap(Mm::Vmm::TEST_ADDRESS);
    Mm::Pmm::freeFrame(frame);

    if (userInFirst != SELF_TEST_MARKER_A || userInSecond != SELF_TEST_MARKER_B) {
      @panic("address space self-test: loading CR3 did not change the user half");
    }

    if (kernelInFirst != SELF_TEST_KERNEL_MARKER || kernelInSecond != SELF_TEST_KERNEL_MARKER) {
      @panic("address space self-test: a later kernel mapping is not shared");
    }
  }
}
