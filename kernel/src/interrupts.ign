//!
//! # Interrupt and Exception Dispatch
//!
//! The Ignis side of interrupt handling: one dispatcher for every vector, the
//! exception reports and the rule for faults in ring 3.
//!
//! ## Overview
//!
//! `interrupt_asm.S` saves the registers of the interrupted code and calls
//! `dispatch` with a pointer to the saved frame. From there:
//!
//! ```text
//!   Interrupts::dispatch(frame)
//!   │
//!   ├─ vector 0xFF  local APIC spurious ......... return, no EOI
//!   ├─ vector 0x21  keyboard (IOAPIC) ........... Ps2::handleInterrupt, Lapic EOI
//!   ├─ vector 0x30  local APIC timer ............ Timer::handleTick, Lapic EOI,
//!   │                                             Scheduler::onTick (may switch threads)
//!   ├─ vectors 0x20-0x2F (the rest)  8259 ....... acknowledge or absorb a spurious one
//!   ├─ exception from ring 3 (cs & 3 == 3) ..... report, kill the process
//!   └─ any other exception ...................... report on COM1 and the
//!                                                 console, halt the machine
//! ```
//!
//! A CPU exception in the kernel is fatal: it is reported on COM1 and on the
//! console, then the processor halts. An exception taken in ring 3 (the saved
//! code selector has RPL 3) is the process's own fault: it is reported and the
//! process is killed while the kernel keeps running. NMI and machine check
//! stay fatal even from ring 3, because they report the machine and not the
//! process.
//!
//! Device interrupts come from the IOAPIC and are acknowledged at the local
//! APIC with `Lapic::endOfInterrupt`. The 8259 is fully masked, but its
//! vectors `0x20-0x2F` stay mapped to thunks so a spurious 8259 interrupt is
//! absorbed. The local APIC's spurious vector is ignored without any
//! acknowledgement.
//!
//! ## Exceptions
//!
//! | Vec | Mnemonic | Name                         | Class | Error code |
//! |-----|----------|------------------------------|-------|------------|
//! | 0   | `#DE`    | Divide Error                 | fault | no         |
//! | 1   | `#DB`    | Debug                        | fault/trap | no    |
//! | 2   | NMI      | Non-Maskable Interrupt       | interrupt | no      |
//! | 3   | `#BP`    | Breakpoint                   | trap  | no         |
//! | 4   | `#OF`    | Overflow                     | trap  | no         |
//! | 5   | `#BR`    | Bound Range Exceeded         | fault | no         |
//! | 6   | `#UD`    | Invalid Opcode               | fault | no         |
//! | 7   | `#NM`    | Device Not Available         | fault | no         |
//! | 8   | `#DF`    | Double Fault                 | abort | yes (0)    |
//! | 9   | -        | Coprocessor Segment Overrun  | fault (legacy) | no |
//! | 10  | `#TS`    | Invalid TSS                  | fault | yes        |
//! | 11  | `#NP`    | Segment Not Present          | fault | yes        |
//! | 12  | `#SS`    | Stack-Segment Fault          | fault | yes        |
//! | 13  | `#GP`    | General Protection Fault     | fault | yes        |
//! | 14  | `#PF`    | Page Fault                   | fault | yes        |
//! | 16  | `#MF`    | x87 Floating-Point Exception | fault | no         |
//! | 17  | `#AC`    | Alignment Check              | fault | yes (0)    |
//! | 18  | `#MC`    | Machine Check                | abort | no         |
//! | 19  | `#XM`    | SIMD Floating-Point Exception| fault | no         |
//! | 20  | `#VE`    | Virtualization Exception     | fault | no         |
//! | 21  | `#CP`    | Control Protection Exception | fault | yes        |
//! | 28  | `#HV`    | Hypervisor Injection (AMD)   | fault | no         |
//! | 29  | `#VC`    | VMM Communication (AMD)      | fault | yes        |
//! | 30  | `#SX`    | Security Exception (AMD)     | fault | yes        |
//! | 15, 22-27, 31 | - | reserved                 |       |            |
//!
//! For a page fault the error code has these bits, and CR2 holds the faulting
//! address:
//!
//! ```text
//!   bit 0  P    0 = page not present, 1 = protection violation
//!   bit 1  W    1 = the access was a write
//!   bit 2  U    1 = the access came from ring 3
//!   bit 3  RSVD 1 = a reserved bit was set in a page table entry
//!   bit 4  I/D  1 = the access was an instruction fetch
//!
//!   0x06 = user write to an unmapped page        (the "null write" test)
//!   0x05 = user read of a supervisor-only page   (the "kernel read" test)
//!   0x07 = user write to a read-only page        (the "code write" test)
//!   0x15 = user instruction fetch from a no-execute page (the "stack jump")
//! ```
//!
//! See concept doc 04 and Intel SDM Vol. 3A, "Interrupt and Exception
//! Handling".

import Cpu from "./arch/x86_64/cpu";
import Lapic from "./arch/x86_64/lapic";
import Pic from "./arch/x86_64/pic";
import Color, Console from "./console";
import Process from "./process";
import Ps2 from "./ps2";
import Scheduler from "./scheduler";
import Serial from "./serial";
import Timer from "./timer";

/// The state `interrupt_asm.S` leaves on the stack, lowest address first.
/// The registers are pushed by the common stub, `vector` by the thunk, and
/// `errorCode` by the thunk when the processor did not push one. The last
/// five fields are the processor's own frame.
///
/// ```text
///   offset  field        pushed by
///     0     rax          common stub (last push, lowest address)
///     8     rbx          ...
///    16     rcx
///    24     rdx
///    32     rsi
///    40     rdi
///    48     rbp
///    56     r8
///    64     r9
///    72     r10
///    80     r11
///    88     r12
///    96     r13
///   104     r14
///   112     r15          common stub (first push)
///   120     vector       thunk
///   128     errorCode    processor, or 0 from the thunk
///   136     rip          processor: where to resume
///   144     cs           processor: code segment; bits 1:0 are the CPL
///   152     rflags       processor
///   160     rsp          processor: stack pointer of the interrupted code
///   168     ss           processor
/// ```
///
/// The `SYSCALL` entry stub builds the same frame by hand, with vector 256,
/// so system calls and interrupts share one record. A handler may change the
/// saved values: the registers are reloaded from the frame on the way out.
@cLayout
export record InterruptFrame {
  /// Saved general purpose registers. The `rsp` field further down is the stack
  /// pointer of the interrupted code, not the register at the time of the call.
  public rax: u64;

  /// Saved `rbx`.
  public rbx: u64;

  /// Saved `rcx`.
  public rcx: u64;

  /// Saved `rdx`.
  public rdx: u64;

  /// Saved `rsi`.
  public rsi: u64;

  /// Saved `rdi`.
  public rdi: u64;

  /// Saved `rbp`.
  public rbp: u64;

  /// Saved `r8`.
  public r8: u64;

  /// Saved `r9`.
  public r9: u64;

  /// Saved `r10`.
  public r10: u64;

  /// Saved `r11`.
  public r11: u64;

  /// Saved `r12`.
  public r12: u64;

  /// Saved `r13`.
  public r13: u64;

  /// Saved `r14`.
  public r14: u64;

  /// Saved `r15`.
  public r15: u64;

  /// The vector number, 0 to 255, or 256 for a system call.
  public vector: u64;

  /// The processor's error code for the vectors that push one, otherwise 0.
  public errorCode: u64;

  /// Address of the instruction to resume at (for a fault, the one that
  /// faulted).
  public rip: u64;

  /// Code segment selector of the interrupted code. Its low two bits are the
  /// privilege level: 0 for the kernel, 3 for a user process.
  public cs: u64;

  /// RFLAGS of the interrupted code, including its interrupt flag.
  public rflags: u64;

  /// Stack pointer of the interrupted code.
  public rsp: u64;

  /// Stack segment selector of the interrupted code.
  public ss: u64;
}

/// Interrupt vector numbers and the dispatcher.
export namespace Interrupts {
  /// First vector of the remapped 8259 range, `0x20`.
  const FIRST_IRQ_VECTOR: u64 = 32;

  /// Number of vectors in the 8259 range: 16 lines.
  const IRQ_VECTOR_COUNT: u64 = 16;

  /// The vector the IOAPIC raises for the keyboard. It equals the vector of
  /// 8259 line 1, which is harmless because that line is masked.
  const KEYBOARD_VECTOR: u64 = 0x21;

  /// The vector of the local APIC timer tick. It is just above the 8259
  /// vectors so nothing legacy shares it.
  const TIMER_VECTOR: u64 = 0x30;

  /// Vector 14.
  const PAGE_FAULT: u64 = 14;

  /// Vector 0.
  const DIVIDE_ERROR: u64 = 0;

  /// Vector 1.
  const DEBUG: u64 = 1;

  /// Vector 2.
  const NMI: u64 = 2;

  /// Vector 3.
  const BREAKPOINT: u64 = 3;

  /// Vector 8. Its saved CS and RIP are undefined (Intel SDM, "Interrupt 8,
  /// Double Fault Exception"), so it can never be attributed to a process.
  const DOUBLE_FAULT: u64 = 8;

  /// Vector 6.
  const INVALID_OPCODE: u64 = 6;

  /// Vector 16.
  const X87_FAULT: u64 = 16;

  /// Vector 17.
  const ALIGNMENT_CHECK: u64 = 17;

  /// Vector 18.
  const MACHINE_CHECK: u64 = 18;

  /// Vector 19.
  const SIMD_FAULT: u64 = 19;

  /// Signal numbers of Linux x86_64. `killUserProcess` maps each exception to
  /// the signal Linux would send for it.
  ///
  /// SIGILL (4): illegal instruction.
  const SIGILL: u64 = 4;

  /// SIGTRAP (5): breakpoint or debug trap.
  const SIGTRAP: u64 = 5;

  /// SIGBUS (7): misaligned access.
  const SIGBUS: u64 = 7;

  /// SIGFPE (8): arithmetic error.
  const SIGFPE: u64 = 8;

  /// SIGSEGV (11): invalid memory access or privilege violation. The fallback
  /// for every exception that has no more specific signal.
  const SIGSEGV: u64 = 11;

  /// Added to the signal number to build the exit status of a killed process,
  /// as a shell does: 128 + 11 = 139 for a segmentation fault.
  const EXIT_STATUS_SIGNAL_BASE: u64 = 128;

  /// Called by the common stub for every vector, on the interrupted stack,
  /// with interrupts disabled. `frame` points at the saved registers and can be
  /// modified. See the module header for the routing.
  @externName("ignis_interrupt_dispatch")
  function dispatch(frame: *mut InterruptFrame): void {
    let vector: u64 = (*frame).vector;

    if (vector == Lapic::spuriousVector()) {
      return;
    }

    if (vector == KEYBOARD_VECTOR) {
      Ps2::handleInterrupt();
      Lapic::endOfInterrupt();
      return;
    }

    if (vector == TIMER_VECTOR) {
      Timer::handleTick();
      Lapic::endOfInterrupt();
      Scheduler::onTick();
      return;
    }

    if (vector >= FIRST_IRQ_VECTOR && vector < FIRST_IRQ_VECTOR + IRQ_VECTOR_COUNT) {
      handleLegacyInterrupt((vector - FIRST_IRQ_VECTOR) as u8);
      return;
    }

    if (isUserFault(frame)) {
      killUserProcess(frame);
    }

    reportException(frame);

    Cpu::haltForever();
  }

  /// True for a processor exception that interrupted ring 3 and that a
  /// process can cause on its own. NMI and machine check are the machine's
  /// business, not the process's, and stay fatal. A double fault is always
  /// fatal too: the CS it saves is undefined, so its RPL proves nothing.
  function isUserFault(frame: *mut InterruptFrame): boolean {
    let vector: u64 = (*frame).vector;

    return ((*frame).cs & 3) == 3 && vector < FIRST_IRQ_VECTOR && vector != NMI && vector != DOUBLE_FAULT && vector != MACHINE_CHECK;
  }

  /// Reports what the process did and ends it. Never returns: the thread
  /// ends on its own kernel stack, which holds this frame, and the next
  /// thread frees the process's memory.
  function killUserProcess(frame: *mut InterruptFrame): never {
    let vector: u64 = (*frame).vector;

    Console::write("process ");
    Console::writeDecimal(Process::currentId());
    Console::write(" faulted: ");
    Console::write(mnemonic(vector));
    Console::write(" ");
    Console::write(name(vector));
    Console::write(" at rip ");
    Console::writeHex((*frame).rip);

    if (hasErrorCode(vector)) {
      Console::write(", error ");
      Console::writeHex((*frame).errorCode);
    }

    if (vector == PAGE_FAULT) {
      Console::write(", address ");
      Console::writeHex(readCr2());
    }

    Console::writeLine("");

    Process::killCurrent(EXIT_STATUS_SIGNAL_BASE + signalFor(vector));
  }

  /// The signal Linux sends for an exception, which a shell reports as
  /// 128 plus its number.
  function signalFor(vector: u64): u64 {
    if (vector == DIVIDE_ERROR || vector == X87_FAULT || vector == SIMD_FAULT) {
      return SIGFPE;
    }

    if (vector == INVALID_OPCODE) {
      return SIGILL;
    }

    if (vector == DEBUG || vector == BREAKPOINT) {
      return SIGTRAP;
    }

    if (vector == ALIGNMENT_CHECK) {
      return SIGBUS;
    }

    return SIGSEGV;
  }

  /// Absorbs an interrupt that came from the 8259, which is fully masked.
  /// A spurious one skips the acknowledgement of its own controller; any
  /// other is acknowledged and dropped.
  function handleLegacyInterrupt(line: u8): void {
    if (Pic::isSpurious(line)) {
      Pic::endSpurious(line);
      return;
    }

    Pic::endOfInterrupt(line);
  }

  /// Writes the exception to COM1 and to the console when it is up.
  function reportException(frame: *mut InterruptFrame): void {
    let vector: u64 = (*frame).vector;

    if (Console::isInitialized()) {
      Console::setColors(Color::BRIGHT_WHITE, Color::RED);
    }

    emitText("\nCPU exception ");
    emitText(mnemonic(vector));
    emitText(" ");
    emitText(name(vector));
    emitText("\n");

    emitText("  vector ");
    emitDecimal(vector);
    emitText(", error code ");

    if (hasErrorCode(vector)) {
      emitHex((*frame).errorCode);
    } else {
      emitText("none");
    }

    emitText("\n");

    emitText("  rip ");
    emitHex((*frame).rip);
    emitText(", cs ");
    emitHex((*frame).cs);
    emitText("\n");

    emitText("  rflags ");
    emitHex((*frame).rflags);
    emitText(", rsp ");
    emitHex((*frame).rsp);
    emitText("\n");

    if (vector == PAGE_FAULT) {
      emitText("  cr2 ");
      emitHex(readCr2());
      emitText("\n");
    }
  }

  /// True for the vectors where the processor pushes an error code: double
  /// fault, invalid TSS, segment not present, stack fault, general
  /// protection, page fault, alignment check, control protection, VMM
  /// communication and security exceptions. For the others the thunk pushes a
  /// dummy zero, which is not worth printing.
  function hasErrorCode(vector: u64): boolean {
    return match (vector) {
      8 -> true,
      10 -> true,
      11 -> true,
      12 -> true,
      13 -> true,
      14 -> true,
      17 -> true,
      21 -> true,
      29 -> true,
      30 -> true,
      _ -> false,
    };
  }

  /// Reads CR2, the linear address that caused the last page fault.
  function readCr2(): u64 {
    return asm () -> (value: u64 in rax) { mov {value}, cr2 };
  }

  /// The console mirrors everything it prints to COM1, so COM1 is written
  /// directly only while the console is not up.
  function emitText(value: str): void {
    if (Console::isInitialized()) {
      Console::write(value);
    } else {
      Serial::write(value);
    }
  }

  /// Like `emitText` for a hexadecimal number.
  function emitHex(value: u64): void {
    if (Console::isInitialized()) {
      Console::writeHex(value);
    } else {
      Serial::writeHex(value);
    }
  }

  /// Like `emitText` for a decimal number.
  function emitDecimal(value: u64): void {
    if (Console::isInitialized()) {
      Console::writeDecimal(value);
    } else {
      Serial::writeDecimal(value);
    }
  }

  /// The short name of an exception vector, for example `#PF`.
  function mnemonic(vector: u64): str {
    return match (vector) {
      0 -> "#DE",
      1 -> "#DB",
      2 -> "NMI",
      3 -> "#BP",
      4 -> "#OF",
      5 -> "#BR",
      6 -> "#UD",
      7 -> "#NM",
      8 -> "#DF",
      9 -> "none",
      10 -> "#TS",
      11 -> "#NP",
      12 -> "#SS",
      13 -> "#GP",
      14 -> "#PF",
      16 -> "#MF",
      17 -> "#AC",
      18 -> "#MC",
      19 -> "#XM",
      20 -> "#VE",
      21 -> "#CP",
      28 -> "#HV",
      29 -> "#VC",
      30 -> "#SX",
      _ -> "reserved",
    };
  }

  /// The long name of an exception vector, for example `Page Fault`.
  function name(vector: u64): str {
    return match (vector) {
      0 -> "Divide Error",
      1 -> "Debug",
      2 -> "Non-Maskable Interrupt",
      3 -> "Breakpoint",
      4 -> "Overflow",
      5 -> "Bound Range Exceeded",
      6 -> "Invalid Opcode",
      7 -> "Device Not Available",
      8 -> "Double Fault",
      9 -> "Coprocessor Segment Overrun",
      10 -> "Invalid TSS",
      11 -> "Segment Not Present",
      12 -> "Stack-Segment Fault",
      13 -> "General Protection Fault",
      14 -> "Page Fault",
      16 -> "x87 Floating-Point Exception",
      17 -> "Alignment Check",
      18 -> "Machine Check",
      19 -> "SIMD Floating-Point Exception",
      20 -> "Virtualization Exception",
      21 -> "Control Protection Exception",
      28 -> "Hypervisor Injection Exception",
      29 -> "VMM Communication Exception",
      30 -> "Security Exception",
      _ -> "Reserved",
    };
  }
}
