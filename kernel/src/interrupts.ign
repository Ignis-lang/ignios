//! The Ignis side of interrupt handling. `interrupt_asm.S` saves the
//! registers and calls `dispatch` with a pointer to the saved frame.
//!
//! A CPU exception in the kernel is fatal: it is reported on COM1 and on the
//! console, then the processor halts. An exception taken in ring 3 (the saved
//! code selector has RPL 3) is the process's own fault: it is reported and the
//! process is killed while the kernel keeps running. Device interrupts come from the IOAPIC
//! and are acknowledged at the local APIC: the keyboard arrives at vector
//! 0x21 and the local APIC timer at vector 0x30, whose handler may switch to
//! another thread after acknowledging the interrupt. The 8259 is fully
//! masked, but its vectors 0x20-0x2F stay mapped to thunks so a spurious 8259
//! interrupt is absorbed. The local APIC's spurious vector is ignored without
//! any acknowledgement.

import Cpu from "./arch/x86_64/cpu";
import Lapic from "./arch/x86_64/lapic";
import Pic from "./arch/x86_64/pic";
import Color, Console from "./console";
import Process from "./process";
import Ps2 from "./ps2";
import Scheduler from "./scheduler";
import Serial from "./serial";
import Timer from "./timer";

/// The state `interrupt_asm.S` leaves on the stack, lowest address first.
/// The registers are pushed by the common stub, `vector` by the thunk, and
/// `errorCode` by the thunk when the processor did not push one. The last
/// five fields are the processor's own frame.
@cLayout
export record InterruptFrame {
  public rax: u64;
  public rbx: u64;
  public rcx: u64;
  public rdx: u64;
  public rsi: u64;
  public rdi: u64;
  public rbp: u64;
  public r8: u64;
  public r9: u64;
  public r10: u64;
  public r11: u64;
  public r12: u64;
  public r13: u64;
  public r14: u64;
  public r15: u64;
  public vector: u64;
  public errorCode: u64;
  public rip: u64;
  public cs: u64;
  public rflags: u64;
  public rsp: u64;
  public ss: u64;
}

export namespace Interrupts {
  const FIRST_IRQ_VECTOR: u64 = 32;
  const IRQ_VECTOR_COUNT: u64 = 16;

  /// The vector the IOAPIC raises for the keyboard. It equals the vector of
  /// 8259 line 1, which is harmless because that line is masked.
  const KEYBOARD_VECTOR: u64 = 0x21;

  /// The vector of the local APIC timer tick. It is just above the 8259
  /// vectors so nothing legacy shares it.
  const TIMER_VECTOR: u64 = 0x30;
  const PAGE_FAULT: u64 = 14;

  const DIVIDE_ERROR: u64 = 0;
  const DEBUG: u64 = 1;
  const NMI: u64 = 2;
  const BREAKPOINT: u64 = 3;
  const INVALID_OPCODE: u64 = 6;
  const X87_FAULT: u64 = 16;
  const ALIGNMENT_CHECK: u64 = 17;
  const MACHINE_CHECK: u64 = 18;
  const SIMD_FAULT: u64 = 19;

  /// Signal numbers of Linux x86_64, and the 128 a shell adds to report a
  /// process that died of one.
  const SIGILL: u64 = 4;
  const SIGTRAP: u64 = 5;
  const SIGBUS: u64 = 7;
  const SIGFPE: u64 = 8;
  const SIGSEGV: u64 = 11;
  const EXIT_STATUS_SIGNAL_BASE: u64 = 128;

  /// Called by the common stub for every vector, on the interrupted stack.
  @externName("ignis_interrupt_dispatch")
  function dispatch(frame: *mut InterruptFrame): void {
    let vector: u64 = (*frame).vector;

    if (vector == Lapic::spuriousVector()) {
      return;
    }

    if (vector == KEYBOARD_VECTOR) {
      Ps2::handleInterrupt();
      Lapic::endOfInterrupt();
      return;
    }

    if (vector == TIMER_VECTOR) {
      Timer::handleTick();
      Lapic::endOfInterrupt();
      Scheduler::onTick();
      return;
    }

    if (vector >= FIRST_IRQ_VECTOR && vector < FIRST_IRQ_VECTOR + IRQ_VECTOR_COUNT) {
      handleLegacyInterrupt((vector - FIRST_IRQ_VECTOR) as u8);
      return;
    }

    if (isUserFault(frame)) {
      killUserProcess(frame);
    }

    reportException(frame);

    Cpu::haltForever();
  }

  /// True for a processor exception that interrupted ring 3 and that a
  /// process can cause on its own. NMI and machine check are the machine's
  /// business, not the process's, and stay fatal.
  function isUserFault(frame: *mut InterruptFrame): boolean {
    let vector: u64 = (*frame).vector;

    return ((*frame).cs & 3) == 3 && vector < FIRST_IRQ_VECTOR && vector != NMI && vector != MACHINE_CHECK;
  }

  /// Reports what the process did and ends it. Never returns: the thread
  /// ends on its own kernel stack, which holds this frame, and the next
  /// thread frees the process's memory.
  function killUserProcess(frame: *mut InterruptFrame): never {
    let vector: u64 = (*frame).vector;

    Console::write("process ");
    Console::writeDecimal(Process::currentId());
    Console::write(" faulted: ");
    Console::write(mnemonic(vector));
    Console::write(" ");
    Console::write(name(vector));
    Console::write(" at rip ");
    Console::writeHex((*frame).rip);

    if (hasErrorCode(vector)) {
      Console::write(", error ");
      Console::writeHex((*frame).errorCode);
    }

    if (vector == PAGE_FAULT) {
      Console::write(", address ");
      Console::writeHex(readCr2());
    }

    Console::writeLine("");

    Process::killCurrent(EXIT_STATUS_SIGNAL_BASE + signalFor(vector));
  }

  /// The signal Linux sends for an exception, which a shell reports as
  /// 128 plus its number.
  function signalFor(vector: u64): u64 {
    if (vector == DIVIDE_ERROR || vector == X87_FAULT || vector == SIMD_FAULT) {
      return SIGFPE;
    }

    if (vector == INVALID_OPCODE) {
      return SIGILL;
    }

    if (vector == DEBUG || vector == BREAKPOINT) {
      return SIGTRAP;
    }

    if (vector == ALIGNMENT_CHECK) {
      return SIGBUS;
    }

    return SIGSEGV;
  }

  /// Absorbs an interrupt that came from the 8259, which is fully masked.
  /// A spurious one skips the acknowledgement of its own controller; any
  /// other is acknowledged and dropped.
  function handleLegacyInterrupt(line: u8): void {
    if (Pic::isSpurious(line)) {
      Pic::endSpurious(line);
      return;
    }

    Pic::endOfInterrupt(line);
  }

  /// Writes the exception to COM1 and to the console when it is up.
  function reportException(frame: *mut InterruptFrame): void {
    let vector: u64 = (*frame).vector;

    if (Console::isInitialized()) {
      Console::setColors(Color::BRIGHT_WHITE, Color::RED);
    }

    emitText("\nCPU exception ");
    emitText(mnemonic(vector));
    emitText(" ");
    emitText(name(vector));
    emitText("\n");

    emitText("  vector ");
    emitDecimal(vector);
    emitText(", error code ");

    if (hasErrorCode(vector)) {
      emitHex((*frame).errorCode);
    } else {
      emitText("none");
    }

    emitText("\n");

    emitText("  rip ");
    emitHex((*frame).rip);
    emitText(", cs ");
    emitHex((*frame).cs);
    emitText("\n");

    emitText("  rflags ");
    emitHex((*frame).rflags);
    emitText(", rsp ");
    emitHex((*frame).rsp);
    emitText("\n");

    if (vector == PAGE_FAULT) {
      emitText("  cr2 ");
      emitHex(readCr2());
      emitText("\n");
    }
  }

  /// True for the vectors where the processor pushes an error code: double
  /// fault, invalid TSS, segment not present, stack fault, general
  /// protection, page fault, alignment check, control protection, VMM
  /// communication and security exceptions. For the others the thunk pushes a
  /// dummy zero, which is not worth printing.
  function hasErrorCode(vector: u64): boolean {
    return match (vector) {
      8 -> true,
      10 -> true,
      11 -> true,
      12 -> true,
      13 -> true,
      14 -> true,
      17 -> true,
      21 -> true,
      29 -> true,
      30 -> true,
      _ -> false,
    };
  }

  function readCr2(): u64 {
    return asm () -> (value: u64 in rax) { mov {value}, cr2 };
  }

  /// The console mirrors everything it prints to COM1, so COM1 is written
  /// directly only while the console is not up.
  function emitText(value: str): void {
    if (Console::isInitialized()) {
      Console::write(value);
    } else {
      Serial::write(value);
    }
  }

  function emitHex(value: u64): void {
    if (Console::isInitialized()) {
      Console::writeHex(value);
    } else {
      Serial::writeHex(value);
    }
  }

  function emitDecimal(value: u64): void {
    if (Console::isInitialized()) {
      Console::writeDecimal(value);
    } else {
      Serial::writeDecimal(value);
    }
  }

  function mnemonic(vector: u64): str {
    return match (vector) {
      0 -> "#DE",
      1 -> "#DB",
      2 -> "NMI",
      3 -> "#BP",
      4 -> "#OF",
      5 -> "#BR",
      6 -> "#UD",
      7 -> "#NM",
      8 -> "#DF",
      9 -> "none",
      10 -> "#TS",
      11 -> "#NP",
      12 -> "#SS",
      13 -> "#GP",
      14 -> "#PF",
      16 -> "#MF",
      17 -> "#AC",
      18 -> "#MC",
      19 -> "#XM",
      20 -> "#VE",
      21 -> "#CP",
      28 -> "#HV",
      29 -> "#VC",
      30 -> "#SX",
      _ -> "reserved",
    };
  }

  function name(vector: u64): str {
    return match (vector) {
      0 -> "Divide Error",
      1 -> "Debug",
      2 -> "Non-Maskable Interrupt",
      3 -> "Breakpoint",
      4 -> "Overflow",
      5 -> "Bound Range Exceeded",
      6 -> "Invalid Opcode",
      7 -> "Device Not Available",
      8 -> "Double Fault",
      9 -> "Coprocessor Segment Overrun",
      10 -> "Invalid TSS",
      11 -> "Segment Not Present",
      12 -> "Stack-Segment Fault",
      13 -> "General Protection Fault",
      14 -> "Page Fault",
      16 -> "x87 Floating-Point Exception",
      17 -> "Alignment Check",
      18 -> "Machine Check",
      19 -> "SIMD Floating-Point Exception",
      20 -> "Virtualization Exception",
      21 -> "Control Protection Exception",
      28 -> "Hypervisor Injection Exception",
      29 -> "VMM Communication Exception",
      30 -> "Security Exception",
      _ -> "Reserved",
    };
  }
}
