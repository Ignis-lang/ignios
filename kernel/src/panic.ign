//!
//! # Panic Handler
//!
//! Where every `@panic(...)` in the kernel ends.
//!
//! ## Overview
//!
//! `onPanic` is registered with `@panicHandler`, so every `@panic(...)` call in
//! the kernel ends there. There is no unwinding: the machine stops in
//! `Arch::Cpu::haltForever`.
//!
//! The report goes to COM1, and to the console once it is initialized. On the
//! console it is bright white on red. On COM1 it is the same text with `\r\n`
//! line endings (added by `Drivers::Serial::write`). A panic raised while
//! reporting another one only reaches COM1, so a fault in the console cannot
//! recurse.
//!
//! The report turns interrupts off and makes the console and serial writes
//! skip their locks (`Drivers::Serial::bypassLocks`): the panic may come from
//! code that holds one of them, a rank violation included, and waiting for it
//! would hang the machine instead of reporting.
//!
//! This file is not a subsystem. `main.ign` imports it so the handler is
//! compiled in.

import Apic from "@apic";
import Arch from "@arch";
import Drivers from "@drivers";

/// Set by the first panic so a second panic knows the console path already
/// failed or is in use.
record PanicState {
  /// 1 once a panic is being reported, claimed with `xchg` so that of two
  /// processors panicking at once only one reports.
  static mut claimed: u64 = 0;

  /// The processor reporting it.
  static mut reporter: u64 = 0;
}

/// Reports the panic on COM1, and on the console once it is initialized, then
/// stops the machine. A panic raised while reporting another one only reaches
/// COM1, so a fault in the console cannot recurse.
///
/// The compiler routes every `@panic(...)` call here. `file` and `line` locate
/// the call in the Ignis source. Never returns.
///
/// On the console the report is bright white on red. On COM1 it is the same
/// text with `\r\n` line endings (added by `Drivers::Serial::write`).
@panicHandler
function onPanic(message: str, file: str, line: u32): never {
  Arch::Cpu::disableInterrupts();

  let first: boolean = Arch::Spin::exchange(@integerFromPointer(&mut PanicState::claimed as *mut u64)) == 0;

  // Another processor is already reporting a panic: this one stops quietly
  // instead of mixing its lines into the report.
  if (!first && @readVolatile<u64>(&mut PanicState::reporter as *mut u64) != Arch::CpuLocal::index()) {
    Arch::Cpu::haltForever();
  }

  if (first) {
    @writeVolatile<u64>(&mut PanicState::reporter as *mut u64, Arch::CpuLocal::index());
  }

  Drivers::Serial::bypassLocks();
  Apic::Lapic::stopOthers();

  if (!first || !Drivers::Console::isInitialized()) {
    Drivers::Serial::write("\npanic: ");
    Drivers::Serial::write(message);
    Drivers::Serial::write(" at ");
    Drivers::Serial::write(file);
    Drivers::Serial::write(":");
    Drivers::Serial::writeDecimal(line);
    Drivers::Serial::write("\n");

    Arch::Cpu::haltForever();
  }

  Drivers::Console::setColors(Drivers::Color::BRIGHT_WHITE, Drivers::Color::RED);
  Drivers::Console::write("\npanic: ");
  Drivers::Console::write(message);
  Drivers::Console::write(" at ");
  Drivers::Console::write(file);
  Drivers::Console::write(":");
  Drivers::Console::writeDecimal(line);
  Drivers::Console::write("\n");

  Arch::Cpu::haltForever();
}
