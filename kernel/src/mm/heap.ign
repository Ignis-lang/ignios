//!
//! # Kernel Heap
//!
//! A first-fit allocator over a region of the higher half that grows on
//! demand with frames from the PMM.
//!
//! ## Overview
//!
//! Every block starts with a 16-byte header, a size and a state tag, and the
//! payload follows, so payloads are 16-byte aligned. Free blocks are chained
//! in address order through a pointer stored in their payload, which lets
//! `free` merge a block with both neighbours. A request for a larger
//! alignment splits the space in front of the aligned payload off as a free
//! block of its own. `allocate` and `free` run with interrupts disabled,
//! which is all the mutual exclusion the single processor needs: no other
//! thread can run in the middle of a list update.
//!
//! The compiler's allocation handlers sit on top of it, so escaping capturing
//! closures allocate here.
//!
//! ## Block Layout
//!
//! ```text
//!   block address b (16-byte aligned)
//!   ┌──────────────┬──────────────┬──────────────────────────────────┐
//!   │ size   u64   │ tag    u64   │ payload                          │
//!   │ b + 0        │ b + 8        │ b + 16  <- pointer given out     │
//!   └──────────────┴──────────────┴──────────────────────────────────┘
//!    size = whole block, header included
//!
//!   used block:  tag = USED_TAG ("USED")
//!   free block:  tag = FREE_TAG ("FREE"), payload starts with `next`,
//!                the address of the next free block, or 0
//!
//!   ┌────────┬─────────────┐   ┌────────┬─────────────┐   ┌────────┬───
//!   │ FREE   │ next ───────┼──►│ FREE   │ next ───────┼──►│ FREE   │ ...
//!   └────────┴─────────────┘   └────────┴─────────────┘   └────────┴───
//!    HeapState::firstFree        address order: low to high
//! ```
//!
//! ## Allocation
//!
//! `takeFirstFit` walks the free list for the first block that can hold an
//! aligned payload. `carve` then cuts the used block out of it:
//!
//! ```text
//!   free block before:   [ gap ][ payload ........ ][ tail ]
//!                                ▲ aligned payload address
//!
//!   after carve:         [FREE gap][USED payload][FREE tail]
//!
//!   - the gap stays in the list as a free block, but only when it is at
//!     least MIN_BLOCK_SIZE (32 bytes). If it would be smaller, the payload
//!     moves up by one alignment unit instead, so the gap becomes big enough.
//!   - the tail becomes a new free block when it is at least MIN_BLOCK_SIZE,
//!     otherwise it is added to the used block.
//! ```
//!
//! When no block fits, `grow` maps `GROW_PAGES` (16) more pages, or more if
//! the request needs it, as one new free block at the end of the heap region
//! and the search runs again.
//!
//! ## Free and Merge
//!
//! `insertFree` puts the block in address order and merges it with the block
//! before it and the block after it when they touch. A block merged into a
//! neighbour has its tag overwritten with `ABSORBED_TAG`, so freeing a stale
//! pointer into it is caught instead of corrupting the list:
//!
//! ```text
//!   before:  [FREE a][USED b][FREE c]       free(b)
//!   after:   [FREE a + b + c]               b and c headers get "DEAD"
//! ```
//!
//! See concept doc 10.

import Arch from "@arch";
import _ from "./pmm";
import _ from "./vmm";

/// Heap state, touched only with interrupts disabled.
record HeapState {
  /// Virtual address just past the last mapped heap page. The heap occupies
  /// `BASE` up to this value.
  static mut mappedEnd: u64 = 0;

  /// Address of the first free block, or 0 when none is free.
  static mut firstFree: u64 = 0;

  /// Bytes in live blocks, headers included.
  static mut allocatedBytes: u64 = 0;
}

/// The heap API. `allocate` and `free` are the only entry points the rest of
/// the kernel needs.
namespace Mm::Heap {
  /// Start of the heap, in its own top-level slot away from the direct map.
  const BASE: u64 = 0xFFFFC00000000000;

  /// The most address space the heap may use: 256 MiB (`0x10000000`).
  const LIMIT_SIZE: u64 = 0x10000000;

  /// 4 KiB.
  const PAGE_SIZE: u64 = 4096;

  /// Pages mapped at once when the heap grows.
  const GROW_PAGES: u64 = 16;

  /// Bytes in front of every payload.
  const HEADER_SIZE: u64 = 16;

  /// The smallest alignment of a payload, and the granularity of block sizes.
  const MIN_ALIGNMENT: u64 = 16;

  /// A free block holds its header and the pointer to the next free block.
  const MIN_BLOCK_SIZE: u64 = 32;

  /// Tag of a free block: the ASCII bytes "FREE" as a number.
  const FREE_TAG: u64 = 0x46524545;

  /// Tag of a block in use: "USED".
  const USED_TAG: u64 = 0x55534544;

  /// Written over the header of a block that was merged into a neighbour, so
  /// a second `free` of a pointer into it is not taken for a live block.
  const ABSORBED_TAG: u64 = 0x44454144;

  /// Prepares an empty heap. Nothing is mapped until the first allocation.
  function initialize(): void {
    if (Mm::Vmm::translate(BASE) != Mm::Vmm::NOT_MAPPED) {
      @panic("heap: the heap base is already mapped");
    }

    HeapState::mappedEnd = BASE;
    HeapState::firstFree = 0;
    HeapState::allocatedBytes = 0;
  }

  /// Allocates `size` bytes aligned to `align`, which must be a power of
  /// two. Returns null when the alignment is invalid or the heap cannot grow
  /// any further.
  function allocate(size: u64, align: u64): *mut u8 {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();
    let pointer: *mut u8 = allocateLocked(size, align);

    Arch::Cpu::restoreInterrupts(saved);

    return pointer;
  }

  /// The body of `allocate`. Interrupts must be disabled. A size of 0 is served
  /// as a 1-byte request, so every allocation returns a distinct pointer.
  function allocateLocked(size: u64, align: u64): *mut u8 {
    if (align == 0 || (align & (align - 1)) != 0) {
      return null;
    }

    let alignment: u64 = align < MIN_ALIGNMENT ? MIN_ALIGNMENT : align;
    let payloadSize: u64 = alignUp(size == 0 ? 1 : size, MIN_ALIGNMENT);

    let mut payload: u64 = takeFirstFit(payloadSize, alignment);

    while (payload == 0) {
      if (!grow(payloadSize + alignment + HEADER_SIZE)) {
        return null;
      }

      payload = takeFirstFit(payloadSize, alignment);
    }

    return @pointerFromInteger<*mut u8>(payload);
  }

  /// Returns a block to the heap. Freeing null does nothing. A pointer that
  /// is not a live block is a kernel bug and panics, which includes a second
  /// free of a block, also after it was merged into a neighbour.
  function free(pointer: *mut u8): void {
    if (pointer == null) {
      return;
    }

    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();

    let payload: u64 = @integerFromPointer(pointer);
    let block: u64 = payload - HEADER_SIZE;

    if (payload % MIN_ALIGNMENT != 0 || block < BASE || payload >= HeapState::mappedEnd || readTag(block) != USED_TAG) {
      @panic("heap: free of a pointer that is not allocated");
    }

    HeapState::allocatedBytes -= readSize(block);
    insertFree(block, readSize(block));

    Arch::Cpu::restoreInterrupts(saved);
  }

  /// Bytes in live blocks, headers included.
  function allocatedBytes(): u64 {
    return HeapState::allocatedBytes;
  }

  /// Bytes of heap address space that are backed by frames.
  function mappedBytes(): u64 {
    return HeapState::mappedEnd - BASE;
  }

  /// Takes the first free block that can hold an aligned payload of
  /// `payloadSize` bytes, splits it, and returns the payload address, or 0.
  function takeFirstFit(payloadSize: u64, alignment: u64): u64 {
    let mut previous: u64 = 0;
    let mut block: u64 = HeapState::firstFree;

    while (block != 0) {
      let blockEnd: u64 = block + readSize(block);
      let mut payload: u64 = alignUp(block + HEADER_SIZE, alignment);

      if (payload - HEADER_SIZE != block && payload - HEADER_SIZE - block < MIN_BLOCK_SIZE) {
        payload += alignment;
      }

      if (payload + payloadSize <= blockEnd) {
        return carve(previous, block, payload, payloadSize);
      }

      previous = block;
      block = readNext(block);
    }

    return 0;
  }

  /// Cuts a used block with payload `payload` out of free block `block`.
  /// Space in front of it stays a free block in the list, space behind it
  /// becomes a new free block unless it is too small to be one, in which
  /// case it joins the used block.
  function carve(previous: u64, block: u64, payload: u64, payloadSize: u64): u64 {
    let blockEnd: u64 = block + readSize(block);
    let used: u64 = payload - HEADER_SIZE;
    let mut usedEnd: u64 = payload + payloadSize;
    let next: u64 = readNext(block);

    let mut following: u64 = next;

    if (blockEnd - usedEnd >= MIN_BLOCK_SIZE) {
      writeBlock(usedEnd, blockEnd - usedEnd, FREE_TAG);
      writeNext(usedEnd, next);
      following = usedEnd;
    } else {
      usedEnd = blockEnd;
    }

    if (used > block) {
      writeSize(block, used - block);
      writeNext(block, following);
    } else {
      relink(previous, following);
    }

    writeBlock(used, usedEnd - used, USED_TAG);
    HeapState::allocatedBytes += usedEnd - used;

    return payload;
  }

  /// Points `previous`, or the list head when it is 0, at `target`.
  function relink(previous: u64, target: u64): void {
    if (previous == 0) {
      HeapState::firstFree = target;
    } else {
      writeNext(previous, target);
    }
  }

  /// Adds a block to the address-ordered free list, merging it with the
  /// blocks right before and after it when they touch.
  function insertFree(block: u64, size: u64): void {
    let mut previous: u64 = 0;
    let mut next: u64 = HeapState::firstFree;

    while (next != 0 && next < block) {
      previous = next;
      next = readNext(next);
    }

    let mut start: u64 = block;
    let mut length: u64 = size;

    if (next != 0 && block + size == next) {
      length += readSize(next);
      writeTag(next, ABSORBED_TAG);
      next = readNext(next);
    }

    if (previous != 0 && previous + readSize(previous) == block) {
      length += readSize(previous);
      writeTag(block, ABSORBED_TAG);
      start = previous;
    } else {
      relink(previous, block);
    }

    writeBlock(start, length, FREE_TAG);
    writeNext(start, next);
  }

  /// Maps at least `minBytes` more heap, as one free block. Returns false
  /// when the limit is reached or the PMM has no frame left.
  function grow(minBytes: u64): boolean {
    let wanted: u64 = alignUp(minBytes, PAGE_SIZE) / PAGE_SIZE;
    let pages: u64 = wanted < GROW_PAGES ? GROW_PAGES : wanted;
    let start: u64 = HeapState::mappedEnd;

    if (start + pages * PAGE_SIZE > BASE + LIMIT_SIZE) {
      return false;
    }

    let mut mapped: u64 = 0;

    while (mapped < pages) {
      let frame: u64 = Mm::Pmm::allocateFrame();

      if (frame == Mm::Pmm::NO_FRAME) {
        break;
      }

      if (!Mm::Vmm::map(HeapState::mappedEnd, frame, Mm::Vmm::WRITABLE | Mm::Vmm::NO_EXECUTE)) {
        @panic("heap: a heap page was already mapped");
      }

      HeapState::mappedEnd += PAGE_SIZE;
      mapped += 1;
    }

    if (mapped == 0) {
      return false;
    }

    insertFree(start, mapped * PAGE_SIZE);

    return true;
  }

  /// Rounds `value` up to a multiple of `alignment`, a power of two.
  function alignUp(value: u64, alignment: u64): u64 {
    return (value + alignment - 1) & ~(alignment - 1);
  }

  /// Header and payload accessors. The address `block` is the start of the
  /// header: the size is at offset 0, the tag at 8 and the free-list link at 16.
  function readSize(block: u64): u64 {
    return *(@pointerFromInteger<*mut u64>(block));
  }

  /// The state tag of the block at `block`.
  function readTag(block: u64): u64 {
    return *(@pointerFromInteger<*mut u64>(block) + 1);
  }

  /// The free-list link stored in the payload of the free block at `block`.
  function readNext(block: u64): u64 {
    return *(@pointerFromInteger<*mut u64>(block) + 2);
  }

  /// Sets the size field of the header at `block`.
  function writeSize(block: u64, size: u64): void {
    *(@pointerFromInteger<*mut u64>(block)) = size;
  }

  /// Sets the free-list link of the free block at `block`.
  function writeNext(block: u64, next: u64): void {
    *(@pointerFromInteger<*mut u64>(block) + 2) = next;
  }

  /// Sets the tag field of the header at `block`.
  function writeTag(block: u64, tag: u64): void {
    *(@pointerFromInteger<*mut u64>(block) + 1) = tag;
  }

  /// Writes the size and the tag of the header at `block`.
  function writeBlock(block: u64, size: u64, tag: u64): void {
    let header: *mut u64 = @pointerFromInteger<*mut u64>(block);

    *header = size;
    *(header + 1) = tag;
  }

  /// The compiler's allocation hook. The compiler calls it for allocations it
  /// makes itself, such as the environment of an escaping closure. It panics
  /// when the heap is out of memory, because the compiler-generated code has no
  /// way to handle a null result.
  @allocHandler
  function onAllocate(size: u64, align: u64): *mut u8 {
    let pointer: *mut u8 = allocate(size, align);

    if (pointer == null) {
      @panic("heap: out of memory");
    }

    return pointer;
  }

  /// The compiler's release hook, the counterpart of `onAllocate`.
  @freeHandler
  function onFree(pointer: *mut u8): void {
    free(pointer);
  }
}
