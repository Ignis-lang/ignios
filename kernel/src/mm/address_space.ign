//!
//! # Per-Process Address Spaces
//!
//! One PML4 per process: a private lower half and the shared kernel half.
//!
//! ## Overview
//!
//! An address space is its PML4, identified by the physical address of that
//! frame. The lower half (PML4 entries 0 to 255, virtual addresses below
//! `USER_LIMIT`) is private: only the process's own pages are mapped there,
//! all with the U/S bit set. The upper half (entries 256 to 511) is the
//! kernel's: `create` copies those 256 entries from the kernel PML4, and
//! `Mm::Vmm::initialize` already gave every one of them a page directory pointer
//! table, so the copies point at the same tables for good. A kernel mapping
//! made after a space was created appears in that space too, and the kernel
//! code, the direct map and every kernel stack stay reachable after a CR3
//! load.
//!
//! ```text
//!   kernel PML4 (Mm::Vmm::rootTable)              process PML4 (Mm::AddressSpace::create)
//!   ┌────────────────────────────┐            ┌────────────────────────────┐
//!   │ 0..255   empty             │            │ 0..255   private, starts   │
//!   │                            │            │          empty, filled by  │
//!   │                            │            │          allocatePage      │
//!   ├────────────────────────────┤            ├────────────────────────────┤
//!   │ 256..511 ─► shared PDPTs ◄─┼────────────┼─ 256..511 same 256 entries │
//!   └────────────────────────────┘            └────────────────────────────┘
//! ```
//!
//! The page tables and the frames mapped in the lower half belong to the
//! space: `destroy` returns all of them to the PMM. The kernel half is never
//! freed, it is shared.
//!
//! ## Reaching User Memory
//!
//! The kernel reaches user memory through the page tables of the space, one
//! page at a time (`translateUser`), and not through a raw user pointer: a
//! bad pointer then fails a check instead of faulting in ring 0. Each copy
//! function splits the range at page boundaries, translates every page to a
//! physical address and copies through the direct map:
//!
//! ```text
//!   copyFromUser(root, dst, src, length)
//!     for each page-sized piece of [src, src + length):
//!       translateUser(root, address, forWrite=false)
//!           ├─ address >= USER_LIMIT ............ fail
//!           ├─ no leaf entry, not present ....... fail
//!           ├─ U/S clear ........................ fail
//!           └─ otherwise physical = frame | offset
//!       Lib::Mem::copy(dst + done, Boot::Hhdm::toVirtual(physical), chunk)
//! ```
//!
//! See concept doc 14.

import Arch from "@arch";
import Boot from "@boot";
import Lib from "@lib";
import _ from "./pmm";
import _ from "./vmm";

/// The address space API. A space is identified by the physical address of
/// its PML4, which every function here takes as `root`.
namespace Mm::AddressSpace {
  /// 4 KiB.
  const PAGE_SIZE: u64 = 4096;

  /// Entries in a table.
  const ENTRIES_PER_TABLE: u64 = 512;

  /// PML4 entries 0 to 255 are the user half. The kernel half starts at this
  /// index.
  const USER_HALF_ENTRIES: u64 = 256;

  /// One past the last user address a process may map. The last page below
  /// the 47-bit boundary stays unmapped on purpose: a `syscall` instruction
  /// at its very end would leave a non-canonical return address in RCX.
  const USER_LIMIT: u64 = 0x00007FFFFFFFF000;

  /// Returned by `translateUser` when the page is not mapped, not user
  /// accessible, or not writable when a write was asked for.
  const NOT_MAPPED: u64 = 0xFFFFFFFFFFFFFFFF;

  /// Makes an empty address space whose upper half is the kernel's. Returns
  /// the physical address of its PML4, or `Mm::Pmm::NO_FRAME` when no frame is
  /// left.
  function create(): u64 {
    let root: u64 = Mm::Pmm::allocateFrame();

    if (root == Mm::Pmm::NO_FRAME) {
      return Mm::Pmm::NO_FRAME;
    }

    let table: *mut u64 = Mm::Vmm::tableAt(root) as *mut u64;
    let kernelTable: *mut u64 = Mm::Vmm::tableAt(Mm::Vmm::rootTable()) as *mut u64;

    Lib::Mem::fill(table as *mut u8, 0, USER_HALF_ENTRIES * 8);
    Lib::Mem::copy((table + USER_HALF_ENTRIES) as *mut u8, (kernelTable + USER_HALF_ENTRIES) as *u8, USER_HALF_ENTRIES * 8);

    return root;
  }

  /// Frees every user page and page table of the space and its PML4. The
  /// space must not be the one the processor is running in, nor loaded on
  /// another: it is destroyed after the last thread of its process is gone,
  /// so no TLB shootdown is needed.
  function destroy(root: u64): void {
    if (Arch::Cpu::readCr3() == root) {
      @panic("address space: destroying the active space");
    }

    let pml4: *mut u64 = Mm::Vmm::tableAt(root) as *mut u64;
    let mut index: u64 = 0;

    while (index < USER_HALF_ENTRIES) {
      let entry: u64 = *(pml4 + index);

      if ((entry & Mm::Vmm::PRESENT) != 0) {
        freeLevel(entry & Mm::Vmm::ADDRESS_MASK, 3);
      }

      index += 1;
    }

    Mm::Pmm::freeFrame(root);
  }

  /// Loads the space into CR3 and records it as this processor's loaded
  /// root (`Mm::Vmm::loadRoot`).
  function activate(root: u64): void {
    Mm::Vmm::loadRoot(root);
  }

  /// Maps the page at `virtualAddress` in the space to the frame `frame`
  /// with the U/S bit set. Returns false and changes nothing when the address
  /// is not page aligned, is not below `USER_LIMIT`, or is already mapped.
  function mapPage(root: u64, virtualAddress: u64, frame: u64, flags: u64): boolean {
    if (virtualAddress >= USER_LIMIT) {
      return false;
    }

    return Mm::Vmm::mapIn(root, virtualAddress, frame, flags | Mm::Vmm::USER);
  }

  /// Maps the 2 MiB page at `virtualAddress` in the space to the 2 MiB
  /// frame `frame` (from `Mm::Pmm::allocateLargeFrame`) with the U/S bit
  /// set. The space owns the 512 frames from then on. Returns false and
  /// changes nothing when an address is not 2 MiB aligned, the page does
  /// not end below `USER_LIMIT`, or anything is mapped in its range.
  function mapLargePage(root: u64, virtualAddress: u64, frame: u64, flags: u64): boolean {
    if (virtualAddress >= USER_LIMIT || USER_LIMIT - virtualAddress < Mm::Vmm::LARGE_PAGE_SIZE) {
      return false;
    }

    return Mm::Vmm::mapLargeIn(root, virtualAddress, frame, flags | Mm::Vmm::USER);
  }

  /// Builds the page tables for the user range `[start, start + length)`
  /// without mapping any page, so faults in it later need only their own
  /// frame. Returns false when the range leaves the user half or no frame
  /// is available for a table.
  function prepareRange(root: u64, start: u64, length: u64): boolean {
    return isUserRange(start, length) && Mm::Vmm::prepareIn(root, start, length, Mm::Vmm::USER);
  }

  /// Maps the frame `frame`, which the caller zeroed and owns, at
  /// `virtualAddress`; panics when it cannot, because the caller prepared
  /// the tables (`prepareRange`) and checked the page was not mapped.
  function mapPrepared(root: u64, virtualAddress: u64, frame: u64, flags: u64): void {
    if (!mapPage(root, virtualAddress, frame, flags)) {
      @panic("address space: a page in a prepared range could not be mapped");
    }
  }

  /// Maps a new zeroed frame at `virtualAddress` and returns it, or
  /// `Mm::Pmm::NO_FRAME` when no frame is left or the address cannot be mapped.
  /// The space owns the frame from then on.
  function allocatePage(root: u64, virtualAddress: u64, flags: u64): u64 {
    let frame: u64 = Mm::Pmm::allocateFrame();

    if (frame == Mm::Pmm::NO_FRAME) {
      return Mm::Pmm::NO_FRAME;
    }

    Lib::Mem::fill(Boot::Hhdm::toVirtual(frame), 0, PAGE_SIZE);

    if (!mapPage(root, virtualAddress, frame, flags)) {
      Mm::Pmm::freeFrame(frame);
      return Mm::Pmm::NO_FRAME;
    }

    return frame;
  }

  /// Unmaps the 4 KiB user page at `virtualAddress` and frees its frame at
  /// once. Returns false and changes nothing when no 4 KiB user page is
  /// mapped there. The TLB entry is dropped on this processor only, so the
  /// space must be loaded on no other processor; a space the threads of a
  /// process share uses `detachPage`, `Sched::Shootdown::flush` and
  /// `releaseDetached` instead.
  function freePage(root: u64, virtualAddress: u64): boolean {
    if (virtualAddress >= USER_LIMIT) {
      return false;
    }

    let entry: u64 = Mm::Vmm::leafEntryIn(root, virtualAddress);

    if ((entry & Mm::Vmm::PRESENT) == 0 || (entry & Mm::Vmm::USER) == 0) {
      return false;
    }

    if (!Mm::Vmm::unmapIn(root, virtualAddress)) {
      return false;
    }

    Mm::Pmm::freeFrame(entry & Mm::Vmm::ADDRESS_MASK);

    return true;
  }

  /// First step of removing the 4 KiB user page at `virtualAddress`: the
  /// page stops being present, on this processor's TLB too, and its frame
  /// stays in the entry. Returns the old entry, or 0 when no 4 KiB user page
  /// is present there. The caller holds the address space lock until
  /// `releaseDetached`, and sends the shootdown in between.
  function detachPage(root: u64, virtualAddress: u64): u64 {
    if (virtualAddress >= USER_LIMIT) {
      return 0;
    }

    if ((Mm::Vmm::leafEntryIn(root, virtualAddress) & Mm::Vmm::USER) == 0) {
      return 0;
    }

    return Mm::Vmm::detachIn(root, virtualAddress);
  }

  /// Last step: clears the entry `detachPage` left at `virtualAddress`,
  /// frees its frame (a cache frame loses one reference) and returns the
  /// entry, or 0 when no page was detached there.
  function releaseDetached(root: u64, virtualAddress: u64): u64 {
    if (virtualAddress >= USER_LIMIT) {
      return 0;
    }

    let entry: u64 = Mm::Vmm::forgetIn(root, virtualAddress);

    if (entry != 0) {
      Mm::Pmm::freeFrame(entry & Mm::Vmm::ADDRESS_MASK);
    }

    return entry;
  }

  /// True when the byte range lies entirely below `USER_LIMIT`.
  function isUserRange(address: u64, length: u64): boolean {
    if (address >= USER_LIMIT || length > USER_LIMIT - address) {
      return false;
    }

    return true;
  }

  /// The physical address behind the user address `virtualAddress`, or
  /// `NOT_MAPPED` unless the page is present, user accessible, and writable
  /// when `forWrite`. The page may be a 4 KiB page or part of a 2 MiB page.
  function translateUser(root: u64, virtualAddress: u64, forWrite: boolean): u64 {
    if (virtualAddress >= USER_LIMIT) {
      return NOT_MAPPED;
    }

    let mut entry: u64 = Mm::Vmm::leafEntryIn(root, virtualAddress);
    let mut frameMask: u64 = Mm::Vmm::ADDRESS_MASK;
    let mut offsetMask: u64 = PAGE_SIZE - 1;

    if (entry == 0) {
      entry = Mm::Vmm::largeEntryIn(root, virtualAddress);
      frameMask = Mm::Vmm::LARGE_ADDRESS_MASK;
      offsetMask = Mm::Vmm::LARGE_PAGE_SIZE - 1;
    }

    if ((entry & Mm::Vmm::PRESENT) == 0 || (entry & Mm::Vmm::USER) == 0) {
      return NOT_MAPPED;
    }

    if (forWrite && (entry & Mm::Vmm::WRITABLE) == 0) {
      return NOT_MAPPED;
    }

    return (entry & frameMask) | (virtualAddress & offsetMask);
  }

  /// True when every page of the byte range is user accessible, and
  /// writable when `forWrite`, and the range stays in the user half.
  function isAccessible(root: u64, address: u64, length: u64, forWrite: boolean): boolean {
    if (!isUserRange(address, length)) {
      return false;
    }

    let mut done: u64 = 0;

    while (done < length) {
      if (translateUser(root, address + done, forWrite) == NOT_MAPPED) {
        return false;
      }

      done += bytesToPageEnd(address + done, length - done);
    }

    return true;
  }

  /// Copies `length` bytes from the user address `source` to the kernel
  /// buffer `destination`. Returns false, with the buffer partly written,
  /// when any byte of the range is outside the user half or on a page the
  /// process cannot read.
  function copyFromUser(root: u64, destination: *mut u8, source: u64, length: u64): boolean {
    if (!isUserRange(source, length)) {
      return false;
    }

    let mut done: u64 = 0;

    while (done < length) {
      let address: u64 = source + done;
      let physical: u64 = translateUser(root, address, false);

      if (physical == NOT_MAPPED) {
        return false;
      }

      let chunk: u64 = bytesToPageEnd(address, length - done);

      Lib::Mem::copy(destination + done, Boot::Hhdm::toVirtual(physical) as *u8, chunk);
      done += chunk;
    }

    return true;
  }

  /// Copies the NUL-terminated string at the user address `source` to the
  /// kernel buffer `destination`, which holds `capacity` bytes, NUL
  /// included. Returns the string length without the NUL; `capacity` when no
  /// NUL came within `capacity` bytes (the string is too long); `NOT_MAPPED`
  /// when a byte before the NUL is outside the user half or on a page the
  /// process cannot read. Reads one page at a time, so a string that ends
  /// just before an unmapped page is fine.
  function copyStringFromUser(root: u64, destination: *mut u8, source: u64, capacity: u64): u64 {
    let mut done: u64 = 0;

    while (done < capacity) {
      let address: u64 = source + done;

      if (!isUserRange(address, 1)) {
        return NOT_MAPPED;
      }

      let physical: u64 = translateUser(root, address, false);

      if (physical == NOT_MAPPED) {
        return NOT_MAPPED;
      }

      let chunk: u64 = bytesToPageEnd(address, capacity - done);
      let bytes: *u8 = Boot::Hhdm::toVirtual(physical) as *u8;
      let mut index: u64 = 0;

      while (index < chunk) {
        let byte: u8 = *(bytes + index);

        *(destination + done + index) = byte;

        if (byte == 0) {
          return done + index;
        }

        index += 1;
      }

      done += chunk;
    }

    return capacity;
  }

  /// Copies `length` bytes from the kernel buffer `source` to the user
  /// address `destination`. Returns false, with the range partly written,
  /// when any byte of it is outside the user half or on a page the process
  /// cannot write.
  function copyToUser(root: u64, destination: u64, source: *u8, length: u64): boolean {
    if (!isUserRange(destination, length)) {
      return false;
    }

    let mut done: u64 = 0;

    while (done < length) {
      let address: u64 = destination + done;
      let physical: u64 = translateUser(root, address, true);

      if (physical == NOT_MAPPED) {
        return false;
      }

      let chunk: u64 = bytesToPageEnd(address, length - done);

      Lib::Mem::copy(Boot::Hhdm::toVirtual(physical), source + done, chunk);
      done += chunk;
    }

    return true;
  }

  /// Writes `length` bytes from the kernel buffer `source` to the user
  /// address `destination` whatever the permissions of the pages are, for the
  /// loader to fill pages that stay read only for the process. Returns false
  /// when a page of the range is not mapped.
  function loadBytes(root: u64, destination: u64, source: *u8, length: u64): boolean {
    if (!isUserRange(destination, length)) {
      return false;
    }

    let mut done: u64 = 0;

    while (done < length) {
      let physical: u64 = Mm::Vmm::translateIn(root, destination + done);

      if (physical == Mm::Vmm::NOT_MAPPED) {
        return false;
      }

      let chunk: u64 = bytesToPageEnd(destination + done, length - done);

      Lib::Mem::copy(Boot::Hhdm::toVirtual(physical), source + done, chunk);
      done += chunk;
    }

    return true;
  }

  /// Bytes from `address` to the end of its page, at most `limit`.
  function bytesToPageEnd(address: u64, limit: u64): u64 {
    let room: u64 = PAGE_SIZE - (address & (PAGE_SIZE - 1));

    return room < limit ? room : limit;
  }

  /// Frees a table `level` levels above the page frames (3 is a page
  /// directory pointer table, 1 a page table) with everything below it.
  ///
  /// A page directory entry (level 2) with PS set is a 2 MiB page, not a
  /// table: its 512 frames are freed one by one. A PDPT entry (level 3) with
  /// PS set would be a 1 GiB page, which the kernel never creates, so it
  /// panics instead of walking page data as if it were a table.
  function freeLevel(table: u64, level: u64): void {
    let entries: *mut u64 = Mm::Vmm::tableAt(table) as *mut u64;
    let mut index: u64 = 0;

    while (index < ENTRIES_PER_TABLE) {
      let entry: u64 = *(entries + index);

      if ((entry & Mm::Vmm::PRESENT) != 0) {
        if (level == 1) {
          Mm::Pmm::freeFrame(entry & Mm::Vmm::ADDRESS_MASK);
        } else if ((entry & Mm::Vmm::HUGE) == 0) {
          freeLevel(entry & Mm::Vmm::ADDRESS_MASK, level - 1);
        } else if (level == 2) {
          freeLargeFrame(entry & Mm::Vmm::LARGE_ADDRESS_MASK);
        } else {
          @panic("address space: a 1 GiB page in the user half");
        }
      }

      index += 1;
    }

    Mm::Pmm::freeFrame(table);
  }

  /// Gives the 512 frames of the 2 MiB page at `frame` back to the PMM.
  function freeLargeFrame(frame: u64): void {
    let mut offset: u64 = 0;

    while (offset < Mm::Vmm::LARGE_PAGE_SIZE) {
      Mm::Pmm::freeFrame(frame + offset);
      offset += PAGE_SIZE;
    }
  }
}
