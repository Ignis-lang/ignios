//!
//! # Physical Memory Manager
//!
//! The frame allocator: one bit per 4 KiB frame, set when the frame is in use
//! or not managed, and a second bitmap that remembers which frames are
//! managed at all.
//!
//! ## Overview
//!
//! Only `usable` memory map entries are ever handed out. Bootloader
//! reclaimable memory stays reserved, because the kernel still runs on the
//! bootloader's stack and reads its responses. Frame 0 is never handed out,
//! so address 0 can mean "no frame" (`NO_FRAME`).
//!
//! The bitmap lives in the first usable region at or above 1 MiB that is big
//! enough, reached through the higher half direct map. That sizes it to the
//! machine instead of to a compile-time maximum. Every bitmap change holds
//! a spinlock taken with `lockIrq` (rank `Lib::Rank::FRAMES`), so neither
//! another thread, another processor nor an interrupt handler on this one
//! runs in the middle of it.
//!
//! ## Bitmap Layout
//!
//! ```text
//!   frame number f  <->  physical address f * 4096
//!
//!   word w of the bitmap covers frames w*64 .. w*64+63
//!   bit b of word w is frame w*64 + b     (bit 0 = lowest frame)
//!
//!        word 0                         word 1
//!   ┌───────────────────────┐   ┌───────────────────────┐
//!   │ 63 ........ 2  1  0   │   │ 127 ....... 66 65 64  │  ...
//!   │  1 .. 1 .. 1  1  1    │   │  0  0  1  0 ...       │
//!   └───────────────────────┘   └───────────────────────┘
//!     1 = used or never managed       0 = free
//! ```
//!
//! The bitmap needs `ceil(highest usable end / 4096 / 64)` words. For the
//! 256 MiB guest used in development that is 1024 words, 8 KiB, 2 frames;
//! with the managed bitmap and the reference counts (4 bytes a frame) the
//! three take 272 KiB.
//!
//! ## Managed Frames
//!
//! A set bit in the used bitmap means "allocated" or "never usable", and the
//! two cannot be told apart from that bit alone. A second bitmap of the same
//! size, right after the first, has a bit set for every frame the allocator
//! may hand out: the usable frames at boot minus frame 0 and the frames of
//! the two bitmaps. `freeFrame` and `isAllocated` look at both:
//!
//! ```text
//!   managed  used   meaning
//!   0        1      never usable (firmware, kernel image, MMIO, the bitmaps)
//!   1        1      allocated
//!   1        0      free
//!   0        0      never happens
//! ```
//!
//! Freeing a frame that is not "managed and used" is a kernel bug and
//! panics, so a wrong address can never put firmware or kernel memory on the
//! free list.
//!
//! ## Reference Counts
//!
//! A third array, right after the managed bitmap, holds one 32-bit reference
//! count per frame. An allocation sets it to 1, `reference` adds one when a
//! second address space maps the same frame, and `freeFrame` drops one; only
//! the last drop puts the frame back on the free list. Code that frees a
//! space (`Mm::AddressSpace::destroy`) therefore needs no idea of who else
//! maps a frame.
//!
//! ## Reservations
//!
//! A lazy mapping gets its frames only when it is touched, but its `mmap`
//! must already know they will be there. `reserve(n)` promises `n` of the
//! free frames: `reserved` grows, and `allocateFrame` refuses to dip below
//! it. The page fault that first touches a page takes its frame with
//! `allocateReserved`, which therefore never fails. Unused promises go back
//! with `unreserve`. Without swap this keeps the old guarantee: memory that
//! `mmap` granted is memory the process can use.
//!
//! ```text
//!   free frames:  ├──────── available ────────┼──── reserved ────┤
//!                 allocateFrame, reserve        allocateReserved
//! ```
//!
//! ## Allocation
//!
//! `takeFrame` scans word by word, starting at `searchWord`, for a word that
//! is not all ones, then takes the lowest clear bit. `searchWord` is a hint
//! that moves down when a lower frame is freed, so a freed frame is the next
//! one handed out. The scan wraps once around the bitmap before it gives up.
//!
//! See concept doc 08.

import Arch from "@arch";
import Boot from "@boot";
import Drivers from "@drivers";
import Lib from "@lib";

/// Allocator state. After `initialize`, every field changes only with
/// `PmmState::lock` held.
record PmmState {
  /// The bitmap, reached through the direct map. Null before `initialize`.
  static mut bitmap: *mut u64 = null;

  /// The managed bitmap, `wordCount` words right after `bitmap`. A set bit
  /// marks a frame the allocator may hand out.
  static mut managed: *mut u64 = null;

  /// Number of 64-bit words in the bitmap.
  static mut wordCount: u64 = 0;

  /// Frames that were usable at boot, the bitmap's own frames included.
  static mut usableFrames: u64 = 0;

  /// Frames currently free.
  static mut freeFrames: u64 = 0;

  /// Free frames promised to reservations (`reserve`): only
  /// `allocateReserved` may take them.
  static mut reserved: u64 = 0;

  /// Index of the word where the next scan starts.
  static mut searchWord: u64 = 0;

  /// One reference count per frame, `wordCount * 64` of them right after the
  /// managed bitmap. Meaningful only for allocated frames.
  static mut references: *mut u32 = null;

  /// Taken with `lockIrq` around every bitmap change, rank
  /// `Lib::Rank::FRAMES`.
  static mut lock: Arch::SpinLock;
}

/// The frame allocator API. Frames are identified by their physical address,
/// which is always a multiple of `FRAME_SIZE`.
namespace Mm::Pmm {
  /// Size of a frame: 4 KiB, the smallest page the page tables map.
  const FRAME_SIZE: u64 = 4096;

  /// Frames tracked per bitmap word.
  const BITS_PER_WORD: u64 = 64;

  /// A bitmap word with every bit set, meaning no frame in it is free.
  const ALL_USED: u64 = 0xFFFFFFFFFFFFFFFF;

  /// 1 MiB. Memory below it is scarce on a PC (real mode, legacy devices), so
  /// the bitmap is placed above it when possible.
  const LOW_MEMORY_LIMIT: u64 = 0x100000;

  /// Returned by `allocateFrame` and `allocateLargeFrame` when no frame is
  /// free.
  const NO_FRAME: u64 = 0;

  /// Size of a large frame: 2 MiB, what one page directory entry maps.
  const LARGE_FRAME_SIZE: u64 = 2097152;

  /// Bitmap words that cover one large frame: 512 frames / 64 bits per word.
  const WORDS_PER_LARGE_FRAME: u64 = 8;

  /// Builds both bitmaps from the Limine memory map. Everything starts as
  /// used and unmanaged; only usable frames are cleared and marked managed,
  /// and the bitmaps' own frames are then taken back out.
  function initialize(): void {
    Arch::Spin::initialize(frameLock(), Lib::Rank::FRAMES);

    let memmap: *mut Boot::Limine::MemmapResponse = Boot::Limine::memmap();

    if (memmap == null) {
      @panic("Limine provided no memory map");
    }

    let highest: u64 = highestUsableEnd(memmap);

    if (highest == 0) {
      @panic("pmm: the memory map has no usable memory");
    }

    let words: u64 = (highest / FRAME_SIZE + BITS_PER_WORD - 1) / BITS_PER_WORD;
    let bytes: u64 = words * 8;
    let countBytes: u64 = words * BITS_PER_WORD * 4;
    let bitmapBase: u64 = findBitmapRegion(memmap, bytes * 2 + countBytes);

    PmmState::bitmap = Boot::Hhdm::toVirtual(bitmapBase) as *mut u64;
    PmmState::managed = PmmState::bitmap + words;
    PmmState::references = (PmmState::managed + words) as *mut u32;
    PmmState::wordCount = words;
    PmmState::usableFrames = 0;
    PmmState::freeFrames = 0;
    PmmState::searchWord = 0;

    Lib::Mem::fill(PmmState::bitmap as *mut u8, 0xFF, bytes);
    Lib::Mem::fill(PmmState::managed as *mut u8, 0, bytes);

    let mut index: u64 = 0;

    while (index < (*memmap).entryCount) {
      let entry: *mut Boot::Limine::MemmapEntry = Boot::Limine::memmapEntry(memmap, index);

      if ((*entry).kind == Boot::Limine::MEMMAP_USABLE) {
        releaseRange((*entry).base, (*entry).length);
      }

      index += 1;
    }

    reserveRange(bitmapBase, bytes * 2 + countBytes);
  }

  /// The physical address of a free frame, or `NO_FRAME`. The frame is not
  /// zeroed. Frames promised to reservations are not handed out here.
  function allocateFrame(): u64 {
    Arch::Spin::lockIrq(frameLock());

    let mut frame: u64 = NO_FRAME;

    if (PmmState::freeFrames > PmmState::reserved) {
      frame = takeFrame();
    }

    Arch::Spin::unlockIrq(frameLock());

    return frame;
  }

  /// The physical address of 2 MiB of free, contiguous, 2 MiB aligned
  /// memory, or `NO_FRAME`. The memory is not zeroed. It is 512 ordinary
  /// frames, and each of them is given back with `freeFrame`.
  ///
  /// A 2 MiB aligned run starts at a frame number that is a multiple of 512,
  /// so it is exactly the 8 bitmap words from a word index that is a
  /// multiple of 8. The scan looks for 8 such words that are all zero.
  function allocateLargeFrame(): u64 {
    Arch::Spin::lockIrq(frameLock());

    let mut word: u64 = 0;

    while (PmmState::freeFrames - PmmState::reserved >= WORDS_PER_LARGE_FRAME * BITS_PER_WORD && word + WORDS_PER_LARGE_FRAME <= PmmState::wordCount) {
      if (isRunFree(word)) {
        let mut index: u64 = 0;

        while (index < WORDS_PER_LARGE_FRAME) {
          *(PmmState::bitmap + word + index) = ALL_USED;
          index += 1;
        }

        let mut frame: u64 = 0;

        while (frame < WORDS_PER_LARGE_FRAME * BITS_PER_WORD) {
          *(PmmState::references + word * BITS_PER_WORD + frame) = 1;
          frame += 1;
        }

        PmmState::freeFrames -= WORDS_PER_LARGE_FRAME * BITS_PER_WORD;
        Arch::Spin::unlockIrq(frameLock());

        return word * BITS_PER_WORD * FRAME_SIZE;
      }

      word += WORDS_PER_LARGE_FRAME;
    }

    Arch::Spin::unlockIrq(frameLock());

    return NO_FRAME;
  }

  /// True when the `WORDS_PER_LARGE_FRAME` words from `word` have every
  /// frame free.
  function isRunFree(word: u64): boolean {
    let mut index: u64 = 0;

    while (index < WORDS_PER_LARGE_FRAME) {
      if (*(PmmState::bitmap + word + index) != 0) {
        return false;
      }

      index += 1;
    }

    return true;
  }

  /// Finds and marks a free frame, with the frame lock held.
  function takeFrame(): u64 {
    let words: u64 = PmmState::wordCount;
    let mut word: u64 = PmmState::searchWord;
    let mut scanned: u64 = 0;

    while (scanned < words) {
      let value: u64 = *(PmmState::bitmap + word);

      if (value != ALL_USED) {
        let frame: u64 = word * BITS_PER_WORD + firstClearBit(value);

        setUsed(frame);
        *(PmmState::references + frame) = 1;
        PmmState::searchWord = word;
        PmmState::freeFrames -= 1;

        return frame * FRAME_SIZE;
      }

      word += 1;
      scanned += 1;

      if (word == words) {
        word = 0;
      }
    }

    return NO_FRAME;
  }

  /// Promises `count` free frames to the caller: they stay out of
  /// `allocateFrame` and `allocateLargeFrame`, and `allocateReserved` takes
  /// them one at a time. Returns false, promising nothing, when fewer than
  /// `count` frames are free and not promised already. This is commit
  /// accounting: memory promised to a lazy mapping is there when the mapping
  /// is first touched.
  function reserve(count: u64): boolean {
    Arch::Spin::lockIrq(frameLock());

    let granted: boolean = PmmState::freeFrames - PmmState::reserved >= count;

    if (granted) {
      PmmState::reserved += count;
    }

    Arch::Spin::unlockIrq(frameLock());

    return granted;
  }

  /// Gives back `count` promised frames that were never taken. Panics when
  /// fewer are promised.
  function unreserve(count: u64): void {
    Arch::Spin::lockIrq(frameLock());

    if (count > PmmState::reserved) {
      @panic("pmm: unreserve of more frames than are reserved");
    }

    PmmState::reserved -= count;
    Arch::Spin::unlockIrq(frameLock());
  }

  /// Takes one frame of a reservation the caller holds. Never fails: a
  /// reservation always has its frame. Panics when nothing is reserved.
  function allocateReserved(): u64 {
    Arch::Spin::lockIrq(frameLock());

    if (PmmState::reserved == 0) {
      @panic("pmm: allocateReserved without a reservation");
    }

    let frame: u64 = takeFrame();

    if (frame == NO_FRAME) {
      @panic("pmm: a reserved frame was missing");
    }

    PmmState::reserved -= 1;
    Arch::Spin::unlockIrq(frameLock());

    return frame;
  }

  /// Free frames not promised to a reservation: what `allocateFrame` and
  /// `reserve` can still hand out.
  function availableFrameCount(): u64 {
    return PmmState::freeFrames - PmmState::reserved;
  }

  /// Frames promised to reservations.
  function reservedFrameCount(): u64 {
    return PmmState::reserved;
  }

  /// Adds a reference to the allocated frame at `address`: one more
  /// `freeFrame` is then needed before it goes back. Panics unless it is
  /// allocated.
  function reference(address: u64): void {
    Arch::Spin::lockIrq(frameLock());

    if (!isAllocated(address)) {
      @panic("pmm: reference to a frame that is not allocated");
    }

    *(PmmState::references + address / FRAME_SIZE) += 1;
    Arch::Spin::unlockIrq(frameLock());
  }

  /// The references of the frame at `address`, 0 when it is not allocated.
  function referenceCount(address: u64): u64 {
    Arch::Spin::lockIrq(frameLock());

    let count: u64 = isAllocated(address) ? *(PmmState::references + address / FRAME_SIZE) as u64 : 0;

    Arch::Spin::unlockIrq(frameLock());

    return count;
  }

  /// Drops a reference to the frame at `address`; the last one returns the
  /// frame to the allocator. Panics unless `address` is an allocated frame:
  /// a misaligned address, one beyond the bitmap, a frame that is already
  /// free, and a frame that was never usable are all kernel bugs.
  function freeFrame(address: u64): void {
    Arch::Spin::lockIrq(frameLock());

    if (!isAllocated(address)) {
      @panic("pmm: free of a frame that is not allocated");
    }

    let frame: u64 = address / FRAME_SIZE;
    let count: *mut u32 = PmmState::references + frame;

    *count -= 1;

    if (*count > 0) {
      Arch::Spin::unlockIrq(frameLock());
      return;
    }

    setFree(frame);
    PmmState::freeFrames += 1;

    if (frame / BITS_PER_WORD < PmmState::searchWord) {
      PmmState::searchWord = frame / BITS_PER_WORD;
    }

    Arch::Spin::unlockIrq(frameLock());
  }

  /// `PmmState::lock`.
  function frameLock(): *mut Arch::SpinLock {
    return &mut PmmState::lock as *mut Arch::SpinLock;
  }

  /// True when `address` is the start of a frame the allocator handed out
  /// and nobody freed yet. False for a free frame, a frame that was never
  /// usable, a misaligned address and an address beyond the bitmap.
  function isAllocated(address: u64): boolean {
    let frame: u64 = address / FRAME_SIZE;

    if (address % FRAME_SIZE != 0 || frame >= PmmState::wordCount * BITS_PER_WORD) {
      return false;
    }

    return isManaged(frame) && isUsed(frame);
  }

  /// Frames that were usable at boot, including the ones the bitmaps
  /// occupy. The bitmaps' frames are counted but never free.
  function totalFrames(): u64 {
    return PmmState::usableFrames;
  }

  /// Frames currently free.
  function freeFrameCount(): u64 {
    return PmmState::freeFrames;
  }

  /// Prints the frame counts: `pmm: 53469 usable frames, 53465 free (208 MiB)`.
  function report(): void {
    Drivers::Console::write("pmm: ");
    Drivers::Console::writeDecimal(totalFrames());
    Drivers::Console::write(" usable frames, ");
    Drivers::Console::writeDecimal(freeFrameCount());
    Drivers::Console::write(" free (");
    Drivers::Console::writeDecimal(freeFrameCount() * 4 / 1024);
    Drivers::Console::writeLine(" MiB)");
  }

  /// Prints the number of memory-map entries and the higher half direct map
  /// offset. Panics when Limine answered neither request.
  function reportMemoryMap(): void {
    let memmap: *mut Boot::Limine::MemmapResponse = Boot::Limine::memmap();

    if (memmap == null) {
      @panic("Limine provided no memory map");
    }

    let hhdm: *mut Boot::Limine::HhdmResponse = Boot::Limine::hhdm();

    if (hhdm == null) {
      @panic("Limine provided no higher half direct map");
    }

    Drivers::Console::write("memory map: ");
    Drivers::Console::writeDecimal((*memmap).entryCount);
    Drivers::Console::write(" entries, hhdm offset ");
    Drivers::Console::writeHex((*hhdm).offset);
    Drivers::Console::writeLine("");
  }

  /// The end of the highest usable entry.
  function highestUsableEnd(memmap: *mut Boot::Limine::MemmapResponse): u64 {
    let mut highest: u64 = 0;
    let mut index: u64 = 0;

    while (index < (*memmap).entryCount) {
      let entry: *mut Boot::Limine::MemmapEntry = Boot::Limine::memmapEntry(memmap, index);
      let end: u64 = (*entry).base + (*entry).length;

      if ((*entry).kind == Boot::Limine::MEMMAP_USABLE && end > highest) {
        highest = end;
      }

      index += 1;
    }

    return highest;
  }

  /// The base of the first usable entry that can hold `bytes`, preferring
  /// memory above 1 MiB so the scarce low memory stays free.
  function findBitmapRegion(memmap: *mut Boot::Limine::MemmapResponse, bytes: u64): u64 {
    let needed: u64 = (bytes + FRAME_SIZE - 1) / FRAME_SIZE * FRAME_SIZE;
    let mut lowFallback: u64 = 0;
    let mut index: u64 = 0;

    while (index < (*memmap).entryCount) {
      let entry: *mut Boot::Limine::MemmapEntry = Boot::Limine::memmapEntry(memmap, index);

      if ((*entry).kind == Boot::Limine::MEMMAP_USABLE && (*entry).length >= needed) {
        if ((*entry).base >= LOW_MEMORY_LIMIT) {
          return (*entry).base;
        }

        if (lowFallback == 0) {
          lowFallback = (*entry).base;
        }
      }

      index += 1;
    }

    if (lowFallback == 0) {
      @panic("pmm: no usable region can hold the bitmap");
    }

    return lowFallback;
  }

  /// Marks every frame of a usable range free and managed, except frame 0.
  function releaseRange(base: u64, length: u64): void {
    let mut frame: u64 = base / FRAME_SIZE;
    let end: u64 = (base + length) / FRAME_SIZE;

    while (frame < end) {
      if (frame != 0) {
        setFree(frame);
        setManaged(frame, true);
        PmmState::usableFrames += 1;
        PmmState::freeFrames += 1;
      }

      frame += 1;
    }
  }

  /// Marks every frame touched by `[base, base + length)` used and not
  /// managed, for good, and takes it out of the free count.
  function reserveRange(base: u64, length: u64): void {
    let mut frame: u64 = base / FRAME_SIZE;
    let end: u64 = (base + length + FRAME_SIZE - 1) / FRAME_SIZE;

    while (frame < end) {
      if (!isUsed(frame)) {
        setUsed(frame);
        PmmState::freeFrames -= 1;
      }

      setManaged(frame, false);

      frame += 1;
    }
  }

  /// True when the bit of `frame` is set.
  function isUsed(frame: u64): boolean {
    let word: u64 = *(PmmState::bitmap + frame / BITS_PER_WORD);

    return ((word >> (frame % BITS_PER_WORD)) & 1) != 0;
  }

  /// True when the managed bit of `frame` is set.
  function isManaged(frame: u64): boolean {
    let word: u64 = *(PmmState::managed + frame / BITS_PER_WORD);

    return ((word >> (frame % BITS_PER_WORD)) & 1) != 0;
  }

  /// Sets or clears the managed bit of `frame`.
  function setManaged(frame: u64, value: boolean): void {
    let word: *mut u64 = PmmState::managed + frame / BITS_PER_WORD;
    let bit: u64 = (1 as u64) << (frame % BITS_PER_WORD);

    if (value) {
      *word = *word | bit;
    } else {
      *word = *word & ~bit;
    }
  }

  /// Sets the bit of `frame`.
  function setUsed(frame: u64): void {
    let word: *mut u64 = PmmState::bitmap + frame / BITS_PER_WORD;

    *word = *word | ((1 as u64) << (frame % BITS_PER_WORD));
  }

  /// Clears the bit of `frame`.
  function setFree(frame: u64): void {
    let word: *mut u64 = PmmState::bitmap + frame / BITS_PER_WORD;

    *word = *word & ~((1 as u64) << (frame % BITS_PER_WORD));
  }

  /// Index of the lowest clear bit of `word`, which must not be all ones.
  function firstClearBit(word: u64): u64 {
    let mut bit: u64 = 0;

    while (((word >> bit) & 1) != 0) {
      bit += 1;
    }

    return bit;
  }
}
