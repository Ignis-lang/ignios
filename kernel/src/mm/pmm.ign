//!
//! # Physical Memory Manager
//!
//! The frame allocator: one bit per 4 KiB frame, set when the frame is in use
//! or not managed.
//!
//! ## Overview
//!
//! Only `usable` memory map entries are ever handed out. Bootloader
//! reclaimable memory stays reserved, because the kernel still runs on the
//! bootloader's stack and reads its responses. Frame 0 is never handed out,
//! so address 0 can mean "no frame" (`NO_FRAME`).
//!
//! The bitmap lives in the first usable region at or above 1 MiB that is big
//! enough, reached through the higher half direct map. That sizes it to the
//! machine instead of to a compile-time maximum. `allocateFrame` and
//! `freeFrame` run with interrupts disabled, which is all the mutual
//! exclusion the single processor needs: no other thread can run in the
//! middle of a bitmap update.
//!
//! ## Bitmap Layout
//!
//! ```text
//!   frame number f  <->  physical address f * 4096
//!
//!   word w of the bitmap covers frames w*64 .. w*64+63
//!   bit b of word w is frame w*64 + b     (bit 0 = lowest frame)
//!
//!        word 0                         word 1
//!   ┌───────────────────────┐   ┌───────────────────────┐
//!   │ 63 ........ 2  1  0   │   │ 127 ....... 66 65 64  │  ...
//!   │  1 .. 1 .. 1  1  1    │   │  0  0  1  0 ...       │
//!   └───────────────────────┘   └───────────────────────┘
//!     1 = used or never managed       0 = free
//! ```
//!
//! The bitmap needs `ceil(highest usable end / 4096 / 64)` words. For the
//! 256 MiB guest used in development that is 1024 words, 8 KiB, 2 frames.
//!
//! ## Allocation
//!
//! `takeFrame` scans word by word, starting at `searchWord`, for a word that
//! is not all ones, then takes the lowest clear bit. `searchWord` is a hint
//! that moves down when a lower frame is freed, so a freed frame is the next
//! one handed out. The scan wraps once around the bitmap before it gives up.
//!
//! See concept doc 08.

import Arch from "@arch";
import Boot from "@boot";
import Lib from "@lib";

/// Allocator state. Every field is touched only with interrupts disabled.
record PmmState {
  /// The bitmap, reached through the direct map. Null before `initialize`.
  static mut bitmap: *mut u64 = null;

  /// Number of 64-bit words in the bitmap.
  static mut wordCount: u64 = 0;

  /// Frames that were usable at boot, the bitmap's own frames included.
  static mut usableFrames: u64 = 0;

  /// Frames currently free.
  static mut freeFrames: u64 = 0;

  /// Index of the word where the next scan starts.
  static mut searchWord: u64 = 0;
}

/// The frame allocator API. Frames are identified by their physical address,
/// which is always a multiple of `FRAME_SIZE`.
namespace Mm::Pmm {
  /// Size of a frame: 4 KiB, the smallest page the page tables map.
  const FRAME_SIZE: u64 = 4096;

  /// Frames tracked per bitmap word.
  const BITS_PER_WORD: u64 = 64;

  /// A bitmap word with every bit set, meaning no frame in it is free.
  const ALL_USED: u64 = 0xFFFFFFFFFFFFFFFF;

  /// 1 MiB. Memory below it is scarce on a PC (real mode, legacy devices), so
  /// the bitmap is placed above it when possible.
  const LOW_MEMORY_LIMIT: u64 = 0x100000;

  /// Frames the self-test allocates at once. The test keeps their addresses in
  /// an array of this size.
  const SELF_TEST_FRAMES: u64 = 8;

  /// Returned by `allocateFrame` when no frame is free.
  const NO_FRAME: u64 = 0;

  /// Builds the bitmap from the Limine memory map. Everything starts as
  /// used; only usable frames are cleared.
  function initialize(): void {
    let memmap: *mut Boot::Limine::MemmapResponse = Boot::Limine::memmap();

    if (memmap == null) {
      @panic("Limine provided no memory map");
    }

    let highest: u64 = highestUsableEnd(memmap);

    if (highest == 0) {
      @panic("pmm: the memory map has no usable memory");
    }

    let words: u64 = (highest / FRAME_SIZE + BITS_PER_WORD - 1) / BITS_PER_WORD;
    let bytes: u64 = words * 8;
    let bitmapBase: u64 = findBitmapRegion(memmap, bytes);

    PmmState::bitmap = Boot::Hhdm::toVirtual(bitmapBase) as *mut u64;
    PmmState::wordCount = words;
    PmmState::usableFrames = 0;
    PmmState::freeFrames = 0;
    PmmState::searchWord = 0;

    Lib::Mem::fill(PmmState::bitmap as *mut u8, 0xFF, bytes);

    let mut index: u64 = 0;

    while (index < (*memmap).entryCount) {
      let entry: *mut Boot::Limine::MemmapEntry = Boot::Limine::memmapEntry(memmap, index);

      if ((*entry).kind == Boot::Limine::MEMMAP_USABLE) {
        releaseRange((*entry).base, (*entry).length);
      }

      index += 1;
    }

    reserveRange(bitmapBase, bytes);
  }

  /// The physical address of a free frame, or `NO_FRAME`. The frame is not
  /// zeroed.
  function allocateFrame(): u64 {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();
    let frame: u64 = takeFrame();

    Arch::Cpu::restoreInterrupts(saved);

    return frame;
  }

  /// Finds and marks a free frame. Interrupts must be disabled.
  function takeFrame(): u64 {
    let words: u64 = PmmState::wordCount;
    let mut word: u64 = PmmState::searchWord;
    let mut scanned: u64 = 0;

    while (scanned < words) {
      let value: u64 = *(PmmState::bitmap + word);

      if (value != ALL_USED) {
        let frame: u64 = word * BITS_PER_WORD + firstClearBit(value);

        setUsed(frame);
        PmmState::searchWord = word;
        PmmState::freeFrames -= 1;

        return frame * FRAME_SIZE;
      }

      word += 1;
      scanned += 1;

      if (word == words) {
        word = 0;
      }
    }

    return NO_FRAME;
  }

  /// Returns a frame to the allocator. A misaligned address, one beyond the
  /// bitmap, or a frame that is already free is a kernel bug and panics. The
  /// check cannot tell an allocated frame from one that was never usable: both
  /// are "used" in the bitmap.
  function freeFrame(address: u64): void {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();
    let frame: u64 = address / FRAME_SIZE;

    if (address % FRAME_SIZE != 0 || frame >= PmmState::wordCount * BITS_PER_WORD || !isUsed(frame)) {
      @panic("pmm: free of a frame that is not allocated");
    }

    setFree(frame);
    PmmState::freeFrames += 1;

    if (frame / BITS_PER_WORD < PmmState::searchWord) {
      PmmState::searchWord = frame / BITS_PER_WORD;
    }

    Arch::Cpu::restoreInterrupts(saved);
  }

  /// Frames the allocator manages: every usable frame at boot, including the
  /// ones the bitmap itself occupies.
  function totalFrames(): u64 {
    return PmmState::usableFrames;
  }

  /// Frames currently free.
  function freeFrameCount(): u64 {
    return PmmState::freeFrames;
  }

  /// Allocates and frees a few frames and checks the allocator's promises:
  /// aligned non-zero frames, no frame handed out twice, the free count
  /// following every step, and a freed frame coming back first. Panics on
  /// the first violation.
  function selfTest(): void {
    let mut frames: u64[8];
    let before: u64 = PmmState::freeFrames;

    let mut index: u64 = 0;

    while (index < SELF_TEST_FRAMES) {
      let frame: u64 = allocateFrame();

      if (frame == NO_FRAME || frame % FRAME_SIZE != 0) {
        @panic("pmm self-test: bad frame");
      }

      let mut earlier: u64 = 0;

      while (earlier < index) {
        if (frames[earlier] == frame) {
          @panic("pmm self-test: frame handed out twice");
        }

        earlier += 1;
      }

      frames[index] = frame;
      index += 1;
    }

    if (PmmState::freeFrames != before - SELF_TEST_FRAMES) {
      @panic("pmm self-test: free count did not drop");
    }

    let reused: u64 = frames[3];

    freeFrame(reused);

    if (allocateFrame() != reused) {
      @panic("pmm self-test: freed frame was not reused");
    }

    index = 0;

    while (index < SELF_TEST_FRAMES) {
      freeFrame(frames[index]);
      index += 1;
    }

    if (PmmState::freeFrames != before) {
      @panic("pmm self-test: free count did not recover");
    }
  }

  /// The end of the highest usable entry.
  function highestUsableEnd(memmap: *mut Boot::Limine::MemmapResponse): u64 {
    let mut highest: u64 = 0;
    let mut index: u64 = 0;

    while (index < (*memmap).entryCount) {
      let entry: *mut Boot::Limine::MemmapEntry = Boot::Limine::memmapEntry(memmap, index);
      let end: u64 = (*entry).base + (*entry).length;

      if ((*entry).kind == Boot::Limine::MEMMAP_USABLE && end > highest) {
        highest = end;
      }

      index += 1;
    }

    return highest;
  }

  /// The base of the first usable entry that can hold `bytes`, preferring
  /// memory above 1 MiB so the scarce low memory stays free.
  function findBitmapRegion(memmap: *mut Boot::Limine::MemmapResponse, bytes: u64): u64 {
    let needed: u64 = (bytes + FRAME_SIZE - 1) / FRAME_SIZE * FRAME_SIZE;
    let mut lowFallback: u64 = 0;
    let mut index: u64 = 0;

    while (index < (*memmap).entryCount) {
      let entry: *mut Boot::Limine::MemmapEntry = Boot::Limine::memmapEntry(memmap, index);

      if ((*entry).kind == Boot::Limine::MEMMAP_USABLE && (*entry).length >= needed) {
        if ((*entry).base >= LOW_MEMORY_LIMIT) {
          return (*entry).base;
        }

        if (lowFallback == 0) {
          lowFallback = (*entry).base;
        }
      }

      index += 1;
    }

    if (lowFallback == 0) {
      @panic("pmm: no usable region can hold the bitmap");
    }

    return lowFallback;
  }

  /// Marks every frame of a usable range free, except frame 0.
  function releaseRange(base: u64, length: u64): void {
    let mut frame: u64 = base / FRAME_SIZE;
    let end: u64 = (base + length) / FRAME_SIZE;

    while (frame < end) {
      if (frame != 0) {
        setFree(frame);
        PmmState::usableFrames += 1;
        PmmState::freeFrames += 1;
      }

      frame += 1;
    }
  }

  /// Marks every frame touched by `[base, base + length)` used and takes it
  /// out of the free count.
  function reserveRange(base: u64, length: u64): void {
    let mut frame: u64 = base / FRAME_SIZE;
    let end: u64 = (base + length + FRAME_SIZE - 1) / FRAME_SIZE;

    while (frame < end) {
      if (!isUsed(frame)) {
        setUsed(frame);
        PmmState::freeFrames -= 1;
      }

      frame += 1;
    }
  }

  /// True when the bit of `frame` is set.
  function isUsed(frame: u64): boolean {
    let word: u64 = *(PmmState::bitmap + frame / BITS_PER_WORD);

    return ((word >> (frame % BITS_PER_WORD)) & 1) != 0;
  }

  /// Sets the bit of `frame`.
  function setUsed(frame: u64): void {
    let word: *mut u64 = PmmState::bitmap + frame / BITS_PER_WORD;

    *word = *word | ((1 as u64) << (frame % BITS_PER_WORD));
  }

  /// Clears the bit of `frame`.
  function setFree(frame: u64): void {
    let word: *mut u64 = PmmState::bitmap + frame / BITS_PER_WORD;

    *word = *word & ~((1 as u64) << (frame % BITS_PER_WORD));
  }

  /// Index of the lowest clear bit of `word`, which must not be all ones.
  function firstClearBit(word: u64): u64 {
    let mut bit: u64 = 0;

    while (((word >> bit) & 1) != 0) {
      bit += 1;
    }

    return bit;
  }
}
