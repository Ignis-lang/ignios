//!
//! # Interrupt and Exception Dispatch
//!
//! The Ignis side of interrupt handling: one dispatcher for every vector.
//!
//! ## Overview
//!
//! `interrupt_asm.S` saves the registers of the interrupted code and calls
//! `dispatch` with a pointer to the saved frame. From there:
//!
//! ```text
//!   Trap::dispatch(frame)
//!   │
//!   ├─ vector 0xFF  local APIC spurious ......... return, no EOI
//!   ├─ vector 0x21  keyboard (IOAPIC) ........... Drivers::Ps2::handleInterrupt, Apic EOI,
//!   │                                             Fs::Tty::keysArrived (wakes readers)
//!   ├─ vector 0x30  local APIC timer ............ Time::Timer::handleTick, Apic EOI,
//!   │                                             Sched::Scheduler::onTick (may switch threads)
//!   ├─ vectors 0x20-0x2F (the rest)  8259 ....... acknowledge or absorb a spurious one
//!   ├─ exception from ring 3 (cs & 3 == 3) ..... report, kill the process
//!   └─ any other exception ...................... report on COM1 and the
//!                                                 console, halt the machine
//! ```
//!
//! Before any of that, `dispatch` clears RFLAGS.AC with
//! `Arch::Protection::forbidUserAccess`: an interrupt from ring 3 keeps the
//! user's RFLAGS, and a user-set AC would run the handler with SMAP off.
//! `countAccessFlag` then counts entries from ring 3 with AC set and entries
//! that still have it, so `Tests::User` can prove the `clac` is there.
//!
//! A CPU exception in the kernel is fatal, and one taken in ring 3 kills only
//! the process. `Trap::Exception` (`exception.ign`) holds the rule and the
//! report.
//!
//! Device interrupts come from the IOAPIC and are acknowledged at the local
//! APIC with `Apic::Lapic::endOfInterrupt`. The 8259 is fully masked, but its
//! vectors `0x20-0x2F` stay mapped to thunks so a spurious 8259 interrupt is
//! absorbed. The local APIC's spurious vector is ignored without any
//! acknowledgement.
//!
//! See concept doc 04 and Intel SDM Vol. 3A, "Interrupt and Exception
//! Handling".

import Apic from "@apic";
import Arch from "@arch";
import Drivers from "@drivers";
import Fs from "@fs";
import Proc from "@proc";
import Sched from "@sched";
import Time from "@time";
import _ from "./exception";

/// What `Trap::dispatch` saw of RFLAGS.AC and of timer ticks, for
/// `Tests::User`.
record TrapState {
  /// Timer ticks that interrupted a process's thread in ring 0: in a system
  /// call, since those run with interrupts on.
  static mut processKernelTicks: u64 = 0;

  /// Entries from ring 3 whose saved RFLAGS had AC set.
  static mut userEntriesWithAccessFlag: u64 = 0;

  /// Entries that still had AC set after `forbidUserAccess`. Stays 0 while
  /// SMAP is on.
  static mut entriesWithAccessLeftOpen: u64 = 0;
}

/// Interrupt vector numbers and the dispatcher.
namespace Trap {
  /// RFLAGS bit 18 (AC). With SMAP on, ring 0 may touch user pages while it
  /// is set.
  const FLAG_ACCESS_CHECK: u64 = 0x40000;

  /// Requested privilege level bits of a code segment selector: 3 is ring 3.
  const SELECTOR_RING_MASK: u64 = 3;

  /// First vector of the remapped 8259 range, `0x20`.
  const FIRST_IRQ_VECTOR: u64 = 32;

  /// Number of vectors in the 8259 range: 16 lines.
  const IRQ_VECTOR_COUNT: u64 = 16;

  /// The vector the IOAPIC raises for the keyboard. It equals the vector of
  /// 8259 line 1, which is harmless because that line is masked.
  const KEYBOARD_VECTOR: u64 = 0x21;

  /// The vector of the local APIC timer tick. It is just above the 8259
  /// vectors so nothing legacy shares it.
  const TIMER_VECTOR: u64 = 0x30;

  /// Called by the common stub for every vector, on the interrupted stack,
  /// with interrupts disabled. `frame` points at the saved registers and can be
  /// modified. See the module header for the routing.
  @externName("ignis_interrupt_dispatch")
  function dispatch(frame: *mut Arch::InterruptFrame): void {
    // An interrupt from ring 3 keeps the user's RFLAGS, and with them a
    // user-set AC flag that would turn SMAP off for this handler.
    Arch::Protection::forbidUserAccess();
    countAccessFlag(frame);
    route(frame);

    // About to return to ring 3: a process that was killed ends here.
    if (((*frame).cs & SELECTOR_RING_MASK) == SELECTOR_RING_MASK) {
      Proc::Process::checkKill();
    }
  }

  /// Runs the handler of the vector in `frame`. See the module header for
  /// the routing.
  function route(frame: *mut Arch::InterruptFrame): void {
    let vector: u64 = (*frame).vector;

    if (vector == Apic::Lapic::spuriousVector()) {
      return;
    }

    if (vector == KEYBOARD_VECTOR) {
      Drivers::Ps2::handleInterrupt();
      Apic::Lapic::endOfInterrupt();
      Fs::Tty::keysArrived();
      return;
    }

    if (vector == TIMER_VECTOR) {
      if (((*frame).cs & 3) == 0 && Sched::Scheduler::currentProcess() != 0) {
        TrapState::processKernelTicks += 1;
      }

      Time::Timer::handleTick();
      Apic::Lapic::endOfInterrupt();
      Sched::Scheduler::onTick();
      return;
    }

    if (vector >= FIRST_IRQ_VECTOR && vector < FIRST_IRQ_VECTOR + IRQ_VECTOR_COUNT) {
      handleLegacyInterrupt((vector - FIRST_IRQ_VECTOR) as u8);
      return;
    }

    if (Arch::Probe::recover(frame, vector)) {
      return;
    }

    if (Exception::isUserFault(frame)) {
      // A page of a region the process never touched yet gets its frame
      // here, and the instruction runs again.
      if (vector == Exception::PAGE_FAULT && Proc::User::resolveFault(Exception::readCr2(), (*frame).errorCode)) {
        return;
      }

      Exception::killUserProcess(frame);
    }

    Exception::report(frame);

    Arch::Cpu::haltForever();
  }

  /// Absorbs an interrupt that came from the 8259, which is fully masked.
  /// A spurious one skips the acknowledgement of its own controller; any
  /// other is acknowledged and dropped.
  function handleLegacyInterrupt(line: u8): void {
    if (Arch::Pic::isSpurious(line)) {
      Arch::Pic::endSpurious(line);
      return;
    }

    Arch::Pic::endOfInterrupt(line);
  }

  /// Counts, for `Tests::User`, an entry from ring 3 with AC set in the saved
  /// RFLAGS, and an entry that still runs with AC set after
  /// `forbidUserAccess`. A few instructions per interrupt.
  function countAccessFlag(frame: *mut Arch::InterruptFrame): void {
    if (((*frame).cs & SELECTOR_RING_MASK) == SELECTOR_RING_MASK && ((*frame).rflags & FLAG_ACCESS_CHECK) != 0) {
      TrapState::userEntriesWithAccessFlag += 1;
    }

    if ((Arch::Cpu::readFlags() & FLAG_ACCESS_CHECK) != 0) {
      TrapState::entriesWithAccessLeftOpen += 1;
    }
  }

  /// Timer ticks that landed while a process's thread ran kernel code, which
  /// is a system call.
  function processKernelTicks(): u64 {
    return TrapState::processKernelTicks;
  }

  /// Interrupts and exceptions taken from ring 3 while the program had
  /// RFLAGS.AC set.
  function userEntriesWithAccessFlag(): u64 {
    return TrapState::userEntriesWithAccessFlag;
  }

  /// Entries that ran past `forbidUserAccess` with RFLAGS.AC still set. Any
  /// value other than 0 with SMAP on means a handler ran with SMAP off.
  function entriesWithAccessLeftOpen(): u64 {
    return TrapState::entriesWithAccessLeftOpen;
  }
}
