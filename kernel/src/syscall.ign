//!
//! # System Calls
//!
//! The entry point from ring 3 into the kernel, and the handlers.
//!
//! ## Overview
//!
//! `usermode_asm.S` builds an `InterruptFrame` for a `SYSCALL` and calls
//! `dispatch` with it. The result goes back in RAX, where a value from -4095
//! to -1 is a negated errno.
//!
//! Dispatch has two steps so the kernel can speak more than one convention
//! later. Each process has an ABI, its personality. The ABI owns a table that
//! turns a system call number into an operation of the kernel, a small
//! number that does not depend on any convention, and the kernel runs that
//! operation. The only ABI so far is Linux x86_64: the call number in RAX,
//! the arguments in RDI, RSI, RDX, R10, R8 and R9, Linux's numbers and
//! Linux's errno values. A number the table does not know turns into
//! `OP_NONE` and fails with `-ENOSYS`.
//!
//! Every pointer a process passes is checked before the kernel touches it,
//! and never dereferenced directly: `Mm::AddressSpace::copyFromUser` and
//! `copyToUser` walk the process's page tables and refuse a range that
//! leaves the user half or crosses a page that is not mapped, not user
//! accessible, or, for a write, not writable. A refused range is `-EFAULT`.
//!
//! The handlers run with interrupts off, which is how `SYSCALL` leaves them:
//! the kernel has one CPU, so nothing else can touch the state in the
//! meantime, and a handler that waits (`nanosleep`) does it through the
//! scheduler, which switches threads with interrupts off as well.
//!
//! ## Flow
//!
//! ```text
//!   user:    mov eax, 1 ; mov edi, 1 ; lea rsi, [msg] ; mov edx, n ; syscall
//!                │
//!                ▼  (hardware: RCX = RIP, R11 = RFLAGS, IF cleared, CPL 0)
//!   kernel:  ignis_syscall_entry          switch to the kernel stack, build the frame
//!                │
//!                ▼
//!            Syscall::dispatch(frame)
//!                ├─ lookup(abi, frame.rax)     number -> operation (OP_WRITE ...)
//!                ├─ run the operation          arguments from rdi, rsi, rdx
//!                └─ frame.rax := result        value or -errno
//!                │
//!                ▼
//!            ignis_syscall_entry          reload registers, sysretq
//! ```
//!
//! ## Calls Implemented
//!
//! | Linux no | Name          | Operation  | Notes                                 |
//! |----------|---------------|------------|---------------------------------------|
//! | 1        | `write`       | `OP_WRITE` | fd 1 and 2 only, to the console       |
//! | 24       | `sched_yield` | `OP_YIELD` | returns 0                             |
//! | 35       | `nanosleep`   | `OP_SLEEP` | rounded up to 10 ms ticks             |
//! | 39       | `getpid`      | `OP_GET_PID` | the process id                      |
//! | 60       | `exit`        | `OP_EXIT`  | status & 0xFF                         |
//! | 231      | `exit_group`  | `OP_EXIT`  | same as `exit`                        |
//!
//! Every other number returns `-ENOSYS` (-38). The numbers come from the Linux
//! x86_64 syscall table, `arch/x86/entry/syscalls/syscall_64.tbl`. See concept
//! doc 15.

import Drivers from "@drivers";
import Mm from "@mm";
import Process from "./process";
import Scheduler from "./scheduler";
import Timer from "./timer";

/// The number-to-operation table of the Linux ABI and a scratch buffer.
record SyscallState {
  /// One byte per system call number, the `OP_*` value it maps to. Zero entries
  /// are `OP_NONE`. The size must equal `Syscall::TABLE_SIZE`.
  static mut linux: u8[512];

  /// Staging buffer for `write`: user bytes are copied here, then printed. The
  /// size must equal `Syscall::COPY_BUFFER_SIZE`.
  static mut copyBuffer: u8[256];
}

/// The system call API.
export namespace Syscall {
  /// System call numbers 0 to 511 can be mapped. The Linux table has fewer.
  const TABLE_SIZE: u64 = 512;

  /// Kernel operations. 0 is what a number the ABI does not know maps to.
  const OP_NONE: u8 = 0;

  /// End the process.
  const OP_EXIT: u8 = 1;

  /// Write bytes to the console.
  const OP_WRITE: u8 = 2;

  /// Return the process id.
  const OP_GET_PID: u8 = 3;

  /// Give up the processor.
  const OP_YIELD: u8 = 4;

  /// Sleep for a time.
  const OP_SLEEP: u8 = 5;

  /// Linux numbers, from arch/x86/entry/syscalls/syscall_64.tbl.
  const LINUX_WRITE: u64 = 1;

  /// `sched_yield`, number 24.
  const LINUX_SCHED_YIELD: u64 = 24;

  /// `nanosleep`, number 35.
  const LINUX_NANOSLEEP: u64 = 35;

  /// `getpid`, number 39.
  const LINUX_GETPID: u64 = 39;

  /// `exit`, number 60.
  const LINUX_EXIT: u64 = 60;

  /// `exit_group`, number 231.
  const LINUX_EXIT_GROUP: u64 = 231;

  /// errno values, from include/uapi/asm-generic/errno-base.h.
  const EBADF: i64 = 9;

  /// Bad address (14): a user pointer failed validation.
  const EFAULT: i64 = 14;

  /// Invalid argument (22).
  const EINVAL: i64 = 22;

  /// Function not implemented (38).
  const ENOSYS: i64 = 38;

  /// File descriptor 1.
  const STDOUT: u64 = 1;

  /// File descriptor 2, which goes to the console too.
  const STDERR: u64 = 2;

  /// The most one `write` takes. A longer request is a short write, which
  /// the caller already has to handle.
  const MAX_WRITE: u64 = 65536;

  /// Bytes of `SyscallState::copyBuffer`, the unit `write` copies and prints at a
  /// time. It must equal the array size there.
  const COPY_BUFFER_SIZE: u64 = 256;

  /// 10^9.
  const NANOSECONDS_PER_SECOND: u64 = 1000000000;

  /// 10^7 ns = 10 ms, one tick of the 100 Hz timer (`Timer::FREQUENCY`).
  const NANOSECONDS_PER_TICK: u64 = 10000000;

  /// Longest sleep in seconds, so the tick count cannot overflow.
  const MAX_SLEEP_SECONDS: u64 = 1000000;

  /// `struct timespec`: seconds and nanoseconds, both signed 64-bit.
  @cLayout
  record Timespec {
    /// Whole seconds.
    public seconds: i64;

    /// Nanoseconds, 0 to 999999999.
    public nanoseconds: i64;
  }

  /// Fills the table of the Linux ABI.
  function initialize(): void {
    let table: *mut u8 = &mut SyscallState::linux as *mut u8;

    *(table + LINUX_WRITE) = OP_WRITE;
    *(table + LINUX_SCHED_YIELD) = OP_YIELD;
    *(table + LINUX_NANOSLEEP) = OP_SLEEP;
    *(table + LINUX_GETPID) = OP_GET_PID;
    *(table + LINUX_EXIT) = OP_EXIT;
    *(table + LINUX_EXIT_GROUP) = OP_EXIT;
  }

  /// Called by the entry stub with interrupts off, on the kernel stack of
  /// the calling thread.
  @externName("ignis_syscall_dispatch")
  function dispatch(frame: *mut Arch::InterruptFrame): void {
    let operation: u8 = lookup(Process::currentAbi(), (*frame).rax);

    let first: u64 = (*frame).rdi;
    let second: u64 = (*frame).rsi;
    let third: u64 = (*frame).rdx;

    if (operation == OP_EXIT) {
      Process::exitCurrent(first & 0xFF);
    }

    if (operation == OP_WRITE) {
      (*frame).rax = write(first, second, third);
    } else if (operation == OP_GET_PID) {
      (*frame).rax = Process::currentId();
    } else if (operation == OP_YIELD) {
      Scheduler::yield();
      (*frame).rax = 0;
    } else if (operation == OP_SLEEP) {
      (*frame).rax = nanosleep(first, second);
    } else {
      (*frame).rax = failure(ENOSYS);
    }
  }

  /// `write(fd, buf, count)`: only the console, as descriptors 1 and 2, goes
  /// anywhere. The whole range is checked before the first byte is printed,
  /// so a bad pointer is `-EFAULT` and prints nothing. The bytes then pass
  /// through a small kernel buffer, so a long request is copied and printed
  /// piece by piece.
  function write(descriptor: u64, buffer: u64, count: u64): u64 {
    if (descriptor != STDOUT && descriptor != STDERR) {
      return failure(EBADF);
    }

    let total: u64 = count < MAX_WRITE ? count : MAX_WRITE;
    let root: u64 = Process::currentRoot();
    let chunk: *mut u8 = &mut SyscallState::copyBuffer as *mut u8;

    if (!Mm::AddressSpace::isAccessible(root, buffer, total, false)) {
      return failure(EFAULT);
    }

    let mut done: u64 = 0;

    while (done < total) {
      let piece: u64 = total - done < COPY_BUFFER_SIZE ? total - done : COPY_BUFFER_SIZE;

      if (!Mm::AddressSpace::copyFromUser(root, chunk, buffer + done, piece)) {
        return failure(EFAULT);
      }

      let mut index: u64 = 0;

      while (index < piece) {
        Drivers::Console::writeChar(*(chunk + index));
        index += 1;
      }

      done += piece;
    }

    return done;
  }

  /// `nanosleep(req, rem)`: blocks for the requested time rounded up to
  /// whole timer ticks (10 ms). The sleep is never interrupted, so `rem`,
  /// when given, is set to zero.
  function nanosleep(request: u64, remaining: u64): u64 {
    let root: u64 = Process::currentRoot();
    let mut time: Timespec = Timespec { seconds: 0, nanoseconds: 0 };

    if (!Mm::AddressSpace::copyFromUser(root, &mut time as *mut u8, request, 16)) {
      return failure(EFAULT);
    }

    if (time.seconds < 0 || time.nanoseconds < 0 || (time.nanoseconds as u64) >= NANOSECONDS_PER_SECOND) {
      return failure(EINVAL);
    }

    let mut seconds: u64 = time.seconds as u64;

    if (seconds > MAX_SLEEP_SECONDS) {
      seconds = MAX_SLEEP_SECONDS;
    }

    let ticks: u64 = seconds * Timer::FREQUENCY + ((time.nanoseconds as u64) + NANOSECONDS_PER_TICK - 1) / NANOSECONDS_PER_TICK;

    Scheduler::sleep(ticks);

    if (remaining != 0) {
      let zero: Timespec = Timespec { seconds: 0, nanoseconds: 0 };

      if (!Mm::AddressSpace::copyToUser(root, remaining, &zero as *u8, 16)) {
        return failure(EFAULT);
      }
    }

    return 0;
  }

  /// The operation the ABI `abi` maps `number` to.
  function lookup(abi: u64, number: u64): u8 {
    if (number >= TABLE_SIZE) {
      return OP_NONE;
    }

    return *(tableFor(abi) + number);
  }

  /// The number-to-operation table of an ABI. Linux is the only one.
  function tableFor(abi: u64): *mut u8 {
    return &mut SyscallState::linux as *mut u8;
  }

  /// Called by the entry stub when the return address of a system call is
  /// not canonical and `SYSRET` would fault in ring 0.
  @externName("ignis_syscall_bad_return")
  function badReturn(rip: u64): never {
    Drivers::Console::write("process ");
    Drivers::Console::writeDecimal(Process::currentId());
    Drivers::Console::write(": non-canonical return address ");
    Drivers::Console::writeHex(rip);
    Drivers::Console::writeLine("");

    Process::killCurrent(139);
  }

  /// The value a failing call returns in RAX: the errno, negated.
  function failure(errno: i64): u64 {
    let value: i64 = 0 - errno;

    return value as u64;
  }
}
