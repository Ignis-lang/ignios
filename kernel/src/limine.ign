//! Limine boot protocol: the layouts of the requests in
//! `limine_requests.S` and of their responses, and readers for them.
//!
//! The bootloader writes the responses before the kernel starts, behind the
//! compiler's back, so every read of a request slot is volatile.

export namespace Limine {
  const BASE_REVISION_SUPPORTED: u64 = 0;

  /// A request header. `response` is the response address as an integer
  /// because a reference to a pointer-typed place currently yields the
  /// pointer itself, so it cannot be read through @readVolatile. Repro:
  /// ignis-os-repros/ref_to_pointer_place in the session scratchpad.
  @cLayout
  record Request {
    public id0: u64;
    public id1: u64;
    public id2: u64;
    public id3: u64;
    public revision: u64;
    public response: u64;
  }

  @cLayout
  record BaseRevision {
    public magic0: u64;
    public magic1: u64;
    public revision: u64;
  }

  @cLayout
  record Framebuffer {
    public address: *mut u8;
    public width: u64;
    public height: u64;
    public pitch: u64;
    public bpp: u16;
    public memoryModel: u8;
    public redMaskSize: u8;
    public redMaskShift: u8;
    public greenMaskSize: u8;
    public greenMaskShift: u8;
    public blueMaskSize: u8;
    public blueMaskShift: u8;
  }

  @cLayout
  record FramebufferResponse {
    public revision: u64;
    public framebufferCount: u64;
    public framebuffers: *mut *mut Framebuffer;
  }

  @cLayout
  record MemmapEntry {
    public base: u64;
    public length: u64;
    public kind: u64;
  }

  @cLayout
  record MemmapResponse {
    public revision: u64;
    public entryCount: u64;
    public entries: *mut *mut MemmapEntry;
  }

  @cLayout
  record HhdmResponse {
    public revision: u64;
    public offset: u64;
  }

  function baseRevisionTag(): *mut BaseRevision {
    return asm pure () -> (address: *mut BaseRevision in reg) { lea {address}, [rip + limine_base_revision] };
  }

  function framebufferRequest(): *mut Request {
    return asm pure () -> (address: *mut Request in reg) { lea {address}, [rip + limine_framebuffer_request] };
  }

  function memmapRequest(): *mut Request {
    return asm pure () -> (address: *mut Request in reg) { lea {address}, [rip + limine_memmap_request] };
  }

  function hhdmRequest(): *mut Request {
    return asm pure () -> (address: *mut Request in reg) { lea {address}, [rip + limine_hhdm_request] };
  }

  /// The bootloader clears the requested revision when it supports it.
  function isBaseRevisionSupported(): boolean {
    let tag: *mut BaseRevision = baseRevisionTag();

    return @readVolatile<u64>(&mut (*tag).revision as *mut u64) == BASE_REVISION_SUPPORTED;
  }

  /// The response address the bootloader left in `request`, or 0 when it
  /// left none.
  function responseAddress(request: *mut Request): u64 {
    return @readVolatile<u64>(&mut (*request).response as *mut u64);
  }

  /// The first framebuffer, or null when the bootloader provided none.
  function firstFramebuffer(): *mut Framebuffer {
    let address: u64 = responseAddress(framebufferRequest());

    if (address == 0) {
      return null;
    }

    let response: *mut FramebufferResponse = @pointerFromInteger<*mut FramebufferResponse>(address);

    if ((*response).framebufferCount == 0) {
      return null;
    }

    return *(*response).framebuffers;
  }

  /// The memory map, or null when the bootloader provided none.
  function memmap(): *mut MemmapResponse {
    return @pointerFromInteger<*mut MemmapResponse>(responseAddress(memmapRequest()));
  }

  /// The higher half direct map, or null when the bootloader provided none.
  function hhdm(): *mut HhdmResponse {
    return @pointerFromInteger<*mut HhdmResponse>(responseAddress(hhdmRequest()));
  }
}
