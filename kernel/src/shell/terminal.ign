//!
//! # Shell Terminal
//!
//! The interactive prompt: reads keys, edits one line and runs it.
//!
//! ## Overview
//!
//! `Shell::Terminal::run` is where the boot thread ends up. It first runs the
//! user space shell, `/bin/sh`, and waits for it; the kernel terminal below
//! is the fallback once it ends (Ctrl+D or `exit`). The terminal prints a
//! prompt, reads one line with `Fs::Tty::readLine` (which echoes it and
//! handles Backspace without ever erasing the prompt) and runs it as a
//! command (`Shell::Commands::run`). The keyboard interrupt fills the
//! scancode queue whether the terminal is waiting or not, so keys typed while
//! a program runs are not lost. Input past `LINE_CAPACITY` and Tab are
//! ignored.

import Drivers from "@drivers";
import Fs from "@fs";
import Proc from "@proc";
import _ from "./commands";

/// The terminal loop.
namespace Shell::Terminal {
  /// ASCII line feed (0x0A), the byte the Enter key decodes to.
  const NEWLINE: u8 = 0x0A;

  /// Bytes one input line can hold. It must equal the array size in
  /// `Shell::Terminal::run`, which has to be an integer literal.
  const LINE_CAPACITY: u64 = 128;

  /// Prints the green `> ` prompt, then switches to bright white for the text
  /// the user types.
  function printPrompt(): void {
    Drivers::Console::setColors(Drivers::Color::BRIGHT_GREEN, Drivers::Color::BLACK);
    Drivers::Console::write("> ");
    Drivers::Console::setColors(Drivers::Color::BRIGHT_WHITE, Drivers::Color::BLACK);
  }

  /// Runs `/bin/sh` and waits for it. When it ends, or cannot start, the
  /// kernel terminal takes over: it reads one line at a time with
  /// `Fs::Tty::readLine`, which echoes it
  /// and handles Backspace, and runs it as a command, forever. The terminal
  /// runs in the boot thread, so the keyboard keeps working while other
  /// threads run. Input past `LINE_CAPACITY` characters is ignored; Ctrl+D on
  /// an empty line just starts a new prompt.
  function run(): void {
    // Literal size: array lengths must be integer literals, so this repeats
    // `LINE_CAPACITY` plus the newline.
    let mut line: u8[129];
    let status: u64 = Proc::Programs::runNamed("/bin/sh");

    if (status == Proc::Process::NO_PROCESS) {
      Drivers::Console::writeLine("shell: /bin/sh did not start, the kernel terminal takes over");
    } else {
      Drivers::Console::writeLine("shell: /bin/sh ended, the kernel terminal takes over");
    }

    while (true) {
      printPrompt();

      let length: u64 = Fs::Tty::readLine(&mut line as *mut u8, LINE_CAPACITY + 1);

      if (length == 0 || line[length - 1] != NEWLINE) {
        Drivers::Console::writeChar(NEWLINE);
        continue;
      }

      Shell::Commands::run(&mut line as *mut u8, length - 1);
    }
  }
}
