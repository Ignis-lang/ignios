//! IgniOS kernel entry point.

import Cpu from "./arch/x86_64/cpu";
import Gdt from "./arch/x86_64/gdt";
import Idt from "./arch/x86_64/idt";
import Lapic from "./arch/x86_64/lapic";
import Pic from "./arch/x86_64/pic";
import Color, Console from "./console";
import _ from "./interrupts";
import Keyboard from "./keyboard";
import Limine from "./limine";
import Pmm from "./pmm";
import Ps2 from "./ps2";
import ScancodeQueue from "./scancode_queue";
import Serial from "./serial";
import Vmm from "./vmm";
import _ from "./lib/mem";

record PanicState {
  static mut active: boolean = false;
}

const BACKSPACE: u8 = 0x08;
const NEWLINE: u8 = 0x0A;
const FIRST_PRINTABLE: u8 = 0x20;
const LAST_PRINTABLE: u8 = 0x7E;

/// Bytes one input line can hold. It must equal the array size in
/// `runTerminal`, which has to be an integer literal.
const LINE_CAPACITY: u64 = 128;

/// Reports the panic on COM1, and on the console once it is initialized, then
/// stops the machine. A panic raised while reporting another one only reaches
/// COM1, so a fault in the console cannot recurse.
@panicHandler
function onPanic(message: str, file: str, line: u32): never {
  if (PanicState::active || !Console::isInitialized()) {
    Serial::write("\npanic: ");
    Serial::write(message);
    Serial::write(" at ");
    Serial::write(file);
    Serial::write(":");
    Serial::writeDecimal(line);
    Serial::write("\n");

    Cpu::haltForever();
  }

  PanicState::active = true;

  Console::setColors(Color::BRIGHT_WHITE, Color::RED);
  Console::write("\npanic: ");
  Console::write(message);
  Console::write(" at ");
  Console::write(file);
  Console::write(":");
  Console::writeDecimal(line);
  Console::write("\n");

  Cpu::haltForever();
}

function requireFramebuffer(): *mut Limine::Framebuffer {
  let framebuffer: *mut Limine::Framebuffer = Limine::firstFramebuffer();

  if (framebuffer == null) {
    @panic("Limine provided no framebuffer");
  }

  return framebuffer;
}

function reportFramebuffer(framebuffer: *mut Limine::Framebuffer): void {
  Console::write("framebuffer: ");
  Console::writeDecimal((*framebuffer).width);
  Console::write("x");
  Console::writeDecimal((*framebuffer).height);
  Console::write(", pitch ");
  Console::writeDecimal((*framebuffer).pitch);
  Console::write(", bpp ");
  Console::writeDecimal((*framebuffer).bpp);
  Console::write(", ");
  Console::writeDecimal(Console::columns());
  Console::write("x");
  Console::writeDecimal(Console::rows());
  Console::writeLine(" cells");
}

function reportMemory(): void {
  let memmap: *mut Limine::MemmapResponse = Limine::memmap();

  if (memmap == null) {
    @panic("Limine provided no memory map");
  }

  let hhdm: *mut Limine::HhdmResponse = Limine::hhdm();

  if (hhdm == null) {
    @panic("Limine provided no higher half direct map");
  }

  Console::write("memory map: ");
  Console::writeDecimal((*memmap).entryCount);
  Console::write(" entries, hhdm offset ");
  Console::writeHex((*hhdm).offset);
  Console::writeLine("");
}

function printBanner(framebuffer: *mut Limine::Framebuffer): void {
  Console::setColors(Color::BRIGHT_YELLOW, Color::BLUE);
  Console::write(" IgniOS ");
  Console::setColors(Color::BRIGHT_CYAN, Color::BLACK);
  Console::writeLine(" an x86_64 kernel written in Ignis");
  Console::writeLine("");

  Console::setColors(Color::WHITE, Color::BLACK);
  reportFramebuffer(framebuffer);
  reportMemory();
  Console::writeLine("");
}

/// Brings up the PS/2 keyboard and reports the result on the console.
function initializeKeyboard(): boolean {
  if (!Ps2::initialize()) {
    Console::writeLine("keyboard: no PS/2 controller answered");
    return false;
  }

  Console::writeLine("keyboard: PS/2, scancode set 1, US layout, IRQ1");
  return true;
}

function reportGdt(): void {
  Serial::write("gdt: cs=");
  Serial::writeHex(Gdt::currentCode() as u64);
  Serial::write(" tr=");
  Serial::writeHex(Gdt::currentTask() as u64);
  Serial::write("\n");
}

/// Builds the frame allocator and the kernel page tables, reports on them and
/// runs their self-tests.
function initializeMemory(framebuffer: *mut Limine::Framebuffer): void {
  Pmm::initialize();

  Console::write("pmm: ");
  Console::writeDecimal(Pmm::totalFrames());
  Console::write(" usable frames, ");
  Console::writeDecimal(Pmm::freeFrameCount());
  Console::write(" free (");
  Console::writeDecimal(Pmm::freeFrameCount() * 4 / 1024);
  Console::writeLine(" MiB)");

  Pmm::selfTest();
  Console::writeLine("pmm: self-test ok");

  Vmm::initialize(framebuffer);

  Console::write("vmm: cr3 switched, cr3 ");
  Console::writeHex(Cpu::readCr3());
  Console::write(", pml4 ");
  Console::writeHex(Vmm::rootTable());
  Console::writeLine("");

  Vmm::selfTest();
  Console::writeLine("vmm: self-test ok");
}

function printPrompt(): void {
  Console::setColors(Color::BRIGHT_GREEN, Color::BLACK);
  Console::write("> ");
  Console::setColors(Color::BRIGHT_WHITE, Color::BLACK);
}

/// Drains the scancode queue forever and edits one line at a time: printable
/// characters are echoed and stored, Backspace erases the last stored
/// character but never the prompt, and Enter starts a new prompt. Input past
/// LINE_CAPACITY and Tab are ignored. The queue is checked with interrupts
/// off, so an IRQ1 cannot land between the check and the `sti; hlt` that
/// sleeps until the next one.
function runTerminal(): void {
  let mut line: u8[128];
  let mut length: u64 = 0;

  printPrompt();

  while (true) {
    Cpu::disableInterrupts();

    if (ScancodeQueue::isEmpty()) {
      Cpu::waitForInterrupt();
      continue;
    }

    Cpu::enableInterrupts();

    let character: u8 = Keyboard::decode(ScancodeQueue::pop());

    if (character == NEWLINE) {
      Console::writeChar(NEWLINE);
      length = 0;
      printPrompt();
    } else if (character == BACKSPACE) {
      if (length > 0) {
        length -= 1;
        Console::writeChar(BACKSPACE);
      }
    } else if (character >= FIRST_PRINTABLE && character <= LAST_PRINTABLE && length < LINE_CAPACITY) {
      line[length] = character;
      length += 1;
      Console::writeChar(character);
    }
  }
}

/// The ELF entry point. Limine jumps here in long mode on its own stack, with
/// interrupts disabled and every request already answered.
@externName("kmain")
function kmain(): void {
  Serial::initialize();
  Serial::writeLine("IgniOS booting");

  Gdt::initialize();
  reportGdt();

  Idt::initialize();
  Serial::writeLine("idt: 48 gates loaded");

  if (!Limine::isBaseRevisionSupported()) {
    @panic("Limine base revision 6 is not supported");
  }

  let framebuffer: *mut Limine::Framebuffer = requireFramebuffer();

  Console::initialize(framebuffer);
  printBanner(framebuffer);

  initializeMemory(framebuffer);

  if (!initializeKeyboard()) {
    Cpu::haltForever();
  }

  Pic::initialize();
  Lapic::disable();

  runTerminal();
}
