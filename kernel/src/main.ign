//!
//! # Kernel Entry Point
//!
//! `kmain`, the boot sequence, the panic handler and the interactive terminal.
//!
//! ## Overview
//!
//! Limine loads the kernel ELF, switches the CPU to 64-bit mode with paging
//! on, answers the requests in `limine.ign` and jumps to `kmain` (the ELF
//! entry point named in `kernel/linker.ld`). From there everything runs in
//! ring 0 on the boot thread. When `kmain` reaches `runTerminal` the boot
//! thread becomes the shell and never returns.
//!
//! State on entry (Limine protocol, x86-64): interrupts off (RFLAGS.IF clear),
//! the 8259 PIC lines masked, Limine's own GDT loaded, a stack of at least
//! 64 KiB in bootloader-reclaimable memory, the kernel mapped in the top 2 GiB
//! (`0xffffffff80000000` and up). See concept doc 01.
//!
//! ## Boot Sequence
//!
//! Each step needs the ones above it. The right column names the file to read
//! and the concept doc that explains the hardware.
//!
//! ```text
//!   kmain
//!   │
//!   ├─ Serial::initialize ........ COM1 up, first log line      serial.ign       doc 06
//!   ├─ Gdt::initialize ........... own GDT, TSS, CS/SS/DS       gdt.ign           doc 03
//!   ├─ Idt::initialize ........... 50 gates (49 thunks + spur.) idt.ign           doc 04
//!   ├─ Limine::isBaseRevisionSupported                          limine.ign        doc 01
//!   ├─ Console::initialize ....... framebuffer text console     console.ign       doc 07
//!   ├─ printBanner ............... banner, framebuffer, memory map
//!   ├─ initializeMemory
//!   │    ├─ Pmm::initialize ...... frame bitmap                 pmm.ign           doc 08
//!   │    ├─ Vmm::initialize ...... own page tables, CR3 switch  vmm.ign           doc 09
//!   │    ├─ Modules::initialize .. map Limine modules           modules.ign       doc 15
//!   │    ├─ Heap::initialize ..... kernel heap                  heap.ign          doc 10
//!   │    └─ AddressSpace::selfTest                              address_space.ign doc 14
//!   ├─ Scheduler::initialize, Process::initialize, Syscall::initialize
//!   ├─ UserMode::initialize ...... EFER.SCE, STAR/LSTAR/FMASK   usermode.ign      doc 14
//!   ├─ Acpi::initialize/report ... RSDP, XSDT, MADT             acpi.ign          doc 12
//!   ├─ Pic::initialize ........... remap and mask the 8259      pic.ign           doc 05
//!   ├─ Lapic::initialize ......... local APIC on                lapic.ign         doc 05
//!   ├─ Ioapic::initialize + routeIsa(keyboard)                  ioapic.ign        doc 12
//!   ├─ initializeTimer ........... APIC timer, 100 Hz           timer.ign         doc 12
//!   ├─ Context::selfTest, SchedulerTest::*                      scheduler_test.ign doc 13
//!   ├─ Scheduler::enablePreemption
//!   ├─ UserTest::run ............. ring 3 smoke tests           user_test.ign     doc 14
//!   ├─ initializeKeyboard ........ 8042 enable, IRQ1 live       ps2.ign           doc 06
//!   └─ runTerminal ............... prompt loop, never returns
//! ```
//!
//! ## Where Output Goes
//!
//! Before the console exists, `kmain` logs to COM1 only (`Serial::write`).
//! `Console::write` shows text on the framebuffer and mirrors every byte to
//! COM1, so the serial log of a headless run contains the whole screen. The
//! `docs/READING.md` guide annotates the complete boot log line by line.
//!
//! ## Terminal Commands
//!
//! | Command     | Effect                                                  |
//! |-------------|---------------------------------------------------------|
//! | `uptime`    | Time since the timer started, from the tick counter     |
//! | `ps`        | Lists the kernel threads (`thread_commands.ign`)        |
//! | `threads`   | Starts the demo threads (`thread_commands.ign`)         |
//! | `run NAME`  | Runs the Limine module called NAME in ring 3            |
//!
//! ## Panics
//!
//! `onPanic` is registered with `@panicHandler`, so every `@panic(...)` call in
//! the kernel ends there. There is no unwinding: the machine stops in
//! `Cpu::haltForever`.

import Acpi from "./acpi";
import AddressSpace from "./address_space";
import Context from "./arch/x86_64/context";
import Cpu from "./arch/x86_64/cpu";
import Gdt from "./arch/x86_64/gdt";
import Idt from "./arch/x86_64/idt";
import Ioapic from "./arch/x86_64/ioapic";
import Lapic from "./arch/x86_64/lapic";
import Pic from "./arch/x86_64/pic";
import Color, Console from "./console";
import Heap from "./heap";
import UserMode from "./arch/x86_64/usermode";
import Interrupts from "./interrupts";
import Keyboard from "./keyboard";
import Limine from "./limine";
import Modules from "./modules";
import Pmm from "./pmm";
import Process from "./process";
import Programs from "./programs";
import Ps2 from "./ps2";
import ScancodeQueue from "./scancode_queue";
import Scheduler from "./scheduler";
import SchedulerTest from "./scheduler_test";
import Serial from "./serial";
import Syscall from "./syscall";
import ThreadCommands from "./thread_commands";
import UserTest from "./user_test";
import Timer from "./timer";
import Vmm from "./vmm";
import _ from "./lib/mem";

/// Set by the first panic so a second panic knows the console path already
/// failed or is in use.
record PanicState {
  /// True once a panic is being reported.
  static mut active: boolean = false;
}

/// ASCII backspace (0x08), the byte the Backspace key decodes to.
const BACKSPACE: u8 = 0x08;

/// ASCII line feed (0x0A), the byte the Enter key decodes to.
const NEWLINE: u8 = 0x0A;

/// First printable ASCII character, space (0x20).
const FIRST_PRINTABLE: u8 = 0x20;

/// Last printable ASCII character, tilde (0x7E). The terminal stores only
/// bytes from `FIRST_PRINTABLE` to `LAST_PRINTABLE`, both included.
const LAST_PRINTABLE: u8 = 0x7E;

/// The ISA interrupt line of the PS/2 keyboard (IRQ1). The IOAPIC routes it
/// through the GSI that ACPI assigns to it.
const KEYBOARD_IRQ: u8 = 1;

/// Prints the time since the timer started.
const UPTIME_COMMAND: str = "uptime";

/// Lists the kernel threads.
const PS_COMMAND: str = "ps";

/// Starts the demo threads.
const THREADS_COMMAND: str = "threads";

/// Runs a program the bootloader loaded: `run hello`. The command is a prefix
/// followed by a module name.
const RUN_COMMAND: str = "run ";

/// Byte length of `RUN_COMMAND`, including the trailing space.
const RUN_COMMAND_LENGTH: u64 = 4;

/// Bytes one input line can hold. It must equal the array size in
/// `runTerminal`, which has to be an integer literal.
const LINE_CAPACITY: u64 = 128;

/// Reports the panic on COM1, and on the console once it is initialized, then
/// stops the machine. A panic raised while reporting another one only reaches
/// COM1, so a fault in the console cannot recurse.
///
/// The compiler routes every `@panic(...)` call here. `file` and `line` locate
/// the call in the Ignis source. Never returns.
///
/// On the console the report is bright white on red. On COM1 it is the same
/// text with `\r\n` line endings (added by `Serial::write`).
@panicHandler
function onPanic(message: str, file: str, line: u32): never {
  if (PanicState::active || !Console::isInitialized()) {
    Serial::write("\npanic: ");
    Serial::write(message);
    Serial::write(" at ");
    Serial::write(file);
    Serial::write(":");
    Serial::writeDecimal(line);
    Serial::write("\n");

    Cpu::haltForever();
  }

  PanicState::active = true;

  Console::setColors(Color::BRIGHT_WHITE, Color::RED);
  Console::write("\npanic: ");
  Console::write(message);
  Console::write(" at ");
  Console::write(file);
  Console::write(":");
  Console::writeDecimal(line);
  Console::write("\n");

  Cpu::haltForever();
}

/// The first Limine framebuffer. Panics when the bootloader provided none,
/// because the console has nowhere to draw.
function requireFramebuffer(): *mut Limine::Framebuffer {
  let framebuffer: *mut Limine::Framebuffer = Limine::firstFramebuffer();

  if (framebuffer == null) {
    @panic("Limine provided no framebuffer");
  }

  return framebuffer;
}

/// Prints the framebuffer geometry and the resulting cell grid, for example
/// `framebuffer: 1280x800, pitch 5120, bpp 32, 160x50 cells`. The pitch is
/// the number of bytes between two pixel rows and can exceed `width * 4`.
function reportFramebuffer(framebuffer: *mut Limine::Framebuffer): void {
  Console::write("framebuffer: ");
  Console::writeDecimal((*framebuffer).width);
  Console::write("x");
  Console::writeDecimal((*framebuffer).height);
  Console::write(", pitch ");
  Console::writeDecimal((*framebuffer).pitch);
  Console::write(", bpp ");
  Console::writeDecimal((*framebuffer).bpp);
  Console::write(", ");
  Console::writeDecimal(Console::columns());
  Console::write("x");
  Console::writeDecimal(Console::rows());
  Console::writeLine(" cells");
}

/// Prints the number of memory-map entries and the higher half direct map
/// offset. Panics when Limine answered neither request.
function reportMemory(): void {
  let memmap: *mut Limine::MemmapResponse = Limine::memmap();

  if (memmap == null) {
    @panic("Limine provided no memory map");
  }

  let hhdm: *mut Limine::HhdmResponse = Limine::hhdm();

  if (hhdm == null) {
    @panic("Limine provided no higher half direct map");
  }

  Console::write("memory map: ");
  Console::writeDecimal((*memmap).entryCount);
  Console::write(" entries, hhdm offset ");
  Console::writeHex((*hhdm).offset);
  Console::writeLine("");
}

/// Draws the colored banner and the framebuffer and memory lines. This is the
/// first console output of the boot.
function printBanner(framebuffer: *mut Limine::Framebuffer): void {
  Console::setColors(Color::BRIGHT_YELLOW, Color::BLUE);
  Console::write(" IgniOS ");
  Console::setColors(Color::BRIGHT_CYAN, Color::BLACK);
  Console::writeLine(" an x86_64 kernel written in Ignis");
  Console::writeLine("");

  Console::setColors(Color::WHITE, Color::BLACK);
  reportFramebuffer(framebuffer);
  reportMemory();
  Console::writeLine("");
}

/// Brings up the PS/2 keyboard and reports the result on the console. Returns
/// false when no controller answered, in which case `kmain` halts: without a
/// keyboard the terminal is useless.
function initializeKeyboard(): boolean {
  if (!Ps2::initialize()) {
    Console::writeLine("keyboard: no PS/2 controller answered");
    return false;
  }

  Console::writeLine("keyboard: PS/2, scancode set 1, US layout, IRQ1 through the IOAPIC");
  return true;
}

/// Logs the code segment selector and the task register read back from the
/// CPU. On a correct boot they are `0x8` and `0x28`, which proves the far
/// return and `ltr` in `Gdt::initialize` took effect.
function reportGdt(): void {
  Serial::write("gdt: cs=");
  Serial::writeHex(Gdt::currentCode() as u64);
  Serial::write(" tr=");
  Serial::writeHex(Gdt::currentTask() as u64);
  Serial::write("\n");
}

/// Builds the frame allocator, the kernel page tables and the heap, reports on
/// them and runs their self-tests.
///
/// The order is fixed. `Vmm::initialize` takes page-table frames from the
/// PMM, and `Modules::initialize` and the heap map their pages through the
/// VMM. Every self-test panics on failure, so a boot that continues has
/// passed them.
function initializeMemory(framebuffer: *mut Limine::Framebuffer): void {
  Pmm::initialize();

  Console::write("pmm: ");
  Console::writeDecimal(Pmm::totalFrames());
  Console::write(" usable frames, ");
  Console::writeDecimal(Pmm::freeFrameCount());
  Console::write(" free (");
  Console::writeDecimal(Pmm::freeFrameCount() * 4 / 1024);
  Console::writeLine(" MiB)");

  Pmm::selfTest();
  Console::writeLine("pmm: self-test ok");

  Vmm::initialize(framebuffer);

  Console::write("vmm: cr3 switched, cr3 ");
  Console::writeHex(Cpu::readCr3());
  Console::write(", pml4 ");
  Console::writeHex(Vmm::rootTable());
  Console::writeLine("");

  Vmm::selfTest();
  Console::writeLine("vmm: self-test ok");

  Modules::initialize();

  Heap::initialize();
  Heap::selfTest();

  Console::write("heap: self-test ok, ");
  Console::writeDecimal(Heap::mappedBytes() / 1024);
  Console::write(" KiB mapped, ");
  Console::writeDecimal(Heap::allocatedBytes());
  Console::writeLine(" bytes in use");

  AddressSpace::selfTest();
  Console::writeLine("address space: self-test ok, private user half, shared kernel half, frames returned");
}

/// Prints the local APIC state: physical base from the `IA32_APIC_BASE` MSR,
/// its ID and version registers, and whether it is enabled in the MSR (global
/// enable, bit 11) and in the spurious vector register (software enable,
/// bit 8). LINT0 is masked because the PIC is not used, LINT1 is set to NMI.
function reportLapic(): void {
  Console::write("lapic: base ");
  Console::writeHex(Lapic::physicalBase());
  Console::write(", id ");
  Console::writeDecimal(Lapic::id() as u64);
  Console::write(", version ");
  Console::writeHex(Lapic::version() as u64);
  Console::write(", msr enabled ");
  Console::writeDecimal(Lapic::isGloballyEnabled() ? 1 : 0);
  Console::write(", svr enabled ");
  Console::writeDecimal(Lapic::isSoftwareEnabled() ? 1 : 0);
  Console::writeLine(", LINT0 masked, LINT1 NMI");
}

/// Prints every IOAPIC (ID, version, redirection entry count, first GSI) and
/// the keyboard route: ISA IRQ 1, the GSI ACPI maps it to, the vector the
/// interrupt arrives on and the raw 64-bit redirection entry. Finishes with
/// the PIC interrupt mask register, which must read `0xffff` (all masked).
function reportIoapic(keyboardGsi: u32): void {
  let mut index: u64 = 0;

  while (index < Acpi::ioapicCount()) {
    Console::write("ioapic: id ");
    Console::writeDecimal(Ioapic::id(index) as u64);
    Console::write(", version ");
    Console::writeHex(Ioapic::version(index) as u64);
    Console::write(", ");
    Console::writeDecimal(Ioapic::entryCount(index));
    Console::write(" redirection entries, gsi base ");
    Console::writeDecimal(Acpi::ioapicGsiBase(index) as u64);
    Console::writeLine("");
    index += 1;
  }

  Console::write("ioapic: keyboard IRQ ");
  Console::writeDecimal(KEYBOARD_IRQ as u64);
  Console::write(" -> GSI ");
  Console::writeDecimal(keyboardGsi as u64);
  Console::write(", vector ");
  Console::writeHex(Interrupts::KEYBOARD_VECTOR);
  Console::write(", entry ");
  Console::writeHex(Ioapic::redirection(keyboardGsi));
  Console::writeLine("");

  Console::write("pic: masked, imr ");
  Console::writeHex(Pic::masks() as u64);
  Console::writeLine("");
}

/// Calibrates the APIC timer against the PIT, starts it, checks that ticks
/// arrive and reports the numbers. See `timer.ign`.
function initializeTimer(): void {
  Timer::initialize(Interrupts::TIMER_VECTOR as u8);

  Console::write("timer: calibrated on PIT channel 2: ");
  Console::writeDecimal(Timer::countRate());
  Console::write(" Hz (divide 16), initial count ");
  Console::writeDecimal(Timer::initialCount());
  Console::write(", ");
  Console::writeDecimal(Timer::FREQUENCY);
  Console::write(" Hz periodic, vector ");
  Console::writeHex(Interrupts::TIMER_VECTOR);
  Console::writeLine("");

  Timer::selfTest();

  Console::write("timer: self-test ok, ");
  Console::writeDecimal(Timer::ticks());
  Console::writeLine(" ticks so far");
}

/// Prints seconds with three decimals, then the raw tick count. The
/// fraction is zero-padded by hand to three digits, because `writeDecimal`
/// does no padding.
function printUptime(): void {
  let milliseconds: u64 = Timer::uptimeMilliseconds();
  let fraction: u64 = milliseconds % 1000;

  Console::write("uptime: ");
  Console::writeDecimal(milliseconds / 1000);
  Console::write(".");

  if (fraction < 100) {
    Console::write("0");
  }

  if (fraction < 10) {
    Console::write("0");
  }

  Console::writeDecimal(fraction);
  Console::write(" s, ");
  Console::writeDecimal(Timer::ticks());
  Console::write(" ticks at ");
  Console::writeDecimal(Timer::FREQUENCY);
  Console::writeLine(" Hz");
}

/// True when the first `length` bytes of `line` spell `text` exactly.
/// `text` is NUL-terminated and `line` is not, so `length` bounds `line`.
function lineIs(line: *mut u8, length: u64, text: str): boolean {
  let mut cursor: *u8 = text as *u8;
  let mut index: u64 = 0;

  while (*cursor != 0) {
    if (index == length || *(line + index) != *cursor) {
      return false;
    }

    index += 1;
    cursor = cursor + 1;
  }

  return index == length;
}

/// True when the line begins with `prefix`. `prefix` is NUL-terminated and
/// `line` is not, so `length` bounds `line`.
function lineStartsWith(line: *mut u8, length: u64, prefix: str): boolean {
  let mut cursor: *u8 = prefix as *u8;
  let mut index: u64 = 0;

  while (*cursor != 0) {
    if (index == length || *(line + index) != *cursor) {
      return false;
    }

    index += 1;
    cursor = cursor + 1;
  }

  return true;
}

/// Runs the command on the line. A line that names no command does nothing:
/// there is no "unknown command" message.
function runCommand(line: *mut u8, length: u64): void {
  if (lineIs(line, length, UPTIME_COMMAND)) {
    printUptime();
  } else if (lineIs(line, length, PS_COMMAND)) {
    ThreadCommands::printThreads();
  } else if (lineIs(line, length, THREADS_COMMAND)) {
    if (!ThreadCommands::startDemo()) {
      Console::writeLine("threads: the thread table is full");
    }
  } else if (lineStartsWith(line, length, RUN_COMMAND)) {
    Programs::run((line + RUN_COMMAND_LENGTH) as *u8, length - RUN_COMMAND_LENGTH);
  }
}

/// Prints the green `> ` prompt, then switches to bright white for the text
/// the user types.
function printPrompt(): void {
  Console::setColors(Color::BRIGHT_GREEN, Color::BLACK);
  Console::write("> ");
  Console::setColors(Color::BRIGHT_WHITE, Color::BLACK);
}

/// Drains the scancode queue forever and edits one line at a time: printable
/// characters are echoed and stored, Backspace erases the last stored
/// character but never the prompt, and Enter runs the line as a command and
/// starts a new prompt. The terminal runs in the boot thread, so the keyboard
/// keeps working while other threads run. Input past `LINE_CAPACITY` and Tab
/// are ignored.
///
/// The queue is checked with interrupts off, so an IRQ1 cannot land between
/// the check and the `sti; hlt` that sleeps until the next one:
///
/// ```text
///   cli
///   queue empty?  ── yes ──► sti; hlt   (one pair: an interrupt that was
///                            │           already pending wakes the hlt)
///                            └─ loop
///   no ──► sti, pop one scancode, decode, act
/// ```
///
/// Without the `cli` the interrupt could fire after the emptiness check and
/// before the `hlt`, and the processor would sleep with a byte waiting.
function runTerminal(): void {
  // Literal size: array lengths must be integer literals, so this repeats
  // `LINE_CAPACITY`.
  let mut line: u8[128];
  let mut length: u64 = 0;

  printPrompt();

  while (true) {
    Cpu::disableInterrupts();

    if (ScancodeQueue::isEmpty()) {
      Cpu::waitForInterrupt();
      continue;
    }

    Cpu::enableInterrupts();

    let character: u8 = Keyboard::decode(ScancodeQueue::pop());

    if (character == NEWLINE) {
      Console::writeChar(NEWLINE);

      runCommand(&mut line as *mut u8, length);

      length = 0;
      printPrompt();
    } else if (character == BACKSPACE) {
      if (length > 0) {
        length -= 1;
        Console::writeChar(BACKSPACE);
      }
    } else if (character >= FIRST_PRINTABLE && character <= LAST_PRINTABLE && length < LINE_CAPACITY) {
      line[length] = character;
      length += 1;
      Console::writeChar(character);
    }
  }
}

/// The ELF entry point. Limine jumps here in long mode on its own stack, with
/// interrupts disabled and every request already answered. The function never
/// returns: it ends in the terminal loop or, on a fatal error, in
/// `Cpu::haltForever`.
///
/// `@externName("kmain")` keeps the C symbol name unmangled, which is the
/// name `ENTRY(kmain)` in `kernel/linker.ld` refers to.
@externName("kmain")
function kmain(): void {
  Serial::initialize();
  Serial::writeLine("IgniOS booting");

  // The IDT gates installed next name the kernel's code selector, and the double
  // fault gate names IST1 of the kernel's TSS, so the GDT comes first.
  Gdt::initialize();
  reportGdt();

  // From here every CPU exception reaches `Interrupts::dispatch`. The IDT state
  // Limine leaves is not specified by the protocol, so the kernel installs its
  // own before it does anything that can fault.
  Idt::initialize();
  Serial::writeLine("idt: 50 gates loaded");

  // Limine overwrites the third word of the base revision tag with 0 when it
  // supports the revision requested. Anything else means the responses below
  // cannot be trusted.
  if (!Limine::isBaseRevisionSupported()) {
    @panic("Limine base revision 6 is not supported");
  }

  let framebuffer: *mut Limine::Framebuffer = requireFramebuffer();

  Console::initialize(framebuffer);
  printBanner(framebuffer);

  initializeMemory(framebuffer);

  Scheduler::initialize();
  Process::initialize();
  Syscall::initialize();

  // Sets IA32_EFER.SCE and programs IA32_STAR, IA32_LSTAR and IA32_FMASK. See
  // `usermode.ign`. The values are logged to COM1 only.
  UserMode::initialize();
  Serial::write("usermode: syscall enabled, star ");
  Serial::writeHex(UserMode::starValue());
  Serial::write(", lstar ");
  Serial::writeHex(UserMode::entryAddress());
  Serial::write(", fmask ");
  Serial::writeHex(UserMode::flagMask());
  Serial::write("\n");

  Acpi::initialize();
  Acpi::report();

  // The 8259 is remapped to vectors 0x20-0x2F, away from the CPU exceptions
  // 0-31, and fully masked. The kernel receives device interrupts through the
  // IOAPIC instead.
  Pic::initialize();
  Lapic::initialize();
  reportLapic();

  Ioapic::initialize();

  let keyboardGsi: u32 = Ioapic::routeIsa(KEYBOARD_IRQ, Interrupts::KEYBOARD_VECTOR as u8);

  if (keyboardGsi == Ioapic::NO_GSI) {
    @panic("no IOAPIC serves the keyboard interrupt");
  }

  reportIoapic(keyboardGsi);

  initializeTimer();

  Context::selfTest();
  Console::writeLine("context: self-test ok, stack switch, argument, alignment and registers checked");

  SchedulerTest::runCooperative();

  Console::write("scheduler: self-test ok, round-robin, sleep and slot reuse, ");
  Console::writeDecimal(Scheduler::switchCount());
  Console::writeLine(" switches");

  SchedulerTest::runAddressSpaces();
  Console::writeLine("scheduler: address-space self-test ok, each thread ran in its own CR3 and every frame came back");

  // From here the timer tick can switch threads. The self-tests above ran
  // cooperatively because their expectations assume no preemption.
  Scheduler::enablePreemption();

  let preemptions: u64 = SchedulerTest::runPreemptive();

  Console::write("scheduler: preemption self-test ok, two threads that never yield shared the processor, ");
  Console::writeDecimal(preemptions);
  Console::writeLine(" preemptions");

  UserTest::run();

  // The keyboard is initialized last: its interrupt is live from here on, and
  // the terminal is the first code that consumes it.
  if (!initializeKeyboard()) {
    Cpu::haltForever();
  }

  runTerminal();
}
