//!
//! # Kernel Entry Point
//!
//! `kmain`, the boot order. Every step is a call into the subsystem that owns
//! it, and the subsystem prints its own boot log line.
//!
//! ## Overview
//!
//! Limine loads the kernel ELF, switches the CPU to 64-bit mode with paging
//! on, answers the requests in `boot/limine.ign` and jumps to `kmain` (the ELF
//! entry point named in `kernel/linker.ld`). From there everything runs in
//! ring 0 on the boot thread. When `kmain` reaches `Shell::Terminal::run` the
//! boot thread becomes the shell and never returns.
//!
//! State on entry (Limine protocol, x86-64): interrupts off (RFLAGS.IF clear),
//! the 8259 PIC lines masked, Limine's own GDT loaded, a stack of at least
//! 64 KiB in bootloader-reclaimable memory, the kernel mapped in the top 2 GiB
//! (`0xffffffff80000000` and up). See concept doc 01.
//!
//! ## Boot Sequence
//!
//! Each step needs the ones above it. The right column names the subsystem
//! that owns the step and the concept doc that explains the hardware.
//!
//! ```text
//!   kmain
//!   │
//!   ├─ Drivers::Serial::initialize ........ COM1 up, first log line       drivers/   doc 06
//!   ├─ Trap::Setup::initializeGdt ......... own GDT, TSS, CS/SS/DS        trap/      doc 03
//!   ├─ Trap::Setup::initializeIdt ......... 50 gates (49 thunks + spur.)  trap/      doc 04
//!   ├─ Boot::Limine::require* ............. base revision, framebuffer    boot/      doc 01
//!   ├─ Drivers::Console::initialize ....... framebuffer text console      drivers/   doc 07
//!   ├─ banner, framebuffer, memory map lines
//!   ├─ Mm::Pmm::initialize + Tests::Pmm ... frame bitmap                  mm/        doc 08
//!   ├─ Mm::Vmm::initialize + Tests::Vmm ... own page tables, CR3 switch   mm/        doc 09
//!   ├─ Mm::Modules::initialize ............ map Limine modules            mm/        doc 15
//!   ├─ Mm::Heap::initialize + Tests::Heap . kernel heap                   mm/        doc 10
//!   ├─ Tests::AddressSpace ................ private user halves           mm/        doc 14
//!   ├─ Sched::Scheduler::initialize, Proc::Process::initialize, Syscall::initialize
//!   ├─ Trap::Setup::initializeUserMode .... EFER.SCE, STAR/LSTAR/FMASK    trap/      doc 14
//!   ├─ Acpi::initialize/report ............ RSDP, XSDT, MADT              acpi/      doc 12
//!   ├─ Arch::Pic::initialize .............. remap and mask the 8259       arch/      doc 05
//!   ├─ Apic::Lapic::initialize ............ local APIC on                 apic/      doc 05
//!   ├─ Apic::Ioapic::initialize + routeIsa(keyboard)                      apic/      doc 12
//!   ├─ Time::Timer::initialize ............ APIC timer, 100 Hz            time/      doc 12
//!   ├─ Tests::Context, Tests::Scheduler ... context switch, scheduler     tests/     doc 13
//!   ├─ Sched::Scheduler::enablePreemption
//!   ├─ Tests::User::run ................... ring 3 smoke tests            tests/     doc 14
//!   ├─ Drivers::Keyboard::initialize ...... 8042 enable, IRQ1 live        drivers/   doc 06
//!   └─ Shell::Terminal::run ............... prompt loop, never returns    shell/
//! ```
//!
//! ## Where Output Goes
//!
//! Before the console exists, `kmain` logs to COM1 only
//! (`Drivers::Serial::write`). `Drivers::Console::write` shows text on the
//! framebuffer and mirrors every byte to COM1, so the serial log of a headless
//! run contains the whole screen. The `docs/READING.md` guide annotates the
//! complete boot log line by line.
//!
//! ## Panics
//!
//! The panic handler is in `panic.ign`. This file imports it so the compiler
//! includes it.

import Acpi from "@acpi";
import Apic from "@apic";
import Arch from "@arch";
import Boot from "@boot";
import Drivers from "@drivers";
import Mm from "@mm";
import Proc from "@proc";
import Sched from "@sched";
import Shell from "@shell";
import Syscall from "@syscall";
import Tests from "@tests";
import Time from "@time";
import Trap from "@trap";
import _ from "./panic";

/// The ISA interrupt line of the PS/2 keyboard (IRQ1). The IOAPIC routes it
/// through the GSI that ACPI assigns to it.
const KEYBOARD_IRQ: u8 = 1;

/// The ELF entry point. Limine jumps here in long mode on its own stack, with
/// interrupts disabled and every request already answered. The function never
/// returns: it ends in the terminal loop or, on a fatal error, in
/// `Arch::Cpu::haltForever`.
///
/// `@externName("kmain")` keeps the C symbol name unmangled, which is the
/// name `ENTRY(kmain)` in `kernel/linker.ld` refers to.
@externName("kmain")
function kmain(): void {
  Drivers::Serial::initialize();
  Drivers::Serial::writeLine("IgniOS booting");

  // The IDT gates installed next name the kernel's code selector, and the double
  // fault gate names IST1 of the kernel's TSS, so the GDT comes first. From the
  // IDT on, every CPU exception reaches `Trap::dispatch`.
  Trap::Setup::initializeGdt();
  Trap::Setup::initializeIdt();
  Trap::Setup::initializeFpu();

  // Anything but the revision requested means the responses below cannot be
  // trusted.
  Boot::Limine::requireBaseRevision();

  let framebuffer: *mut Boot::Limine::Framebuffer = Boot::Limine::requireFramebuffer();

  Drivers::Console::initialize(framebuffer);
  Drivers::Console::printBanner(framebuffer);
  Mm::Pmm::reportMemoryMap();
  Drivers::Console::writeLine("");

  // The order is fixed. `Mm::Vmm::initialize` takes page-table frames from the
  // PMM, and the modules and the heap map their pages through the VMM. Every
  // self-test panics on failure, so a boot that continues has passed them.
  Mm::Pmm::initialize();
  Mm::Pmm::report();
  Tests::Pmm::run();

  Mm::Vmm::initialize(framebuffer);
  Mm::Vmm::report();
  Tests::Vmm::run();

  Mm::Modules::initialize();

  Mm::Heap::initialize();
  Tests::Heap::run();

  Tests::AddressSpace::run();

  // The kernel page tables have no user page, so ring 0 cannot trip over
  // SMEP or SMAP from here on except by a bug, which then faults.
  Trap::Setup::initializeProtection();
  Tests::Protection::run();

  Sched::Scheduler::initialize();
  Proc::Process::initialize();
  Syscall::initialize();

  Trap::Setup::initializeUserMode();

  Acpi::initialize();
  Acpi::report();

  // The 8259 is remapped to vectors 0x20-0x2F, away from the CPU exceptions
  // 0-31, and fully masked. The kernel receives device interrupts through the
  // IOAPIC instead.
  Arch::Pic::initialize();
  Apic::Lapic::initialize();
  Apic::Lapic::report();

  Apic::Ioapic::initialize();

  let keyboardGsi: u32 = Apic::Ioapic::routeIsa(KEYBOARD_IRQ, Trap::KEYBOARD_VECTOR as u8);

  if (keyboardGsi == Apic::Ioapic::NO_GSI) {
    @panic("no IOAPIC serves the keyboard interrupt");
  }

  Apic::Ioapic::report(KEYBOARD_IRQ, keyboardGsi, Trap::KEYBOARD_VECTOR);

  Time::Timer::initialize(Trap::TIMER_VECTOR as u8);
  Time::Timer::report();
  Tests::Timer::run();

  Tests::Context::run();
  Tests::Scheduler::runCooperative();
  Tests::Scheduler::runAddressSpaces();

  // From here the timer tick can switch threads. The self-tests above ran
  // cooperatively because their expectations assume no preemption.
  Sched::Scheduler::enablePreemption();

  Tests::Scheduler::runPreemptive();
  Tests::User::run();
  Tests::CpuLocal::run();

  // The keyboard is initialized last: its interrupt is live from here on, and
  // the terminal is the first code that consumes it.
  if (!Drivers::Keyboard::initialize()) {
    Arch::Cpu::haltForever();
  }

  Shell::Terminal::run();
}
