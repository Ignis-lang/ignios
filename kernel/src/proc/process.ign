//!
//! # Processes
//!
//! User processes: an address space, a thread that runs in it, and the
//! bookkeeping that outlives the thread.
//!
//! ## Overview
//!
//! A process is a slot in a fixed table next to a kernel thread that owns the
//! address space (`Sched::Scheduler::spawnIn`). The thread starts in `userMain`,
//! which drops to ring 3 and never comes back: from then on the thread is
//! only the kernel stack that interrupts and system calls of the process run
//! on. When the process ends, through `exit` or because it was killed, the
//! slot records the status, the thread ends, and the next thread to run frees
//! the thread's stack and the address space. `wait` collects the status and
//! frees the slot.
//!
//! The process id is not the thread id. Syscalls find the calling process
//! by looking for the slot whose thread is the running one.
//!
//! ## Lifetime
//!
//! ```text
//!   Proc::Programs::run("hello")
//!     └─ Proc::Process::startElf(image)
//!          ├─ Mm::AddressSpace::create            new PML4, kernel half shared
//!          ├─ Proc::Elf::load                       map and fill PT_LOAD segments
//!          ├─ mapStack                        8 zeroed no-execute pages
//!          └─ launch
//!               ├─ slot := RUNNING, id := nextId++
//!               └─ Sched::Scheduler::spawnIn(userMain, slot, root)   thread owns `root`
//!
//!   the new thread:  userMain ─► Arch::UserMode::enter ─► ring 3 ...
//!                                    ... syscall exit(n) or a fault ...
//!   finishCurrent:   status := n, state := EXITED, print "process N exited"
//!                      └─ Sched::Scheduler::exitCurrent   thread DEAD
//!   next thread:     reapZombie frees the kernel stack and destroys the
//!                    address space (every frame goes back to the PMM)
//!   Proc::Process::wait:   sleeps until EXITED and the thread is gone,
//!                    returns the status, slot := FREE
//! ```
//!
//! ## User Address Space of a Process
//!
//! ```text
//!   0x0000000000400000  program segments (text r-x, rodata r--, data rw-)
//!   0x00007FFFFFFF7000  ┐
//!                       │ stack: 8 pages, read/write, no-execute, zeroed
//!   0x00007FFFFFFFF000  ┘ STACK_TOP = Mm::AddressSpace::USER_LIMIT, the first
//!                         byte past the stack and the page that stays unmapped
//!   initial RSP = STACK_TOP - 8, as if a `call` had just pushed a return
//!   address, so the System V ABI alignment holds at the first instruction
//! ```
//!
//! See concept doc 14.

import Arch from "@arch";
import Boot from "@boot";
import Drivers from "@drivers";
import Lib from "@lib";
import Mm from "@mm";
import Sched from "@sched";
import _ from "./elf";

/// One entry of the process table.
@cLayout
record ProcessEntry {
  /// The process id, from a counter that starts at 1 and never repeats.
  public id: u64;

  /// `FREE`, `RUNNING` or `EXITED`.
  public state: u64;

  /// Id of the kernel thread that runs the process.
  public thread: u64;

  /// User address the program starts at.
  public entry: u64;

  /// User stack pointer the program starts with.
  public stackPointer: u64;

  /// The exit status, valid once the state is `EXITED`.
  public status: u64;

  /// The system call convention of the process, `ABI_LINUX`.
  public abi: u64;
}

/// The process table and the id counter.
record ProcessState {
  /// The process slots.
  static mut table: ProcessEntry[8];

  /// The id the next process gets.
  static mut nextId: u64;
}

/// The process API.
namespace Proc::Process {
  /// Size of the process table.
  const MAX_PROCESSES: u64 = 8;

  /// Returned instead of a process id or a slot when there is none.
  const NO_PROCESS: u64 = 0xFFFFFFFFFFFFFFFF;

  /// Slot state: not in use.
  const FREE: u64 = 0;

  /// Slot state: the process was started and has not ended.
  const RUNNING: u64 = 1;

  /// Slot state: the process ended and its status waits for `wait`.
  const EXITED: u64 = 2;

  /// The system call convention the process speaks: Linux x86_64 numbers and
  /// errno values.
  const ABI_LINUX: u64 = 0;

  /// 4 KiB.
  const PAGE_SIZE: u64 = 4096;

  /// Where raw test programs are loaded.
  const CODE_BASE: u64 = 0x400000;

  /// The user stack is `STACK_PAGES` pages that end at the user limit minus
  /// the unmapped last page, so running off its bottom faults.
  const STACK_PAGES: u64 = 8;

  /// The first address past the user stack: `Mm::AddressSpace::USER_LIMIT`. The
  /// stack grows down from here and the page at this address stays unmapped.
  const STACK_TOP: u64 = Mm::AddressSpace::USER_LIMIT;

  /// Process ids start at 1.
  function initialize(): void {
    ProcessState::nextId = 1;
  }

  /// Starts a process whose whole image is `length` bytes of machine code
  /// copied to `CODE_BASE`, read and execute, with a fresh stack. The code
  /// must fit one page. Returns the process id, or `NO_PROCESS`.
  function startCode(code: *u8, length: u64): u64 {
    if (length == 0 || length > PAGE_SIZE) {
      return NO_PROCESS;
    }

    let root: u64 = Mm::AddressSpace::create();

    if (root == Mm::Pmm::NO_FRAME) {
      return NO_PROCESS;
    }

    let frame: u64 = Mm::AddressSpace::allocatePage(root, CODE_BASE, 0);

    if (frame == Mm::Pmm::NO_FRAME || !mapStack(root)) {
      Mm::AddressSpace::destroy(root);
      return NO_PROCESS;
    }

    Lib::Mem::copy(Boot::Hhdm::toVirtual(frame), code, length);

    return launch(root, CODE_BASE);
  }

  /// Starts a process from the ELF executable in the `size` bytes at `image`
  /// and a fresh stack. Prints what the loader mapped, or why it refused the
  /// file. Returns the process id, or `NO_PROCESS`.
  function startElf(image: *u8, size: u64): u64 {
    let root: u64 = Mm::AddressSpace::create();

    if (root == Mm::Pmm::NO_FRAME) {
      return NO_PROCESS;
    }

    let mut loaded: Proc::LoadedImage = Proc::LoadedImage { entry: 0, segments: 0, pages: 0 };
    let error: u64 = Proc::Elf::load(image, size, root, &mut loaded as *mut Proc::LoadedImage);

    if (error != Proc::Elf::OK) {
      Drivers::Console::write("elf: ");
      Drivers::Console::writeLine(Proc::Elf::describe(error));
      Mm::AddressSpace::destroy(root);
      return NO_PROCESS;
    }

    if (!mapStack(root)) {
      Drivers::Console::writeLine("elf: out of memory for the stack");
      Mm::AddressSpace::destroy(root);
      return NO_PROCESS;
    }

    Drivers::Console::write("elf: ");
    Drivers::Console::writeDecimal(loaded.segments);
    Drivers::Console::write(" segments, ");
    Drivers::Console::writeDecimal(loaded.pages);
    Drivers::Console::write(" pages, entry ");
    Drivers::Console::writeHex(loaded.entry);
    Drivers::Console::write(", stack top ");
    Drivers::Console::writeHex(STACK_TOP);
    Drivers::Console::writeLine("");

    return launch(root, loaded.entry);
  }

  /// Maps the user stack, zeroed and no-execute. Returns false when memory
  /// runs out; the caller destroys the space.
  function mapStack(root: u64): boolean {
    let mut page: u64 = 1;

    while (page <= STACK_PAGES) {
      let address: u64 = STACK_TOP - page * PAGE_SIZE;

      if (Mm::AddressSpace::allocatePage(root, address, Mm::Vmm::WRITABLE | Mm::Vmm::NO_EXECUTE) == Mm::Pmm::NO_FRAME) {
        return false;
      }

      page += 1;
    }

    return true;
  }

  /// Makes a process of the address space `root`, which the process now owns
  /// and which must already hold the program and its stack, and queues its
  /// thread. The program starts at `entry`. The stack pointer starts 8 below
  /// the top, as if a `call` had just pushed a return address, so a function
  /// compiled for the System V ABI sees the alignment it expects at its
  /// first instruction. Returns the process id, or `NO_PROCESS`; the space is
  /// destroyed on failure.
  function launch(root: u64, entry: u64): u64 {
    let saved: u64 = Arch::Cpu::saveAndDisableInterrupts();
    let slot: u64 = findFreeSlot();

    if (slot == NO_PROCESS) {
      Mm::AddressSpace::destroy(root);
      Arch::Cpu::restoreInterrupts(saved);
      return NO_PROCESS;
    }

    let process: *mut ProcessEntry = slotPointer(slot);

    (*process).id = ProcessState::nextId;
    (*process).state = RUNNING;
    (*process).entry = entry;
    (*process).stackPointer = STACK_TOP - 8;
    (*process).status = 0;
    (*process).abi = ABI_LINUX;

    let thread: u64 = Sched::Scheduler::spawnIn(Arch::ContextAsm::ignis_function_address(userMain), slot, root);

    if (thread == Sched::Thread::NO_THREAD) {
      (*process).state = FREE;
      Arch::Cpu::restoreInterrupts(saved);
      return NO_PROCESS;
    }

    (*process).thread = thread;
    ProcessState::nextId += 1;

    let id: u64 = (*process).id;

    Arch::Cpu::restoreInterrupts(saved);

    return id;
  }

  /// Waits until the process `id` has ended and its address space is freed,
  /// then returns its exit status and frees its slot. Returns
  /// `0xFFFFFFFFFFFFFFFF` for an id that is not in the table.
  function wait(id: u64): u64 {
    let slot: u64 = findSlot(id);

    if (slot == NO_PROCESS) {
      return NO_PROCESS;
    }

    let process: *mut ProcessEntry = slotPointer(slot);

    while ((*process).state != EXITED || Sched::Thread::isAlive((*process).thread)) {
      Sched::Scheduler::sleep(1);
    }

    let status: u64 = (*process).status;

    (*process).state = FREE;

    return status;
  }

  /// The id of the process the running thread belongs to, or `NO_PROCESS`
  /// when it is a kernel thread.
  function currentId(): u64 {
    let slot: u64 = currentSlot();

    if (slot == NO_PROCESS) {
      return NO_PROCESS;
    }

    return (*slotPointer(slot)).id;
  }

  /// The system call convention of the running process.
  function currentAbi(): u64 {
    let slot: u64 = currentSlot();

    if (slot == NO_PROCESS) {
      return ABI_LINUX;
    }

    return (*slotPointer(slot)).abi;
  }

  /// The address space of the running process. Zero for a kernel thread.
  function currentRoot(): u64 {
    if (currentSlot() == NO_PROCESS) {
      return 0;
    }

    return Arch::Cpu::readCr3();
  }

  /// Ends the running process with `status` and never returns.
  function exitCurrent(status: u64): never {
    finishCurrent(status, false);
  }

  /// Ends the running process because it did something the kernel does not
  /// allow. `status` follows the shell convention, 128 plus the number of
  /// the signal Linux would have sent. Never returns.
  function killCurrent(status: u64): never {
    finishCurrent(status, true);
  }

  /// Records the status, reports the end on the console and ends the
  /// thread. The address space is freed by the next thread that runs.
  function finishCurrent(status: u64, killed: boolean): never {
    let slot: u64 = currentSlot();

    if (slot == NO_PROCESS) {
      @panic("process: a kernel thread tried to end a process");
    }

    let process: *mut ProcessEntry = slotPointer(slot);

    (*process).status = status;
    (*process).state = EXITED;

    Drivers::Console::write("process ");
    Drivers::Console::writeDecimal((*process).id);

    if (killed) {
      Drivers::Console::write(" killed, status ");
    } else {
      Drivers::Console::write(" exited with status ");
    }

    Drivers::Console::writeDecimal(status);
    Drivers::Console::writeLine("");

    Sched::Scheduler::exitCurrent();
  }

  /// Runs in the thread of a new process: drops to ring 3. The argument is
  /// the process slot.
  function userMain(slot: u64): void {
    let process: *mut ProcessEntry = slotPointer(slot);

    Arch::UserMode::enter((*process).entry, (*process).stackPointer);
  }

  /// The slot of the process whose thread is running, or `NO_PROCESS`.
  function currentSlot(): u64 {
    let thread: u64 = Sched::Scheduler::currentId();
    let mut slot: u64 = 0;

    while (slot < MAX_PROCESSES) {
      let process: *mut ProcessEntry = slotPointer(slot);

      if ((*process).state == RUNNING && (*process).thread == thread) {
        return slot;
      }

      slot += 1;
    }

    return NO_PROCESS;
  }

  /// The slot of the process with this id that is not free, or `NO_PROCESS`.
  function findSlot(id: u64): u64 {
    let mut slot: u64 = 0;

    while (slot < MAX_PROCESSES) {
      let process: *mut ProcessEntry = slotPointer(slot);

      if ((*process).state != FREE && (*process).id == id) {
        return slot;
      }

      slot += 1;
    }

    return NO_PROCESS;
  }

  /// The first free slot, or `NO_PROCESS` when the table is full.
  function findFreeSlot(): u64 {
    let mut slot: u64 = 0;

    while (slot < MAX_PROCESSES) {
      if ((*slotPointer(slot)).state == FREE) {
        return slot;
      }

      slot += 1;
    }

    return NO_PROCESS;
  }

  /// A pointer to the table entry of `slot`.
  function slotPointer(slot: u64): *mut ProcessEntry {
    return tableBase() + slot;
  }

  /// A pointer to the first entry of the process table.
  function tableBase(): *mut ProcessEntry {
    return &mut ProcessState::table as *mut ProcessEntry;
  }
}
