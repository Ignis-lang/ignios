//!
//! # Running Programs
//!
//! Running the programs the bootloader loaded: look a module up by name,
//! start it as a process and wait for it.
//!
//! ## Overview
//!
//! `run hello` at the terminal ends up in `Proc::Programs::run`:
//!
//! ```text
//!   Proc::Programs::run(name, length)
//!     ├─ Mm::Modules::find            match the module string
//!     ├─ Proc::Process::startElf        build the address space, load, launch
//!     └─ Proc::Process::wait            block until the process is gone, return its status
//! ```

import Drivers from "@drivers";
import Mm from "@mm";
import _ from "./process";

/// The program API.
namespace Proc::Programs {
  /// Runs the module whose configuration string is the `length` bytes at
  /// `name`, waits for the process and returns its exit status. Returns
  /// `Proc::Process::NO_PROCESS` after printing why when no process ran.
  function run(name: *u8, length: u64): u64 {
    let index: u64 = Mm::Modules::find(name, length);

    if (index == Mm::Modules::NOT_FOUND) {
      Drivers::Console::write("run: no program named ");

      let mut position: u64 = 0;

      while (position < length) {
        Drivers::Console::writeChar(*(name + position));
        position += 1;
      }

      Drivers::Console::writeLine("");

      return Proc::Process::NO_PROCESS;
    }

    let id: u64 = Proc::Process::startElf(Mm::Modules::address(index), Mm::Modules::size(index));

    if (id == Proc::Process::NO_PROCESS) {
      return Proc::Process::NO_PROCESS;
    }

    return Proc::Process::wait(id);
  }

  /// `run` for a name known at compile time.
  function runNamed(name: str): u64 {
    let mut length: u64 = 0;

    while (*(name as *u8 + length) != 0) {
      length += 1;
    }

    return run(name as *u8, length);
  }
}
