//!
//! # ELF64 Loader
//!
//! A loader for static ELF64 executables.
//!
//! ## Overview
//!
//! The accepted file is what the user linker script produces: a 64-bit
//! little-endian `ET_EXEC` for x86-64 that needs no relocation, with its
//! program headers inside the file. Only `PT_LOAD` headers matter. For each
//! one the loader stages a private file region of the executable
//! (`Proc::Memory::stageImage`) covering `p_memsz` bytes at `p_vaddr`,
//! rounded out to whole pages: nothing is copied or mapped at load, and
//! every page comes from the page cache of the file on first access. The
//! first `p_filesz` bytes are the file's and the rest is zero, which is how
//! `.bss` appears. A region is writable when the segment has `PF_W` and
//! executable when it has `PF_X`; a segment with both is refused, so no
//! user page is ever writable and executable at once. Two segments may not
//! share a page, and nothing may be mapped below one page or at or above
//! `Proc::Memory::MAP_BOTTOM`, where the `mmap` regions and the stack live.
//! The headers and notes are read through `Fs::Vfs::read` under the VFS
//! lock, never from the node's `data`, which a cached page supersedes.
//!
//! The loader trusts nothing in the file: every offset, size and address is
//! checked against the file size and the user range before it is used, with
//! comparisons that cannot overflow.
//!
//! ## From File to Address Space
//!
//! The `hello` program as `user.ld` lays it out (`readelf -l build/user/hello.elf`):
//!
//! ```text
//!   ELF file (hello.elf), its page cache      user address space of the process
//!   ┌─────────────────────┐ 0x0000
//!   │ ELF header (64 B)   │
//!   │ program headers     │ 3 x 56 B
//!   ├─────────────────────┤ 0x1000 page 1        0x400000 ┌────────────────────────┐
//!   │ .text   0x692 bytes │ ─ PT_LOAD R+X ───────────────► │ r-x  cache frame,      │
//!   │                     │   region, file bytes to the    │ shared by every process │
//!   │                     │   end of the page              │                        │
//!   ├─────────────────────┤ 0x2000 page 2        0x401000 ├────────────────────────┤
//!   │ .rodata 0xA7 bytes  │ ─ PT_LOAD R ─────────────────► │ r--  cache frame       │
//!   ├─────────────────────┤ 0x3000 page 3        0x402000 ├────────────────────────┤
//!   │ .data   8 bytes     │ ─ PT_LOAD R+W ───────────────► │ rw-  private copy:     │
//!   │ (.bss 8 bytes is    │   filesz 8, memsz 16,          │ 8 bytes from the file, │
//!   │  not in the file)   │   file bytes end at 8          │ zeros after (.bss)     │
//!   ├─────────────────────┤                                └────────────────────────┘
//!   │ symbols, sections   │ not loaded
//!   └─────────────────────┘
//!
//!   page states on first access (Proc::Memory::resolve):
//!     backed page, read or fetch   the cache frame, read-only, shared
//!     backed page, write           a private copy (data, copy on write)
//!     page holding the end of the  a private frame: the file bytes, then
//!     file bytes, or past them     zeros (the reservation pays for it)
//!
//!   entry point 0x400000 must lie in an executable region (checkEntry)
//! ```
//!
//! A read-only segment with nothing past its file bytes (`p_memsz` equals
//! `p_filesz`) takes its last page whole from the file, as Linux maps it, so
//! even a text of 0x692 bytes is a shared cache frame. The image regions
//! keep the file from being removed, written or truncated (`BUSY`, Linux
//! `ETXTBSY`) while the process lives.
//!
//! A segment's file offset and virtual address must agree modulo the page size
//! (`offset % 4096 == address % 4096`), which the linker script guarantees by
//! starting every segment on its own page.
//!
//! ## ELF Structures
//!
//! ```text
//!   Elf64_Ehdr (64 bytes)                    Elf64_Phdr (56 bytes)
//!    0  e_ident[16]  7F 'E' 'L' 'F',          0  p_type    u32   1 = PT_LOAD
//!                    class 2 (64-bit),         4  p_flags   u32   1 X, 2 W, 4 R
//!                    data 1 (little endian),   8  p_offset  u64
//!                    version 1                16  p_vaddr   u64
//!   16  e_type      u16  2 = ET_EXEC          24  p_paddr   u64
//!   18  e_machine   u16  62 = x86-64          32  p_filesz  u64
//!   20  e_version   u32                       40  p_memsz   u64
//!   24  e_entry     u64                       48  p_align   u64
//!   32  e_phoff     u64
//!   40  e_shoff     u64
//!   48  e_flags     u32
//!   52  e_ehsize    u16
//!   54  e_phentsize u16  must be 56
//!   56  e_phnum     u16  1 to 32
//!   58  e_shentsize u16
//!   60  e_shnum     u16
//!   62  e_shstrndx  u16
//! ```
//!
//! See concept doc 15 and the System V ABI, "ELF-64 Object File Format".

import Drivers from "@drivers";
import Fs from "@fs";
import Mm from "@mm";
import _ from "./memory";

/// `Elf64_Ehdr`, 64 bytes. The field names follow the Ignis convention; each
/// matches the `e_*` field of the same meaning.
@cLayout
record ElfHeader {
  /// `e_ident`: the magic bytes `7F 45 4C 46`, the class (2 = 64-bit), the data
  /// encoding (1 = little endian) and the version (1).
  public ident: u8[16];

  /// `e_type`: 2 for an executable at fixed addresses.
  public kind: u16;

  /// `e_machine`: 62 for x86-64.
  public machine: u16;

  /// `e_version`: 1.
  public version: u32;

  /// `e_entry`: the virtual address where execution starts.
  public entry: u64;

  /// `e_phoff`: file offset of the program header table.
  public programHeaderOffset: u64;

  /// `e_shoff`: file offset of the section header table. Not used by the loader.
  public sectionHeaderOffset: u64;

  /// `e_flags`: processor-specific flags, 0 on x86-64. Not used.
  public flags: u32;

  /// `e_ehsize`: size of this header, 64. Not used.
  public headerSize: u16;

  /// `e_phentsize`: size of one program header, 56.
  public programHeaderSize: u16;

  /// `e_phnum`: number of program headers.
  public programHeaderCount: u16;

  /// `e_shentsize`: size of one section header. Not used.
  public sectionHeaderSize: u16;

  /// `e_shnum`: number of section headers. Not used.
  public sectionHeaderCount: u16;

  /// `e_shstrndx`: index of the section name string table. Not used.
  public sectionNameIndex: u16;
}

/// `Elf64_Phdr`, 56 bytes: describes one segment.
@cLayout
record ProgramHeader {
  /// `p_type`: 1 for a loadable segment (`PT_LOAD`).
  public kind: u32;

  /// `p_flags`: bit 0 execute, bit 1 write, bit 2 read.
  public flags: u32;

  /// `p_offset`: where the segment's bytes start in the file.
  public offset: u64;

  /// `p_vaddr`: where the segment starts in the process.
  public virtualAddress: u64;

  /// `p_paddr`: physical address, ignored for a user program.
  public physicalAddress: u64;

  /// `p_filesz`: bytes to copy from the file.
  public fileSize: u64;

  /// `p_memsz`: bytes the segment occupies in memory. The part beyond
  /// `fileSize` is zero.
  public memorySize: u64;

  /// `p_align`: alignment of the segment. Not used; the loader checks page
  /// agreement of `offset` and `virtualAddress` directly.
  public alignment: u64;
}

namespace Proc {
  /// What `Proc::Elf::load` reports about a loaded image.
  @cLayout
  record LoadedImage {
    /// The entry point, taken from the header.
    public entry: u64;

    /// Loadable segments staged.
    public segments: u64;

    /// Pages the segments span, mapped on first access.
    public pages: u64;

    /// The system call ABI the program asks for: `Proc::Elf::ABI_LINUX`, or
    /// `Proc::Elf::ABI_NATIVE` when it carries the IgniOS note.
    public abi: u64;
  }
}

/// The loader API.
namespace Proc::Elf {
  /// Size of `Elf64_Ehdr`.
  const HEADER_SIZE: u64 = 64;

  /// Size of `Elf64_Phdr`.
  const PROGRAM_HEADER_SIZE: u64 = 56;

  /// The most program headers the loader accepts.
  const MAX_PROGRAM_HEADERS: u64 = 32;

  /// 4 KiB.
  const PAGE_SIZE: u64 = 4096;

  /// `e_ident[4]`: ELFCLASS64.
  const CLASS_64: u8 = 2;

  /// `e_ident[5]`: ELFDATA2LSB.
  const DATA_LITTLE_ENDIAN: u8 = 1;

  /// `e_ident[6]`: EV_CURRENT.
  const VERSION_CURRENT: u8 = 1;

  /// `e_type` ET_EXEC.
  const TYPE_EXECUTABLE: u16 = 2;

  /// `e_machine` EM_X86_64.
  const MACHINE_X86_64: u16 = 62;

  /// `p_type` PT_LOAD.
  const SEGMENT_LOAD: u32 = 1;

  /// `p_flags` PF_X.
  const FLAG_EXECUTE: u32 = 1;

  /// `p_flags` PF_W.
  const FLAG_WRITE: u32 = 2;

  /// `Proc::Elf::load` results: 0 is success, anything else names what was wrong.
  const OK: u64 = 0;

  /// The file is shorter than an ELF header.
  const ERR_TOO_SMALL: u64 = 1;

  /// The file does not start with the ELF magic.
  const ERR_MAGIC: u64 = 2;

  /// Not a static little-endian x86-64 ELF64 executable.
  const ERR_FORMAT: u64 = 3;

  /// The program header table is empty, too big or outside the file.
  const ERR_PROGRAM_HEADERS: u64 = 4;

  /// The file has no `PT_LOAD` segment.
  const ERR_NO_SEGMENTS: u64 = 5;

  /// A segment lies outside the user address space or at page 0.
  const ERR_SEGMENT_RANGE: u64 = 6;

  /// A segment's bytes lie outside the file, or its offset and address do not
  /// agree modulo the page size.
  const ERR_SEGMENT_FILE: u64 = 7;

  /// A segment is both writable and executable.
  const ERR_WRITE_EXECUTE: u64 = 8;

  /// Two segments share a page.
  const ERR_OVERLAP: u64 = 9;

  /// No frame was left for a page.
  const ERR_MEMORY: u64 = 10;

  /// The entry point is not in an executable user page.
  const ERR_ENTRY: u64 = 11;

  /// The IgniOS note names an ABI version this kernel does not know.
  const ERR_ABI: u64 = 12;

  /// A note segment, or a note in it, runs past the end of the file.
  const ERR_NOTE: u64 = 13;

  /// Segment type of a note segment (`PT_NOTE`).
  const SEGMENT_NOTE: u32 = 4;

  /// The program speaks the Linux x86_64 system call ABI. Equals
  /// `Proc::Process::ABI_LINUX`.
  const ABI_LINUX: u64 = 0;

  /// The program speaks the native IgniOS ABI. Equals
  /// `Proc::Process::ABI_NATIVE`.
  const ABI_NATIVE: u64 = 1;

  /// The note type of the IgniOS ABI note.
  const NOTE_ABI: u32 = 1;

  /// The only native ABI version.
  const NATIVE_VERSION: u32 = 1;

  /// The fixed part of a note: `namesz`, `descsz`, `type`, 4 bytes each.
  const NOTE_HEADER: u64 = 12;

  /// Loads the executable file `node` into the address space `root`:
  /// checks it, stages one image region per `PT_LOAD` segment in `staged`
  /// (`Proc::Memory::stageImage`, nothing is copied or mapped yet) and fills
  /// `result`. The headers and notes are read through `Fs::Vfs::read`,
  /// under the VFS lock, which this function takes unless the caller holds
  /// it. On failure the regions staged so far stay in `staged` for the
  /// caller's `Proc::Memory::dropStaged`, and their page tables in `root`.
  function load(node: *mut Fs::Node, root: u64, staged: *mut Proc::StagedImage, result: *mut Proc::LoadedImage): u64 {
    let taken: boolean = Fs::Vfs::lockUnlessHeld();
    let error: u64 = loadLocked(node, root, staged, result);

    Fs::Vfs::unlockIfTaken(taken);

    return error;
  }

  /// `load` with the VFS lock held.
  function loadLocked(node: *mut Fs::Node, root: u64, staged: *mut Proc::StagedImage, result: *mut Proc::LoadedImage): u64 {
    let size: u64 = (*node).size;
    let header: *mut ElfHeader = Mm::Heap::allocate(HEADER_SIZE, 16) as *mut ElfHeader;

    if (header == null) {
      return ERR_MEMORY;
    }

    let mut problem: u64 = size < HEADER_SIZE ? ERR_TOO_SMALL : OK;

    if (problem == OK && !readFile(node, 0, header as *mut u8, HEADER_SIZE)) {
      problem = ERR_TOO_SMALL;
    }

    if (problem == OK) {
      problem = checkHeader(header as *ElfHeader, size);
    }

    if (problem != OK) {
      Mm::Heap::free(header as *mut u8);
      return problem;
    }

    let count: u64 = (*header).programHeaderCount as u64;
    let tableBytes: u64 = count * PROGRAM_HEADER_SIZE;
    let headers: *mut u8 = Mm::Heap::allocate(tableBytes, 16);

    (*result).entry = (*header).entry;
    (*result).segments = 0;
    (*result).pages = 0;
    (*result).abi = ABI_LINUX;

    let first: u64 = (*header).programHeaderOffset;

    Mm::Heap::free(header as *mut u8);

    if (headers == null) {
      return ERR_MEMORY;
    }

    if (!readFile(node, first, headers, tableBytes)) {
      Mm::Heap::free(headers);
      return ERR_PROGRAM_HEADERS;
    }

    let error: u64 = loadSegments(node, size, root, staged, headers as *u8, count, result);

    Mm::Heap::free(headers);

    return error;
  }

  /// Reads the ABI note and stages every `PT_LOAD` of the `count` program
  /// headers at `headers`, then checks the entry point.
  function loadSegments(
    node: *mut Fs::Node,
    size: u64,
    root: u64,
    staged: *mut Proc::StagedImage,
    headers: *u8,
    count: u64,
    result: *mut Proc::LoadedImage
  ): u64 {
    let abiProblem: u64 = findAbi(node, size, headers, count, &mut (*result).abi as *mut u64);

    if (abiProblem != OK) {
      return abiProblem;
    }

    let mut index: u64 = 0;

    while (index < count) {
      let segment: *ProgramHeader = (headers + index * PROGRAM_HEADER_SIZE) as *ProgramHeader;

      if ((*segment).kind == SEGMENT_LOAD) {
        let error: u64 = loadSegment(node, size, root, staged, segment, result);

        if (error != OK) {
          return error;
        }
      }

      index += 1;
    }

    if ((*result).segments == 0) {
      return ERR_NO_SEGMENTS;
    }

    return checkEntry(staged, (*result).entry);
  }

  /// Copies exactly `count` bytes of file `node` from `offset` to `buffer`
  /// through the page cache; false when the file is shorter. The VFS lock
  /// is held.
  function readFile(node: *mut Fs::Node, offset: u64, buffer: *mut u8, count: u64): boolean {
    let mut copied: u64 = 0;

    return Fs::Vfs::read(node, offset, buffer, count, &mut copied as *mut u64) == Fs::Vfs::OK && copied == count;
  }

  /// A short description of an error from `load`.
  function describe(error: u64): str {
    return match (error) {
      0 -> "no error",
      1 -> "the file is smaller than an ELF header",
      2 -> "not an ELF file",
      3 -> "not a static little-endian x86-64 ELF64 executable",
      4 -> "the program headers are not inside the file",
      5 -> "no loadable segment",
      6 -> "a segment lies outside the user address space",
      7 -> "a segment's file bytes lie outside the file",
      8 -> "a segment is both writable and executable",
      9 -> "two segments share a page",
      10 -> "out of memory",
      11 -> "the entry point is not in an executable user page",
      12 -> "the IgniOS ABI note names an unknown version",
      13 -> "a note runs past the end of the file",
      _ -> "unknown error",
    };
  }

  /// Checks the ELF header, read from a file of `size` bytes, and that the
  /// program header table fits the file.
  function checkHeader(header: *ElfHeader, size: u64): u64 {
    if (size < HEADER_SIZE) {
      return ERR_TOO_SMALL;
    }

    if ((*header).ident[0] != 0x7F || (*header).ident[1] != 0x45 || (*header).ident[2] != 0x4C || (*header).ident[3] != 0x46) {
      return ERR_MAGIC;
    }

    if ((*header).ident[4] != CLASS_64 || (*header).ident[5] != DATA_LITTLE_ENDIAN || (*header).ident[6] != VERSION_CURRENT) {
      return ERR_FORMAT;
    }

    if ((*header).kind != TYPE_EXECUTABLE || (*header).machine != MACHINE_X86_64 || (*header).programHeaderSize != PROGRAM_HEADER_SIZE) {
      return ERR_FORMAT;
    }

    let count: u64 = (*header).programHeaderCount as u64;
    let offset: u64 = (*header).programHeaderOffset;

    if (count == 0 || count > MAX_PROGRAM_HEADERS || offset % 8 != 0) {
      return ERR_PROGRAM_HEADERS;
    }

    if (offset > size || count * PROGRAM_HEADER_SIZE > size - offset) {
      return ERR_PROGRAM_HEADERS;
    }

    return OK;
  }

  /// Looks for the IgniOS ABI note in the `PT_NOTE` segments among the
  /// `count` program headers at `headers` of the executable file `node` of
  /// `size` bytes, whose header `checkHeader` accepted. Writes `ABI_NATIVE` to `abi` when a note named `IgniOS` of
  /// type `NOTE_ABI` says version `NATIVE_VERSION`, and leaves it alone
  /// otherwise (a Linux program). Notes of other names, such as `GNU`, are
  /// skipped. Returns `ERR_NOTE` for a segment or note that runs past the
  /// file and `ERR_ABI` for an IgniOS note of another version.
  ///
  /// ```text
  ///   offset 0   namesz = 7          4 bytes
  ///          4   descsz = 4          4 bytes
  ///          8   type   = 1          4 bytes
  ///         12   "IgniOS\0" + 1 pad   name, padded to 4
  ///         20   version = 1         desc, padded to 4
  /// ```
  /// A note segment is copied out of the file through the cache to be
  /// read; `ERR_MEMORY` when the heap cannot hold it.
  function findAbi(node: *mut Fs::Node, size: u64, headers: *u8, count: u64, abi: *mut u64): u64 {
    let mut index: u64 = 0;

    while (index < count) {
      let segment: *ProgramHeader = (headers + index * PROGRAM_HEADER_SIZE) as *ProgramHeader;

      if ((*segment).kind == SEGMENT_NOTE) {
        let offset: u64 = (*segment).offset;
        let length: u64 = (*segment).fileSize;

        if (offset > size || length > size - offset) {
          return ERR_NOTE;
        }

        let mut problem: u64 = OK;

        if (length > 0) {
          let notes: *mut u8 = Mm::Heap::allocate(length, 16);

          if (notes == null) {
            return ERR_MEMORY;
          }

          problem = readFile(node, offset, notes, length) ? scanNotes(notes as *u8, length, abi) : ERR_NOTE;
          Mm::Heap::free(notes);
        }

        if (problem != OK) {
          return problem;
        }
      }

      index += 1;
    }

    return OK;
  }

  /// Walks the notes in the `length` bytes at `notes`. See `findAbi`.
  function scanNotes(notes: *u8, length: u64, abi: *mut u64): u64 {
    let mut position: u64 = 0;

    while (length - position >= NOTE_HEADER) {
      let nameSize: u64 = readU32(notes + position) as u64;
      let descriptionSize: u64 = readU32(notes + position + 4) as u64;
      let noteType: u32 = readU32(notes + position + 8);
      let nameRoom: u64 = (nameSize + 3) / 4 * 4;
      let descriptionRoom: u64 = (descriptionSize + 3) / 4 * 4;

      if (nameRoom > length - position - NOTE_HEADER || descriptionRoom > length - position - NOTE_HEADER - nameRoom) {
        return ERR_NOTE;
      }

      let name: *u8 = notes + position + NOTE_HEADER;

      if (nameSize == 7 && noteType == NOTE_ABI && isIgniOs(name)) {
        if (descriptionSize < 4 || readU32(name + nameRoom) != NATIVE_VERSION) {
          return ERR_ABI;
        }

        *abi = ABI_NATIVE;
      }

      position += NOTE_HEADER + nameRoom + descriptionRoom;
    }

    return OK;
  }

  /// True when the 7 bytes at `name` are `IgniOS` and a NUL.
  function isIgniOs(name: *u8): boolean {
    return *name == ('I' as u8) && *(name + 1) == ('g' as u8) && *(name + 2) == ('n' as u8) && *(name + 3) == ('i' as u8) && *(name + 4) == ('O' as u8) && *(name + 5) == ('S' as u8) && *(name + 6) == 0;
  }

  /// The little-endian 32-bit value at `bytes`, read a byte at a time so the
  /// address need not be aligned.
  function readU32(bytes: *u8): u32 {
    return (*bytes as u32) | ((*(bytes + 1) as u32) << 8) | ((*(bytes + 2) as u32) << 16) | ((*(bytes + 3) as u32) << 24);
  }

  /// Stages the image region of one `PT_LOAD` header and prints a line
  /// about it. The region covers the segment's pages; its file bytes end at
  /// `p_filesz`, so a page past them is a private zeroed page and the page
  /// holding their end a private copy with a zeroed tail, except for a
  /// read-only segment with nothing past its file bytes (`p_memsz` equal to
  /// `p_filesz`), whose last page takes the rest of the file page, as Linux
  /// maps it, so that page is a shared cache frame too.
  function loadSegment(
    node: *mut Fs::Node,
    size: u64,
    root: u64,
    staged: *mut Proc::StagedImage,
    segment: *ProgramHeader,
    result: *mut Proc::LoadedImage
  ): u64 {
    let address: u64 = (*segment).virtualAddress;
    let memorySize: u64 = (*segment).memorySize;
    let fileSize: u64 = (*segment).fileSize;
    let offset: u64 = (*segment).offset;
    let flags: u32 = (*segment).flags;

    if (memorySize == 0 || address < PAGE_SIZE || !Mm::AddressSpace::isUserRange(address, memorySize)) {
      return ERR_SEGMENT_RANGE;
    }

    let first: u64 = address / PAGE_SIZE * PAGE_SIZE;
    let end: u64 = (address + memorySize + PAGE_SIZE - 1) / PAGE_SIZE * PAGE_SIZE;

    // The regions of `mmap` and the stack live above `MAP_BOTTOM`; a
    // segment there would hide behind them in `Proc::Memory::resolve`.
    if (end > Proc::Memory::MAP_BOTTOM) {
      return ERR_SEGMENT_RANGE;
    }

    if (fileSize > memorySize || offset > size || fileSize > size - offset || offset % PAGE_SIZE != address % PAGE_SIZE) {
      return ERR_SEGMENT_FILE;
    }

    if ((flags & FLAG_WRITE) != 0 && (flags & FLAG_EXECUTE) != 0) {
      return ERR_WRITE_EXECUTE;
    }

    let mut protection: u64 = Proc::Memory::READ;

    if ((flags & FLAG_WRITE) != 0) {
      protection = protection | Proc::Memory::WRITE;
    }

    if ((flags & FLAG_EXECUTE) != 0) {
      protection = protection | Proc::Memory::EXECUTE;
    }

    if (Proc::Memory::overlapsStaged(staged, first, end)) {
      return ERR_OVERLAP;
    }

    let fileStart: u64 = offset - (address - first);
    let mut fileBytes: u64 = address - first + fileSize;

    if ((flags & FLAG_WRITE) == 0 && memorySize == fileSize) {
      let wholePages: u64 = (fileBytes + PAGE_SIZE - 1) / PAGE_SIZE * PAGE_SIZE;

      fileBytes = size - fileStart < wholePages ? size - fileStart : wholePages;
    }

    let staging: u64 = Proc::Memory::stageImage(staged, root, first, end - first, protection, node, fileStart, fileBytes);

    if (staging != Proc::Memory::OK) {
      return ERR_MEMORY;
    }

    (*result).segments += 1;
    (*result).pages += (end - first) / PAGE_SIZE;

    Drivers::Console::write("elf: PT_LOAD ");
    Drivers::Console::writeHex(address);
    Drivers::Console::write(" file ");
    Drivers::Console::writeDecimal(fileSize);
    Drivers::Console::write(" mem ");
    Drivers::Console::writeDecimal(memorySize);
    Drivers::Console::write(" ");
    Drivers::Console::write("r");
    Drivers::Console::write((flags & FLAG_WRITE) != 0 ? "w" : "-");
    Drivers::Console::writeLine((flags & FLAG_EXECUTE) != 0 ? "x" : "-");

    return OK;
  }

  /// The entry point must sit in an executable staged region. Its page is
  /// not mapped yet: the first fetch resolves it.
  function checkEntry(staged: *mut Proc::StagedImage, entry: u64): u64 {
    if (!Mm::AddressSpace::isUserRange(entry, 1) || !Proc::Memory::isStagedExecutable(staged, entry)) {
      return ERR_ENTRY;
    }

    return OK;
  }
}
