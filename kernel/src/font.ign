//! The 8x16 console font: the printable ASCII glyphs of Spleen, generated
//! into `font_8x16.ign`.

import FontData from "./font_8x16";

export namespace Font {
  const WIDTH: u64 = 8;
  const HEIGHT: u64 = 16;

  const FIRST: u8 = 0x20;
  const LAST: u8 = 0x7E;
  const FALLBACK: u8 = 0x3F;

  /// The HEIGHT rows of the glyph for `character`, top row first, leftmost
  /// pixel in the most significant bit. Characters outside FIRST..LAST get
  /// the glyph of `?`.
  function glyph(character: u8): *u8 {
    let mut index: u8 = character;

    if (index < FIRST || index > LAST) {
      index = FALLBACK;
    }

    return (&FontData::Glyphs::rows as *u8) + ((index - FIRST) as u64) * HEIGHT;
  }
}
