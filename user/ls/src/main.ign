//!
//! # ls
//!
//! `ls [PATH...]`: lists the entries of each directory, one name per line.
//!
//! ## Behaviour
//!
//! | Case                  | Output                                               | Status |
//! |-----------------------|------------------------------------------------------|--------|
//! | no arguments          | the entries of the current directory, which is `/`   | 0      |
//! | a directory           | its entries in creation order, without `.` and `..`  | 0      |
//! | a file                | its path, as given                                   | 0      |
//! | more than one path    | each directory under a `PATH:` heading, a blank line between them | 0 |
//! | a path that fails     | `ls: cannot access 'PATH': REASON` on standard error | 2      |
//!
//! The names come from `Sys::readEntry`, which every flavour of the library
//! implements on its own system calls and which leaves out `.` and `..`.
//! Status 2 for a missing path is GNU ls's "serious trouble".

import Args from "std::args";
import Io from "std::io";
import Sys from "std::sys";

/// The listing's buffer.
record Ls {
  /// The name of the current entry, NUL-terminated.
  static mut name: u8[256];
}

/// Prints `ls: cannot access 'PATH': REASON` on standard error.
function report(path: *u8, result: i64): void {
  Io::error("ls: cannot access '");
  Io::errorString(path);
  Io::error("': ");
  Io::error(Sys::errorText(result));
  Io::error("\n");
}

/// Prints every entry of the open directory `descriptor`. Returns 0, or the
/// negated error code of a failed read.
function listEntries(descriptor: u64): i64 {
  let name: *mut u8 = &mut Ls::name as *mut u8;
  let mut kind: u64 = 0;

  while (true) {
    let length: i64 = Sys::readEntry(descriptor, name, &mut kind as *mut u64);

    if (length <= 0) {
      return length;
    }

    Io::printBytes(name as *u8, length as u64);
    Io::print("\n");
  }

  return 0;
}

/// Lists one path. With `heading`, a directory is listed under `PATH:`.
/// Returns true on success.
function listPath(path: *u8, heading: boolean): boolean {
  let mut info: Sys::FileInfo = Sys::FileInfo { kind: 0, size: 0, id: 0, mode: 0 };
  let described: i64 = Sys::infoAt(path, &mut info as *mut Sys::FileInfo);

  if (described < 0) {
    report(path, described);
    return false;
  }

  if (info.kind != Sys::KIND_DIRECTORY) {
    Io::printString(path);
    Io::print("\n");
    return true;
  }

  let descriptor: i64 = Sys::open(path, Sys::O_RDONLY | Sys::O_DIRECTORY, 0);

  if (descriptor < 0) {
    report(path, descriptor);
    return false;
  }

  if (heading) {
    Io::printString(path);
    Io::print(":\n");
  }

  let result: i64 = listEntries(descriptor as u64);

  Sys::close(descriptor as u64);

  if (result < 0) {
    report(path, result);
    return false;
  }

  return true;
}

/// Called by `_start` with argc and argv.
@externName("ignis_main")
function main(count: u64, values: *u64): u64 {
  if (count < 2) {
    return listPath("." as *u8, false) ? 0 : 2;
  }

  let heading: boolean = count > 2;
  let mut status: u64 = 0;
  let mut index: u64 = 1;

  while (index < count) {
    if (heading && index > 1) {
      Io::print("\n");
    }

    if (!listPath(Args::get(values, index), heading)) {
      status = 2;
    }

    index += 1;
  }

  return status;
}

/// Prints the message and exits with status 101.
@panicHandler
function onPanic(message: str, file: str, line: u32): never {
  Io::error("ls: panic: ");
  Io::error(message);
  Io::error("\n");
  Sys::exit(101);
}
