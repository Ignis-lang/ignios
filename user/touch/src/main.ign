//!
//! # touch
//!
//! `touch FILE...`: creates each file that does not exist, empty.
//!
//! ## Behaviour
//!
//! | Case                         | Effect                                          | Status |
//! |------------------------------|-------------------------------------------------|--------|
//! | the file does not exist      | an empty regular file, mode 0644                | 0      |
//! | the file or directory exists | nothing: there is no clock date to set yet      | 0      |
//! | it cannot be created         | `touch: cannot touch 'PATH': REASON` on standard error | 1 |
//! | no arguments                 | `touch: missing file operand` on standard error | 1      |
//!
//! The file is opened with `O_CREAT | O_RDONLY`, which creates it when it is
//! missing. On an existing directory that is `-EISDIR`, which `touch` takes
//! as success, the way GNU touch accepts a directory.

import Args from "std::args";
import Io from "std::io";
import Sys from "std::sys";
import _ from "std::panic";

/// rw-r--r--.
const FILE_MODE: u64 = 0x1A4;

/// Creates `path` if missing. Returns true on success.
function touchFile(path: *u8): boolean {
  let descriptor: i64 = Sys::open(path, Sys::O_CREAT | Sys::O_RDONLY, FILE_MODE);

  // An existing directory is -EISDIR, as on Linux. GNU touch accepts it, and
  // with no clock date to set there is nothing more to do.
  if (descriptor == 0 - Sys::EISDIR) {
    return true;
  }

  if (descriptor < 0) {
    Io::error("touch: cannot touch '");
    Io::errorString(path);
    Io::error("': ");
    Io::error(Sys::errorText(descriptor));
    Io::error("\n");
    return false;
  }

  Sys::close(descriptor as u64);

  return true;
}

/// Called by `_start` with argc and argv.
@externName("ignis_main")
function main(count: u64, values: *u64): u64 {
  if (count < 2) {
    Io::error("touch: missing file operand\n");
    return 1;
  }

  let mut status: u64 = 0;
  let mut index: u64 = 1;

  while (index < count) {
    if (!touchFile(Args::get(values, index))) {
      status = 1;
    }

    index += 1;
  }

  return status;
}
