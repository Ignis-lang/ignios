//!
//! # nativetest
//!
//! Ring 3 checks of the native IgniOS system call ABI: every call, its
//! arguments and its status codes, through the raw `Sys::callN` wrappers so
//! that RAX and RDX are seen as they come back.
//!
//! ## Checks
//!
//! | Status | Check                                                                |
//! |--------|----------------------------------------------------------------------|
//! | 10     | `WRITE` to the console: status 0 in RAX, the byte count in RDX       |
//! | 11     | `WRITE` from address 1: `BAD_ADDRESS`, RDX 0                         |
//! | 12     | `WRITE` to descriptor 7: `BAD_DESCRIPTOR`, RDX 0                     |
//! | 13     | call 9999: `NOT_SUPPORTED`, RDX 0 even when RDX went in as `0x1234` |
//! | 14     | call 39 (Linux `getpid`): `NOT_SUPPORTED`; the Linux table is not used |
//! | 15     | `PROCESS_ID`: status 0, a positive id                                |
//! | 16     | the portable `Sys::write` returns the count, or the negated status   |
//! | 20-23  | `OPEN` of `/etc/motd` by length (no NUL needed): descriptor 3; `READ` in pieces, then 0 |
//! | 24-25  | `SEEK` from start, current, end; -1 is `INVALID`; the console is `NOT_SEEKABLE` |
//! | 26-27  | `INFO`: kind 1, size 19, mode 0644, an id; the console is kind 3    |
//! | 30-37  | `OPEN` errors: `NOT_FOUND`, `NOT_DIRECTORY`, `IS_DIRECTORY`, unknown flag bit, no access bit, a bad directory descriptor, `BAD_ADDRESS`, `NAME_TOO_LONG` |
//! | 40-46  | `MAKE_DIRECTORY` of `/nt`, again `EXISTS`; `CREATE`, `EXCLUSIVE`, `APPEND`, `TRUNCATE` in it |
//! | 50-53  | `INFO_AT` from `ROOT` and relative to a directory descriptor; an empty path is `NOT_FOUND` |
//! | 60-64  | `READ_ENTRY`: `a` then `b` with kind and id, no `.` or `..`, then 0; a small buffer is `INVALID`; a file is `NOT_DIRECTORY` |
//! | 70-75  | `MAP` anonymous and of a file; write with execute, an unknown flag, a directory (`NO_DEVICE`), a write-only descriptor (`ACCESS`); `UNMAP` |
//! | 76-77  | `MAP_SHARED` of `/nt/a` read-only maps and reads; with write access on a read-only descriptor it is `ACCESS`; with `MAP_ANONYMOUS` it is `INVALID` |
//! | 80-81  | `YIELD` and `SLEEP(20 ms)` return 0                                  |
//! | 82     | `CLOSE` twice: the second is `BAD_DESCRIPTOR`                        |
//! | 90-92  | `READ_ENTRY` into a kernel address is `BAD_ADDRESS` and does not consume the entry; 24 bytes for a 25-byte entry is `INVALID`; `SEEK` on a directory |
//! | 93-94  | `READ` into a kernel address is `BAD_ADDRESS` and moves nothing; an unknown `SEEK` whence is `INVALID` |
//! | 95-96  | `MAP` of length 0 or at an unaligned offset, `UNMAP` of an unaligned address: `INVALID` |
//! | 97-98  | RDX comes back 0 from `CLOSE` and `YIELD` even when it went in as `0x1234`; call 512 is `NOT_SUPPORTED` |
//! | 99     | `OPEN` of a path that crosses the user limit is `BAD_ADDRESS`        |
//! | 100    | a path with a NUL byte in it (`/nt/x\0y`, length 7) is `INVALID`    |
//! | 120-125 | `CURRENT_DIRECTORY` is `/`; `CHANGE_DIRECTORY` to `/nt`, then paths relative to `CURRENT` start there; the current directory is `BUSY`; a file is `NOT_DIRECTORY`; a buffer too small is `INVALID` |
//! | 130-137 | `SPAWN` of `/bin/pwd` and `WAIT` for its status 0; a second `WAIT` is `NOT_FOUND`; waiting for itself is `INVALID`; a missing program `NOT_FOUND`, a directory `IS_DIRECTORY`, a text file `INVALID`; arguments that do not match their count `INVALID`; a bad argument pointer `BAD_ADDRESS`; the child starts in the parent's current directory (`rmdir sub` from `/nt` removes `/nt/sub`) |
//! | 200-206 | `POWER` with an unknown action is `INVALID`; `WAIT` for an id that never existed is `NOT_FOUND`; an argument block with an empty string is accepted; a child's exit status 1 comes back; the 64-slot process table fills up (63 children at boot), the next start is refused, and after waiting starting works again; `CURRENT_DIRECTORY` into 1 byte; removing `.` or `/bin/..` is `INVALID` |
//! | 176-177 | killing a keyboard reader and then a sleeper ends both; a child killed before it ever runs creates nothing |
//! | 170-175 | `KILL` of an unknown id is `NOT_FOUND`; a child sleeping 10 000 s (a missing wake-up hangs the boot instead of passing late), a child spinning in ring 3, a child waiting for the keyboard and a child waiting for its own child (which sleeps 10 000 s, and is then killed as an orphan and freed) each end with status 137 right away; a process that kills itself ends with 137 |
//! | 160-163 | `WAIT_ANY`: no child is `NO_CHILD`; a bad status pointer `BAD_ADDRESS`; with a quick child and a napping one, it returns the quick one first and then blocks until the napping one ends, each with its id and status |
//! | 140-143 | parents: a grandchild is not the caller's child (`NO_CHILD`); an orphan is freed when it ends (`NOT_FOUND` afterwards); a child that ended before its parent is freed with the parent (`NOT_FOUND`) |
//! | 110-115 | `UNLINK` and `REMOVE_DIRECTORY`: a file, then `NOT_FOUND`; a directory as a file `IS_DIRECTORY`; a non-empty directory `NOT_EMPTY`; an open one `BUSY`; a file as a directory `NOT_DIRECTORY`; relative to a directory descriptor |
//!
//! The exit status is the number of the first check that failed, 0 when all
//! passed. `Tests::User::runNative` runs it at boot and removes `/nt`.

import Args from "std::args";
import Io from "std::io";
import Sys from "std::sys";
import _ from "std::panic";

/// The line the first check writes.
const LINE: str = "nativetest: hello through the native ABI\n";

/// Length of `LINE`.
const LINE_LENGTH: u64 = 41;

/// 4 KiB.
const PAGE: u64 = 4096;

/// The id `killChild` started last.
record Last {
  /// The id.
  static mut child: u64 = 0;
}

/// What the checks share.
record State {
  /// Bytes read back and directory entries.
  static mut buffer: u8[512];

  /// One info record.
  static mut info: u8[32];
}

/// Exits with `status` unless `result` has `wantedStatus` and `wantedValue`,
/// after printing what came back.
function expect(result: Sys::Result, wantedStatus: u64, wantedValue: u64, status: u64): void {
  if (result.status != wantedStatus || result.value != wantedValue) {
    Io::print("nativetest: check ");
    Io::printNumber(status as i64);
    Io::print(" got status ");
    Io::printNumber(result.status as i64);
    Io::print(", value ");
    Io::printNumber(result.value as i64);
    Io::print("\n");
    Sys::exit(status);
  }
}

/// Exits with `status` unless `result` has status 0, and returns its value.
function succeed(result: Sys::Result, status: u64): u64 {
  if (result.status != Sys::OK) {
    Io::print("nativetest: check ");
    Io::printNumber(status as i64);
    Io::print(" got status ");
    Io::printNumber(result.status as i64);
    Io::print("\n");
    Sys::exit(status);
  }

  return result.value;
}

/// Exits with `status` unless `condition` holds.
function require(condition: boolean, status: u64): void {
  if (!condition) {
    Io::print("nativetest: check ");
    Io::printNumber(status as i64);
    Io::print(" failed\n");
    Sys::exit(status);
  }
}

/// The address of `text`, a string literal.
function at(text: str): u64 {
  return @integerFromPointer(text as *u8);
}

/// The first byte of `State::buffer`.
function buffer(): u64 {
  return @integerFromPointer(&mut State::buffer as *mut u8);
}

/// The first byte of `State::info`.
function info(): u64 {
  return @integerFromPointer(&mut State::info as *mut u8);
}

/// The 8-byte field at `offset` of the bytes at `address`.
function word(address: u64, offset: u64): u64 {
  return *@pointerFromInteger<*u64>(address + offset);
}

/// The byte at `address`.
function byte(address: u64): u8 {
  return *@pointerFromInteger<*u8>(address);
}

/// True when the `length` bytes at `address` are `text`.
function same(address: u64, text: str, length: u64): boolean {
  let mut index: u64 = 0;

  while (index < length) {
    if (byte(address + index) != *(text as *u8 + index)) {
      return false;
    }

    index += 1;
  }

  return true;
}

/// `OPEN(ROOT, text, length, flags, 0644)`.
function open(text: str, length: u64, flags: u64): Sys::Result {
  return Sys::call5(Sys::OPEN, Sys::ROOT, at(text), length, flags, 0x1A4);
}

/// The calls of the first version of the ABI.
function checkBasics(): void {
  expect(Sys::call3(Sys::WRITE, Sys::STDOUT, at(LINE), LINE_LENGTH), Sys::OK, LINE_LENGTH, 10);
  expect(Sys::call3(Sys::WRITE, Sys::STDOUT, 1, 5), Sys::BAD_ADDRESS, 0, 11);
  expect(Sys::call3(Sys::WRITE, 7, at(LINE), 1), Sys::BAD_DESCRIPTOR, 0, 12);
  expect(Sys::call0(9999), Sys::NOT_SUPPORTED, 0, 13);
  expect(Sys::call3(9999, 1, 2, 0x1234), Sys::NOT_SUPPORTED, 0, 13);
  expect(Sys::call0(39), Sys::NOT_SUPPORTED, 0, 14);
  require(succeed(Sys::call0(Sys::PROCESS_ID), 15) > 0, 15);
  require(Sys::write(Sys::STDOUT, "" as *u8, 0) == 0 && Sys::write(9, "x" as *u8, 1) == 0 - (Sys::BAD_DESCRIPTOR as i64), 16);
}

/// Opening, reading, seeking and describing `/etc/motd`. The path is passed
/// with a length that stops before the `x`, so no NUL is needed.
function checkReading(): void {
  let fd: u64 = succeed(open("/etc/motdx", 9, Sys::OPEN_READ), 20);

  require(fd == 3, 20);
  expect(Sys::call3(Sys::READ, fd, buffer(), 7), Sys::OK, 7, 21);
  require(same(buffer(), "Welcome", 7), 21);
  expect(Sys::call3(Sys::READ, fd, buffer(), 100), Sys::OK, 12, 22);
  expect(Sys::call3(Sys::READ, fd, buffer(), 100), Sys::OK, 0, 23);

  expect(Sys::call3(Sys::SEEK, fd, 3, Sys::SEEK_SET), Sys::OK, 3, 24);
  expect(Sys::call3(Sys::SEEK, fd, 2, Sys::SEEK_CUR), Sys::OK, 5, 24);
  expect(Sys::call3(Sys::SEEK, fd, 0xFFFFFFFFFFFFFFFF, Sys::SEEK_END), Sys::OK, 18, 24);
  expect(Sys::call3(Sys::SEEK, fd, 0xFFFFFFFFFFFFFFFF, Sys::SEEK_SET), Sys::INVALID, 0, 25);
  expect(Sys::call3(Sys::SEEK, Sys::STDOUT, 0, Sys::SEEK_SET), Sys::NOT_SEEKABLE, 0, 25);

  expect(Sys::call2(Sys::INFO, fd, info()), Sys::OK, 0, 26);
  require(word(info(), 0) == Sys::KIND_FILE && word(info(), 8) == 19 && word(info(), 16) != 0 && word(info(), 24) == 0x1A4, 26);
  expect(Sys::call2(Sys::INFO, Sys::STDOUT, info()), Sys::OK, 0, 27);
  require(word(info(), 0) == Sys::KIND_DEVICE, 27);

  expect(Sys::call1(Sys::CLOSE, fd), Sys::OK, 0, 82);
  expect(Sys::call1(Sys::CLOSE, fd), Sys::BAD_DESCRIPTOR, 0, 82);
}

/// The errors of `OPEN`.
function checkOpenErrors(): void {
  expect(open("/nope", 5, Sys::OPEN_READ), Sys::NOT_FOUND, 0, 30);
  expect(open("/etc/motd/x", 11, Sys::OPEN_READ), Sys::NOT_DIRECTORY, 0, 31);
  expect(open("/etc", 4, Sys::OPEN_WRITE), Sys::IS_DIRECTORY, 0, 32);
  expect(open("/etc/motd", 9, Sys::OPEN_READ | 128), Sys::INVALID, 0, 33);
  expect(open("/etc/motd", 9, Sys::OPEN_CREATE), Sys::INVALID, 0, 34);
  expect(Sys::call5(Sys::OPEN, 7, at("motd"), 4, Sys::OPEN_READ, 0), Sys::BAD_DESCRIPTOR, 0, 35);
  expect(Sys::call5(Sys::OPEN, Sys::ROOT, 1, 4, Sys::OPEN_READ, 0), Sys::BAD_ADDRESS, 0, 36);
  expect(Sys::call5(Sys::OPEN, Sys::ROOT, at(LINE), 4096, Sys::OPEN_READ, 0), Sys::NAME_TOO_LONG, 0, 37);
}

/// `MAKE_DIRECTORY` and creating, appending and truncating a file in it.
function checkWriting(): void {
  expect(Sys::call4(Sys::MAKE_DIRECTORY, Sys::ROOT, at("/nt"), 3, 0x1ED), Sys::OK, 0, 40);
  expect(Sys::call4(Sys::MAKE_DIRECTORY, Sys::ROOT, at("/nt"), 3, 0x1ED), Sys::EXISTS, 0, 41);

  let file: u64 = succeed(open("/nt/a", 5, Sys::OPEN_WRITE | Sys::OPEN_CREATE | Sys::OPEN_EXCLUSIVE), 42);

  expect(Sys::call3(Sys::WRITE, file, at("hello"), 5), Sys::OK, 5, 42);
  succeed(Sys::call1(Sys::CLOSE, file), 42);
  expect(open("/nt/a", 5, Sys::OPEN_WRITE | Sys::OPEN_CREATE | Sys::OPEN_EXCLUSIVE), Sys::EXISTS, 0, 43);

  let appender: u64 = succeed(open("/nt/a", 5, Sys::OPEN_WRITE | Sys::OPEN_APPEND), 44);

  expect(Sys::call3(Sys::WRITE, appender, at(" world"), 6), Sys::OK, 6, 44);
  succeed(Sys::call1(Sys::CLOSE, appender), 44);

  let reader: u64 = succeed(open("/nt/a", 5, Sys::OPEN_READ), 45);

  expect(Sys::call3(Sys::READ, reader, buffer(), 100), Sys::OK, 11, 45);
  require(same(buffer(), "hello world", 11), 45);
  succeed(Sys::call1(Sys::CLOSE, reader), 45);

  let truncated: u64 = succeed(open("/nt/a", 5, Sys::OPEN_WRITE | Sys::OPEN_TRUNCATE), 46);

  expect(Sys::call3(Sys::WRITE, truncated, at("abc"), 3), Sys::OK, 3, 46);
  succeed(Sys::call1(Sys::CLOSE, truncated), 46);
}

/// Paths relative to a directory descriptor, `INFO_AT` and `READ_ENTRY`.
function checkDirectories(): void {
  let directory: u64 = succeed(open("/nt", 3, Sys::OPEN_READ | Sys::OPEN_DIRECTORY), 50);
  let made: u64 = succeed(Sys::call5(Sys::OPEN, directory, at("b"), 1, Sys::OPEN_WRITE | Sys::OPEN_CREATE, 0x1A4), 50);

  succeed(Sys::call1(Sys::CLOSE, made), 50);
  expect(Sys::call4(Sys::INFO_AT, directory, at("a"), 1, info()), Sys::OK, 0, 51);
  require(word(info(), 0) == Sys::KIND_FILE && word(info(), 8) == 3, 51);
  expect(Sys::call4(Sys::INFO_AT, Sys::ROOT, at("/nt"), 3, info()), Sys::OK, 0, 52);
  require(word(info(), 0) == Sys::KIND_DIRECTORY, 52);
  expect(Sys::call4(Sys::INFO_AT, Sys::ROOT, at(""), 0, info()), Sys::NOT_FOUND, 0, 53);

  expect(Sys::call3(Sys::READ_ENTRY, directory, buffer(), 10), Sys::INVALID, 0, 60);
  expect(Sys::call3(Sys::READ_ENTRY, directory, buffer(), 512), Sys::OK, 25, 61);
  require(word(buffer(), 0) == Sys::KIND_FILE && word(buffer(), 8) != 0 && word(buffer(), 16) == 1 && byte(buffer() + 24) == ('a' as u8), 61);
  expect(Sys::call3(Sys::READ_ENTRY, directory, buffer(), 512), Sys::OK, 25, 62);
  require(byte(buffer() + 24) == ('b' as u8), 62);
  expect(Sys::call3(Sys::READ_ENTRY, directory, buffer(), 512), Sys::OK, 0, 63);

  let file: u64 = succeed(open("/etc/motd", 9, Sys::OPEN_READ), 64);

  expect(Sys::call3(Sys::READ_ENTRY, file, buffer(), 512), Sys::NOT_DIRECTORY, 0, 64);
  succeed(Sys::call1(Sys::CLOSE, file), 64);
  succeed(Sys::call1(Sys::CLOSE, directory), 64);
}

/// `MAP` and `UNMAP`.
function checkMapping(): void {
  let anonymous: u64 = succeed(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ | Sys::PROT_WRITE, Sys::MAP_ANONYMOUS, 0, 0), 70);

  require(anonymous % PAGE == 0 && byte(anonymous) == 0, 70);
  *@pointerFromInteger<*mut u8>(anonymous) = 7;
  require(byte(anonymous) == 7, 70);
  expect(Sys::call2(Sys::UNMAP, anonymous, PAGE), Sys::OK, 0, 70);

  let motd: u64 = succeed(open("/etc/motd", 9, Sys::OPEN_READ), 71);
  let mapped: u64 = succeed(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ, 0, motd, 0), 71);

  require(same(mapped, "Welcome to IgniOS.\n", 19) && byte(mapped + 19) == 0, 71);
  expect(Sys::call2(Sys::UNMAP, mapped, PAGE), Sys::OK, 0, 71);
  expect(Sys::call5(Sys::MAP, PAGE, Sys::PROT_WRITE | Sys::PROT_EXEC, Sys::MAP_ANONYMOUS, 0, 0), Sys::INVALID, 0, 72);
  expect(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ, 4, motd, 0), Sys::INVALID, 0, 73);
  succeed(Sys::call1(Sys::CLOSE, motd), 73);

  let directory: u64 = succeed(open("/etc", 4, Sys::OPEN_READ), 74);

  expect(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ, 0, directory, 0), Sys::NO_DEVICE, 0, 74);
  succeed(Sys::call1(Sys::CLOSE, directory), 74);

  let writeOnly: u64 = succeed(open("/nt/a", 5, Sys::OPEN_WRITE), 75);

  expect(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ, 0, writeOnly, 0), Sys::ACCESS, 0, 75);
  succeed(Sys::call1(Sys::CLOSE, writeOnly), 75);

  let readOnly: u64 = succeed(open("/nt/a", 5, Sys::OPEN_READ), 76);
  let shared: u64 = succeed(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ, Sys::MAP_SHARED, readOnly, 0), 76);

  require(shared % PAGE == 0, 76);
  byte(shared);
  expect(Sys::call2(Sys::UNMAP, shared, PAGE), Sys::OK, 0, 76);
  expect(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ | Sys::PROT_WRITE, Sys::MAP_SHARED, readOnly, 0), Sys::ACCESS, 0, 77);
  expect(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ, Sys::MAP_SHARED | Sys::MAP_ANONYMOUS, 0, 0), Sys::INVALID, 0, 77);
  succeed(Sys::call1(Sys::CLOSE, readOnly), 77);
}

/// `YIELD` and `SLEEP`.
function checkScheduling(): void {
  expect(Sys::call0(Sys::YIELD), Sys::OK, 0, 80);
  expect(Sys::call1(Sys::SLEEP, 20000000), Sys::OK, 0, 81);
}

/// Edge cases of the arguments: kernel addresses, sizes at the limit, bad
/// alignment, unknown values, and a NUL byte inside a path.
function checkEdges(): void {
  let kernel: u64 = 0xFFFF800000001000;
  let directory: u64 = succeed(open("/nt", 3, Sys::OPEN_READ | Sys::OPEN_DIRECTORY), 90);

  expect(Sys::call3(Sys::READ_ENTRY, directory, kernel, 512), Sys::BAD_ADDRESS, 0, 90);
  expect(Sys::call3(Sys::READ_ENTRY, directory, buffer(), 512), Sys::OK, 25, 90);
  require(byte(buffer() + 24) == ('a' as u8), 90);
  expect(Sys::call3(Sys::READ_ENTRY, directory, buffer(), 24), Sys::INVALID, 0, 91);
  expect(Sys::call3(Sys::SEEK, directory, 1, Sys::SEEK_SET), Sys::OK, 1, 92);
  expect(Sys::call3(Sys::READ_ENTRY, directory, buffer(), 512), Sys::OK, 25, 92);
  require(byte(buffer() + 24) == ('b' as u8), 92);
  succeed(Sys::call1(Sys::CLOSE, directory), 92);

  let fd: u64 = succeed(open("/etc/motd", 9, Sys::OPEN_READ), 93);

  expect(Sys::call3(Sys::READ, fd, kernel, 5), Sys::BAD_ADDRESS, 0, 93);
  expect(Sys::call3(Sys::SEEK, fd, 0, Sys::SEEK_CUR), Sys::OK, 0, 93);
  expect(Sys::call3(Sys::SEEK, fd, 0, 3), Sys::INVALID, 0, 94);
  expect(Sys::call5(Sys::MAP, 0, Sys::PROT_READ, Sys::MAP_ANONYMOUS, 0, 0), Sys::INVALID, 0, 95);
  expect(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ, 0, fd, 1), Sys::INVALID, 0, 95);

  let page: u64 = succeed(Sys::call5(Sys::MAP, PAGE, Sys::PROT_READ | Sys::PROT_WRITE, Sys::MAP_ANONYMOUS, 0, 0), 96);

  expect(Sys::call2(Sys::UNMAP, page + 1, PAGE), Sys::INVALID, 0, 96);
  succeed(Sys::call2(Sys::UNMAP, page, PAGE), 96);
  succeed(Sys::call1(Sys::CLOSE, fd), 96);

  expect(Sys::call3(Sys::CLOSE, 99, 0, 0x1234), Sys::BAD_DESCRIPTOR, 0, 97);
  expect(Sys::call3(Sys::YIELD, 0, 0, 0x1234), Sys::OK, 0, 97);
  expect(Sys::call0(512), Sys::NOT_SUPPORTED, 0, 98);
  expect(Sys::call5(Sys::OPEN, Sys::ROOT, 0x7FFFFFFFFFFE, 4, Sys::OPEN_READ, 0), Sys::BAD_ADDRESS, 0, 99);

  let path: *mut u8 = @pointerFromInteger<*mut u8>(buffer());

  *path = 0x2F;
  *(path + 1) = ('n' as u8);
  *(path + 2) = ('t' as u8);
  *(path + 3) = 0x2F;
  *(path + 4) = ('x' as u8);
  *(path + 5) = 0;
  *(path + 6) = ('y' as u8);
  expect(Sys::call4(Sys::MAKE_DIRECTORY, Sys::ROOT, buffer(), 7, 0x1ED), Sys::INVALID, 0, 100);
}

/// The current directory.
function checkCurrentDirectory(): void {
  let current: u64 = 0xFFFFFFFFFFFFFFFE;

  expect(Sys::call2(Sys::CURRENT_DIRECTORY, buffer(), 100), Sys::OK, 1, 120);
  require(byte(buffer()) == 0x2F, 120);
  expect(Sys::call3(Sys::CHANGE_DIRECTORY, Sys::ROOT, at("/nt"), 3), Sys::OK, 0, 121);
  expect(Sys::call2(Sys::CURRENT_DIRECTORY, buffer(), 100), Sys::OK, 3, 121);
  require(same(buffer(), "/nt", 3), 121);
  expect(Sys::call4(Sys::INFO_AT, current, at("a"), 1, info()), Sys::OK, 0, 122);
  expect(Sys::call4(Sys::INFO_AT, Sys::ROOT, at("a"), 1, info()), Sys::NOT_FOUND, 0, 122);
  expect(Sys::call3(Sys::REMOVE_DIRECTORY, Sys::ROOT, at("/nt"), 3), Sys::BUSY, 0, 123);
  expect(Sys::call3(Sys::CHANGE_DIRECTORY, current, at("a"), 1), Sys::NOT_DIRECTORY, 0, 124);
  expect(Sys::call2(Sys::CURRENT_DIRECTORY, buffer(), 2), Sys::INVALID, 0, 125);
  expect(Sys::call3(Sys::CHANGE_DIRECTORY, current, at(".."), 2), Sys::OK, 0, 125);
  expect(Sys::call2(Sys::CURRENT_DIRECTORY, buffer(), 100), Sys::OK, 1, 125);
}

/// `SPAWN(path, length, arguments, bytes, count)`.
function spawn(path: str, length: u64, arguments: str, bytes: u64, count: u64): Sys::Result {
  return Sys::call5(Sys::SPAWN, at(path), length, at(arguments), bytes, count);
}

/// Process creation.
function checkSpawn(): void {
  let child: u64 = succeed(spawn("/bin/pwd", 8, "pwd", 4, 1), 130);

  expect(Sys::call1(Sys::WAIT, child), Sys::OK, 0, 130);
  expect(Sys::call1(Sys::WAIT, child), Sys::NOT_FOUND, 0, 131);

  let me: u64 = succeed(Sys::call0(Sys::PROCESS_ID), 132);

  expect(Sys::call1(Sys::WAIT, me), Sys::INVALID, 0, 132);
  expect(spawn("/bin/nope", 9, "nope", 5, 1), Sys::NOT_FOUND, 0, 133);
  expect(spawn("/bin", 4, "bin", 4, 1), Sys::IS_DIRECTORY, 0, 133);
  expect(spawn("/etc/motd", 9, "motd", 5, 1), Sys::INVALID, 0, 134);
  expect(spawn("/bin/pwd", 8, "pwd", 4, 2), Sys::INVALID, 0, 135);
  expect(spawn("/bin/pwd", 8, "pwdx", 3, 1), Sys::INVALID, 0, 135);
  expect(Sys::call5(Sys::SPAWN, at("/bin/pwd"), 8, 1, 4, 1), Sys::BAD_ADDRESS, 0, 136);

  succeed(Sys::call4(Sys::MAKE_DIRECTORY, Sys::ROOT, at("/nt/sub"), 7, 0x1ED), 137);
  succeed(Sys::call3(Sys::CHANGE_DIRECTORY, Sys::ROOT, at("/nt"), 3), 137);

  let remover: u64 = succeed(spawn("/bin/rmdir", 10, "rmdir\0sub", 10, 2), 137);

  expect(Sys::call1(Sys::WAIT, remover), Sys::OK, 0, 137);
  expect(Sys::call4(Sys::INFO_AT, Sys::ROOT, at("/nt/sub"), 7, info()), Sys::NOT_FOUND, 0, 137);
  succeed(Sys::call3(Sys::CHANGE_DIRECTORY, Sys::ROOT, at("/"), 1), 137);
}

/// Edge cases of `POWER`, `SPAWN`, `WAIT` and the current directory.
function checkLimits(): void {
  expect(Sys::call1(Sys::POWER, 0), Sys::INVALID, 0, 200);
  expect(Sys::call1(Sys::POWER, 3), Sys::INVALID, 0, 200);
  expect(Sys::call1(Sys::WAIT, 123456), Sys::NOT_FOUND, 0, 201);

  let empty: u64 = succeed(spawn("/bin/pwd", 8, "a\0", 3, 2), 202);

  expect(Sys::call1(Sys::WAIT, empty), Sys::OK, 0, 202);

  let failing: u64 = succeed(spawn("/bin/rmdir", 10, "rmdir\0nope", 11, 2), 203);

  expect(Sys::call1(Sys::WAIT, failing), Sys::OK, 1, 203);

  let children: *mut u64 = @pointerFromInteger<*mut u64>(buffer());
  let mut started: u64 = 0;
  let mut last: Sys::Result = Sys::Result { status: 0, value: 0 };

  while (started < 64) {
    last = spawn("/bin/pwd", 8, "pwd", 4, 1);

    if (last.status != Sys::OK) {
      break;
    }

    *@pointerFromInteger<*mut u64>(@integerFromPointer(children) + started * 8) = last.value;
    started += 1;
  }

  // 64 slots: this process holds one, and /bin/sh one more when it started
  // this program; the kernel test runs it with no shell.
  require(started >= 62 && started <= 63 && last.status == Sys::INVALID, 204);

  while (started > 0) {
    started -= 1;
    expect(Sys::call1(Sys::WAIT, *@pointerFromInteger<*u64>(@integerFromPointer(children) + started * 8)), Sys::OK, 0, 204);
  }

  let again: u64 = succeed(spawn("/bin/pwd", 8, "pwd", 4, 1), 204);

  expect(Sys::call1(Sys::WAIT, again), Sys::OK, 0, 204);
  expect(Sys::call2(Sys::CURRENT_DIRECTORY, buffer(), 1), Sys::OK, 1, 205);
  expect(Sys::call3(Sys::UNLINK, 0xFFFFFFFFFFFFFFFE, at("."), 1), Sys::INVALID, 0, 206);
  expect(Sys::call3(Sys::REMOVE_DIRECTORY, Sys::ROOT, at("/bin/.."), 7), Sys::INVALID, 0, 206);
}

/// Parents and children. `nativetest orphan` starts `nativetest nap` and
/// ends at once, so the napping grandchild becomes an orphan; `nativetest
/// zombie` starts `/bin/pwd`, lets it end, and ends without waiting for it.
/// Both exit with the grandchild's id, which fits a status in these runs.
function checkParents(): void {
  let orphanMaker: u64 = succeed(spawn("/bin/nativetest", 15, "nativetest\0orphan", 18, 2), 140);
  let orphan: u64 = succeed(Sys::call1(Sys::WAIT, orphanMaker), 140);

  expect(Sys::call1(Sys::WAIT, orphan), Sys::NO_CHILD, 0, 141);
  expect(Sys::call1(Sys::SLEEP, 400000000), Sys::OK, 0, 142);
  expect(Sys::call1(Sys::WAIT, orphan), Sys::NOT_FOUND, 0, 142);

  let zombieMaker: u64 = succeed(spawn("/bin/nativetest", 15, "nativetest\0zombie", 18, 2), 143);
  let zombie: u64 = succeed(Sys::call1(Sys::WAIT, zombieMaker), 143);

  expect(Sys::call1(Sys::WAIT, zombie), Sys::NOT_FOUND, 0, 143);
}

/// `WAIT_ANY(statusPointer)`.
function checkWaitAny(): void {
  let statusAddress: u64 = buffer();

  expect(Sys::call1(Sys::WAIT_ANY, statusAddress), Sys::NO_CHILD, 0, 160);
  expect(Sys::call1(Sys::WAIT_ANY, 1), Sys::BAD_ADDRESS, 0, 161);

  let quick: u64 = succeed(spawn("/bin/rmdir", 10, "rmdir\0nope", 11, 2), 162);
  let napper: u64 = succeed(spawn("/bin/nativetest", 15, "nativetest\0nap", 15, 2), 162);

  expect(Sys::call1(Sys::WAIT_ANY, statusAddress), Sys::OK, quick, 162);
  require(word(statusAddress, 0) == 1, 162);
  expect(Sys::call1(Sys::WAIT_ANY, statusAddress), Sys::OK, napper, 163);
  require(word(statusAddress, 0) == 0, 163);
  expect(Sys::call1(Sys::WAIT_ANY, statusAddress), Sys::NO_CHILD, 0, 163);
}

/// Starts `nativetest MODE`, lets it run 50 ms, kills it, and requires
/// status 137 from `WAIT`.
function killChild(mode: str, length: u64, status: u64): void {
  let arguments: *mut u8 = @pointerFromInteger<*mut u8>(buffer());
  let prefix: str = "nativetest";
  let mut index: u64 = 0;

  while (index < 10) {
    *(arguments + index) = *(prefix as *u8 + index);
    index += 1;
  }

  *(arguments + 10) = 0;
  index = 0;

  while (index < length) {
    *(arguments + 11 + index) = *(mode as *u8 + index);
    index += 1;
  }

  *(arguments + 11 + length) = 0;

  let child: u64 = succeed(Sys::call5(Sys::SPAWN, at("/bin/nativetest"), 15, buffer(), 12 + length, 2), status);

  Last::child = child;

  expect(Sys::call1(Sys::SLEEP, 50000000), Sys::OK, 0, status);
  expect(Sys::call1(Sys::KILL, child), Sys::OK, 0, status);
  expect(Sys::call1(Sys::WAIT, child), Sys::OK, 137, status);
}

/// Killing a keyboard reader and then another process still ends the
/// reader: each reader has its own cancel flag.
function checkKillTwo(): void {
  let reader: u64 = succeed(spawn("/bin/nativetest", 15, "nativetest\0read", 16, 2), 176);
  let sleeper: u64 = succeed(spawn("/bin/nativetest", 15, "nativetest\0sleep", 17, 2), 176);

  expect(Sys::call1(Sys::SLEEP, 50000000), Sys::OK, 0, 176);
  expect(Sys::call1(Sys::KILL, reader), Sys::OK, 0, 176);
  expect(Sys::call1(Sys::KILL, sleeper), Sys::OK, 0, 176);
  expect(Sys::call1(Sys::WAIT, sleeper), Sys::OK, 137, 176);
  expect(Sys::call1(Sys::WAIT, reader), Sys::OK, 137, 176);
}

/// A child killed before it ever runs does nothing: `touch` must not create
/// its file.
function checkKillUnstarted(): void {
  let child: u64 = succeed(spawn("/bin/touch", 10, "touch\0/nt/killed", 17, 2), 177);

  expect(Sys::call1(Sys::KILL, child), Sys::OK, 0, 177);
  expect(Sys::call1(Sys::WAIT, child), Sys::OK, 137, 177);
  expect(open("/nt/killed", 10, Sys::OPEN_READ), Sys::NOT_FOUND, 0, 177);
}

/// `KILL`.
function checkKill(): void {
  expect(Sys::call1(Sys::KILL, 999999), Sys::NOT_FOUND, 0, 170);
  killChild("sleep", 5, 171);
  killChild("spin", 4, 172);
  killChild("read", 4, 173);
  killChild("waiter", 6, 174);

  // The waiter's child sleeps 10 000 s and became an orphan. It was started
  // right after the waiter, so its id is the next one. Killing it ends it,
  // and an orphan's slot is freed as soon as it ends.
  let orphan: u64 = Last::child + 1;

  expect(Sys::call1(Sys::KILL, orphan), Sys::OK, 0, 174);
  expect(Sys::call1(Sys::SLEEP, 50000000), Sys::OK, 0, 174);
  expect(Sys::call1(Sys::KILL, orphan), Sys::NOT_FOUND, 0, 174);

  checkKillTwo();
  checkKillUnstarted();

  let suicide: u64 = succeed(spawn("/bin/nativetest", 15, "nativetest\0suicide", 19, 2), 175);

  expect(Sys::call1(Sys::WAIT, suicide), Sys::OK, 137, 175);
}

/// The helper modes of `checkParents` and `checkKill`. Returns the exit
/// status.
function helper(mode: *u8): u64 {
  let length: u64 = Args::length(mode);

  if (length == 5 && same(@integerFromPointer(mode), "sleep", 5)) {
    Sys::call1(Sys::SLEEP, 10000000000000);
    return 0;
  }

  if (length == 4 && same(@integerFromPointer(mode), "spin", 4)) {
    let mut turns: u64 = 0;

    while (true) {
      turns = @readVolatile<u64>(&mut turns as *mut u64) + 1;
      @writeVolatile<u64>(&mut turns as *mut u64, turns);
    }

    return 0;
  }

  if (length == 4 && same(@integerFromPointer(mode), "read", 4)) {
    Sys::call3(Sys::READ, Sys::STDIN, buffer(), 100);
    return 0;
  }

  if (length == 6 && same(@integerFromPointer(mode), "waiter", 6)) {
    succeed(spawn("/bin/nativetest", 15, "nativetest\0sleep", 17, 2), 153);
    Sys::call1(Sys::WAIT_ANY, buffer());
    return 0;
  }

  if (length == 7 && same(@integerFromPointer(mode), "suicide", 7)) {
    Sys::call1(Sys::KILL, succeed(Sys::call0(Sys::PROCESS_ID), 154));
    return 0;
  }

  if (length == 3 && same(@integerFromPointer(mode), "nap", 3)) {
    Sys::call1(Sys::SLEEP, 200000000);
    return 0;
  }

  if (length == 6 && same(@integerFromPointer(mode), "orphan", 6)) {
    return succeed(spawn("/bin/nativetest", 15, "nativetest\0nap", 15, 2), 150) & 0xFF;
  }

  if (length == 6 && same(@integerFromPointer(mode), "zombie", 6)) {
    let child: u64 = succeed(spawn("/bin/pwd", 8, "pwd", 4, 1), 151);

    Sys::call1(Sys::SLEEP, 100000000);
    return child & 0xFF;
  }

  return 152;
}

/// `UNLINK` and `REMOVE_DIRECTORY`.
function checkRemove(): void {
  let made: u64 = succeed(open("/nt/gone", 8, Sys::OPEN_WRITE | Sys::OPEN_CREATE), 110);

  succeed(Sys::call1(Sys::CLOSE, made), 110);
  expect(Sys::call3(Sys::UNLINK, Sys::ROOT, at("/nt/gone"), 8), Sys::OK, 0, 110);
  expect(Sys::call3(Sys::UNLINK, Sys::ROOT, at("/nt/gone"), 8), Sys::NOT_FOUND, 0, 111);
  expect(Sys::call3(Sys::UNLINK, Sys::ROOT, at("/nt"), 3), Sys::IS_DIRECTORY, 0, 112);
  expect(Sys::call3(Sys::REMOVE_DIRECTORY, Sys::ROOT, at("/nt"), 3), Sys::NOT_EMPTY, 0, 113);

  let directory: u64 = succeed(open("/nt", 3, Sys::OPEN_READ | Sys::OPEN_DIRECTORY), 114);

  expect(Sys::call3(Sys::REMOVE_DIRECTORY, Sys::ROOT, at("/nt/a"), 5), Sys::NOT_DIRECTORY, 0, 114);
  succeed(Sys::call4(Sys::MAKE_DIRECTORY, directory, at("e"), 1, 0x1ED), 115);

  let inner: u64 = succeed(open("/nt/e", 5, Sys::OPEN_READ | Sys::OPEN_DIRECTORY), 115);

  expect(Sys::call3(Sys::REMOVE_DIRECTORY, directory, at("e"), 1), Sys::BUSY, 0, 115);
  succeed(Sys::call1(Sys::CLOSE, inner), 115);
  expect(Sys::call3(Sys::REMOVE_DIRECTORY, directory, at("e"), 1), Sys::OK, 0, 115);
  succeed(Sys::call1(Sys::CLOSE, directory), 115);
}

/// Called by `_start` with argc and argv.
@externName("ignis_main")
function main(count: u64, values: *u64): u64 {
  if (count > 1) {
    return helper(Args::get(values, 1));
  }

  checkBasics();
  checkReading();
  checkOpenErrors();
  checkWriting();
  checkDirectories();
  checkMapping();
  checkScheduling();
  checkEdges();
  checkRemove();
  checkCurrentDirectory();
  checkSpawn();
  checkLimits();
  checkParents();
  checkWaitAny();
  checkKill();

  Io::print("nativetest: every native call, its arguments and its status codes behave as specified\n");

  return 0;
}
