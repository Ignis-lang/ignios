//!
//! # shutdown
//!
//! `shutdown`: powers the machine off through ACPI with the native `POWER`
//! call.
//!
//! | Case                   | Effect                                              | Status |
//! |------------------------|-----------------------------------------------------|--------|
//! | power-off works        | the kernel prints `power: shutting down`, the machine turns off (QEMU exits) | (none) |
//! | no ACPI power-off      | `shutdown: Function not implemented` on standard error | 1   |
//!
//! The files in memory are lost.

import Io from "std::io";
import Sys from "std::sys";
import _ from "std::panic";

/// Called by `_start` with argc and argv.
@externName("ignis_main")
function main(count: u64, values: *u64): u64 {
  let result: i64 = Sys::powerOff();

  Io::error("shutdown: ");
  Io::error(Sys::errorText(result));
  Io::error("\n");

  return 1;
}
