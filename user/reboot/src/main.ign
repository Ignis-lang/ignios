//!
//! # reboot
//!
//! `reboot`: resets the machine with the native `POWER` call.
//!
//! | Case                   | Effect                                              | Status |
//! |------------------------|-----------------------------------------------------|--------|
//! | the reset works        | the kernel prints `power: rebooting`, the machine boots again | (none) |
//! | the call comes back    | `reboot: REASON` on standard error                  | 1      |
//!
//! The files in memory are lost, as on any reboot.

import Io from "std::io";
import Sys from "std::sys";
import _ from "std::panic";

/// Called by `_start` with argc and argv.
@externName("ignis_main")
function main(count: u64, values: *u64): u64 {
  let result: i64 = Sys::reboot();

  Io::error("reboot: ");
  Io::error(Sys::errorText(result));
  Io::error("\n");

  return 1;
}
