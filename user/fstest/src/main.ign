//!
//! # fstest
//!
//! Ring 3 checks of the file system calls: every call, its flags and its
//! errors, the way a Linux program sees them.
//!
//! ## What It Checks
//!
//! | Status | Check                                                               |
//! |--------|---------------------------------------------------------------------|
//! | 10-15  | `openat` of `/etc/motd` gives descriptor 3; `read` in pieces, then 0 at the end |
//! | 20-24  | `lseek` from the start, the current offset and the end; -1 is `-EINVAL`; the console is `-ESPIPE` |
//! | 30-32  | `fstat`: size 19, mode `S_IFREG` 0644, an inode number              |
//! | 40-43  | `write` to a read-only descriptor is `-EBADF`; `close` twice, `read` after `close` |
//! | 50-56  | `openat` errors: `-ENOENT`, `-ENOTDIR` (twice), `-EISDIR`, `-EFAULT`, access mode 3 `-EINVAL`, a 4096-byte path `-ENAMETOOLONG` |
//! | 60-62  | `mkdirat` of `/fstest`, again `-EEXIST`, under a missing directory `-ENOENT` |
//! | 70-76  | `O_CREAT`, `O_EXCL`, `write`, `O_APPEND`, `O_TRUNC`, reading back what was written |
//! | 80-85  | relative paths from a directory descriptor, `newfstatat`, `AT_EMPTY_PATH`, an empty path `-ENOENT` |
//! | 90-95  | `getdents64` lists `.`, `..`, `a` and `b` with their types, then 0; a small buffer is `-EINVAL`; a file is `-ENOTDIR` |
//! | 100    | 16 descriptors per process, then `-EMFILE`                          |
//! | 110-111 | descriptors 0 to 2: `fstat` says character device `0x501` (reading descriptor 0 waits for the keyboard; `make shelltest` checks it) |
//! | 120-122 | a write at 2^62 or at 64 MiB is `-EFBIG`, one whose end overflows is `-EINVAL`; the file stays empty |
//! | 123-124 | a bad buffer is `-EFAULT` for `read`, `write`, `fstat`, `newfstatat`, `getdents64`; a 48-byte `getdents64` buffer takes `.` and `..` |
//! | 125    | `O_CREAT` on an existing directory is `-EISDIR`                      |
//! | 140-147 | `getcwd` is `/`, then `/fstest` after `chdir`; a relative `openat` and `mkdirat` start there; a current directory cannot be removed (`-EBUSY`); `chdir` to a file `-ENOTDIR`, to nothing `-ENOENT`; `getcwd` into 2 bytes `-ERANGE`, into a bad pointer `-EFAULT` |
//! | 130-138 | `unlinkat`: a file, then `-ENOENT`; a directory without `AT_REMOVEDIR` `-EISDIR`; a non-empty one `-ENOTEMPTY`; an open one `-EBUSY`, then 0 once closed; a file with `AT_REMOVEDIR` `-ENOTDIR`; `/` and an unknown flag `-EINVAL`; a file named with a trailing `/` `-ENOTDIR`; an open file `-EBUSY` |
//!
//! The exit status is the number of the first check that failed, 0 when all
//! passed. `Tests::User::runFiles` runs it at boot and then removes the
//! directory `/fstest` it created.

import Args from "std::args";
import Io from "std::io";
import Sys from "std::sys";
import _ from "std::panic";

/// The text of `initramfs/etc/motd`.
const MOTD: str = "Welcome to IgniOS.\n";

/// Length of `MOTD`.
const MOTD_LENGTH: u64 = 19;

/// `st_mode` of a regular file with mode 0644: `S_IFREG` (`0x8000`) | `0x1A4`.
const MODE_REGULAR_644: u32 = 0x81A4;

/// The file type bits of `st_mode`.
const MODE_TYPE_MASK: u32 = 0xF000;

/// `S_IFDIR`.
const MODE_DIRECTORY: u32 = 0x4000;

/// `S_IFCHR`.
const MODE_CHARACTER: u32 = 0x2000;

/// `st_rdev` of the console, `makedev(5, 1)`.
const CONSOLE_RDEV: u64 = 0x501;

/// `d_type` of a directory.
const DT_DIR: u8 = 4;

/// `d_type` of a regular file.
const DT_REG: u8 = 8;

/// Descriptors a process can hold.
const MAX_DESCRIPTORS: u64 = 16;

/// What the checks share.
record State {
  /// A `struct stat`.
  static mut stat: u8[144];

  /// Bytes read back and directory records.
  static mut buffer: u8[512];

  /// A path longer than `PATH_MAX`.
  static mut longPath: u8[4097];
}

/// Exits with `status` unless `got` equals `wanted`, after printing both.
function expect(got: i64, wanted: i64, status: u64): void {
  if (got != wanted) {
    Io::print("fstest: check ");
    Io::printNumber(status as i64);
    Io::print(" got ");
    Io::printNumber(got);
    Io::print(", expected ");
    Io::printNumber(wanted);
    Io::print("\n");
    Sys::exit(status);
  }
}

/// Exits with `status` unless `condition` holds.
function require(condition: boolean, status: u64): void {
  if (!condition) {
    Io::print("fstest: check ");
    Io::printNumber(status as i64);
    Io::print(" failed\n");
    Sys::exit(status);
  }
}

/// The first byte of `State::buffer`.
function buffer(): *mut u8 {
  return &mut State::buffer as *mut u8;
}

/// The first byte of `State::stat`.
function stat(): *mut u8 {
  return &mut State::stat as *mut u8;
}

/// The 8-byte field at `offset` of the bytes at `bytes`.
function word(bytes: *mut u8, offset: u64): u64 {
  return *@pointerFromInteger<*u64>(@integerFromPointer(bytes) + offset);
}

/// The 4-byte field at `offset` of the bytes at `bytes`.
function half(bytes: *mut u8, offset: u64): u32 {
  return *@pointerFromInteger<*u32>(@integerFromPointer(bytes) + offset);
}

/// True when the `length` bytes at `bytes` are the text `text`.
function same(bytes: *u8, text: str, length: u64): boolean {
  let mut index: u64 = 0;

  while (index < length) {
    if (*(bytes + index) != *(text as *u8 + index)) {
      return false;
    }

    index += 1;
  }

  return *(text as *u8 + length) == 0;
}

/// Opening, reading, seeking and describing `/etc/motd`, and closing it.
function checkReading(): void {
  let fd: i64 = Sys::open("/etc/motd" as *u8, Sys::O_RDONLY, 0);

  expect(fd, 3, 10);
  expect(Sys::read(fd as u64, buffer(), 7), 7, 11);
  require(same(buffer() as *u8, "Welcome", 7), 12);
  expect(Sys::read(fd as u64, buffer(), 100), (MOTD_LENGTH - 7) as i64, 13);
  require(same(buffer() as *u8, " to IgniOS.\n", 12), 14);
  expect(Sys::read(fd as u64, buffer(), 100), 0, 15);

  expect(Sys::seek(fd as u64, 3, Sys::SEEK_SET), 3, 20);
  expect(Sys::seek(fd as u64, 2, Sys::SEEK_CUR), 5, 21);
  expect(Sys::seek(fd as u64, -1, Sys::SEEK_END), (MOTD_LENGTH - 1) as i64, 22);
  expect(Sys::seek(fd as u64, -1, Sys::SEEK_SET), 0 - Sys::EINVAL, 23);
  expect(Sys::seek(Sys::STDOUT, 0, Sys::SEEK_SET), 0 - Sys::ESPIPE, 24);

  expect(Sys::fstat(fd as u64, stat()), 0, 30);
  require(word(stat(), 48) == MOTD_LENGTH && half(stat(), 24) == MODE_REGULAR_644, 31);
  require(word(stat(), 8) != 0, 32);

  expect(Sys::write(fd as u64, "x" as *u8, 1), 0 - Sys::EBADF, 40);
  expect(Sys::close(fd as u64), 0, 41);
  expect(Sys::close(fd as u64), 0 - Sys::EBADF, 42);
  expect(Sys::read(fd as u64, buffer(), 1), 0 - Sys::EBADF, 43);
}

/// The errors of `openat`.
function checkOpenErrors(): void {
  expect(Sys::open("/nope" as *u8, Sys::O_RDONLY, 0), 0 - Sys::ENOENT, 50);
  expect(Sys::open("/etc/motd/x" as *u8, Sys::O_RDONLY, 0), 0 - Sys::ENOTDIR, 51);
  expect(Sys::open("/etc" as *u8, Sys::O_WRONLY, 0), 0 - Sys::EISDIR, 52);
  expect(Sys::open("/etc/motd" as *u8, Sys::O_DIRECTORY, 0), 0 - Sys::ENOTDIR, 53);
  expect(Sys::open(@pointerFromInteger<*u8>(1), Sys::O_RDONLY, 0), 0 - Sys::EFAULT, 54);
  expect(Sys::open("/etc/motd" as *u8, 3, 0), 0 - Sys::EINVAL, 55);

  let path: *mut u8 = &mut State::longPath as *mut u8;
  let mut index: u64 = 0;

  while (index < 4096) {
    *(path + index) = 0x2F;
    index += 1;
  }

  *(path + 4096) = 0;
  expect(Sys::open(path as *u8, Sys::O_RDONLY, 0), 0 - Sys::ENAMETOOLONG, 56);
}

/// `mkdirat`, then creating, writing, appending and truncating a file in
/// the new directory.
function checkWriting(): void {
  expect(Sys::makeDirectory("/fstest" as *u8, 0x1ED), 0, 60);
  expect(Sys::makeDirectory("/fstest" as *u8, 0x1ED), 0 - Sys::EEXIST, 61);
  expect(Sys::makeDirectory("/nope/x" as *u8, 0x1ED), 0 - Sys::ENOENT, 62);

  let created: i64 = Sys::open("/fstest/a" as *u8, Sys::O_CREAT | Sys::O_WRONLY | Sys::O_EXCL, 0x1A4);

  require(created >= 0, 70);
  expect(Sys::write(created as u64, "hello" as *u8, 5), 5, 71);
  expect(Sys::close(created as u64), 0, 71);
  expect(Sys::open("/fstest/a" as *u8, Sys::O_CREAT | Sys::O_WRONLY | Sys::O_EXCL, 0x1A4), 0 - Sys::EEXIST, 72);

  let appender: i64 = Sys::open("/fstest/a" as *u8, Sys::O_WRONLY | Sys::O_APPEND, 0);

  expect(Sys::write(appender as u64, " world" as *u8, 6), 6, 73);
  expect(Sys::close(appender as u64), 0, 73);

  let reader: i64 = Sys::open("/fstest/a" as *u8, Sys::O_RDONLY, 0);

  expect(Sys::read(reader as u64, buffer(), 100), 11, 74);
  require(same(buffer() as *u8, "hello world", 11), 74);
  expect(Sys::close(reader as u64), 0, 74);

  let truncated: i64 = Sys::open("/fstest/a" as *u8, Sys::O_WRONLY | Sys::O_TRUNC, 0);

  expect(Sys::fstat(truncated as u64, stat()), 0, 75);
  expect(word(stat(), 48) as i64, 0, 76);
  expect(Sys::write(truncated as u64, "abc" as *u8, 3), 3, 76);
  expect(Sys::close(truncated as u64), 0, 76);
}

/// Paths relative to a directory descriptor, `newfstatat` and
/// `getdents64`.
function checkDirectories(): void {
  let directory: i64 = Sys::open("/fstest" as *u8, Sys::O_RDONLY | Sys::O_DIRECTORY, 0);

  require(directory >= 0, 80);

  let made: i64 = Sys::openAt(directory as u64, "b" as *u8, Sys::O_CREAT | Sys::O_WRONLY, 0x1A4);

  require(made >= 0, 81);
  expect(Sys::close(made as u64), 0, 81);

  expect(Sys::statAt(directory as u64, "a" as *u8, stat(), 0), 0, 82);
  require(word(stat(), 48) == 3 && half(stat(), 24) == MODE_REGULAR_644, 82);
  expect(Sys::statAt(Sys::AT_FDCWD, "/fstest" as *u8, stat(), 0), 0, 83);
  require((half(stat(), 24) & MODE_TYPE_MASK) == MODE_DIRECTORY, 83);
  expect(Sys::statAt(directory as u64, "" as *u8, stat(), Sys::AT_EMPTY_PATH), 0, 84);
  require((half(stat(), 24) & MODE_TYPE_MASK) == MODE_DIRECTORY, 84);
  expect(Sys::statAt(Sys::AT_FDCWD, "" as *u8, stat(), 0), 0 - Sys::ENOENT, 85);

  let bytes: i64 = Sys::readDirectory(directory as u64, buffer(), 512);

  require(bytes > 0, 90);
  checkEntries(bytes as u64);
  expect(Sys::readDirectory(directory as u64, buffer(), 512), 0, 92);
  expect(Sys::seek(directory as u64, 0, Sys::SEEK_SET), 0, 93);
  expect(Sys::readDirectory(directory as u64, buffer(), 8), 0 - Sys::EINVAL, 93);

  let file: i64 = Sys::open("/etc/motd" as *u8, Sys::O_RDONLY, 0);

  expect(Sys::readDirectory(file as u64, buffer(), 512), 0 - Sys::ENOTDIR, 94);
  expect(Sys::close(file as u64), 0, 95);
  expect(Sys::close(directory as u64), 0, 95);
}

/// The records `getdents64` wrote: `.`, `..`, `a`, `b`, in that order and
/// with their types, each record length a multiple of 8.
function checkEntries(total: u64): void {
  let mut offset: u64 = 0;
  let mut count: u64 = 0;

  while (offset < total) {
    let entry: *mut u8 = buffer() + offset;
    let length: u64 = (*(entry + 16) as u64) | ((*(entry + 17) as u64) << 8);
    let kind: u8 = *(entry + 18);
    let name: *u8 = (entry + 19) as *u8;

    require(length % 8 == 0 && length > 19, 91);

    if (count == 0) {
      require(same(name, ".", Args::length(name)) && kind == DT_DIR, 91);
    } else if (count == 1) {
      require(same(name, "..", Args::length(name)) && kind == DT_DIR, 91);
    } else if (count == 2) {
      require(same(name, "a", Args::length(name)) && kind == DT_REG, 91);
    } else if (count == 3) {
      require(same(name, "b", Args::length(name)) && kind == DT_REG, 91);
    }

    require(word(entry, 8) == count + 1, 91);

    offset += length;
    count += 1;
  }

  expect(count as i64, 4, 91);
}

/// The descriptor limit: 13 more open files fill the table, the next one is
/// `-EMFILE`.
function checkLimit(): void {
  let mut opened: u64 = 3;

  while (opened < MAX_DESCRIPTORS) {
    expect(Sys::open("/etc/motd" as *u8, Sys::O_RDONLY, 0), opened as i64, 100);
    opened += 1;
  }

  expect(Sys::open("/etc/motd" as *u8, Sys::O_RDONLY, 0), 0 - Sys::EMFILE, 100);

  while (opened > 3) {
    opened -= 1;
    expect(Sys::close(opened), 0, 100);
  }
}

/// Writes at huge offsets are refused before anything is allocated, and the
/// file stays empty: past the 64 MiB file limit is `-EFBIG`, an offset that
/// overflows with the count is `-EINVAL`.
function checkHugeOffsets(): void {
  let fd: i64 = Sys::open("/fstest/huge" as *u8, Sys::O_CREAT | Sys::O_RDWR, 0x1A4);

  require(fd >= 0, 120);
  expect(Sys::seek(fd as u64, 4611686018427387904, Sys::SEEK_SET), 4611686018427387904, 120);
  expect(Sys::write(fd as u64, "ab" as *u8, 2), 0 - Sys::EFBIG, 120);
  expect(Sys::seek(fd as u64, 67108864, Sys::SEEK_SET), 67108864, 121);
  expect(Sys::write(fd as u64, "ab" as *u8, 2), 0 - Sys::EFBIG, 121);
  expect(Sys::seek(fd as u64, 9223372036854775807, Sys::SEEK_SET), 9223372036854775807, 121);
  expect(Sys::write(fd as u64, "ab" as *u8, 2), 0 - Sys::EINVAL, 121);
  expect(Sys::fstat(fd as u64, stat()), 0, 122);
  expect(word(stat(), 48) as i64, 0, 122);
  expect(Sys::close(fd as u64), 0, 122);
}

/// Bad buffers are `-EFAULT` for every call that takes one, and a
/// `getdents64` buffer of 48 bytes takes `.` and `..` only, the rest coming
/// on the next call.
function checkBuffers(): void {
  let bad: *mut u8 = @pointerFromInteger<*mut u8>(1);
  let motd: i64 = Sys::open("/etc/motd" as *u8, Sys::O_RDONLY, 0);

  expect(Sys::read(motd as u64, bad, 4), 0 - Sys::EFAULT, 123);
  expect(Sys::write(Sys::STDOUT, bad as *u8, 4), 0 - Sys::EFAULT, 123);
  expect(Sys::fstat(motd as u64, bad), 0 - Sys::EFAULT, 123);
  expect(Sys::statAt(Sys::AT_FDCWD, "/etc" as *u8, bad, 0), 0 - Sys::EFAULT, 123);
  expect(Sys::close(motd as u64), 0, 123);

  let directory: i64 = Sys::open("/fstest" as *u8, Sys::O_RDONLY | Sys::O_DIRECTORY, 0);

  expect(Sys::readDirectory(directory as u64, bad, 512), 0 - Sys::EFAULT, 124);
  expect(Sys::readDirectory(directory as u64, buffer(), 48), 48, 124);
  require(same((buffer() + 19) as *u8, ".", 1) && same((buffer() + 43) as *u8, "..", 2), 124);
  require(Sys::readDirectory(directory as u64, buffer(), 512) > 0, 124);
  expect(Sys::close(directory as u64), 0, 124);
}

/// `unlinkat` with and without `AT_REMOVEDIR`, and its errors.
function checkRemove(): void {
  let made: i64 = Sys::open("/fstest/gone" as *u8, Sys::O_CREAT | Sys::O_WRONLY, 0x1A4);

  expect(Sys::close(made as u64), 0, 130);
  expect(Sys::unlink("/fstest/gone" as *u8), 0, 130);
  expect(Sys::unlink("/fstest/gone" as *u8), 0 - Sys::ENOENT, 131);
  expect(Sys::unlink("/fstest" as *u8), 0 - Sys::EISDIR, 132);
  expect(Sys::removeDirectory("/fstest" as *u8), 0 - Sys::ENOTEMPTY, 133);
  expect(Sys::makeDirectory("/fstest/d" as *u8, 0x1ED), 0, 134);

  let directory: i64 = Sys::open("/fstest/d" as *u8, Sys::O_RDONLY | Sys::O_DIRECTORY, 0);

  expect(Sys::removeDirectory("/fstest/d" as *u8), 0 - Sys::EBUSY, 134);
  expect(Sys::close(directory as u64), 0, 134);
  expect(Sys::removeDirectory("/fstest/d" as *u8), 0, 134);
  expect(Sys::removeDirectory("/fstest/a" as *u8), 0 - Sys::ENOTDIR, 135);
  expect(Sys::removeDirectory("/" as *u8), 0 - Sys::EINVAL, 136);
  expect(Sys::unlinkAt(Sys::AT_FDCWD, "/fstest/a" as *u8, 1), 0 - Sys::EINVAL, 136);
  expect(Sys::unlink("/fstest/a/" as *u8), 0 - Sys::ENOTDIR, 137);

  let open: i64 = Sys::open("/fstest/a" as *u8, Sys::O_RDONLY, 0);

  expect(Sys::unlink("/fstest/a" as *u8), 0 - Sys::EBUSY, 138);
  expect(Sys::close(open as u64), 0, 138);
}

/// `chdir`, `getcwd` and relative paths.
function checkCurrentDirectory(): void {
  expect(Sys::getcwd(buffer(), 100), 2, 140);
  require(same(buffer() as *u8, "/", 1), 140);
  expect(Sys::changeDirectory("/fstest" as *u8), 0, 141);
  expect(Sys::getcwd(buffer(), 100), 8, 141);
  require(same(buffer() as *u8, "/fstest", 7), 141);

  let relative: i64 = Sys::open("a" as *u8, Sys::O_RDONLY, 0);

  require(relative >= 0, 142);
  expect(Sys::close(relative as u64), 0, 142);
  expect(Sys::makeDirectory("c" as *u8, 0x1ED), 0, 143);
  expect(Sys::changeDirectory("c" as *u8), 0, 143);
  expect(Sys::getcwd(buffer(), 100), 10, 143);
  expect(Sys::removeDirectory("/fstest/c" as *u8), 0 - Sys::EBUSY, 144);
  expect(Sys::changeDirectory(".." as *u8), 0, 144);
  expect(Sys::removeDirectory("c" as *u8), 0, 144);
  expect(Sys::changeDirectory("a" as *u8), 0 - Sys::ENOTDIR, 145);
  expect(Sys::changeDirectory("nope" as *u8), 0 - Sys::ENOENT, 145);
  expect(Sys::getcwd(buffer(), 2), 0 - Sys::ERANGE, 146);
  expect(Sys::getcwd(@pointerFromInteger<*mut u8>(1), 100), 0 - Sys::EFAULT, 147);
  expect(Sys::changeDirectory("/" as *u8), 0, 147);
}

/// `O_CREAT` on an existing directory is `-EISDIR`, as on Linux.
function checkCreateDirectory(): void {
  expect(Sys::open("/etc" as *u8, Sys::O_CREAT | Sys::O_RDONLY, 0x1A4), 0 - Sys::EISDIR, 125);
}

/// The standard descriptors are the console.
function checkConsole(): void {
  expect(Sys::fstat(Sys::STDOUT, stat()), 0, 110);
  require((half(stat(), 24) & MODE_TYPE_MASK) == MODE_CHARACTER && word(stat(), 40) == CONSOLE_RDEV, 111);
}

/// Runs every check and prints one line when all passed.
@externName("ignis_main")
function main(count: u64, values: *u64): u64 {
  checkReading();
  checkOpenErrors();
  checkWriting();
  checkDirectories();
  checkLimit();
  checkConsole();
  checkHugeOffsets();
  checkBuffers();
  checkCreateDirectory();
  checkRemove();
  checkCurrentDirectory();

  Io::print("fstest: openat, read, write, lseek, close, fstat, newfstatat, getdents64 and mkdirat behave as on Linux\n");

  return 0;
}
