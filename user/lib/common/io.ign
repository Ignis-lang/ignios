//!
//! # Text Output (user side)
//!
//! Printing built on `Sys::write`.
//!
//! ## Overview
//!
//! There is no buffering: every call is one or more `write` system calls to
//! standard output, which the kernel prints on the console. `printNumber`
//! writes digit by digit, so a number can be interleaved with output from
//! another process.

import Sys from "std::sys";

/// The text output functions.
export namespace Io {
  /// Writes the `length` bytes at `bytes` to standard output.
  function printBytes(bytes: *u8, length: u64): void {
    Sys::write(Sys::STDOUT, bytes, length);
  }

  /// Writes the NUL-terminated string at `text` to standard output.
  function printString(text: *u8): void {
    printBytes(text, stringLength(text));
  }

  /// Writes a NUL-terminated string to standard error.
  function error(text: str): void {
    errorString(text as *u8);
  }

  /// Writes the NUL-terminated string at `text` to standard error.
  function errorString(text: *u8): void {
    Sys::write(Sys::STDERR, text, stringLength(text));
  }

  /// The length of the NUL-terminated string at `text`, without the NUL.
  function stringLength(text: *u8): u64 {
    let mut length: u64 = 0;

    while (*(text + length) != 0) {
      length += 1;
    }

    return length;
  }

  /// Writes a NUL-terminated string to standard output.
  function print(text: str): void {
    let mut length: u64 = 0;

    while (*(text as *u8 + length) != 0) {
      length += 1;
    }

    Sys::write(Sys::STDOUT, text as *u8, length);
  }

  /// Writes `text` followed by a newline.
  function printLine(text: str): void {
    print(text);
    print("\n");
  }

  /// Writes a signed number in decimal. Digits are produced least significant
  /// first into a local buffer of 24 bytes (an `i64` has at most 20 characters)
  /// and written most significant first.
  ///
  /// The magnitude of a negative value is computed in `u64` as `0 - value`,
  /// where the subtraction wraps modulo 2^64. Negating in `i64` instead would
  /// Writes `value` in decimal, with a `-` when negative, to standard output.
  function printNumber(value: i64): void {
    writeNumber(Sys::STDOUT, value);
  }

  /// Writes `value` in decimal to standard error.
  function errorNumber(value: i64): void {
    writeNumber(Sys::STDERR, value);
  }

  /// Writes `value` in decimal, with a `-` when negative, to `descriptor`.
  /// The magnitude is computed in `u64`, so the `i64` minimum has one.
  function writeNumber(descriptor: u64, value: i64): void {
    let mut digits: u8[24];
    let mut length: u64 = 0;
    let negative: boolean = value < 0;

    let mut magnitude: u64 = value as u64;

    if (negative) {
      magnitude = 0 - magnitude;
    }

    if (magnitude == 0) {
      digits[0] = 0x30;
      length = 1;
    }

    while (magnitude > 0) {
      digits[length] = ((magnitude % 10) as u8) + 0x30;
      magnitude /= 10;
      length += 1;
    }

    if (negative) {
      Sys::write(descriptor, "-" as *u8, 1);
    }

    while (length > 0) {
      length -= 1;
      Sys::write(descriptor, &digits[length] as *u8, 1);
    }
  }
}
