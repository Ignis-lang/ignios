//!
//! # System Calls (user side)
//!
//! Thin wrappers over the `syscall` instruction.
//!
//! ## Overview
//!
//! IgniOS speaks the Linux x86_64 convention for the calls it implements: the
//! number in RAX, up to six arguments in RDI, RSI, RDX, R10, R8 and R9, and
//! the result in RAX. A result from -4095 to -1 is a negated errno. `syscall`
//! overwrites RCX and R11 and the kernel preserves every other register.
//!
//! ```text
//!   Sys::write(1, buf, n)
//!     └─ call3(WRITE = 1, 1, buf, n)
//!          asm: rax = 1, rdi = 1, rsi = buf, rdx = n
//!               syscall                      -> kernel (kernel/src/syscall.ign)
//!          result in rax; rcx, r11 and memory are declared clobbered
//! ```
//!
//! The `callN` helpers differ only in how many argument registers they fill
//! in. Each declares `rcx`, `r11` and memory as clobbered so the compiler
//! reloads anything it kept in them.
//!
//! This is the only module of the user library that talks to the kernel. See
//! concept doc 15.

/// `struct timespec`, the argument of `nanosleep`: seconds and nanoseconds,
/// both signed 64-bit, 16 bytes with C layout.
@cLayout
export record Timespec {
  /// Whole seconds.
  public seconds: i64;

  /// Nanoseconds, 0 to 999999999.
  public nanoseconds: i64;
}

/// The system call wrappers.
export namespace Sys {
  /// Linux system call number 0.
  const READ: u64 = 0;

  /// Linux system call number 1.
  const WRITE: u64 = 1;

  /// Linux system call number 3.
  const CLOSE: u64 = 3;

  /// Linux system call number 5.
  const FSTAT: u64 = 5;

  /// Linux system call number 8.
  const LSEEK: u64 = 8;

  /// Linux system call number 9.
  const MMAP: u64 = 9;

  /// Linux system call number 11.
  const MUNMAP: u64 = 11;

  /// Linux system call number 217.
  const GETDENTS64: u64 = 217;

  /// Linux system call number 257.
  const OPENAT: u64 = 257;

  /// Linux system call number 258.
  const MKDIRAT: u64 = 258;

  /// Linux system call number 262.
  const NEWFSTATAT: u64 = 262;

  /// Linux system call number 24.
  const SCHED_YIELD: u64 = 24;

  /// Linux system call number 35.
  const NANOSLEEP: u64 = 35;

  /// Linux system call number 39.
  const GETPID: u64 = 39;

  /// Linux system call number 60.
  const EXIT: u64 = 60;

  /// File descriptor 0, the console, which reads as empty.
  const STDIN: u64 = 0;

  /// File descriptor 1, the console.
  const STDOUT: u64 = 1;

  /// File descriptor 2, also the console.
  const STDERR: u64 = 2;

  /// `dirfd` meaning the current directory, -100. The current directory is
  /// always `/` for now.
  const AT_FDCWD: u64 = 0xFFFFFFFFFFFFFF9C;

  /// `newfstatat` flag: an empty path describes `dirfd` itself.
  const AT_EMPTY_PATH: u64 = 0x1000;

  /// `openat` access mode: read only.
  const O_RDONLY: u64 = 0;

  /// `openat` access mode: write only.
  const O_WRONLY: u64 = 1;

  /// `openat` access mode: read and write.
  const O_RDWR: u64 = 2;

  /// `openat`: create a regular file if missing.
  const O_CREAT: u64 = 0x40;

  /// `openat`: with `O_CREAT`, fail if the name exists.
  const O_EXCL: u64 = 0x80;

  /// `openat`: cut a regular file opened for writing.
  const O_TRUNC: u64 = 0x200;

  /// `openat`: every write goes to the end.
  const O_APPEND: u64 = 0x400;

  /// `openat`: fail unless the path is a directory.
  const O_DIRECTORY: u64 = 0x10000;

  /// `lseek` from the start.
  const SEEK_SET: u64 = 0;

  /// `lseek` from the current offset.
  const SEEK_CUR: u64 = 1;

  /// `lseek` from the end.
  const SEEK_END: u64 = 2;

  /// `mmap` protection: no access.
  const PROT_NONE: u64 = 0;

  /// `mmap` protection: read.
  const PROT_READ: u64 = 1;

  /// `mmap` protection: write.
  const PROT_WRITE: u64 = 2;

  /// `mmap` protection: execute.
  const PROT_EXEC: u64 = 4;

  /// `mmap` flag: shared (refused by IgniOS).
  const MAP_SHARED: u64 = 0x01;

  /// `mmap` flag: private.
  const MAP_PRIVATE: u64 = 0x02;

  /// `mmap` flag: at exactly this address (refused by IgniOS).
  const MAP_FIXED: u64 = 0x10;

  /// `mmap` flag: not backed by a file.
  const MAP_ANONYMOUS: u64 = 0x20;

  /// No such file or directory.
  const ENOENT: i64 = 2;

  /// Out of memory.
  const ENOMEM: i64 = 12;

  /// Permission denied.
  const EACCES: i64 = 13;

  /// File exists.
  const EEXIST: i64 = 17;

  /// No such device.
  const ENODEV: i64 = 19;

  /// Not a directory.
  const ENOTDIR: i64 = 20;

  /// Is a directory.
  const EISDIR: i64 = 21;

  /// Too many open files.
  const EMFILE: i64 = 24;

  /// Illegal seek.
  const ESPIPE: i64 = 29;

  /// File name too long.
  const ENAMETOOLONG: i64 = 36;

  /// Bad file descriptor (9).
  const EBADF: i64 = 9;

  /// Bad address (14).
  const EFAULT: i64 = 14;

  /// Invalid argument (22).
  const EINVAL: i64 = 22;

  /// Function not implemented (38).
  const ENOSYS: i64 = 38;

  /// A system call with no arguments. Returns the raw result in RAX.
  function call0(number: u64): i64 {
    return asm (number in rax) -> (result: i64 in rax) clobber(rcx, r11, memory) { syscall };
  }

  /// A system call with one argument, in RDI.
  function call1(number: u64, first: u64): i64 {
    return asm (number in rax, first in rdi) -> (result: i64 in rax) clobber(rcx, r11, memory) { syscall };
  }

  /// A system call with two arguments, in RDI and RSI.
  function call2(number: u64, first: u64, second: u64): i64 {
    return asm (number in rax, first in rdi, second in rsi) -> (result: i64 in rax) clobber(rcx, r11, memory) { syscall };
  }

  /// A system call with three arguments, in RDI, RSI and RDX.
  function call3(number: u64, first: u64, second: u64, third: u64): i64 {
    return asm (number in rax, first in rdi, second in rsi, third in rdx) -> (result: i64 in rax) clobber(rcx, r11, memory) { syscall };
  }

  /// A system call with four arguments; the fourth goes in R10, not RCX,
  /// because `syscall` overwrites RCX.
  function call4(number: u64, first: u64, second: u64, third: u64, fourth: u64): i64 {
    return asm (number in rax, first in rdi, second in rsi, third in rdx, fourth in r10) -> (result: i64 in rax) clobber(rcx, r11, memory) { syscall };
  }

  /// A system call with six arguments: R10, R8 and R9 carry the last three.
  function call6(
    number: u64,
    first: u64,
    second: u64,
    third: u64,
    fourth: u64,
    fifth: u64,
    sixth: u64
  ): i64 {
    return asm (number in rax, first in rdi, second in rsi, third in rdx, fourth in r10, fifth in r8, sixth in r9) -> (result: i64 in rax) clobber(rcx, r11, memory) { syscall };
  }

  /// Writes `count` bytes at `buffer` to descriptor `descriptor`. Returns the
  /// bytes written or a negated errno.
  function write(descriptor: u64, buffer: *u8, count: u64): i64 {
    return call3(WRITE, descriptor, @integerFromPointer(buffer), count);
  }

  /// Ends the process with the low 8 bits of `status`.
  function exit(status: u64): never {
    call1(EXIT, status);

    while (true) {
    }
  }

  /// The process id of the caller (`getpid`).
  function getPid(): i64 {
    return call0(GETPID);
  }

  /// Offers the processor to another thread. Returns 0.
  function yield(): i64 {
    return call0(SCHED_YIELD);
  }

  /// Sleeps for `seconds` and `nanoseconds`, rounded up to the kernel's 10 ms
  /// tick.
  function sleep(seconds: i64, nanoseconds: i64): i64 {
    let request: Timespec = Timespec { seconds: seconds, nanoseconds: nanoseconds };

    return call2(NANOSLEEP, @integerFromPointer(&request as *u8), 0);
  }

  /// A system call by number that the kernel does not implement, to see the
  /// `read(fd, buf, count)`: the bytes read, 0 at the end, or -errno.
  function read(descriptor: u64, buffer: *mut u8, count: u64): i64 {
    return call3(READ, descriptor, @integerFromPointer(buffer), count);
  }

  /// `openat(dirfd, path, flags, mode)` with a NUL-terminated path: the new
  /// descriptor or -errno.
  function openAt(directory: u64, path: *u8, flags: u64, mode: u64): i64 {
    return call4(OPENAT, directory, @integerFromPointer(path), flags, mode);
  }

  /// `openat(AT_FDCWD, path, flags, mode)`.
  function open(path: *u8, flags: u64, mode: u64): i64 {
    return openAt(AT_FDCWD, path, flags, mode);
  }

  /// `close(fd)`: 0 or -errno.
  function close(descriptor: u64): i64 {
    return call1(CLOSE, descriptor);
  }

  /// `lseek(fd, offset, whence)`: the new offset or -errno.
  function seek(descriptor: u64, offset: i64, whence: u64): i64 {
    return call3(LSEEK, descriptor, offset as u64, whence);
  }

  /// `fstat(fd, statbuf)` into the 144 bytes at `buffer`: 0 or -errno.
  function fstat(descriptor: u64, buffer: *mut u8): i64 {
    return call2(FSTAT, descriptor, @integerFromPointer(buffer));
  }

  /// `newfstatat(dirfd, path, statbuf, flags)`: 0 or -errno.
  function statAt(directory: u64, path: *u8, buffer: *mut u8, flags: u64): i64 {
    return call4(NEWFSTATAT, directory, @integerFromPointer(path), @integerFromPointer(buffer), flags);
  }

  /// `getdents64(fd, dirp, count)`: the bytes of whole records written, 0 at
  /// the end of the directory, or -errno.
  function readDirectory(descriptor: u64, buffer: *mut u8, count: u64): i64 {
    return call3(GETDENTS64, descriptor, @integerFromPointer(buffer), count);
  }

  /// `mkdirat(AT_FDCWD, path, mode)`: 0 or -errno.
  function makeDirectory(path: *u8, mode: u64): i64 {
    return call3(MKDIRAT, AT_FDCWD, @integerFromPointer(path), mode);
  }

  /// `mkdirat(dirfd, path, mode)`: 0 or -errno.
  function makeDirectoryAt(directory: u64, path: *u8, mode: u64): i64 {
    return call3(MKDIRAT, directory, @integerFromPointer(path), mode);
  }

  /// The text Linux's `strerror` gives for a negated errno `result`, for
  /// `mmap(0, length, prot, flags, fd, offset)`: the address of the new
  /// region, or -errno. The kernel picks the address.
  function mmap(length: u64, protection: u64, flags: u64, descriptor: u64, offset: u64): i64 {
    return call6(MMAP, 0, length, protection, flags, descriptor, offset);
  }

  /// `mmap` of `length` zeroed private bytes that can be read and written.
  function mapAnonymous(length: u64): i64 {
    return mmap(length, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, 0xFFFFFFFFFFFFFFFF, 0);
  }

  /// `munmap(addr, length)`: 0 or -errno.
  function munmap(address: u64, length: u64): i64 {
    return call2(MUNMAP, address, length);
  }

  /// the errors the file calls return.
  function errorText(result: i64): str {
    return match (0 - result) {
      ENOENT -> "No such file or directory",
      ENOMEM -> "Cannot allocate memory",
      EACCES -> "Permission denied",
      ENODEV -> "No such device",
      EBADF -> "Bad file descriptor",
      EFAULT -> "Bad address",
      EEXIST -> "File exists",
      ENOTDIR -> "Not a directory",
      EISDIR -> "Is a directory",
      EINVAL -> "Invalid argument",
      EMFILE -> "Too many open files",
      ESPIPE -> "Illegal seek",
      ENAMETOOLONG -> "File name too long",
      ENOSYS -> "Function not implemented",
      _ -> "Unknown error",
    };
  }

  /// error come back.
  function unknown(number: u64): i64 {
    return call0(number);
  }
}
